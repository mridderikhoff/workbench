<script>
"use strict";
/* ===== THEMES =====================================================================
How to add a theme: add one entry to THEMES below; nothing outside this section needs to change.
  name          label in the theme picker
  css           {light:{...}, dark:{...}} custom properties; provide every key that "blood" provides
  fonts         {serif, mono, body} font stacks
  favicon       SVG string for the tab icon
  headerMark    {eye, travel, lid, underlineCss}
                  eye: SVG string with hooks data-eye-iris (moved), data-eye-pupil (circle, resized),
                       data-eye-lid (upper lid, flipped about lid.pivot to blink), data-eye-cover (rect hiding the iris)
                  travel: [rx, ry] pupil travel in viewBox units; lid: {pivot, top, closed} in viewBox units
                  underlineCss: CSS rules for .mark::after (the title underline art)
  logoSource    SVG string, 64x64 viewBox, transparent background; the halftone eye samples its opaque pixels
  anatomy       optional {iris:[x, y, r], pupil:r, tips:[[x, tipY, topY], ...]} in logo units;
                needed by the "watcher" and "bleeding" modes
  palette       {light:[5 colours], dark:[5 colours]} halftone ramp, darkest first
  statusGlyphs  {ok, warn, bad, attn, unknown} SVG strings drawn with currentColor, distinct shapes;
                coloured by --glyph-ok, --warn, --glyph-bad and --idle
  brushStroke   {colors:{core, edge}, presets:{name:{weight, taperIn, taperOut, wobble, bristles, dryEnd, hook,
                drips:[min,max], dripLength, spatter:[min,max]}}} for generated underlines; omit to keep underlineCss
  settingsIcon  SVG string for the settings button; optional hooks .tome-cover (opens), .tome-pages and .tome-glow
  favicons      {ok, warn, bad, badDim} SVG strings (open eye = running, closed eye = down); the tab icon
                follows page health and alternates bad/badDim
  statusGlyphs.awake  optional open-eye glyph with a .glyph-pupil, shown when a ready app pill is hovered
  eyeModes      ids from the shared modes ("watcher", "coin", "bleeding", "off"), or custom renderer objects
                {id, label, init(engine), frame(engine, t), dispose(engine)}; "coin" and "off" need only logoSource
  copy          optional text overrides: {emptyTitle}
Minimal skeleton:
  THEMES.cthulhu = {
    name: "Cthulhu",
    css: {light: {...}, dark: {...}},
    fonts: THEMES.blood.fonts,
    favicon: "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'>...</svg>",
