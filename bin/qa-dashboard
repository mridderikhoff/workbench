        art: {
          floppy: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128"><rect x="9" y="12" width="114" height="114" rx="6" fill="#000" fill-opacity=".5"/><path fill="#2a2342" d="M10 4h96l14 14v96a6 6 0 0 1-6 6H10a6 6 0 0 1-6-6V10a6 6 0 0 1 6-6z"/><path fill="#ff3ea5" fill-opacity=".85" d="M10 4h96l14 14v4H4V10a6 6 0 0 1 6-6z"/><rect x="32" y="4" width="60" height="38" rx="2" fill="#b9b8c8"/><rect x="70" y="10" width="12" height="26" rx="1" fill="#2a2342"/><rect x="40" y="8" width="2" height="30" fill="#fff" fill-opacity=".5"/><rect x="18" y="60" width="92" height="56" rx="3" fill="#f3f1fa"/><path d="M26 74h76M26 86h60M26 98h70" stroke="#2fe6ff" stroke-width="2.4" stroke-linecap="round"/><path d="M26 74h40" stroke="#ff3ea5" stroke-width="2.4" stroke-linecap="round"/><rect x="8" y="110" width="6" height="6" fill="#17142a"/></svg>',
