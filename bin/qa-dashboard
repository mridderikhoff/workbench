    consoleArt: {
      dark: {room: "#0b0a12", void: "#05050b", rib: "#1e1b2e", edge: "#3a3456", shine: "#6b63a0", rim: "#2a2540", shadow: "#141220", deck: "#12101c", vent: "#2d2944", star: "#2fe6ff"},
      light: {room: "#d9d5e6", void: "#c3bfd6", rib: "#a9a3c2", edge: "#7a7398", shine: "#f6f3fb", rim: "#8e87ad", shadow: "#b5afc8", deck: "#bdb7d0", vent: "#9690b2", star: "#d1006f"}
    },
