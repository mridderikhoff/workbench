var justFinished=false;
function schedule(ms){if(INITIAL)return;clearTimeout(pollTimer);pollTimer=setTimeout(poll,ms)}
function poll(){
  fetch("/api/status",{cache:"no-store"}).then(function(r){
    return r.json().then(function(j){if(!r.ok||j.error)throw new Error(j.error||("HTTP "+r.status));return j});
  }).then(function(j){var wasRunning=isRunning();data=j;lastOk=new Date();failure=null;render();justFinished=wasRunning&&!isRunning()})
    .catch(function(e){failure=e.message;render()})
    .then(function(){schedule(isRunning()?1000:justFinished?1200:5000);justFinished=false});
}
// Only text that actually changed is written, so an idle second touches no layout.
setInterval(function(){if(document.hidden)return;setText(document.getElementById("updated"),updatedText());updateAgo()},1000);
if(INITIAL){data=INITIAL;lastOk=INITIAL.generatedAt?new Date(INITIAL.generatedAt):null}
render();buttonFx(document);
if(!INITIAL)poll();
// Procedural brushstrokes for underlines and drip accents; parameters come from the theme's brushStroke config.
var QA_BRUSH=(function(){
  var salt=(Math.random()*4294967296)>>>0;
  var reducedMotion=window.matchMedia("(prefers-reduced-motion: reduce)");
  function random(seed){return function(){seed=seed+0x6D2B79F5|0;var t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
  function smoothNoise(next,knots){
    var values=[];for(var i=0;i<=knots;i++)values.push(next());
    return function(u){var x=Math.max(0,Math.min(0.9999,u))*knots,i=Math.floor(x),f=x-i,s=(1-Math.cos(f*Math.PI))/2;return values[i]*(1-s)+values[i+1]*s};
  }
  function jitter(next,value){return value*(0.85+0.3*next())}
  function fixed(n){return n.toFixed(2)}
  // Blocks: a row of pixel blocks with seeded gaps and the odd light-shade block, like a line of block characters.
  function blocks(width,seed,opts,colors,height,baseline){
    var next=random(seed),size=opts.block||4,step=size+(opts.gap||1),out=[],end=width-next()*step*2;
    for(var x=next()*step;x+size<=end;x+=step){
      var roll=next();if(roll<(opts.drop||0))continue;
      var light=roll>1-(opts.light||0),lift=next()<0.06?-1:0;
      out.push('<rect x="'+fixed(x)+'" y="'+fixed(baseline-size/2+lift)+'" width="'+fixed(size)+'" height="'+fixed(size)+'" style="fill:'+(light?colors.edge:colors.core)+'"'+(light?' fill-opacity=".55"':"")+'/>');
    }
    return'<svg class="brush" viewBox="0 0 '+fixed(width)+" "+height+'" width="'+fixed(width)+'" height="'+height+'" shape-rendering="crispEdges" aria-hidden="true"><g opacity="'+(opts.opacity==null?1:opts.opacity)+'">'+out.join("")+"</g></svg>";
  }
  function svg(width,seed,scale,presetName){
    var config=QA_THEME.current().brushStroke;
    if(!config)return"";
    // presetName may also be a preset object (the divider rule); a preset can carry its own colours.
    var next=random(seed),names=Object.keys(config.presets),pick=names[Math.floor(next()*names.length)],preset=typeof presetName==="object"&&presetName?presetName:config.presets[presetName]||config.presets[pick];
    var colors=preset.colors||config.colors,overprint=preset.overprint||config.overprint;
    if(preset.style==="blocks")return blocks(width,seed,preset,colors,Math.ceil((preset.block||4)*(scale||1)+4),Math.ceil((preset.block||4)*(scale||1)/2+2));
    var k=scale||1,weight=jitter(next,preset.weight)*k,dripLength=jitter(next,preset.dripLength)*k,wobble=jitter(next,preset.wobble)*k;
    var taperIn=jitter(next,preset.taperIn),taperOut=jitter(next,preset.taperOut),height=Math.ceil(weight+dripLength+6*k);
    var pressureA=smoothNoise(next,3),pressureB=smoothNoise(next,7),drift=smoothNoise(next,5),slope=Math.tan((next()*3-1.5)*Math.PI/180);
    var start=next()*2*k,end=width-(1+next()*3)*k,baseY=weight/2+1.5*k,samples=48,top=[],bottom=[],coreTop=[],coreBottom=[],centre=[],thickness=[];
    for(var i=0;i<=samples;i++){
      var u=i/samples,x=start+(end-start)*u;
      var w=weight*(0.42+0.9*pressureA(u)+0.32*(pressureB(u)-0.5))*Math.pow(Math.min(1,u/taperIn),0.6)*Math.pow(Math.min(1,(1-u)/taperOut),0.85);
      var y=baseY+slope*(x-width/2)+wobble*(drift(u)-0.5);
      centre.push([x,y]);thickness.push(w);
      top.push(fixed(x)+" "+fixed(y-w/2));bottom.unshift(fixed(x)+" "+fixed(y+w/2));
      coreTop.push(fixed(x)+" "+fixed(y-w*0.3));coreBottom.unshift(fixed(x)+" "+fixed(y+w*0.3));
    }
    var edge='style="fill:'+colors.edge+'"',core='style="fill:'+colors.core+'"',out=[];
    out.push('<path '+edge+' d="M'+top.join("L")+"L"+bottom.join("L")+'Z"/>');
    out.push('<path '+core+' d="M'+coreTop.join("L")+"L"+coreBottom.join("L")+'Z"/>');
    function at(u){var i=Math.round(Math.max(0,Math.min(1,u))*samples);return{x:centre[i][0],y:centre[i][1],w:thickness[i]}}
    for(var b=0;b<preset.bristles;b++){
      var offset=(b-(preset.bristles-1)/2)*0.32,line=[];
      for(var s=0.15;s<=0.78;s+=0.07){var p=at(s);line.push(fixed(p.x)+" "+fixed(p.y+offset*p.w))}
      out.push('<path style="stroke:'+colors.edge+'" fill="none" stroke-opacity=".45" stroke-width="'+fixed(0.45*k)+'" d="M'+line.join("L")+'"/>');
    }
    var dry=Math.round(jitter(next,preset.dryEnd));
    for(var d=0;d<dry;d++){
      var from=at(0.74+next()*0.06),reach=end+(next()*5-1)*k,dy=(d-(dry-1)/2)*weight*0.32+(next()-0.5)*k;
      out.push('<path style="stroke:'+colors.core+'" fill="none" stroke-linecap="round" stroke-width="'+fixed((0.5+next()*0.6)*k)+'" stroke-dasharray="'+fixed((3+next()*6)*k)+" "+fixed((0.8+next()*1.6)*k)+'" d="M'+fixed(from.x)+" "+fixed(from.y+dy)+"L"+fixed(reach)+" "+fixed(from.y+dy+slope*(reach-from.x)+(next()-0.5)*k)+'"/>');
    }
    if(next()<preset.hook){
      var tail=at(0.97);
      out.push('<path style="stroke:'+colors.core+'" fill="none" stroke-linecap="round" stroke-width="'+fixed(1.2*k)+'" d="M'+fixed(tail.x)+" "+fixed(tail.y)+"Q"+fixed(tail.x+3.5*k)+" "+fixed(tail.y-0.5*k)+" "+fixed(tail.x+2.2*k)+" "+fixed(tail.y-3*k)+'"/>');
    }
    var drips=preset.drips[0]+Math.floor(next()*(preset.drips[1]-preset.drips[0]+1));
    for(var j=0;j<drips;j++){
      var anchor=at(0.15+next()*0.62),length=(2*k+Math.pow(next(),1.6)*dripLength),dw=(1.1+next()*1.1)*k,y0=anchor.y+anchor.w*0.35;
      out.push('<path '+core+' d="M'+fixed(anchor.x-dw/2)+" "+fixed(y0)+"L"+fixed(anchor.x-dw*0.32)+" "+fixed(y0+length)+"L"+fixed(anchor.x+dw*0.32)+" "+fixed(y0+length)+"L"+fixed(anchor.x+dw/2)+" "+fixed(y0)+'Z"/>');
      if(next()<0.65)out.push('<circle '+core+' cx="'+fixed(anchor.x)+'" cy="'+fixed(y0+length)+'" r="'+fixed(dw*0.72)+'"/>');
    }
    var spatter=preset.spatter[0]+Math.floor(next()*(preset.spatter[1]-preset.spatter[0]+1));
    for(var m=0;m<spatter;m++){
      var nearEnd=next()<0.6,sx=nearEnd?end-next()*10*k+2*k:start+next()*8*k,sy=baseY+(next()*2-1)*5*k;
      out.push('<circle '+(next()<0.5?core:edge)+' cx="'+fixed(sx)+'" cy="'+fixed(Math.max(0.6,sy))+'" r="'+fixed((0.35+next()*0.5)*k)+'"/>');
    }
    var ink=out.join("");
    // A second ink prints the same stroke slightly off register, underneath the first.
    if(overprint)ink='<g transform="translate('+fixed(overprint.dx*k)+" "+fixed(overprint.dy*k)+')" opacity="'+(overprint.opacity==null?1:overprint.opacity)+'">'+ink.split(colors.core).join(overprint.color).split(colors.edge).join(overprint.color)+"</g>"+ink;
    return'<svg class="brush" viewBox="0 '+fixed(-3*k)+" "+fixed(width+6*k)+" "+fixed(height+3*k)+'" width="'+fixed(width+6*k)+'" height="'+fixed(height+3*k)+'" aria-hidden="true">'+ink+"</svg>";
  }
  function paint(host,width,seed,scale,animate,presetName){
    var old=host.querySelector(":scope > .brush");
    if(old)old.remove();
    host.insertAdjacentHTML("beforeend",svg(width,seed,scale,presetName));
    var brush=host.querySelector(":scope > .brush");
    if(brush&&animate&&!reducedMotion.matches){brush.classList.add("fresh");brush.addEventListener("animationend",function(){brush.classList.remove("fresh")},{once:true})}
    return brush;
  }
  function wordmark(){
    var mark=document.querySelector(".mark"),theme=QA_THEME.current();
    if(!mark)return;
    // A theme whose character already drips over the wordmark can skip the underline (wordmarkStroke: false).
    if(!theme.brushStroke||theme.wordmarkStroke===false){mark.classList.remove("has-brush");Array.prototype.forEach.call(mark.querySelectorAll(".brush"),function(b){b.remove()});return}
    mark.classList.add("has-brush");
    paint(mark,mark.getBoundingClientRect().width||110,(Math.random()*4294967296)>>>0,1,true);
  }
  // Section dividers, drawn once per branch at the card's real width (so a stroke keeps its weight on a phone).
  // "drybrush": a loaded brush lands and pools, splits into bristle streaks as it runs dry, and lifts off in a flick, with the
  // odd drip and a few specks. "marker": a chisel nib or spray can: hard angled ends, even width, lap marks where it went over
  // itself, overspray dots and the occasional run. Either may be printed again in a second ink, off register.
  function clamp(v){return v<0?0:v>1?1:v}
  function divider(width,seed,rule){
    if(rule.style==="blocks")return blocks(width,seed,rule,rule.colors,rule.height,rule.baseline).replace('class="brush"','class="brush" style="top:'+(12-rule.baseline)+'px;height:'+rule.height+'px"');
    var next=random(seed),c=rule.colors,H=rule.height,base=rule.baseline,out=[],N=140,marker=rule.style==="marker";
    var W=width,weight=jitter(next,rule.weight),start=3+next()*W*0.03,end=W-4-next()*W*(rule.shorten||0.06);
    var bow=(next()-0.5)*2*rule.bow,slope=(next()-0.5)*2*rule.slope,wobble=jitter(next,rule.wobble);
    var drift=smoothNoise(next,6),pressA=smoothNoise(next,4),pressB=smoothNoise(next,13);
    var lift=rule.flick&&next()<rule.flick[0]?rule.flick[1]*(0.65+0.6*next()):0,land=0.04+next()*0.05;
    var nib=marker?Math.tan((rule.nib||0)*Math.PI/180):0,cx=[],cy=[],cw=[];
    for(var i=0;i<=N;i++){
      var u=i/N,x=start+(end-start)*u,t=clamp((u-0.88)/0.12);
      var y=base+slope*(u-0.5)+bow*(4*u*(1-u)-0.5)+wobble*(drift(u)-0.5)-lift*Math.pow(t,1.7);
      var w=marker?weight*(0.93+0.1*pressB(u)):weight*(0.55+0.65*pressA(u)+0.3*(pressB(u)-0.5))*Math.pow(clamp(u/rule.taperIn),0.55)*Math.pow(clamp((1-u)/rule.taperOut),0.9)*(1+0.35*Math.exp(-Math.pow((u-land)/0.05,2)));
      cx.push(x);cy.push(y);cw.push(Math.max(0.15,w));
    }
    function fill(color,opacity){return'style="fill:'+color+'"'+(opacity!=null&&opacity<1?' fill-opacity="'+fixed(opacity)+'"':"")}
    // A ribbon that follows the stroke between u0 and u1: off is its centre as a fraction of the stroke width, frac its width.
    var splay=rule.splay||0;
    function ribbon(i0,i1,off,frac,color,opacity,taper){
      var top=[],bottom=[];
      for(var i=i0;i<=i1;i++){
        var k=taper?Math.min(1,(i-i0+1)/3,(i1-i+1)/3):1,half=cw[i]*frac*k/2,y=cy[i]+off*cw[i]*(1+splay*clamp((i/N-0.6)/0.4)),dx=nib*cw[i]*frac/2;
        top.push(fixed(cx[i]+dx)+" "+fixed(y-half));bottom.unshift(fixed(cx[i]-dx)+" "+fixed(y+half));
      }
      if(top.length>1)out.push('<path '+fill(color,opacity)+' d="M'+top.join("L")+"L"+bottom.join("L")+'Z"/>');
    }
    function speck(x,y,r,color,opacity){out.push('<circle '+fill(color,opacity)+' cx="'+fixed(x)+'" cy="'+fixed(Math.max(r,Math.min(H-r,y)))+'" r="'+fixed(r)+'"/>')}
    function gauss(){return(next()+next()+next()-1.5)/1.5}
    if(marker){
      // Laid down twice where the nib went back over itself, so the overlap reads denser; a blot where the nib rested.
      ribbon(0,N,0,1,c.core,rule.body);
      var lapA=Math.floor(N*(0.05+next()*0.2)),lapB=Math.min(N,lapA+Math.floor(N*(0.2+next()*0.3)));
      ribbon(lapA,lapB,(next()-0.5)*0.12,0.96,c.core,rule.lap);
      out.push('<path '+fill(c.core,rule.body)+' d="'+blobPath(cx[0]+cw[0]*0.15,cy[0],cw[0]*0.62,5,0.07,next()*6)+'"/>');
      // The felt runs dry towards the end: thin streaks of the card show through.
      for(var q=0;q<(rule.dry||0);q++)ribbon(Math.floor(N*(0.5+next()*0.3)),N-1,(next()-0.5)*0.6,0.09+next()*0.09,c.gap,0.75,true);
      for(var o=0;o<rule.overspray;o++){
        var at=Math.min(N,Math.floor(Math.pow(next(),next()<0.5?0.6:1.6)*N)),side=next()<0.62?1:-1,spread=cw[at]/2+Math.abs(gauss())*rule.spread;
        speck(cx[at]+gauss()*6,cy[at]+side*spread,0.3+next()*0.6,c.core,0.35+next()*0.5);
      }
    }else{
      // Bristles: overlapping ribbons that each run out of ink on their own, the outer ones first, so the tail breaks into streaks.
      for(var b=0;b<rule.bristles;b++){
        var off=((b+0.5)/rule.bristles-0.5)*(1+0.06*(next()-0.5)),frac=(1.4+next()*0.8)/rule.bristles,ink=next()<rule.streaks?c.edge:c.core;
        var gaps=smoothNoise(next,34+Math.floor(next()*30)),from=Math.floor(next()*N*0.03),to=N-Math.floor(next()*N*rule.ragged),outer=Math.pow(Math.abs(off)*2,3),run=-1;
        for(var j=from;j<=to+1;j++){
          var dry=clamp((j/N-rule.dryStart)/(1-rule.dryStart)),inked=j<=to&&gaps(j/N)>dry*(0.5+0.4*outer)+outer*0.32+(dry>0?0.08:0);
          if(inked&&run<0)run=j;
          if(!inked&&run>=0){if(j-run>1)ribbon(run,j-1,off,frac*(1-0.5*clamp(((run+j)/2/N-rule.dryStart)/(1-rule.dryStart))),ink,1,true);run=-1}
        }
      }
      // Ink pools where the brush landed and gathers along the edges of the loaded part.
      var loaded=Math.floor(N*rule.dryStart),li=Math.floor(N*land);
      out.push('<path '+fill(c.core)+' d="'+blobPath(cx[li]-cw[li]*0.25,cy[li],cw[li]*0.5,4,0.08,next()*6)+'"/>');
      ribbon(Math.floor(N*land*0.4),Math.floor(N*(land+0.07)),0.04,0.62,c.pool,0.8,true);
      ribbon(2,loaded,-0.4,0.16,c.pool,0.7,true);ribbon(4,Math.floor(loaded*0.8),0.41,0.14,c.pool,0.6,true);
      for(var p=0;p<rule.pools;p++){var p0=Math.floor(N*(0.1+next()*0.4));ribbon(p0,p0+Math.floor(N*(0.04+next()*0.07)),(next()-0.5)*0.4,0.25+next()*0.25,c.pool,0.75,true)}
      if(c.sheen)for(var s=0;s<2;s++){var s0=Math.floor(N*(0.06+next()*0.25));ribbon(s0,s0+Math.floor(N*(0.12+next()*0.2)),-0.18+next()*0.2,0.06,c.sheen,0.5,true)}
      // A few bristles fly past the end of the flick as thin tapered hairs.
      for(var h=0;h<rule.hairs;h++){
        var hi=Math.floor(N*(0.9+next()*0.06)),ho=(next()-0.5)*0.7,hx=end+2+next()*9,hy=cy[N]+ho*cw[hi]*0.5-next()*3,hw=0.35+next()*0.4,mx=(cx[hi]+hx)/2,my=(cy[hi]+ho*cw[hi]+hy)/2;
        out.push('<path '+fill(c.core,0.85)+' d="M'+fixed(cx[hi])+" "+fixed(cy[hi]+ho*cw[hi]-hw)+"Q"+fixed(mx)+" "+fixed(my-hw)+" "+fixed(hx)+" "+fixed(hy)+"Q"+fixed(mx)+" "+fixed(my+hw)+" "+fixed(cx[hi])+" "+fixed(cy[hi]+ho*cw[hi]+hw)+'Z"/>');
      }
    }
    // A drip runs down from the underside: a shoulder where it leaves the stroke, a thin neck and a bead.
    var drips=rule.drips[0]+Math.floor(next()*(rule.drips[1]-rule.drips[0]+1));
    for(var d=0;d<drips;d++){
      var di=Math.floor(N*(0.16+next()*0.5)),dx=cx[di],y0=cy[di]+cw[di]*0.38,len=Math.min(H-y0-3,rule.dripLength*(0.55+0.6*next())),neck=rule.dripWidth*(0.8+0.4*next());
      out.push('<path '+fill(c.core)+' d="M'+fixed(dx-neck*2.4)+" "+fixed(y0-1)+"Q"+fixed(dx-neck*0.55)+" "+fixed(y0+1.5)+" "+fixed(dx-neck*0.5)+" "+fixed(y0+len)+"L"+fixed(dx+neck*0.5)+" "+fixed(y0+len)+"Q"+fixed(dx+neck*0.6)+" "+fixed(y0+1.5)+" "+fixed(dx+neck*2.2)+" "+fixed(y0-1)+'Z"/>');
      speck(dx,y0+len,neck*0.95,c.core);
    }
    // Specks thrown off the end of the stroke, and the odd one near where it landed.
    var specks=rule.spatter[0]+Math.floor(next()*(rule.spatter[1]-rule.spatter[0]+1));
    for(var m=0;m<specks;m++){
      var late=next()<0.7,sx=late?end-12+next()*30:start+next()*W*0.25,sy=(late?cy[N]-lift*0.3:base)+gauss()*(weight*0.9+5);
      speck(sx,sy,0.5+Math.pow(next(),2)*1.4,next()<0.6?c.core:c.edge);
    }
    var ink=out.join(""),op=rule.overprint;
    if(op){var copy=ink;[c.core,c.edge,c.pool,c.sheen].forEach(function(color){if(color)copy=copy.split(color).join(op.color)});ink='<g transform="translate('+fixed(op.dx)+" "+fixed(op.dy)+')" opacity="'+op.opacity+'">'+copy+"</g>"+ink}
    return'<svg class="brush" viewBox="0 0 '+fixed(W)+" "+H+'" preserveAspectRatio="none" style="top:'+(12-base)+'px;height:'+H+'px" aria-hidden="true"><g opacity="'+(rule.opacity==null?1:rule.opacity)+'">'+ink+"</g></svg>";
  }
  // Hand-inked dividers between sessions, seeded per branch so they stay put across refreshes.
  function rules(root){
    var config=QA_THEME.current().brushStroke;
    if(!config||!config.rule)return;
    var cards=root.classList&&root.classList.contains("slot-card")?[root]:root.querySelectorAll(".slot-card");
    Array.prototype.forEach.call(cards,function(card){
      var branch=card.querySelector(".branch"),name=(branch?branch.textContent:"")+"|"+QA_THEME.id(),old=card.querySelector(":scope > .divider");
      var width=Math.round(((card.getBoundingClientRect().width||700)+20)/40)*40,key=name+"|"+width;
      if(old&&old.dataset.ruleFor===key)return;
      if(old)old.remove();
      var seed=hashText("rule:"+name),art=config.rule.style?divider(width,seed,config.rule):svg(720,seed,1,config.rule);
      card.insertAdjacentHTML("afterbegin",'<div class="divider" aria-hidden="true" data-rule-for="'+esc(key)+'">'+art+'</div>');
    });
  }
  var resizeTimer=0;
  window.addEventListener("resize",function(){clearTimeout(resizeTimer);resizeTimer=setTimeout(function(){if(QA_THEME.current().brushStroke)rules(document)},250)});
  function decorate(root){
    if(!QA_THEME.current().brushStroke)return;
    rules(root||document);
    (root||document).querySelectorAll(".branch").forEach(function(branch){
      var name=branch.textContent;
      if(branch.dataset.brushFor===name&&branch.querySelector(":scope > .brush"))return;
      branch.dataset.brushFor=name;branch.classList.add("has-brush");
      paint(branch,Math.min(branch.getBoundingClientRect().width||120,200),hashText(name)^salt,0.7,false);
    });
  }
  function dialogTitle(){
    var title=document.getElementById("settings-title");
    if(!title||!QA_THEME.current().brushStroke)return;
    title.classList.add("has-brush");
    paint(title,96,(Math.random()*4294967296)>>>0,0.85,true);
  }
  return{svg:svg,paint:paint,wordmark:wordmark,decorate:decorate,dialogTitle:dialogTitle,hashText:hashText,salt:salt};
})();
// Shared eye engine: theme-agnostic; art, palette and modes come from the active theme.
// Test aids: ?frame=<seconds> freezes time, ?eye=<mode> picks a mode, ?pointer=<x>,<y> fakes the cursor.
(function eyes(){
  var query=new URLSearchParams(location.search);
  var frozen=parseFloat(query.get("frame")),isFrozen=!isNaN(frozen);
  var reduced=window.matchMedia("(prefers-reduced-motion: reduce)");
  var scheme=window.matchMedia("(prefers-color-scheme: dark)");
  var pointer={x:0,y:0,vx:0,vy:0,movedAt:-1e9,known:false};
  function clock(){return performance.now()}
  function mulberry(seed){return function(){seed=seed+0x6D2B79F5|0;var t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
  function findAt(starts,t){
    if(!starts.length||t<starts[0])return-1;
    var low=0,high=starts.length-1;
    while(low<high){var mid=(low+high+1)>>1;if(starts[mid]<=t)low=mid;else high=mid-1}
    return low;
  }
  function track(x,y){
    var now=clock(),elapsed=Math.max(1,now-pointer.movedAt);
    if(pointer.known&&elapsed<200){pointer.vx=(x-pointer.x)/elapsed;pointer.vy=(y-pointer.y)/elapsed}else{pointer.vx=pointer.vy=0}
    pointer.x=x;pointer.y=y;pointer.movedAt=now;pointer.known=true;
  }
  document.addEventListener("pointermove",function(e){if(e.pointerType!=="touch")track(e.clientX,e.clientY)},{passive:true});
  document.addEventListener("pointerdown",function(e){if(e.pointerType==="touch")track(e.clientX,e.clientY)},{passive:true});
  var fakePointer=query.get("pointer");
  if(fakePointer){var parts=fakePointer.split(",");pointer.x=+parts[0];pointer.y=+parts[1];pointer.known=true;pointer.movedAt=1e15}

  /* ---------- halftone grid engine ---------- */
  // The grid is laid out per character (its stage: canvas size, dot pitch and where logo unit 32 sits); layout() reallocates it.
  var canvas=document.getElementById("eye"),ctx=canvas.getContext("2d");
  var W=200,H=230,PITCH=4.5,SIZE=200,RES=512,SCALE=SIZE/64,CENTER_Y=92,FPS=12,LIGHT_FPS=24;
  var BAYER=[0,8,2,10,12,4,14,6,3,11,1,9,15,7,13,5];
  var cols=0,rows=0,count=0,offsetX=0,offsetY=0;
  var engine={veinPaths:[],veins:null,source:null,anatomy:null,track:{active:false,lastMoveAt:-1e9},inks:[[]],fps:FPS,status:window.QA_ROLLUP||"unknown"};
  var dotShade,dotRadius,drawnShade,drawnRadius,drawnBack,dotOrder,shadeStart=new Uint16Array(41),bucketCounts=new Uint16Array(40),forceDraw=true;
  function layout(character){
    var stage=character.stage||{};
    W=stage.width||200;H=stage.height||230;PITCH=stage.pitch||4.5;SIZE=stage.size||W;CENTER_Y=stage.centerY!=null?stage.centerY:H/2;SCALE=SIZE/64;
    cols=Math.floor(W/PITCH)+1;rows=Math.floor(H/PITCH)+1;count=cols*rows;
    offsetX=(W-(cols-1)*PITCH)/2;offsetY=(H-(rows-1)*PITCH)/2;
    engine.cols=cols;engine.rows=rows;engine.count=count;engine.pitch=PITCH;engine.poolRow=rows-3;
    ["dotX","dotY","intensity","radiusScale","alpha","normalX","normalY","normalZ","angle"].forEach(function(name){engine[name]=new Float32Array(count)});
    ["hash","ink","back","dropout","inIris","edgeIn","edgeOut"].forEach(function(name){engine[name]=new Uint8Array(count)});
    for(var cell=0;cell<count;cell++){
      engine.dotX[cell]=offsetX+(cell%cols)*PITCH;engine.dotY[cell]=offsetY+Math.floor(cell/cols)*PITCH;
      engine.hash[cell]=(Math.imul(cell+1,2654435761)>>>24)&255;
    }
    dotShade=new Int8Array(count);dotRadius=new Uint8Array(count);drawnShade=new Int8Array(count);drawnRadius=new Uint8Array(count);drawnBack=new Uint8Array(count);dotOrder=new Uint16Array(count);
    forceDraw=true;
  }
  engine.colOf=function(u){return Math.round(((u-32)*SCALE+W/2-offsetX)/PITCH)};
  engine.rowOf=function(v){return Math.round(((v-32)*SCALE+CENTER_Y-offsetY)/PITCH)};
  engine.px=function(u){return(u-32)*SCALE+W/2};
  engine.py=function(v){return(v-32)*SCALE+CENTER_Y};
  // put raises a cell (the brighter mark wins); set overwrites it. ink picks the ramp: 0 is the palette, 1.. the theme's inks.
  engine.put=function(col,row,value,ink){
    if(col<0||row<0||col>=cols||row>=rows)return;
    var index=row*cols+col;
    if(value>engine.intensity[index]){engine.intensity[index]=value;engine.ink[index]=ink||0}
  };
  engine.set=function(col,row,value,ink){
    if(col<0||row<0||col>=cols||row>=rows)return;
    var index=row*cols+col;engine.intensity[index]=value;engine.ink[index]=ink||0;
  };
  // For custom renderers: the cursor's offset in CSS px from a cell while tracking is engaged, else null.
  engine.aim=function(col,row){
    if(!engine.track.active||!pointer.known)return null;
    var rect=canvas.getBoundingClientRect(),dx=pointer.x-(rect.left+engine.dotX[0]+col*PITCH),dy=pointer.y-(rect.top+engine.dotY[0]+row*PITCH);
    return{dx:dx,dy:dy,distance:Math.hypot(dx,dy)};
  };
  engine.random=function(seed){return mulberry(seed)};
  engine.reduced=function(){return reduced.matches};
  // Grid-snapped ellipse: radii in whole cells, so every shape is a deliberate pixel pattern.
  engine.stamp=function(col,row,radiusX,radiusY,peak){
    for(var dr=-radiusY;dr<=radiusY;dr++)for(var dc=-radiusX;dc<=radiusX;dc++){
      var qx=radiusX?dc/radiusX:0,qy=radiusY?dr/radiusY:0,q=qx*qx+qy*qy;
      if(q<=1)engine.put(col+dc,row+dr,peak*(1-0.3*q));
    }
  };
  // Teardrops hang from their top row; dimmer corner cells round the halftone silhouette.
  var DROP_SHAPES=[
    [[0,1,0]],
    [[0,1,0],[0.55,1,0.55],[0.45,0.9,0.45]],
    [[0,1,0],[0.4,1,0.4],[0.85,1,0.85],[0.55,1,0.55],[0,0.7,0]],
    [[0,1,0],[0,1,0],[0.5,1,0.5],[0.8,1,0.8],[0.35,0.9,0.35],[0,0.5,0]]
  ];
  engine.drop=function(col,top,size,peak){
    var shape=DROP_SHAPES[size];
    for(var r=0;r<shape.length;r++)for(var c=0;c<3;c++)if(shape[r][c])engine.put(col+c-1,top+r,peak*shape[r][c]);
  };
  function blurField(values,radius){
    var temp=new Float32Array(values.length),out=new Float32Array(values.length),x,y,sum,span=2*radius+1;
    for(y=0;y<RES;y++){sum=0;for(x=-radius;x<RES+radius;x++){
      if(x+radius<RES)sum+=values[y*RES+x+radius];if(x-radius-1>=0)sum-=values[y*RES+x-radius-1];
      if(x>=0&&x<RES)temp[y*RES+x]=sum/span}}
    for(x=0;x<RES;x++){sum=0;for(y=-radius;y<RES+radius;y++){
      if(y+radius<RES)sum+=temp[(y+radius)*RES+x];if(y-radius-1>=0)sum-=temp[(y-radius-1)*RES+x];
      if(y>=0&&y<RES)out[y*RES+x]=sum/span}}
    return out;
  }
  function buildSource(image){
    var off=document.createElement("canvas");off.width=off.height=RES;
    var octx=off.getContext("2d");if(image)octx.drawImage(image,0,0,RES,RES);
    var pixels=octx.getImageData(0,0,RES,RES).data,total=RES*RES,alpha=new Float32Array(total),i;
    for(i=0;i<total;i++)alpha[i]=pixels[i*4+3]/255;
    var soft=blurField(blurField(alpha,4),4),normalX=new Float32Array(total),normalY=new Float32Array(total),normalZ=new Float32Array(total);
    for(i=0;i<total;i++){
      var col=i%RES,row=(i/RES)|0;
      if(col<1||row<1||col>=RES-1||row>=RES-1){normalZ[i]=1;continue}
      var gx=(soft[i+1]-soft[i-1])*9,gy=(soft[i+RES]-soft[i-RES])*9,length=Math.hypot(gx,gy,1);
      normalX[i]=-gx/length;normalY[i]=-gy/length;normalZ[i]=1/length;
    }
    engine.source={alpha:alpha,soft:soft,normalX:normalX,normalY:normalY,normalZ:normalZ};
    var anatomy=engine.anatomy=QA_THEME.character().anatomy||null;
    for(i=0;i<count;i++){
      var sx=Math.floor((engine.dotX[i]-W/2)*RES/SIZE+RES/2),sy=Math.floor((engine.dotY[i]-CENTER_Y)*RES/SIZE+RES/2),index=sy*RES+sx;
      var inside=sx>=0&&sy>=0&&sx<RES&&sy<RES;
      engine.alpha[i]=inside?alpha[index]:0;
      engine.normalX[i]=inside?normalX[index]:0;engine.normalY[i]=inside?normalY[index]:0;engine.normalZ[i]=inside?normalZ[index]:1;
      engine.dropout[i]=inside&&soft[index]>0.12&&soft[index]<0.86&&engine.hash[i]<64?1:0;
      var u=(engine.dotX[i]-W/2)/SCALE+32,v=(engine.dotY[i]-CENTER_Y)/SCALE+32;
      engine.inIris[i]=anatomy&&Math.hypot(u-anatomy.iris[0],v-anatomy.iris[1])<anatomy.iris[2]+0.4?1:0;
    }
    classifyEdges();
  }
  function classifyEdges(){
    var anatomy=engine.anatomy,centerU=anatomy?anatomy.iris[0]:32,centerV=anatomy?anatomy.iris[1]:30,i;
    for(i=0;i<count;i++){
      var col=i%cols,row=(i/cols)|0,lit=engine.alpha[i]>0.3,u=(engine.dotX[i]-W/2)/SCALE+32,v=(engine.dotY[i]-CENTER_Y)/SCALE+32;
      var distance=Math.hypot(u-centerU,v-centerV);
      // The pupil edge belongs to the moving pupil, so only the outer iris rim may wobble.
      var core=anatomy&&distance<anatomy.iris[2]-1.5;
      var litNeighbour=false,darkNeighbour=false;
      [[1,0],[-1,0],[0,1],[0,-1]].forEach(function(step){
        var c=col+step[0],r=row+step[1],neighbourLit=c>=0&&r>=0&&c<cols&&r<rows&&engine.alpha[r*cols+c]>0.3;
        if(neighbourLit)litNeighbour=true;else darkNeighbour=true;
      });
      engine.edgeIn[i]=!core&&lit&&darkNeighbour?1:0;
      engine.edgeOut[i]=!core&&!lit&&litNeighbour?1:0;
      engine.angle[i]=Math.atan2(v-centerV,u-centerU);
    }
    engine.veinPaths=[veinPath(-1,-1),veinPath(-1,1),veinPath(1,-1),veinPath(1,1)];
    engine.veins=schedules(71,4,[6,12],function(random){return{path:Math.floor(random()*4),length:3+Math.floor(random()*4)}});
  }
  // A vein starts at a lid corner and creeps inward along lit lid cells, preferring the upper or lower lid.
  function veinPath(side,vertical){
    var best=-1,path=[],visited={};
    for(var i=0;i<count;i++){
      if(engine.alpha[i]<=0.3||engine.inIris[i])continue;
      if(best<0||(side<0?engine.dotX[i]<engine.dotX[best]:engine.dotX[i]>engine.dotX[best]))best=i;
    }
    for(var stepCount=0;best>=0&&stepCount<8;stepCount++){
      path.push(best);visited[best]=true;
      var col=best%cols,row=(best/cols)|0,next=-1,score=-1e9;
      for(var dr=-1;dr<=1;dr++)for(var dc=-1;dc<=1;dc++){
        var c=col+dc,r=row+dr,index=r*cols+c;
        if(!(dc||dr)||c<0||r<0||c>=cols||r>=rows||visited[index]||engine.alpha[index]<=0.3||engine.inIris[index])continue;
        var gain=-side*dc*2+vertical*dr;
        if(gain>score){score=gain;next=index}
      }
      best=next;
    }
    return path;
  }
  // Edge life and veins; runs on the emblem before blood is drawn. Nothing here grows and shrinks on a regular beat.
  engine.living=function(t,edges){
    if(reduced.matches&&isNaN(frozen))return;
    var step=Math.floor(t*FPS)/FPS;
    // The lobes travel around the rim at an uneven, never-repeating pace; the speed stays positive so they only ever drift forward.
    var crawlA=1.2*step+1.4*Math.sin(step*0.41)+0.9*Math.sin(step*0.157+1.3),crawlB=0.85*step+1.1*Math.sin(step*0.29+0.5)+0.7*Math.sin(step*0.083+2.1),intensity=engine.intensity,radius=engine.radiusScale;
    for(var i=0;i<count;i++){
      var value=intensity[i];
      if(edges&&(engine.edgeIn[i]||engine.edgeOut[i])){
        var angle=engine.angle[i],bulge=0.6*Math.sin(5*angle-crawlA)+0.4*Math.sin(3*angle+crawlB+1.7)+(engine.hash[i]/255-0.5)*0.5;
        if(engine.inIris[i])bulge*=0.7;
        if(engine.edgeOut[i]&&bulge>0.62)value=Math.max(value,0.55);
        if(engine.edgeIn[i]&&bulge<-0.6)value*=0.2;
      }
      if(value>0){
        radius[i]*=1+Math.max(0,value-0.9)*0.6;
      }
      intensity[i]=value;
    }
    if(!edges||!engine.veins)return;
    var j=findAt(engine.veins.starts,step%HORIZON);
    if(j<0)return;
    var vein=engine.veins.data[j],path=engine.veinPaths[vein.path],age=step%HORIZON-engine.veins.starts[j];
    var length=Math.min(vein.length,path.length),creep=length/6,fade=age<creep+0.6?1:1-(age-creep-0.6)/0.8;
    if(fade<=0)return;
    var head=Math.min(length,Math.floor(age*6)+1);
    for(var k=0;k<head;k++){
      var cell=path[k];
      intensity[cell]=intensity[cell]+(1.1-intensity[cell])*fade;
      radius[cell]=Math.max(radius[cell],1+0.15*fade);
    }
  };
  engine.shade=function(index,lightX,lightY,lightZ,band,gain){
    var a=engine.alpha[index];
    if(a<0.05||engine.dropout[index])return 0;
    var lambert=Math.max(0,engine.normalX[index]*lightX+engine.normalY[index]*lightY+engine.normalZ[index]*lightZ);
    return a*(0.1+1.02*Math.pow(lambert,1.5)+0.36*band)*gain;
  };
  // Each dot's shade and radius are bucketed before drawing; a frame identical to the last one skips the canvas entirely.
  // Each dot's ink, shade and radius are bucketed before drawing; a frame identical to the last one skips the canvas entirely.
  // A bucket is ink*5+shade. Backdrop dots (engine.back, bucket+1) are drawn first at full size, under everything.
  function present(){
    var intensity=engine.intensity,radiusScale=engine.radiusScale,ink=engine.ink,back=engine.back,changed=forceDraw,i,buckets=Math.min(40,engine.inks.length*5);
    for(i=0;i<count;i++){
      var value=intensity[i],shade=-1,quantised=0;
      if(value>=0.08){
        var scaled=Math.min(6,value*6),level=Math.floor(scaled);
        if(scaled-level>BAYER[((i/cols|0)&3)*4+(i%cols&3)]/16)level++;
        level=Math.max(1,Math.min(6,level));
        shade=Math.min(buckets-1,ink[i]*5+(level>4?4:level-1));
        quantised=Math.round(Math.min(0.5*PITCH,0.45*PITCH*(0.25+0.75*level/6)*(radiusScale[i]||1))*32);
      }
      dotShade[i]=shade;dotRadius[i]=quantised;
      if(shade!==drawnShade[i]||quantised!==drawnRadius[i]||back[i]!==drawnBack[i])changed=true;
    }
    if(!changed)return;
    forceDraw=false;drawnShade.set(dotShade);drawnRadius.set(dotRadius);drawnBack.set(back);
    var inks=engine.inks,b,k;
    bucketCounts.fill(0);
    for(i=0;i<count;i++)if(dotShade[i]>=0)bucketCounts[dotShade[i]]++;
    shadeStart[0]=0;for(b=0;b<buckets;b++)shadeStart[b+1]=shadeStart[b]+bucketCounts[b];
    for(b=0;b<buckets;b++)bucketCounts[b]=shadeStart[b];
    for(i=0;i<count;i++)if(dotShade[i]>=0)dotOrder[bucketCounts[dotShade[i]]++]=i;
    ctx.clearRect(0,0,W,H);
    var full=0.5*PITCH;
    for(b=1;b<=buckets;b++){
      var started=false;
      for(i=0;i<count;i++){
        if(back[i]!==b)continue;
        if(!started){ctx.fillStyle=inks[(b-1)/5|0][(b-1)%5];ctx.beginPath();started=true}
        ctx.moveTo(engine.dotX[i]+full,engine.dotY[i]);ctx.arc(engine.dotX[i],engine.dotY[i],full,0,6.2832);
      }
      if(started)ctx.fill();
    }
    // Optional bloom (the theme's): soft halos in each ramp's brightest ink under the lit dots, one union per ink and pass.
    var bloom=engine.bloom;
    if(bloom){
      ctx.save();
      for(var pass=0;pass<bloom.length;pass++){
        var reach=bloom[pass][0]*PITCH,from=bloom[pass][2]||0;ctx.globalAlpha=bloom[pass][1];
        for(var inkIndex=0;inkIndex*5<buckets;inkIndex++){
          var any=false;
          for(b=inkIndex*5+from;b<Math.min(buckets,inkIndex*5+5);b++){
            if(shadeStart[b+1]===shadeStart[b])continue;
            if(!any){ctx.fillStyle=inks[inkIndex][4];ctx.beginPath();any=true}
            for(k=shadeStart[b];k<shadeStart[b+1];k++){var lit=dotOrder[k];ctx.moveTo(engine.dotX[lit]+reach,engine.dotY[lit]);ctx.arc(engine.dotX[lit],engine.dotY[lit],reach,0,6.2832)}
          }
          if(any)ctx.fill();
        }
      }
      ctx.restore();
    }
    for(b=0;b<buckets;b++){
      if(shadeStart[b+1]===shadeStart[b])continue;
      ctx.fillStyle=inks[b/5|0][b%5];ctx.beginPath();
      for(k=shadeStart[b];k<shadeStart[b+1];k++){
        var dot=dotOrder[k],radius=dotRadius[dot]/32;
        ctx.moveTo(engine.dotX[dot]+radius,engine.dotY[dot]);ctx.arc(engine.dotX[dot],engine.dotY[dot],radius,0,6.2832);
      }
      ctx.fill();
    }
    // Optional second ink: the same dots again, smaller and off register, composited on this small canvas only.
    var over=engine.overprint;
    if(over){
      ctx.save();ctx.globalCompositeOperation=over.blend||"source-over";ctx.globalAlpha=over.alpha==null?0.85:over.alpha;ctx.fillStyle=over.color;ctx.beginPath();
      for(i=0;i<count;i++){
        if(dotShade[i]<0||dotShade[i]%5<1)continue;
        var r2=dotRadius[i]/32*(over.scale||1),ox=engine.dotX[i]+over.dx,oy=engine.dotY[i]+over.dy;
        ctx.moveTo(ox+r2,oy);ctx.arc(ox,oy,r2,0,6.2832);
      }
      ctx.fill();ctx.restore();
    }
  }
  // Optional glitch: now and then a few horizontal slices of the finished frame slip sideways for a few frames.
  var glitch={next:0,until:0,bands:[],was:false},glitchBuffer=null;
  function glitchActive(real){
    var config=QA_THEME.current().glitch;
    if(!config||!real||reduced.matches)return false;
    function between(range){return range[0]+Math.random()*(range[1]-range[0])}
    if(real>=glitch.next&&real>=glitch.until){
      if(glitch.next){
        glitch.until=real+Math.round(between(config.frames))/FPS;glitch.bands=[];
        for(var b=Math.round(between(config.bands));b>0;b--)glitch.bands.push({y:Math.floor(Math.random()*(H-24)),h:4+Math.floor(Math.random()*18),dx:Math.round(between(config.shift))*(Math.random()<0.5?-1:1)});
      }
      glitch.next=real+between(config.every);
    }
    return real<glitch.until;
  }
  function drawGlitch(){
    var ratio=canvas.width/W;
    if(!glitchBuffer){glitchBuffer=document.createElement("canvas")}
    if(glitchBuffer.width!==canvas.width||glitchBuffer.height!==Math.ceil(24*ratio)){glitchBuffer.width=canvas.width;glitchBuffer.height=Math.ceil(24*ratio)}
    var g=glitchBuffer.getContext("2d");
    glitch.bands.forEach(function(band){
      var sy=Math.round(band.y*ratio),sh=Math.round(band.h*ratio);
      g.clearRect(0,0,glitchBuffer.width,glitchBuffer.height);g.drawImage(canvas,0,sy,canvas.width,sh,0,0,canvas.width,sh);
      ctx.clearRect(0,band.y,W,band.h);ctx.drawImage(glitchBuffer,0,0,canvas.width,sh,band.dx,band.y,W,band.h);
    });
  }
  engine.clear=function(){engine.intensity.fill(0);engine.radiusScale.fill(1);engine.ink.fill(0);engine.back.fill(0)};

  /* ---------- blood: drops, falls, pool (deterministic in time) ---------- */
  var GRAVITY=320,STRETCH=3/FPS,HORIZON=1800;
  function lidColumns(){
    var info={upperTop:new Int16Array(cols).fill(-1),upperBottom:new Int16Array(cols).fill(-1),lowerTop:new Int16Array(cols).fill(-1),lowerBottom:new Int16Array(cols).fill(-1)};
    var irisRow=engine.anatomy?engine.rowOf(engine.anatomy.iris[1]):rows/2;
    for(var col=0;col<cols;col++){
      for(var row=0;row<rows;row++){
        var i=row*cols+col,lit=engine.alpha[i]>0.3&&!engine.inIris[i];
        if(row<irisRow){
          if(lit&&info.upperTop[col]<0)info.upperTop[col]=row;
          if(lit&&info.upperTop[col]>=0&&(info.upperBottom[col]<0||info.upperBottom[col]===row-1))info.upperBottom[col]=row;
        }else{
          if(lit&&info.lowerTop[col]<0)info.lowerTop[col]=row;
          if(lit&&info.lowerTop[col]>=0&&(info.lowerBottom[col]<0||info.lowerBottom[col]===row-1))info.lowerBottom[col]=row;
        }
      }
    }
    return info;
  }
  function makeBlood(config,seed){
    var random=mulberry(seed),emitters=[],tips=engine.anatomy?engine.anatomy.tips:[],lids=lidColumns(),candidates=[];
    for(var col=0;col<cols;col++)if(lids.lowerTop[col]>=0&&lids.lowerBottom[col]-lids.lowerTop[col]<=3)candidates.push(col);
    function schedule(fixed,phase){
      var starts=[],cycles=[],t=phase;
      while(t<HORIZON){
        var col=fixed?fixed.col:candidates[Math.floor(random()*candidates.length)];
        var topRow=fixed?fixed.topRow:lids.lowerBottom[col]+1,tipRow=fixed?fixed.tipRow:topRow+2+Math.floor(random()*3);
        var trickle=!fixed||random()<config.trickle?(tipRow-topRow+1)*2/FPS:0;
        var swell=config.swell[0]+random()*(config.swell[1]-config.swell[0]);
        var fall=Math.sqrt(2*Math.max(1,engine.poolRow-tipRow-2)*PITCH/GRAVITY);
        var land=t+trickle+swell+STRETCH+fall;
        starts.push(t);cycles.push({col:col,topRow:topRow,tipRow:tipRow,trickle:trickle,swell:swell,land:land});
        t=land+config.rest[0]+random()*(config.rest[1]-config.rest[0]);
      }
      return{starts:new Float64Array(starts),cycles:cycles};
    }
    tips.forEach(function(tip,k){
      emitters.push(schedule({col:engine.colOf(tip[0]),tipRow:engine.rowOf(tip[1]),topRow:engine.rowOf(tip[2])},0.3+k*1.7+random()));
    });
    if(candidates.length)for(var r=0;r<config.runs;r++)emitters.push(schedule(null,2+r*3.1+random()*2));
    var span=[cols,0];
    for(col=0;col<cols;col++)if(lids.lowerTop[col]>=0){span[0]=Math.min(span[0],col);span[1]=Math.max(span[1],col)}
    return{config:config,emitters:emitters,pool:new Float32Array(cols),span:span,lids:lids};
  }
  function drawCycle(cycle,age){
    var col=cycle.col,tip=cycle.tipRow,step=Math.floor(age*FPS);
    if(age<cycle.trickle){
      var head=cycle.topRow+Math.floor(step/2);
      for(var row=cycle.topRow;row<head;row++)engine.put(col,row,0.42);
      engine.put(col,head,0.95);return;
    }
    age-=cycle.trickle;
    if(age<cycle.swell){
      var progress=age/cycle.swell;
      if(progress<0.35)engine.put(col,tip+1,0.62);
      else if(progress<0.75)engine.drop(col,tip+1,1,0.74);
      else engine.drop(col,tip+1,2,0.9);
      return;
    }
    age-=cycle.swell;
    if(age<STRETCH){
      var frame=Math.min(2,Math.floor(age*FPS)),top=tip+1+frame;
      if(frame<2)engine.drop(col,top,3,0.92);else engine.stamp(col,top+2,0,1,0.92);
      for(row=tip+1;row<top;row++)engine.put(col,row,0.58);
      return;
    }
    age-=STRETCH;
    var fallRow=tip+2+Math.round(0.5*GRAVITY*age*age/PITCH);
    if(fallRow<engine.poolRow-1){
      engine.stamp(col,fallRow,0,1,0.9);
      if(step%2===0&&age>0.15)engine.put(col,fallRow-2,0.5);
      if(age<2/FPS)engine.put(col,tip+1,0.55);
    }
  }
  function chance(a,b){return((Math.imul(a*73856093^b*19349663,2654435761)>>>0)%10007)/10007}
  // Impact squash, a crown of droplets, a double ripple, a brief bulge and the odd spatter onto the lower lid.
  function splash(blood,cycle,age,seed){
    var config=blood.config.splash,col=cycle.col,pool=engine.poolRow;
    if(age>2.6)return;
    if(age<1/FPS){engine.stamp(col,pool-1,config.width,0,0.98);return}
    if(age<0.4){var rise=0.85*(1-age/0.4);engine.put(col,pool-1,rise);engine.put(col-1,pool-1,rise*0.7);engine.put(col+1,pool-1,rise*0.7)}
    if(age<0.7){
      var reach=1+Math.floor(age*FPS/2),strength=0.8*(1-age/0.7);
      engine.put(col-reach,pool,strength+0.25);engine.put(col+reach,pool,strength+0.25);
      if(reach>3){engine.put(col-reach+3,pool,strength);engine.put(col+reach-3,pool,strength)}
    }
    var droplets=config.droplets[0]+Math.floor(chance(seed,1)*(config.droplets[1]-config.droplets[0]+1));
    for(var k=0;k<droplets;k++){
      var flight=0.5+0.3*chance(seed,10+k),side=(k%2?1:-1)*(config.side[0]+Math.floor(chance(seed,20+k)*(config.side[1]-config.side[0]+1)));
      var height=config.height[0]+Math.floor(chance(seed,30+k)*(config.height[1]-config.height[0]+1)),p=age/flight;
      var spatter=k===0&&chance(seed,40)<config.spatter&&blood.lids;
      if(spatter){
        var target=Math.max(blood.span[0],Math.min(blood.span[1],col+side)),lidRow=blood.lids.lowerBottom[target];
        if(lidRow<0)continue;
        var hop=0.55;
        if(age<hop){var q=age/hop;engine.put(Math.round(col+(target-col)*q),Math.round(pool-1-(pool-1-lidRow)*Math.sin(q*Math.PI/2)-2*q*(1-q)),0.85)}
        else if(age<2.6){var run=Math.floor((age-hop)*FPS/3);engine.put(target,lidRow+1+run,0.8*(1-(age-hop)/2.05)+0.15)}
        continue;
      }
      if(p>=1)continue;
      engine.put(Math.round(col+side*p),Math.round(pool-1-4*height*p*(1-p)),0.85*(1-0.4*p));
    }
  }
  function bloodFrame(blood,t){
    var timeline=Math.floor(t*FPS)/FPS%HORIZON,config=blood.config,pool=blood.pool;
    pool.fill(0);
    for(var c=blood.span[0];c<=blood.span[1];c++)pool[c]=0.14;
    blood.emitters.forEach(function(emitter,index){
      var j=findAt(emitter.starts,timeline);
      if(j<0)return;
      drawCycle(emitter.cycles[j],timeline-emitter.starts[j]);
      for(var m=j;m>=Math.max(0,j-10);m--){
        var cycle=emitter.cycles[m],age=timeline-cycle.land;
        if(age<0)continue;
        if(age>config.evaporate*4)break;
        var amount=config.depth*Math.exp(-age/config.evaporate),spread=1.2+0.8*Math.sqrt(age);
        for(c=Math.max(0,cycle.col-8);c<=Math.min(cols-1,cycle.col+8);c++)pool[c]+=amount*Math.exp(-(c-cycle.col)*(c-cycle.col)/(2*spread*spread));
        splash(blood,cycle,age,m*7+index);
      }
    });
    for(c=0;c<cols;c++){
      var level=Math.tanh(pool[c]);
      engine.put(c,engine.poolRow,level);
      for(var depth=1;depth<config.poolRows;depth++)engine.put(c,engine.poolRow-depth,(level-0.55*depth)*1.6);
    }
  }

  /* ---------- modes ---------- */
  function schedules(seed,first,gap,extra){
    var random=mulberry(seed),starts=[],data=[],t=first;
    while(t<HORIZON){starts.push(t);data.push(extra(random));t+=gap[0]+random()*(gap[1]-gap[0])}
    return{starts:new Float64Array(starts),data:data};
  }
  var BLINK_FRAMES=[-1,-1,0.45,1,1,0.7,0.4,0.15];
  function blinkFraction(starts,data,t,forcedAt){
    var best=0,timeline=t%HORIZON;
    function sample(start,double,at){
      var frame=Math.floor((at-start)*FPS);
      if(frame>=0&&frame<BLINK_FRAMES.length)best=BLINK_FRAMES[frame];
      if(double){frame-=BLINK_FRAMES.length+2;if(frame>=0&&frame<BLINK_FRAMES.length)best=BLINK_FRAMES[frame]}
    }
    var j=findAt(starts,timeline);
    if(j>=0)sample(starts[j],data[j].double,timeline);
    if(forcedAt>-1e8)sample(forcedAt,false,t);
    return best;
  }
  // Full: blinks, saccades, a gaze that follows the cursor, light sweeping across the dots and the theme's drips.
  var full={
    id:"full",label:"Full",tracks:true,
    init:function(){
      this.lids=lidColumns();
      this.blood=makeBlood({swell:[2,5],rest:[1.5,4],trickle:0.3,evaporate:6,depth:0.75,poolRows:1,runs:0,
        splash:{width:2,droplets:[3,4],height:[2,4],side:[3,5],spatter:0.2}},11);
      this.blinks=schedules(23,6,[8,20],function(random){return{double:random()<0.3}});
      this.saccades=schedules(37,3,[9,15],function(random){return{cells:(random()<0.5?-1:1)*(2+Math.floor(random()*2)),hold:0.6+random()*0.4}});
      this.shift=new Int16Array(cols);this.bandTop=new Int16Array(cols);this.forcedBlink=-1e9;this.wasInside=false;this.gazeCol=0;this.gazeRow=0;this.gazePreviousCol=0;this.gazePreviousRow=0;this.gazeKey=-1;this.gazeScale=1;
    },
    // In Full animation the pupil follows the cursor anywhere in the window. The target is sampled once per 12fps step and the pupil
    // moves in whole cells, overshooting by one cell on a big jump. Returns [column, row, pupil scale]; without tracking, the saccade routine.
    pupilCells:function(t,real,previous){
      var tracking=engine.track,a=engine.anatomy;
      if(real&&tracking.active){
        var key=Math.floor(real*FPS);
        if(key!==this.gazeKey){
          this.gazePreviousCol=this.gazeCol;this.gazePreviousRow=this.gazeRow;this.gazeKey=key;
          var rect=canvas.getBoundingClientRect(),dx=pointer.x-(rect.left+engine.px(a.iris[0])),dy=pointer.y-(rect.top+engine.py(a.iris[1]));
          var distance=Math.hypot(dx,dy)||1,reach=Math.min(1,distance/140);
          var targetCol=Math.round(dx/distance*reach*3),targetRow=Math.round(dy/distance*reach*2);
          var jumpCol=targetCol-this.gazeCol,jumpRow=targetRow-this.gazeRow;
          this.gazeCol=Math.max(-3,Math.min(3,targetCol+(Math.abs(jumpCol)>=2?Math.sign(jumpCol):0)));
          this.gazeRow=Math.max(-2,Math.min(2,targetRow+(Math.abs(jumpRow)>=2?Math.sign(jumpRow):0)));
          this.gazeScale=1-0.25*(1-Math.min(1,distance/260));
        }
        return previous?[this.gazePreviousCol,this.gazePreviousRow,this.gazeScale]:[this.gazeCol,this.gazeRow,this.gazeScale];
      }
      this.gazeKey=-1;this.gazeCol=this.gazeRow=this.gazePreviousCol=this.gazePreviousRow=0;
      var j=findAt(this.saccades.starts,t%HORIZON);
      if(j<0)return[0,0,1];
      var saccade=this.saccades.data[j];
      return[t%HORIZON-this.saccades.starts[j]<saccade.hold?saccade.cells:0,0,1];
    },
    frame:function(t,real){
      var a=engine.anatomy,step=Math.floor(t*FPS)/FPS,soft=Math.floor(t*24)/24,phase=2*Math.PI*soft/14;
      if(real){
        if(engine.track.active&&!this.wasInside&&Math.random()<0.5)this.forcedBlink=real+0.35;
        this.wasInside=engine.track.active;
      }
      var lightX=-0.55+0.4*Math.sin(phase),lightY=-0.5+0.3*Math.cos(phase),lightZ=0.75,norm=Math.hypot(lightX,lightY,lightZ);
      lightX/=norm;lightY/=norm;lightZ/=norm;
      var sweep=150*Math.sin(phase);
      var now=this.pupilCells(step,real,false),before=this.pupilCells(step-1/FPS,real,true);
      var smear=Math.abs(now[0]-before[0])>=2;
      var blink=reduced.matches?0:blinkFraction(this.blinks.starts,this.blinks.data,step,real?this.forcedBlink-(real-t):-1e9);
      var lids=this.lids,shift=this.shift,bandTop=this.bandTop;
      for(var col=0;col<cols;col++){
        shift[col]=lids.upperTop[col]<0?0:blink<0?-1:lids.lowerTop[col]<0?0:Math.round(blink*Math.max(0,lids.lowerTop[col]-lids.upperBottom[col]-1));
        // A closing lid thins to two rows so the lid ends do not stand up at the corners.
        var thick=lids.upperBottom[col]-lids.upperTop[col]+1,keep=blink>0?Math.max(2,Math.round(thick-(thick-2)*blink)):thick;
        bandTop[col]=lids.upperBottom[col]+shift[col]-keep+1;
      }
      var irisX=engine.dotX[0]+engine.colOf(a.iris[0])*PITCH,irisY=engine.dotY[0]+engine.rowOf(a.iris[1])*PITCH;
      var pupilX=irisX+now[0]*PITCH,pupilY=irisY+now[1]*PITCH,lastX=irisX+before[0]*PITCH,lastY=irisY+before[1]*PITCH;
      var irisRadius=a.iris[2]*SCALE,pupilRadius=a.pupil*SCALE*now[2];
      engine.time=soft;
      for(var i=0;i<count;i++){
        col=i%cols;var row=(i/cols)|0,source=i,lidOnly=false,value=0,s=shift[col];
        engine.radiusScale[i]=1;
        if(blink!==0&&lids.upperTop[col]>=0&&row<=lids.upperBottom[col]+Math.max(0,s)){
          if(row<bandTop[col]){engine.intensity[i]=0;continue}
          source=(row-s)*cols+col;lidOnly=true;
        }
        if(lidOnly||!engine.inIris[i]){
          value=engine.inIris[source]?0:engine.shade(source,lightX,lightY,lightZ,Math.exp(-Math.pow((engine.dotX[source]-W/2+engine.dotY[source]-CENTER_Y)*0.707-sweep,2)/4050),1);
        }else{
          var dx=engine.dotX[i]-pupilX,dy=engine.dotY[i]-pupilY,toPupil=Math.hypot(dx,dy),toIris=Math.hypot(engine.dotX[i]-irisX,engine.dotY[i]-irisY);
          var hole=toPupil<pupilRadius;
          if(smear)hole=hole||Math.hypot(engine.dotX[i]-lastX,engine.dotY[i]-lastY)<pupilRadius||Math.hypot(engine.dotX[i]-(pupilX+lastX)/2,engine.dotY[i]-(pupilY+lastY)/2)<pupilRadius*0.8;
          if(hole)value=0;
          else if(toPupil<pupilRadius+PITCH*0.6)value=0.15;
          else{
            var ring=Math.min(1,Math.max(0,(toPupil-pupilRadius)/(irisRadius-pupilRadius))),slope=0.9*Math.cos(Math.PI*ring);
            var nx=-slope*dx/toPupil,ny=-slope*dy/toPupil,length=Math.hypot(nx,ny,1);
            var theta=Math.atan2(engine.dotY[i]-irisY,engine.dotX[i]-irisX),rim=irisRadius*(1+0.045*Math.sin(2*theta+1)+0.03*Math.sin(3*theta+0.4));
            var lambert=Math.max(0,(nx*lightX+ny*lightY+lightZ)/length),edge=Math.min(1,Math.max(0,(rim+0.5*PITCH-toIris)/PITCH));
            value=edge*(0.16+0.95*Math.pow(lambert,1.5)+0.34*Math.exp(-Math.pow((engine.dotX[i]-W/2+engine.dotY[i]-CENTER_Y)*0.707-sweep,2)/4050));
          }
        }
        engine.intensity[i]=value;
      }
      engine.living(t,blink===0);
      bloodFrame(this.blood,t);
    },
    still:0.6
  };
  // Subtle: the ambient motion only (drips, edge crawl); no blinks or gaze.
  var subtle={
    id:"subtle",label:"Subtle",
    init:function(){this.blood=makeBlood({swell:[0.8,2],rest:[0.2,0.8],trickle:0.45,evaporate:18,depth:0.55,poolRows:3,runs:2,
      splash:{width:3,droplets:[4,5],height:[3,5],side:[3,6],spatter:0.45}},53)},
    frame:function(t){
      engine.time=Math.floor(t*24)/24;
      var lightX=-0.5,lightY=-0.55,lightZ=0.67;
      for(var i=0;i<count;i++){engine.radiusScale[i]=1;engine.intensity[i]=engine.shade(i,lightX,lightY,lightZ,0.35,1)}
      engine.living(t,true);
      bloodFrame(this.blood,t);
    },
    still:4
  };
  // Static: Subtle's still frame, drawn once; idle, so no loop runs at all.
  var still={id:"static",label:"Static",init:subtle.init,frame:subtle.frame,still:subtle.still,idle:true};
  var blank={id:"",init:function(){},frame:function(){engine.clear()},still:0,idle:true};
  engine.schedules=schedules;engine.findAt=findAt;engine.horizon=HORIZON;
  var MODES={full:full,subtle:subtle,static:still},LEGACY_MODES={watcher:"full",coin:"full",bleeding:"subtle",off:"static"};

  /* ---------- engine lifecycle and controls ---------- */
  var mode=blank,ready=false,running=false,onScreen=true,modalOpen=false,frameTimer=0,lastKey=-1,start=clock(),modeSelect=document.getElementById("eye-mode"),themeSelect=document.getElementById("theme-pick");
  function availableModes(){
    var character=QA_THEME.character();
    return(character.modes||["static"]).map(function(entry){return typeof entry==="string"?MODES[LEGACY_MODES[entry]||entry]:entry})
      .filter(function(entry){return entry&&(!(entry===full||entry===subtle)||character.anatomy)});
  }
  function chooseMode(id){
    var modes=availableModes(),next=modes.filter(function(entry){return entry.id===id})[0]||modes[0]||still;
    if(mode.dispose)mode.dispose(engine);
    mode=next;engine.clear();
    if(ready)mode.init(engine);
    if(modeSelect)modeSelect.value=mode.id;
    if(mode.id)document.documentElement.setAttribute("data-logo-mode",mode.id);
    update(true);
  }
  function renderOnce(t,real){
    if(real)engine.gazeExpire(real);
    if(debug)window.__eyeFrames=(window.__eyeFrames||0)+1;
    var glitching=glitchActive(real);
    if(glitching||glitch.was)forceDraw=true;
    engine.clear();mode.frame(t,real,engine);present();
    if(glitching)drawGlitch();
    glitch.was=glitching;
  }
  // The art moves in 12fps steps and its light in 24fps steps, so one timer step per 24th of a second is the finest change there is.
  function tick(){
    frameTimer=0;
    if(!running)return;
    var elapsed=clock()-start,key=Math.floor(elapsed*LIGHT_FPS/1000);
    if(key!==lastKey){lastKey=key;renderOnce(elapsed/1000,elapsed/1000)}
    frameTimer=setTimeout(tick,Math.max(4,(key+1)*1000/LIGHT_FPS-(clock()-start)+1));
  }
  function stopLoop(){running=false;clearTimeout(frameTimer);frameTimer=0}
  // A modal settings dialog freezes the art behind it, since its backdrop blur would be recomputed on every frame.
  function update(force){
    if(!ready)return;
    var wanted=onScreen&&!document.hidden&&!reduced.matches&&!isFrozen&&!mode.idle,animate=wanted&&!modalOpen;
    if(animate&&!running){running=true;lastKey=-1;tick()}
    else if(!animate){stopLoop();if(!(wanted&&modalOpen)||force)renderOnce(isFrozen?frozen:mode.still,0)}
  }
  // Inks come from the theme: its palette is ink 0, and the character's named ramps (inks: ["warn", "bad"]) are 1..n.
  function readPalette(){
    var theme=QA_THEME.current(),palette=theme.palette,over=theme.halftoneOverprint,scheme=QA_THEME.isDark()?"dark":"light",named=theme.inks&&theme.inks[scheme]||{};
    engine.inks=[palette[scheme]].concat((QA_THEME.character().inks||[]).map(function(name){return named[name]||palette[scheme]}));
    engine.bloom=theme.bloom||null;engine.screen=!!theme.screen;
    engine.overprint=over?{dx:over.dx,dy:over.dy,scale:over.scale,alpha:over.alpha,color:over[scheme].color,blend:over[scheme].blend}:null;
    forceDraw=true;
  }
  function setupCanvas(){
    var ratio=window.devicePixelRatio||1;
    canvas.width=Math.round(W*ratio);canvas.height=Math.round(H*ratio);ctx.setTransform(ratio,0,0,ratio,0,0);forceDraw=true;
  }
  function loadTheme(){
    ready=false;stopLoop();layout(QA_THEME.character());readPalette();
    var settingsButton=document.getElementById("settings-open");
    if(settingsButton){settingsButton.innerHTML=QA_THEME.icon("settings");buttonFx(settingsButton.parentNode)}
    var image=new Image(),wanted=query.get("eye"),stored=null;
    try{stored=localStorage.getItem("qaDashboardEyeMode")}catch(e){}
    // Stored ids from before the three-option picker move to the nearest new option.
    if(stored&&LEGACY_MODES[stored]){stored=LEGACY_MODES[stored];try{localStorage.setItem("qaDashboardEyeMode",stored)}catch(e){}}
    wanted=LEGACY_MODES[wanted]||wanted||stored;
    var source=QA_THEME.character().logoSource,token=++loads;
    function begin(art){
      if(token!==loads)return;
      try{buildSource(art)}catch(e){return}
      ready=true;setupCanvas();
      if(modeSelect)modeSelect.innerHTML=availableModes().map(function(entry){return'<option value="'+entry.id+'" data-label="'+entry.label+'">'+entry.label+'</option>'}).join("");
      chooseMode(mode!==blank?mode.id:wanted||"full");
    }
    if(!source){begin(null);return}
    image.onload=function(){begin(image)};
    image.src="data:image/svg+xml,"+encodeURIComponent(source);
  }
  var loads=0;
  if(themeSelect){
    themeSelect.innerHTML=Object.keys(THEMES).map(function(id){return'<option value="'+id+'" data-label="'+THEMES[id].name+'">'+THEMES[id].name+'</option>'}).join("");
    themeSelect.value=QA_THEME.id();
    themeSelect.addEventListener("change",function(){QA_THEME.choose(themeSelect.value)});
  }
  // Character: "Default" follows the theme's own character; any other pick is stored and wins across themes.
  var characterSelect=document.getElementById("character-pick");
  function characterOptions(){
    if(!characterSelect)return;
    var fallback=CHARACTERS[QA_THEME.current().character]||CHARACTERS.eye,label="Default ("+fallback.name+")";
    characterSelect.innerHTML='<option value="" data-label="'+esc(label)+'">'+esc(label)+'</option>'+Object.keys(CHARACTERS).map(function(id){return'<option value="'+id+'" data-label="'+esc(CHARACTERS[id].name)+'">'+esc(CHARACTERS[id].name)+'</option>'}).join("");
    characterSelect.value=QA_THEME.characterPick();
  }
  characterOptions();
  if(characterSelect)characterSelect.addEventListener("change",function(){QA_THEME.chooseCharacter(characterSelect.value)});
  document.addEventListener("qa-character",function(){mode=blank;loadTheme()});
  if(modeSelect)modeSelect.addEventListener("change",function(){
    try{localStorage.setItem("qaDashboardEyeMode",modeSelect.value)}catch(e){}
    chooseMode(modeSelect.value);
  });
  document.addEventListener("qa-theme",function(){mode=blank;characterOptions();loadTheme();if(typeof render==="function")render();buttonFx(document);QA_BRUSH.wordmark();QA_BRUSH.decorate(document)});
  // The backend rollup reaches renderers as engine.status; a still frame is redrawn when it changes.
  document.addEventListener("qa-status",function(e){engine.status=e.detail||"unknown";if(!running)update(true)});
  QA_BRUSH.wordmark();QA_BRUSH.decorate(document);
  var titleMark=document.querySelector(".mark");
  if(titleMark)titleMark.addEventListener("click",QA_BRUSH.wordmark);
  // Tracking (Full's gaze) follows the cursor anywhere in the window and always ends: when it leaves the window, on blur,
  // when the tab is hidden, or after 4s without movement. Nothing else in the animation waits on it.
  var TRACK_IDLE=4,debug=/^(1|true)$/.test(query.get("debug")||query.get("perf")||"");
  function gazeLog(what,detail){if(debug)console.log("gaze "+what+" "+JSON.stringify(detail||{})+" t="+((clock()-start)/1000).toFixed(2)+" frames="+(window.__eyeFrames||0))}
  function gazeRelease(reason){
    if(!engine.track.active)return;
    engine.track.active=false;lastKey=-1;gazeLog("track release",{reason:reason});
  }
  engine.gazeExpire=function(real){if(engine.track.active&&real-engine.track.lastMoveAt>TRACK_IDLE)gazeRelease("idle")};
  // Pointer moves only store coordinates (see track() above) and flags; the canvas tick does the work at its own 24fps.
  document.addEventListener("pointermove",function(e){
    if(e.pointerType==="touch")return;
    engine.track.lastMoveAt=(clock()-start)/1000;
    if(!engine.track.active&&mode.tracks){engine.track.active=true;lastKey=-1;gazeLog("track engage")}
  },{passive:true});
  document.addEventListener("pointerout",function(e){if(!e.relatedTarget)gazeRelease("window-out")});
  document.documentElement.addEventListener("pointerleave",function(){gazeRelease("document-leave")});
  document.addEventListener("pointercancel",function(){gazeRelease("cancel")});
  window.addEventListener("blur",function(){gazeRelease("window-blur")});
  document.addEventListener("visibilitychange",function(){if(document.hidden)gazeRelease("hidden")});
  if(window.IntersectionObserver)new IntersectionObserver(function(entries){onScreen=entries[entries.length-1].isIntersecting;update()}).observe(canvas);
  document.addEventListener("qa-modal",function(e){modalOpen=!!e.detail;update()});
  document.addEventListener("visibilitychange",function(){update()});
  if(reduced.addEventListener)reduced.addEventListener("change",function(){update()});
  function schemeChanged(){readPalette();if(!running)update(true)}
  if(scheme.addEventListener)scheme.addEventListener("change",schemeChanged);
  document.addEventListener("qa-scheme",schemeChanged);
  var schemeRadios=document.querySelectorAll('input[name="scheme"]');
  Array.prototype.forEach.call(schemeRadios,function(radio){
    radio.checked=radio.value===QA_THEME.schemePreference();
    radio.addEventListener("change",function(){if(radio.checked)QA_THEME.chooseScheme(radio.value)});
  });
  loadTheme();
})();
</script></body></html>
"""


def render_html(status=None):
    """Page HTML; a status embeds a static snapshot and disables polling."""
    blob = json.dumps(status).replace("<", "\\u003c") if status is not None else "null"
    return HTML.replace("/*INITIAL*/null/*END*/", blob)


def load_status_file(path):
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


def run_wt_status():
    result = subprocess.run(
        [WT, "status", "--json"], capture_output=True, text=True,
        timeout=TIMEOUT_SECONDS, cwd=HOME,
    )
    if result.returncode != 0:
        raise RuntimeError(f"wt status exited {result.returncode}: {result.stderr.strip()[:300]}")
    return json.loads(result.stdout)


class StatusSource:
    def __init__(self, status_file=None):
        self.status_file = status_file
        self.lock = threading.Lock()
        self.cached = None
        self.cached_at = 0.0

    def get(self):
        with self.lock:
            if self.cached is not None and time.monotonic() - self.cached_at < CACHE_SECONDS:
                return self.cached
            self.cached = load_status_file(self.status_file) if self.status_file else run_wt_status()
            self.cached_at = time.monotonic()
            return self.cached

    def invalidate(self):
        """Drops the cached status, so the next request sees the result of an action that just finished."""
        with self.lock:
            self.cached = None


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


class ActionRunner:
    """Runs one `wt backend <action>` at a time and remembers the latest run."""

    def __init__(self, wt=WT, timeout=ACTION_TIMEOUT_SECONDS, on_finish=None):
        self.wt = wt
        self.timeout = timeout
        self.on_finish = on_finish
        self.lock = threading.Lock()
        self.last = None

    def snapshot(self):
        with self.lock:
            if not self.last:
                return None
            return {key: value for key, value in dict(self.last, output=list(self.last["output"])).items() if key != "arguments"}

    def start(self, action, arguments=None, target=None):
        with self.lock:
            if self.last and self.last["state"] == "running":
                return False
            self.last = {"action": action, "target": target, "arguments": arguments or ["backend", action],
                         "state": "running", "startedAt": now_iso(), "endedAt": None,
                         "exitCode": None, "output": collections.deque(maxlen=ACTION_TAIL_LINES)}
            run = self.last
        threading.Thread(target=self._run, args=(run,), daemon=True).start()
        return True

    def _append(self, run, line):
        with self.lock:
            run["output"].append(line)

    def _finish(self, run, state, exit_code):
        with self.lock:
            run.update(state=state, exitCode=exit_code, endedAt=now_iso())
        if self.on_finish:
            self.on_finish()

    def _run(self, run):
        try:
            process = subprocess.Popen(
                [self.wt] + run["arguments"], cwd=HOME, stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace",
                start_new_session=True,
            )
        except OSError as error:
            self._append(run, f"could not start wt: {error}")
            self._finish(run, "failed", None)
            return
        timed_out = threading.Event()

        def kill_group():
            # wt starts child processes that inherit stdout; kill the whole group so the read loop ends.
            timed_out.set()
            try:
                os.killpg(process.pid, 9)
            except OSError:
                pass

        timer = threading.Timer(self.timeout, kill_group)
        timer.start()
        try:
            for line in process.stdout:
                self._append(run, line.rstrip("\n"))
            exit_code = process.wait()
        finally:
            timer.cancel()
        if timed_out.is_set():
            self._append(run, f"timed out after {self.timeout} seconds")
        self._finish(run, "ok" if exit_code == 0 and not timed_out.is_set() else "failed", exit_code)


def allowed_origins(port):
    return {f"http://localhost:{port}", f"http://127.0.0.1:{port}"}


def same_origin(headers, port):
    origin = headers.get("Origin")
    return headers.get("X-QA-Dashboard") == "1" and (origin is None or origin in allowed_origins(port))


def handle_action(runner, action, headers, port):
    """Starts a backend action for a same-origin page request; returns (status code, JSON body)."""
    if not same_origin(headers, port):
        return 403, {"error": "forbidden"}
    if action not in BACKEND_ACTIONS:
        return 404, {"error": "not found"}
    if not runner.start(action):
        return 409, {"error": "another backend action is still running", "actions": runner.snapshot()}
    return 202, {"actions": runner.snapshot()}


def handle_slot_stop(runner, body, headers, port, known_branches):
    """Stops one task slot's frontends; the branch must be a slot in the current status."""
    if not same_origin(headers, port):
        return 403, {"error": "forbidden"}
    branch = body.get("branch") if isinstance(body, dict) else None
    if not isinstance(branch, str) or branch not in known_branches:
        return 400, {"error": "unknown branch"}
    if not runner.start("stop", ["serve", "--stop", branch], target=branch):
        return 409, {"error": "another action is still running", "actions": runner.snapshot()}
    return 202, {"actions": runner.snapshot()}


def slot_branches(source):
    try:
        return {slot.get("branch") for slot in source.get().get("slots") or [] if slot.get("branch")}
    except Exception:  # an unreadable status means no branch can be confirmed
        return set()


def make_handler(source, runner, port):
    class Handler(BaseHTTPRequestHandler):
        def send(self, code, body, content_type):
            payload = body.encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)

        def do_GET(self):
            path = self.path.split("?", 1)[0]
            if path == "/":
                self.send(200, render_html(), "text/html; charset=utf-8")
            elif path == "/api/status":
                try:
                    self.send(200, json.dumps(dict(source.get(), actions=runner.snapshot())), "application/json")
                except Exception as error:  # report any failure as a 502 to the page
                    self.send(502, json.dumps({"error": str(error) or type(error).__name__}), "application/json")
            elif path == "/api/actions":
                self.send(200, json.dumps({"actions": runner.snapshot()}), "application/json")
            else:
                self.send(404, json.dumps({"error": "not found"}), "application/json")

        def do_POST(self):
            raw = self.rfile.read(min(int(self.headers.get("Content-Length") or 0), 65536))
            path = self.path.split("?", 1)[0]
            if path == "/api/slot/stop":
                try:
                    body = json.loads(raw or b"{}")
                except ValueError:
                    body = None
                code, body = handle_slot_stop(runner, body, self.headers, port, slot_branches(source))
            elif path.startswith("/api/backend/"):
                code, body = handle_action(runner, path.rsplit("/", 1)[1], self.headers, port)
            else:
                code, body = 404, {"error": "not found"}
            self.send(code, json.dumps(body), "application/json")

        def log_message(self, format, *args):
            sys.stderr.write("qa-dashboard: " + format % args + "\n")

    return Handler


def main():
    parser = argparse.ArgumentParser(description="Overseer: local QA status dashboard")
    parser.add_argument("--render-once", action="store_true", help="print the HTML for the current status and exit")
    parser.add_argument("--status-file", help="read status JSON from this file instead of running wt")
    args = parser.parse_args()
    source = StatusSource(args.status_file)
    if args.render_once:
        try:
            sys.stdout.write(render_html(source.get()))
        except Exception as error:
            sys.stderr.write(f"qa-dashboard: {error}\n")
            return 1
        return 0
    port = int(os.environ.get("QA_DASHBOARD_PORT", "5100"))
    server = ThreadingHTTPServer(("127.0.0.1", port), make_handler(source, ActionRunner(on_finish=source.invalidate), port))
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
