<script>
"use strict";
var INITIAL=/*INITIAL*/null/*END*/;
// Keep one canvas and one eye engine. Every scene gives it an independent place in the left column. Desk has no header:
// the wordmark, freshness and Settings move into the eye card (the masthead) and go back to the header in other scenes.
(function placeEye(){
  var coin=document.querySelector(".coin"),left=document.querySelector(".book-left"),backend=document.getElementById("backend"),label=coin.querySelector(".portrait-label");
  var masthead=coin.querySelector(".masthead"),mastTitle=masthead.querySelector(".masthead-title"),header=document.querySelector("header"),title=header.querySelector("h1"),mark=title.querySelector(".mark"),tools=header.querySelector(".header-tools");
  function sync(){
    label.textContent=QA_THEME.copy("characterName","Overseer");
    var scene=document.documentElement.getAttribute("data-scene"),book=scene==="book",desk=scene==="desk",moved=false;
    if(desk&&mark.parentNode!==mastTitle){mastTitle.appendChild(mark);masthead.appendChild(tools);moved=true}
    else if(!desk&&mark.parentNode===mastTitle){title.appendChild(mark);header.appendChild(tools);moved=true}
    var placed=coin.parentNode===left&&(book?coin.previousElementSibling===backend:coin.nextElementSibling===backend);
    if(!placed){if(book)left.appendChild(coin);else left.insertBefore(coin,backend);moved=true}
    if(!moved)return;
    document.dispatchEvent(new Event("qa-layout"));
    if(window.QA_BRUSH)QA_BRUSH.header();
  }
  sync();document.addEventListener("qa-bg",sync);document.addEventListener("qa-theme",sync);
})();
var APP_NAMES={ri:"RI","ds-demo":"ds-demo",strategy:"Strategy"};
var tenantInput=document.getElementById("tenant");
try{tenantInput.value=localStorage.getItem("qaDashboardTenant")||"mridderikhoff"}catch(e){}
var data=null,lastOk=null,failure=null,actionError=null,outputOpen=false,pollTimer=null;
// The user's expand/collapse choice for the backend details applies only while the health it was made under still holds.
var detailsChoice=null;
try{detailsChoice=JSON.parse(sessionStorage.getItem("qaDashboardBackendDetails"))}catch(e){}
function esc(s){return String(s==null?"":s).replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
function tone(state,attn){
  if(attn)return"attn";
  var s=String(state||"").toLowerCase();
  if(/^ready|^active|healthy/.test(s))return"ok";
  if(/attention/.test(s))return"attn";
  if(/fail|down|error|unhealthy|not ready/.test(s))return"bad";
  if(/listening|degraded|starting|activating/.test(s))return"warn";
  return"";
}
// Rank decides the worst state shown on the overall badge and in the favicon.
var TONE_RANK={ok:0,unknown:1,warn:2,down:3,broken:4,attn:5};
function serviceTone(s){
  if(!s)return"unknown";
  if(s.needsAttention||/attention/i.test(s.status||""))return"attn";
  if(s.probe==="ready"||/^ready/.test(s.status||""))return"ok";
  if(/listening/.test(s.status||"")||s.unitState==="activating"||s.unitState==="reloading")return"warn";
  if(s.unitState==="active")return"broken";
  if(s.unitState==="failed"||s.unitState==="inactive"||/down|fail/.test(s.status||s.probe||""))return"down";
  return"unknown";
}
function worstTone(tones){return tones.reduce(function(worst,t){return(TONE_RANK[t]||0)>(TONE_RANK[worst]||0)?t:worst},"ok")}
function backendTone(b){
  var services=b.services||{},names=Object.keys(services);
  if(!names.length)return tone(b.overall)==="ok"?"ok":tone(b.overall)==="warn"?"warn":"down";
  return worstTone(names.map(function(n){return serviceTone(services[n])}));
}
function dot(t){return'<span class="dot '+(t||"unknown")+'">'+QA_THEME.glyph(t||"unknown")+'</span>'}
function agoSpan(iso){return'<span data-since="'+esc(iso)+'"></span>'}
function agoText(iso){
  if(!iso)return"";var s=Math.max(0,Math.round((Date.now()-new Date(iso).getTime())/1000));
  return s<60?s+"s":s<3600?Math.floor(s/60)+"m":s<86400?Math.floor(s/3600)+"h":Math.floor(s/86400)+"d";
}
function clock(iso){return iso?new Date(iso).toLocaleTimeString():""}
function currentAction(){return data&&data.actions}
function isRunning(){var a=currentAction();return!!(a&&a.state==="running")}
var ACTION_LABELS={heal:["Heal","Healing&hellip;"],update:["Update to develop","Updating&hellip;"],ensure:["Start backend","Starting&hellip;"]};
var ACTION_VERBS={heal:"Heal",update:"Update",ensure:"Backend start",stop:"Stop"};
function actionButton(name,idle,extra){
  var a=currentAction(),busy=isRunning()&&a.action===name,labels=ACTION_LABELS[name];
  var label=busy?labels[1]:(idle||labels[0]);
  return'<button type="button" class="act'+(extra?" "+extra:"")+'" data-action="'+name+'"'+(isRunning()?" disabled":"")+'>'+label+'</button>';
}
function renderActionResult(){
  var a=currentAction();
  if(!a&&!actionError)return"";
  var h='<div class="action-result" aria-live="polite">';
  if(a){
    var verb=(ACTION_VERBS[a.action]||a.action)+(a.target?" "+a.target:""),text,t;
    if(a.state==="running"){text=verb+" running since "+clock(a.startedAt);t="warn"}
    else if(a.state==="ok"){text=verb+" finished at "+clock(a.endedAt);t="ok"}
    else{text=verb+" failed"+(a.exitCode!=null?" (exit "+a.exitCode+")":"")+" at "+clock(a.endedAt);t="down"}
    h+='<span>'+dot(t)+esc(text)+'</span>';
    if(a.output&&a.output.length)h+='<details id="action-output"'+(outputOpen?" open":"")+'><summary>show output</summary><pre>'+esc(a.output.join("\n"))+'</pre></details>';
  }
  if(actionError)h+='<span class="error">'+esc(actionError)+'</span>';
  return h+'</div>';
}
function backendHealthy(b){
  var svcs=b.services||{};
  return tone(b.overall)==="ok"&&Object.keys(svcs).every(function(n){var t=serviceTone(svcs[n]);return t==="ok"||t==="warn"});
}
function detailsOpen(healthy){return detailsChoice&&detailsChoice.healthy===healthy?!!detailsChoice.open:!healthy}
// Collapsed, the card shows only the overall rollup; service names and glyphs live in the details.
function renderBackend(b){
  if(!b)return'<div class="muted">No backend data.</div>';
  var behind=/behind|attached|not develop/i.test(b.relation||""),healthy=backendHealthy(b),open=detailsOpen(healthy),rollup=backendTone(b);
  var actions=(tone(b.overall)==="bad"?actionButton("ensure"):"")+(tone(b.overall)!=="ok"?actionButton("heal"):"");
  var h=(healthy?"":'<span class="card-drip" aria-hidden="true"></span>')+'<div class="backend-body"><div class="head"><div class="rollup tone-'+rollup+'"><span class="title">Backend</span>'+
    '<span class="state">'+dot(rollup)+esc(String(b.overall||"unknown").replace(/-/g," "))+'</span></div>'+
    '<div class="rel">'+(behind?actionButton("update",esc(b.relation.charAt(0).toUpperCase()+b.relation.slice(1))+" &middot; update","quiet behind"):'<span class="pill rel">'+esc(b.relation||"?")+'</span>')+'</div>'+
    (actions?'<div class="acts">'+actions+'</div>':"")+
    '<div class="meta"><span>sha <code>'+esc(b.sha||"?")+'</code></span>'+
    '<button type="button" class="link toggle" data-toggle="services" aria-expanded="'+open+'" aria-controls="backend-details">'+(open?"hide":"show")+' details</button></div></div>'+renderActionResult();
  if(open){
    var svcs=b.services||{};
    h+='<div id="backend-details" class="backend-details">'+(b.dirty?'<span class="pill" style="color:var(--warn)">dirty: '+esc(b.dirty)+'</span>':"");
    Object.keys(svcs).forEach(function(n){
      var s=svcs[n],t=serviceTone(s),attn=!!s.needsAttention||/attention/i.test(s.status||"");
      h+='<div class="svc tone-'+(t||"unknown")+(attn?" attn":"")+'">'+dot(t)+
        '<span class="name">'+esc(n)+'</span><span>'+esc(s.status||s.probe||s.unitState)+'</span>'+
        (s.restartCount?'<span class="muted small">restarts '+esc(s.restartCount)+'</span>':"")+'</div>';
    });
    h+='</div>';
  }
  return h+'</div>';
}
function appUrl(a){
  var url=a.url||"";
  if(url.indexOf("<tenant>")>=0){
    var t=tenantInput.value.trim();
    url=t?url.split("<tenant>").join(encodeURIComponent(t)):url.split("<tenant>")[0];
  }
  return url;
}
// Down or not ready beats a failed build, which beats rebuilding, which beats ok.
function appStatus(a){
  var build=a.build&&a.build.state;
  if(!a.httpReady)return a.unitState==="active"?{tone:"warn",label:"starting"}:{tone:"down",label:a.unitState||"down"};
  if(build==="failed"){var errors=a.build.errorCount;return{tone:"broken",label:"build failed"+(errors?" \u00b7 "+errors+" error"+(errors===1?"":"s"):""),failed:true}}
  if(build==="building")return{tone:"warn",label:"rebuilding"};
  return{tone:"ok",label:""};
}
function hashText(text){var h=2166136261;for(var i=0;i<text.length;i++){h^=text.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0}
// The fill's leading edge is ragged and wet; seeded per pill so each one seeps differently.
function seepFill(seed){
  // A low wet band: ragged along its top surface and at its leading edge, so the pill text stays clear.
  var points=[],value=seed;
  function next(){value=Math.imul(value^value>>>13,1274126177)>>>0;return(value%1000)/1000}
  for(var x=0;x<=100;x+=10)points.push(x+" "+(6+next()*14).toFixed(1));
  for(var y=12;y<=40;y+=7)points.push((100+next()*14).toFixed(1)+" "+y);
  points.push("0 40");
  return'<svg class="seep-fill" viewBox="0 0 114 40" preserveAspectRatio="none" aria-hidden="true"><path style="fill:var(--seep)" d="M'+points.join("L")+'Z"/></svg>';
}
function buildFailed(a){return!!(a.httpReady&&a.build&&a.build.state==="failed")}
function appPill(a){
  var name=APP_NAMES[a.app]||a.app||"app",url=appUrl(a),ready=!!a.httpReady&&!!url,status=appStatus(a);
  var state=status.label||(a.httpReady&&!url?"no link":"");
  var inner=dot(status.tone)+'<span class="app-name">'+esc(name)+'</span>'+
    (status.failed?'<span class="build-failed">'+esc(state)+'</span>':
    (state||a.startedAt?'<span class="port">'+[state&&esc(state),a.httpReady&&a.startedAt&&"up "+agoSpan(a.startedAt)].filter(Boolean).join(" &middot; ")+'</span>':""));
  var since=a.startedAt?" (dev server started "+clock(a.startedAt)+"; if your tab is older, hard-refresh)":"";
  var title=status.failed?"Build failed: "+(a.build.error||"see the browser overlay"):"Open "+name+" on :"+a.port+since;
  if(ready){
    var seed=hashText(name+":"+a.port),awake=inner.replace(dot(status.tone),dot(status.tone==="ok"?"awake":status.tone));
    var seep='<span class="seep" aria-hidden="true">'+seepFill(seed)+'<span class="seep-text">'+awake+'</span></span><span class="pill-drip" aria-hidden="true" style="left:'+(28+seed%44)+'%"></span>';
    return'<a class="app-pill tone-'+status.tone+(status.failed?" failed":"")+'" href="'+esc(url)+'" target="_blank" rel="noopener" title="'+esc(title)+'">'+inner+seep+'</a>';
  }
  if(url)return'<a class="app-pill off tone-'+status.tone+'" href="'+esc(url)+'" target="_blank" rel="noopener" title="'+esc(name)+' is not ready yet; opening anyway">'+inner+'</a>';
  return'<span class="app-pill off tone-'+status.tone+'" title="'+esc(name)+' has no link">'+inner+'</span>';
}
function copyButton(text,label,icon){return'<button type="button" class="icon" data-copy="'+esc(text)+'" aria-label="'+label+'" title="'+label+'">'+QA_THEME.icon(icon)+'</button>'}
function renderSlot(s){
  var cls="card slot-card"+(s.error||(s.apps||[]).some(buildFailed)?" err":"");
  var h=(cls.indexOf(" err")>=0?'<span class="card-drip" aria-hidden="true"></span>':"")+'<span class="slotno">slot '+esc(s.slot)+'</span>'+
    '<div class="head"><span class="branch">'+esc(s.branch||"(no branch)")+'</span>'+
    (s.branch?'<span class="tools">'+copyButton(s.branch,"Copy branch","copy")+copyButton("~/.claude/bin/wt logs "+s.branch,"Copy wt logs command","terminal")+
      ((s.apps||[]).length?'<button type="button" class="icon stop" data-stop="'+esc(s.branch)+'" aria-label="Stop servers" title="Stop servers (wt serve --stop '+esc(s.branch)+')"'+(isRunning()?" disabled":"")+'>'+QA_THEME.icon("stop")+'</button>':"")+'<span class="copied" role="status"></span></span>':"")+
    '</div><div class="apps">';
  (s.apps||[]).forEach(function(a){h+=appPill(a)});
  if(!(s.apps||[]).length)h+='<span class="muted">no apps</span>';
  h+='</div>';
  if(s.head)h+='<div class="muted small head-line" title="'+esc(s.head.subject||"")+'"><code>'+esc(s.head.sha)+'</code>'+
    ' &middot; committed '+agoSpan(s.head.committedAt)+' ago'+
    (s.head.uncommitted?' &middot; <span style="color:var(--warn)">'+esc(s.head.uncommitted)+' uncommitted</span>':'')+'</div>';
  if(s.error)h+='<div class="error">'+esc(s.error)+'</div>';
  if(s.worktree)h+='<div class="muted small" title="'+esc(s.worktree)+'">'+esc(String(s.worktree).replace(/\/+$/,"").split("/").pop())+'</div>';
  return{key:"slot:"+s.slot+":"+(s.branch||""),cls:cls,html:h};
}
function hasRi(s){return(s.apps||[]).some(function(a){return a.app==="ri"})}
function sortedSlots(slots){
  return slots.slice().sort(function(a,b){
    return(hasRi(b)-hasRi(a))||String(a.branch||"").localeCompare(String(b.branch||""));
  });
}
var START_HINT='ask an agent to serve your branch, or run <code>~/.claude/bin/wt serve &lt;branch&gt; ri</code>';
function updatedText(){
  if(!lastOk)return"not loaded";
  var s=Math.max(0,Math.round((Date.now()-lastOk.getTime())/1000));
  return"updated "+(s<5?"just now":s<60?s+"s ago":s<3600?Math.floor(s/60)+"m ago":"at "+lastOk.toLocaleTimeString());
}
function setHtml(element,html){if(element.__html===html)return false;element.__html=html;element.innerHTML=html;return true}
function setClass(element,cls){if(element.className!==cls)element.className=cls}
// Keeps each card's element while its markup is unchanged; only cards whose data changed are touched, and the changed ones are returned.
function reconcileCards(box,cards){
  var existing={},wanted={},changed=[];
  Array.prototype.forEach.call(box.children,function(element){if(element.__key)existing[element.__key]=element});
  cards.forEach(function(card,index){
    var key=wanted[card.key]?card.key+"#"+index:card.key;card.key=key;wanted[key]=true;
    var element=existing[key];
    if(!element){element=document.createElement("div");element.__key=key;changed.push(element)}
    if(element.__html!==card.html){element.__html=card.html;element.innerHTML=card.html;if(changed.indexOf(element)<0)changed.push(element)}
    setClass(element,card.cls);
    if(box.children[index]!==element)box.insertBefore(element,box.children[index]||null);
  });
  Array.prototype.slice.call(box.children).forEach(function(element){if(!wanted[element.__key])element.remove()});
  return changed;
}
function updateAgo(){
  document.querySelectorAll("[data-since]").forEach(function(element){
    var text=agoText(element.getAttribute("data-since"));
    if(element.textContent!==text)element.textContent=text;
  });
}
function render(){
  var loading=!data&&!failure;
  document.body.classList.toggle("loading",loading);
  document.querySelector("main").setAttribute("aria-busy",loading?"true":"false");
  var backend=data&&data.backend,backendBox=document.getElementById("backend");
  setClass(backendBox,"card backend"+(backend?(backendHealthy(backend)?"":" err"):" muted"));
  var backendChanged=setHtml(backendBox,renderBackend(backend));
  var slots=(data&&data.slots)||[];
  setText(document.getElementById("console-count"),String(slots.length));
  if(stopDialog&&stopDialog.open&&!stopAvailable(stopBranch))stopDialog.close();
  var hint=document.getElementById("hint"),hintHtml=slots.length?"To start another session, "+START_HINT+".":"";
  hint.hidden=!slots.length;setHtml(hint,hintHtml);
  var slotsBox=document.getElementById("slots");
  var cards=slots.length?sortedSlots(slots).map(renderSlot):
    [{key:"empty",cls:"card empty",html:'<span class="title">'+esc(QA_THEME.copy("emptyTitle","No sessions running"))+'</span><div class="muted">To start one, '+START_HINT+'.</div>'}];
  var changedCards=reconcileCards(slotsBox,cards);
  if(window.QA_BRUSH)changedCards.forEach(function(card){QA_BRUSH.decorate(card)});
  updateAgo();
  if(QA_PERF){QA_PERF.renders++;QA_PERF.cardsRebuilt+=changedCards.length+(backendChanged?1:0)}
  var unhealthy=failure||(backend&&tone(backend.overall)!=="ok")||slots.some(function(slot){return(slot.apps||[]).some(buildFailed)});
  updateFavicon();
  var title=(unhealthy?"(!) ":"")+"Overseer · "+slots.length+" session"+(slots.length===1?"":"s");
  if(document.title!==title)document.title=title;
  var b=document.getElementById("banner"),banner=failure?"Status unavailable"+(data?" - showing stale data":"")+": "+failure:"";
  setText(document.getElementById("updated"),updatedText());
  if(failure){b.style.display="block";setText(b,banner)}
  else if(b.style.display!=="none")b.style.display="none";
  if(changedCards.length||backendChanged)document.dispatchEvent(new Event("qa-layout"));
}
function setText(element,text){if(element.textContent!==text)element.textContent=text}
function copyText(text,button){
  function done(ok){
    var note=button.parentNode.querySelector(".copied");
    if(!note)return;
    note.textContent=ok?"Copied":"Copy failed";
    clearTimeout(note.timer);note.timer=setTimeout(function(){note.textContent=""},1500);
  }
  if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(text).then(function(){done(true)},function(){done(false)});return}
  var area=document.createElement("textarea"),ok=false;
  area.value=text;document.body.appendChild(area);area.select();
  try{ok=document.execCommand("copy")}catch(e){}
  area.remove();done(ok);
}
function runAction(name,branch){
  actionError=null;
  var request=branch?{url:"/api/slot/stop",body:JSON.stringify({branch:branch})}:{url:"/api/backend/"+name,body:null};
  fetch(request.url,{method:"POST",headers:{"X-QA-Dashboard":"1","Content-Type":"application/json"},body:request.body,cache:"no-store"}).then(function(r){
    return r.json().then(function(j){
      if(j.actions&&data)data.actions=j.actions;
      if(!r.ok)actionError=j.error||("HTTP "+r.status);
      render();schedule(1000);
    });
  }).catch(function(e){actionError=e.message;render()});
}
var stopDialog=document.getElementById("stop-confirm"),stopBranch="",stopOpener=null,stopSubmitting=false;
function stopAvailable(branch){return!isRunning()&&!!((data&&data.slots)||[]).find(function(slot){return slot.branch===branch&&(slot.apps||[]).length})}
function confirmStop(branch,opener){
  if(!stopDialog||!stopDialog.showModal||stopDialog.open||!stopAvailable(branch))return;
  stopBranch=branch;stopOpener=opener;stopSubmitting=false;
  document.getElementById("stop-message").textContent="Stop the frontends for "+branch+"?";
  stopDialog.showModal();document.dispatchEvent(new CustomEvent("qa-modal",{detail:true}));
  document.getElementById("stop-cancel").focus();
}
stopDialog.querySelector("form").addEventListener("submit",function(e){
  e.preventDefault();
  if(stopSubmitting||!stopDialog.open)return;
  if(!stopAvailable(stopBranch)){stopDialog.close();return}
  stopSubmitting=true;var branch=stopBranch;stopDialog.close();runAction("stop",branch);
});
document.getElementById("stop-cancel").addEventListener("click",function(){stopDialog.close()});
stopDialog.addEventListener("click",function(e){
  var rect=stopDialog.getBoundingClientRect();
  if(e.target===stopDialog&&(e.clientX<rect.left||e.clientX>rect.right||e.clientY<rect.top||e.clientY>rect.bottom))stopDialog.close();
});
stopDialog.addEventListener("close",function(){
  document.dispatchEvent(new CustomEvent("qa-modal",{detail:false}));
  var opener=stopOpener;
  if(!opener||!opener.isConnected||opener.disabled)opener=Array.from(document.querySelectorAll("[data-stop]")).find(function(button){return button.getAttribute("data-stop")===stopBranch&&!button.disabled});
  if(!opener)opener=document.getElementById("settings-open");
  if(opener)opener.focus();
  stopOpener=null;
});
document.addEventListener("click",function(e){
  var t=e.target.closest("[data-action],[data-copy],[data-toggle],[data-stop]");
  if(!t||t.disabled)return;
  if(t.hasAttribute("data-toggle")){
    var healthy=!data||!data.backend||backendHealthy(data.backend);
    detailsChoice={healthy:healthy,open:!detailsOpen(healthy)};
    try{sessionStorage.setItem("qaDashboardBackendDetails",JSON.stringify(detailsChoice))}catch(e){}
    render();var again=document.querySelector("[data-toggle]");if(again)again.focus();
  }
  else if(t.hasAttribute("data-copy"))copyText(t.getAttribute("data-copy"),t);
  else if(t.hasAttribute("data-stop")){
    var branch=t.getAttribute("data-stop");
    confirmStop(branch,t);
  }
  else runAction(t.getAttribute("data-action"));
});
document.addEventListener("toggle",function(e){if(e.target.id==="action-output")outputOpen=e.target.open},true);
function pageHealth(){
  if(failure)return"bad";
  var tones=[],backend=data&&data.backend;
  if(backend)tones.push(backendTone(backend));
  ((data&&data.slots)||[]).forEach(function(slot){(slot.apps||[]).forEach(function(a){tones.push(appStatus(a).tone)})});
  var worst=worstTone(tones);
  return worst==="broken"||worst==="attn"?"bad":worst==="down"?"down":worst==="warn"?"warn":"ok";
}
var reducedMotion=window.matchMedia("(prefers-reduced-motion: reduce)"),faviconTimer=null,faviconDim=false;
function updateFavicon(){
  var state=pageHealth(),alternate=state==="bad"&&!reducedMotion.matches&&!(document.visibilityState==="visible"&&document.hasFocus());
  if(alternate&&!faviconTimer)faviconTimer=setInterval(function(){faviconDim=!faviconDim;QA_THEME.favicon(faviconDim?"badDim":"bad")},1000);
  if(!alternate&&faviconTimer){clearInterval(faviconTimer);faviconTimer=null;faviconDim=false}
  if(!faviconTimer)QA_THEME.favicon(state);
}
window.addEventListener("focus",updateFavicon);window.addEventListener("blur",updateFavicon);
document.addEventListener("visibilitychange",updateFavicon);
(function pillLife(){
  document.addEventListener("pointerover",function(e){
    var pill=e.target.closest&&e.target.closest("a.app-pill");
    if(!pill||pill.contains(e.relatedTarget)||reducedMotion.matches)return;
    var drip=pill.querySelector(".pill-drip"),now=Date.now();
    if(!drip||now-(+pill.dataset.dripAt||0)<2500)return;
    pill.dataset.dripAt=now;drip.classList.remove("falling");void drip.offsetWidth;drip.classList.add("falling");
  });
  document.addEventListener("pointermove",function(e){
    var pill=e.target.closest&&e.target.closest("a.app-pill"),pupil=pill&&pill.querySelector(".seep-text .glyph-pupil");
    if(!pupil)return;
    var rect=pupil.ownerSVGElement.getBoundingClientRect(),dx=e.clientX-(rect.left+rect.width/2),dy=e.clientY-(rect.top+rect.height/2),d=Math.hypot(dx,dy)||1,reach=Math.min(1,d/60);
    pupil.setAttribute("transform","translate("+(dx/d*2*reach).toFixed(2)+" "+(dy/d*1.2*reach).toFixed(2)+")");
  },{passive:true});
  document.addEventListener("pointerdown",function(e){
    var pill=e.target.closest&&e.target.closest("a.app-pill");
    if(!pill||reducedMotion.matches)return;
    for(var k=0;k<3;k++){
      var dot=document.createElement("span"),angle=Math.random()*Math.PI*2;
      dot.className="pill-splat";dot.style.left=(10+Math.random()*80)+"%";dot.style.top=(Math.random()<0.5?"-2px":"calc(100% - 1px)");
      dot.style.setProperty("--dx",(Math.cos(angle)*9).toFixed(1)+"px");dot.style.setProperty("--dy",(Math.sin(angle)*6).toFixed(1)+"px");
      dot.addEventListener("animationend",function(){this.remove()});pill.appendChild(dot);
    }
  });
})();
