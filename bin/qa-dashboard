function schedule(ms){if(INITIAL)return;clearTimeout(pollTimer);pollTimer=setTimeout(poll,ms)}
function poll(){
  fetch("/api/status",{cache:"no-store"}).then(function(r){
    return r.json().then(function(j){if(!r.ok||j.error)throw new Error(j.error||("HTTP "+r.status));return j});
  }).then(function(j){data=j;lastOk=new Date();failure=null;render()})
    .catch(function(e){failure=e.message;render()})
    .then(function(){schedule(isRunning()?2000:5000)});
}
