<script>
"use strict";
var INITIAL=/*INITIAL*/null/*END*/;
var APP_NAMES={ri:"RI","ds-demo":"ds-demo",strategy:"Strategy"};
var tenantInput=document.getElementById("tenant");
try{tenantInput.value=localStorage.getItem("qaDashboardTenant")||"mridderikhoff"}catch(e){}
var data=null,lastOk=null,failure=null,actionError=null,pollTimer=null;
// The user's expand/collapse choice for the backend details applies only while the health it was made under still holds.
var detailsChoice=null;
try{detailsChoice=JSON.parse(sessionStorage.getItem("qaDashboardBackendDetails"))}catch(e){}
var outputOpen=false;
function esc(s){return String(s==null?"":s).replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
function tone(state,attn){
  if(attn)return"attn";
  var s=String(state||"").toLowerCase();
  if(/^ready|^active|healthy/.test(s))return"ok";
  if(/attention/.test(s))return"attn";
  if(/fail|down|error|unhealthy|not ready/.test(s))return"bad";
  if(/listening|degraded|starting|activating/.test(s))return"warn";
  return"";
}
// Rank decides the worst state shown on the overall badge and in the favicon.
// busy (an action in progress) is neutral: it never raises a rollup, the favicon or the radio's urgency.
var TONE_RANK={ok:0,busy:0,unknown:1,warn:2,down:3,broken:4,attn:5};
function serviceTone(s){
  if(!s)return"unknown";
  if(s.needsAttention||/attention/i.test(s.status||""))return"attn";
  if(s.probe==="ready"||/^ready/.test(s.status||""))return"ok";
  if(/listening/.test(s.status||"")||s.unitState==="activating"||s.unitState==="reloading")return"warn";
  if(s.unitState==="active")return"broken";
  if(s.unitState==="failed"||s.unitState==="inactive"||/down|fail/.test(s.status||s.probe||""))return"down";
  return"unknown";
}
function worstTone(tones){return tones.reduce(function(worst,t){return(TONE_RANK[t]||0)>(TONE_RANK[worst]||0)?t:worst},"ok")}
function backendTone(b){
  var services=b.services||{},names=Object.keys(services);
  if(!names.length){var t=tone(b.overall);return t==="ok"?"ok":t==="warn"?"warn":t==="bad"||t==="attn"?"down":"unknown"}
  return worstTone(names.map(function(n){return serviceTone(services[n])}));
}
function dot(t){return'<span class="dot '+(t||"unknown")+'">'+QA_THEME.glyph(t||"unknown")+'</span>'}
function agoSpan(iso){return'<span data-since="'+esc(iso)+'"></span>'}
function agoText(iso){
  if(!iso)return"";var s=Math.max(0,Math.round((Date.now()-new Date(iso).getTime())/1000));
  return s<60?s+"s":s<3600?Math.floor(s/60)+"m":s<86400?Math.floor(s/3600)+"h":Math.floor(s/86400)+"d";
}
function clock(iso){return iso?new Date(iso).toLocaleTimeString():""}
// An app's start time, parsed once: label is compact for the pill (hours and minutes today, the date in front on any other
// day) and full is the local date and time for its tooltip. A missing or unparseable time gives null, so neither is shown.
function startTime(iso){
  if(!iso)return null;
  var d=new Date(iso);if(isNaN(d.getTime()))return null;
  var time=d.toLocaleTimeString([],{hour:"numeric",minute:"2-digit"});
  return{label:d.toDateString()===new Date().toDateString()?time:d.toLocaleDateString([],{month:"short",day:"numeric"})+" "+time,full:d.toLocaleString()};
}
// Before the first real snapshot the page says it is checking; it never claims zero sessions or a missing backend.
var LOADING_SESSIONS="Loading saved sessions…",CHECKING_BACKEND="Checking backend status…",STATUS_RETRYING="Status unavailable, retrying.";
function currentAction(){return data&&data.actions}
function isRunning(){var a=currentAction();return!!(a&&a.state==="running")}
var ACTION_LABELS={heal:["Heal","Healing&hellip;"],update:["Update to develop","Updating&hellip;"],ensure:["Start backend","Starting&hellip;"]};
var ACTION_VERBS={heal:"Heal",update:"Update",ensure:"Backend start",stop:"Stop",restart:"Restart",resume:"Resume sessions",forget:"Start fresh"};
function actionSubject(a){return a.action==="restart"?"Backend":a.target||a.action==="resume"||a.action==="forget"?"Session":"Backend"}
function actionButton(name,idle,extra){
  var a=currentAction(),busy=isRunning()&&a.action===name,labels=ACTION_LABELS[name];
  var label=busy?labels[1]:(idle||labels[0]);
  return'<button type="button" class="act'+(extra?" "+extra:"")+'" data-action="'+name+'"'+(isRunning()?" disabled":"")+'>'+label+'</button>';
}
// Updating or returning to develop uses the same action. A behind count is useful; an attached SHA is shown in the branch row.
function updateButton(relation,switching){
  var a=currentAction(),busy=isRunning()&&a.action==="update",count=(/behind\D*(\d+)/i.exec(relation)||[])[1];
  var label=switching?"Switch to develop":"Update",busyLabel=switching?"Switching&hellip;":"Updating&hellip;";
  var description=label+(count?", "+count+" behind":"");
  return'<button type="button" class="update-btn" data-action="update" title="'+esc(description)+'" aria-label="'+esc(busy?busyLabel.replace("&hellip;","…"):description)+'"'+(isRunning()?" disabled":"")+'>'+
    '<span class="update-label">'+(busy?busyLabel:label)+'</span>'+(count?'<span class="behind-badge">'+esc(count)+' behind</span>':"")+'</button>';
}
function actionLine(a){
  var verb=(ACTION_VERBS[a.action]||a.action)+(a.target?" "+a.target:"");
  if(a.state==="running")return{text:verb+" running since "+clock(a.startedAt),tone:"busy"};
  if(a.state==="ok")return{text:verb+" finished at "+clock(a.endedAt),tone:"ok"};
  return{text:verb+" failed"+(a.exitCode!=null?" (exit "+a.exitCode+")":"")+" at "+clock(a.endedAt),tone:"down"};
}
function renderActionResult(){
  var a=currentAction();
  if(!a&&!actionError)return"";
  var h='<div class="action-result" aria-live="polite">';
  if(a){
    var line=actionLine(a);
    h+='<span class="tone-'+line.tone+'">'+dot(line.tone)+esc(line.text)+'</span>';
  }
  if(actionError)h+='<span class="error">'+esc(actionError)+'</span>';
  h+='</div>';
  if(a&&a.output&&a.output.length)h+='<div class="output-disclosure"><div class="output-actions"><button type="button" class="toggle output-toggle" data-output aria-expanded="'+outputOpen+'" aria-controls="action-output"><span class="chev" aria-hidden="true">'+QA_THEME.icon("chevron")+'</span><span>'+(outputOpen?"Hide":"Show")+' output</span></button>'+
    (outputOpen?'<button type="button" class="act quiet output-copy" data-copy-output>Copy output</button><span class="copied" role="status"></span>':"")+'</div><pre id="action-output" class="output-log" tabindex="0" aria-label="Action output"'+(outputOpen?"":" hidden")+'></pre></div>';
  return h;
}
function backendHealthy(b){
  var svcs=b.services||{};
  return tone(b.overall)==="ok"&&Object.keys(svcs).every(function(n){var t=serviceTone(svcs[n]);return t==="ok"||t==="warn"});
}
function detailsOpen(healthy){return detailsChoice&&detailsChoice.healthy===healthy?!!detailsChoice.open:!healthy}
// Collapsed, the card shows only the overall rollup; service names and glyphs live in the details.
function renderBackend(b){
  if(!b)return'<div class="muted">'+(data?"No backend data.":failure?STATUS_RETRYING:CHECKING_BACKEND)+'</div>'+renderActionResult();
  var branch=typeof b.branch==="string"&&b.branch?b.branch:null,switching=branch!=="develop",behind=/behind/i.test(b.relation||""),healthy=backendHealthy(b),open=detailsOpen(healthy),rollup=backendTone(b);
  var actions=(tone(b.overall)==="bad"?actionButton("ensure"):"")+(tone(b.overall)!=="ok"?actionButton("heal"):"");
  var h=(healthy?"":'<span class="card-drip" aria-hidden="true"></span>')+'<div class="backend-body"><div class="head"><div class="rollup tone-'+rollup+'"><span class="title">Backend</span>'+
    '<span class="state" style="--stamp-chars:'+Math.max(6,String(b.overall||"unknown").length)+'">'+dot(rollup)+esc(String(b.overall||"unknown").replace(/-/g," "))+'</span>'+
    '<span class="backend-branch"><span>Backend branch</span><span class="backend-branch-value">'+esc(branch||"Unverified at "+(b.sha||"?"))+'</span></span></div>'+
    ((switching||behind)?'<div class="rel">'+updateButton(b.relation||"",switching)+'</div>':"")+
    (actions?'<div class="acts">'+actions+'</div>':"")+
    '<div class="meta"><span>sha <code>'+esc(b.sha||"?")+'</code></span></div></div>'+
    '<div class="backend-disclosure"><button type="button" class="toggle" data-toggle="services" aria-expanded="'+open+'" aria-controls="backend-details">'+
    '<span class="chev" aria-hidden="true">'+QA_THEME.icon("chevron")+'</span>'+
    '<span>'+(open?"Hide":"Show")+' details</span></button>'+
    '<div id="backend-details" class="backend-details"'+(open?"":" hidden")+'>';
  if(open){
    var svcs=b.services||{};
    h+=(b.dirty?'<span class="pill" style="color:var(--warn)">dirty: '+esc(b.dirty)+'</span>':"");
    Object.keys(svcs).forEach(function(n){
      var s=svcs[n],t=serviceTone(s),attn=!!s.needsAttention||/attention/i.test(s.status||"");
      var restartable=t==="down"||t==="broken"||t==="attn";
      h+='<div class="svc tone-'+(t||"unknown")+(attn?" attn":"")+'">'+dot(t)+
        '<span class="name">'+esc(n)+'</span><span>'+esc(s.status||s.probe||s.unitState)+'</span>'+
        (s.restartCount?'<span class="muted small">restarts '+esc(s.restartCount)+'</span>':"")+
        (restartable?'<button type="button" class="act svc-restart" data-restart="'+esc(n)+'" aria-label="Restart '+esc(n)+'" title="Restart '+esc(n)+' (wt backend restart '+esc(n)+')"'+(isRunning()?" disabled":"")+'>Restart</button>':"")+'</div>';
    });
  }
  return h+'</div></div>'+renderActionResult()+'</div>';
}
function appUrl(a){
  var url=a.url||"";
  if(url.indexOf("<tenant>")>=0){
    var t=tenantInput.value.trim();
    url=t?url.split("<tenant>").join(encodeURIComponent(t)):url.split("<tenant>")[0];
  }
  return url;
}
// Down or not ready beats a failed build, which beats rebuilding, which beats ok.
function appStatus(a){
  var build=a.build&&a.build.state;
  if(!a.httpReady)return a.unitState==="active"?{tone:"warn",label:"starting"}:{tone:"down",label:a.unitState||"down"};
  if(build==="failed"){var errors=a.build.errorCount;return{tone:"broken",label:"build failed"+(errors?" \u00b7 "+errors+" error"+(errors===1?"":"s"):""),failed:true}}
  if(build==="building")return{tone:"warn",label:"rebuilding"};
  return{tone:"ok",label:""};
}
function hashText(text){var h=2166136261;for(var i=0;i<text.length;i++){h^=text.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0}
// Pill hover effects, picked by the theme's pillHover. Each returns the layer drawn over a ready pill; `awake` is the label
// with the hover glyph, and `seed` is stable per pill so nothing re-rolls while you look at it.
// The seep silhouette, shared by tags and buttons: a seeded ragged top on a 100 x 40 box. The right edge stays within 3 units of
// the end and the bottom corners are explicit, so the band always covers the full width and height of the band box at rest.
function seepPoints(seed,reach){
  var points=[],value=seed;
  function next(){value=Math.imul(value^value>>>13,1274126177)>>>0;return(value%1000)/1000}
  for(var x=0;x<=90;x+=10)points.push([x,6+next()*14]);
  for(var y=10;y<40;y+=8)points.push([reach-next()*3,y]);
  points.push([reach,40],[0,40]);
  return points;
}
var PILL_HOVERS={
  // A low wet band: ragged along its top surface and at its leading edge, so the pill text stays clear. One drop falls.
  seep:function(awake,seed){
    var points=seepPoints(seed,100).map(function(point){return point[0].toFixed(1)+" "+point[1].toFixed(1)});
    return'<span class="pill-fx" aria-hidden="true"><svg class="seep-fill" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true"><path style="fill:var(--seep)" d="M'+points.join("L")+'Z"/></svg>'+
      '<span class="fx-text seep-text">'+awake+'</span></span><span class="pill-drip" aria-hidden="true" style="left:'+(28+seed%44)+'%"></span>';
  },
  // A stepped power bar charges across behind the label, and the label inverts as it passes.
  charge:function(awake){return'<span class="pill-fx" aria-hidden="true"><span class="charge-fill"><span class="fx-text charge-text">'+awake+'</span></span></span>'},
  // A DOS block fill: the same stepped bar, led by a ▓▒░ edge, in inverse video.
  blocks:function(awake){return'<span class="pill-fx" aria-hidden="true"><span class="charge-fill blocks"><span class="fx-text charge-text">'+awake+'</span></span><span class="blocks-edge"></span></span>'},
  // A keycap: the theme presses the key down; the legend lights up as if backlit through the cap.
  press:function(awake){return'<span class="pill-fx" aria-hidden="true"><span class="fx-text press-text">'+awake+'</span></span>'},
  none:function(){return""}
};
// Button hover effects (the theme's buttonHover): every button gets a copy of its label inside a fill layer, so the effect
// moves by transform only and the label stays readable as the fill passes. CSS picks the look from data-button-hover; the
// seep also gets a drop that falls once per hover, with a cooldown.
var FX_BUTTONS="button.icon,button.act,.backend .update-btn,.backend .toggle,.settings .done,.confirm-actions button,.settings .segmented label";
function buttonFx(root){
  var kind=QA_THEME.buttonHover();
  Array.prototype.forEach.call((root||document).querySelectorAll(FX_BUTTONS),function(button){
    if(button.__fx===kind+"|"+button.innerHTML)return;
    Array.prototype.slice.call(button.querySelectorAll(":scope > .bfx,:scope > .bfx-drip")).forEach(function(node){node.remove()});
    var layer=document.createElement("span"),fill=document.createElement("span"),text=document.createElement("span");
    layer.className="bfx";layer.setAttribute("aria-hidden","true");fill.className="bfx-fill";text.className="bfx-text";
    Array.prototype.forEach.call(button.childNodes,function(node){
      if(node.nodeType===1&&(node.tagName==="INPUT"||node.classList.contains("brush")||node.classList.contains("copied")))return;
      var copy=node.cloneNode(true);if(copy.removeAttribute)copy.removeAttribute("id");text.appendChild(copy);
    });
    fill.appendChild(text);layer.appendChild(fill);button.appendChild(layer);
    // The seep band wears the same seeded silhouette as the tags; it reaches 4% past the edge so no gap shows at the right.
    if(kind==="seep")fill.style.clipPath="polygon("+seepPoints(hashText((button.textContent||"")+(button.getAttribute("aria-label")||button.title||"")+button.className),104).map(function(q){return q[0].toFixed(1)+"% "+(q[1]*2.5).toFixed(1)+"%"}).join(",")+")";
    if(kind==="seep"){var drip=document.createElement("span");drip.className="pill-drip bfx-drip";drip.setAttribute("aria-hidden","true");drip.style.left=(30+hashText(button.textContent||"x")%40)+"%";button.appendChild(drip)}
    button.__fx=kind+"|"+button.innerHTML;
    // A new layer inside the button that is already hovered starts full, so it does not replay under the pointer.
    if(button===FX_HOVER.over)settleFx(button);
  });
  settleUnderPointer();
}
// Hover fills play once, when the pointer arrives. A click that rebuilds the hovered pill or button (Show details re-renders the
// backend card) or a poll that re-renders its card would otherwise start a fresh, empty fill under the pointer. FX_HOVER
// remembers what the pointer is over; after a rebuild, the new element under it is marked settled (filled, no transition) until
// the pointer leaves it.
var FX_TARGETS="a.app-pill,"+FX_BUTTONS,FX_HOVER={over:null,x:0,y:0,inside:false,settled:[]};
function settleFx(element){if(!element.classList.contains("fx-settled")){element.classList.add("fx-settled");FX_HOVER.settled.push(element)}}
function settleUnderPointer(){
  var was=FX_HOVER.over;
  if(!FX_HOVER.inside||!was||was.isConnected)return;
  var hit=document.elementFromPoint(FX_HOVER.x,FX_HOVER.y),target=hit&&hit.closest&&hit.closest(FX_TARGETS);
  FX_HOVER.over=target||null;
  if(target&&!target.disabled)settleFx(target);
}
function buildFailed(a){return!!(a.httpReady&&a.build&&a.build.state==="failed")}
function appPill(a){
  var name=APP_NAMES[a.app]||a.app||"app",url=appUrl(a),ready=!!a.httpReady&&!!url,status=appStatus(a);
  var state=status.label||(a.httpReady&&!url?"no link":""),started=startTime(a.startedAt);
  var inner=dot(status.tone)+'<span class="app-name">'+esc(name)+'</span>'+
    (status.failed?'<span class="build-failed">'+esc(state)+'</span>':
    (state?'<span class="port">'+esc(state)+'</span>':"")+
    (a.httpReady&&started?'<span class="since"><span class="sr-only">started </span>'+esc(started.label)+'</span>':""));
  var since=started?" (dev server started "+started.full+"; if your tab is older, hard-refresh)":"";
  var title=status.failed?"Build failed: "+(a.build.error||"see the browser overlay")+(started?" (dev server started "+started.full+")":""):"Open "+name+" on :"+a.port+since;
  if(ready){
    var seed=hashText(name+":"+a.port),awake=inner.replace(dot(status.tone),dot(status.tone==="ok"?"awake":status.tone));
    var fx=(PILL_HOVERS[QA_THEME.pillHover()]||PILL_HOVERS.none)(awake,seed);
    return'<a class="app-pill tone-'+status.tone+(status.failed?" failed":"")+'" href="'+esc(url)+'" target="_blank" rel="noopener" title="'+esc(title)+'">'+inner+fx+'</a>';
  }
  if(url)return'<a class="app-pill off tone-'+status.tone+'" href="'+esc(url)+'" target="_blank" rel="noopener" title="'+esc(name)+' is not ready yet; opening anyway">'+inner+'</a>';
  return'<span class="app-pill off tone-'+status.tone+'" title="'+esc(name)+' has no link">'+inner+'</span>';
}
function copyButton(text,label,icon){return'<button type="button" class="icon" data-copy="'+esc(text)+'" aria-label="'+label+'" title="'+label+'">'+QA_THEME.icon(icon)+'</button>'}
// The slot number is stamped by hand: a seeded tilt per slot and branch, so it never re-rolls on refresh.
function stampTilt(s){var h=hashText("stamp:"+s.slot+":"+(s.branch||"")),m=1.5+(h%1000)/1000*3.5;return((h>>>10)&1?m:-m).toFixed(1)}
function renderSlot(s){
  var action=currentAction(),stopping=!!(action&&action.action==="stop"&&action.state==="running"&&action.target===s.branch);
  var cls="card slot-card"+(s.error||(s.apps||[]).some(buildFailed)?" err":"")+(stopping?" stopping":"");
  var h=(cls.indexOf(" err")>=0?'<span class="card-drip" aria-hidden="true"></span>':"")+'<span class="slotno" style="--stamp-tilt:'+stampTilt(s)+'deg"><span class="slotno-k">slot</span> <span class="slotno-v">'+esc(s.slot)+'</span></span>'+
    '<div class="head"><span class="branch">'+esc(s.branch||"(no branch)")+'</span>'+
    (s.branch?'<span class="tools">'+copyButton(s.branch,"Copy branch","copy")+copyButton("~/.claude/bin/wt logs "+s.branch,"Copy wt logs command","terminal")+
      ((s.apps||[]).length&&!s.recovery?'<button type="button" class="icon stop" data-stop="'+esc(s.branch)+'" aria-label="Stop servers" title="Stop servers (wt serve --stop '+esc(s.branch)+')"'+(isRunning()?" disabled":"")+'>'+QA_THEME.icon("stop")+'</button>':"")+'<span class="copied" role="status"></span></span>':"")+
    '</div><div class="apps">';
  (s.apps||[]).forEach(function(a){h+=appPill(a)});
  if(!(s.apps||[]).length)h+='<span class="muted">no apps</span>';
  h+='</div>';
  if(s.head)h+='<div class="muted small head-line" title="'+esc(s.head.subject||"")+'"><code>'+esc(s.head.sha)+'</code>'+
    ' &middot; committed '+agoSpan(s.head.committedAt)+' ago'+
    (s.head.uncommitted?' &middot; <span style="color:var(--warn)">'+esc(s.head.uncommitted)+' uncommitted</span>':'')+'</div>';
  if(s.error)h+='<div class="error">'+esc(s.error)+'</div>';
  if(stopping)h+='<div class="stopping-note" role="status">Stopping&hellip;</div>';
  if(s.worktree)h+='<div class="muted small" title="'+esc(s.worktree)+'">'+esc(String(s.worktree).replace(/\/+$/,"").split("/").pop())+'</div>';
  return{key:"slot:"+s.slot+":"+(s.branch||""),cls:cls,html:h};
}
function hasRi(s){return(s.apps||[]).some(function(a){return a.app==="ri"})}
function sortedSlots(slots){
  return slots.slice().sort(function(a,b){
    return(hasRi(b)-hasRi(a))||String(a.branch||"").localeCompare(String(b.branch||""));
  });
}
var START_HINT='ask an agent to serve your branch';
function updatedText(){
  if(!lastOk)return"not loaded";
  return"updated at "+lastOk.toLocaleTimeString([],{hour:"numeric",minute:"2-digit"});
}
function setHtml(element,html){if(element.__html===html)return false;element.__html=html;element.innerHTML=html;return true}
function setClass(element,cls){if(element.className!==cls)element.className=cls}
function radioMessages(snapshot,fetchFailure,requestFailure){
  var out=[],backend=snapshot&&snapshot.backend,services=backend&&backend.services||{},names=Object.keys(services),slots=sortedSlots(snapshot&&snapshot.slots||[]),action=snapshot&&snapshot.actions;
  function add(key,tone,subject,text){out.push({key:key,tone:tone,subject:subject,text:text})}
  function listed(items){return items.slice(0,3).join(", ")+(items.length>3?", and "+(items.length-3)+" more":"")}
  function serviceNames(want){return names.filter(function(name){return serviceTone(services[name])===want})}
  if(!snapshot&&!fetchFailure)add("loading","unknown","Status",LOADING_SESSIONS+" "+CHECKING_BACKEND);
  if(fetchFailure)add("failure",snapshot?"down":"unknown","Status",snapshot?"Status unavailable: "+fetchFailure+". Showing the last data.":"Status unavailable, retrying: "+fetchFailure+".");
  if(requestFailure)add("request","down","Backend","Request failed: "+requestFailure+".");
  if(backend){
    if(backendTone(backend)==="down"&&names.length){var down=serviceNames("down");add("backend:down","down","Backend","Backend is down."+(down.length?" Not running: "+listed(down)+".":""))}
    ["attn","broken"].forEach(function(t){var group=serviceNames(t);if(group.length)add("backend:"+t,t,"Backend",t==="attn"?"Backend needs attention: "+listed(group)+".":"Backend services running but not ready: "+listed(group)+".")});
  }
  if(action&&action.state!=="running"&&action.state!=="ok")add("action:failed:"+action.action+":"+(action.target||""),"down",actionSubject(action),(ACTION_VERBS[action.action]||action.action)+(action.target?" "+action.target:"")+" failed"+(action.exitCode!=null?" (exit "+action.exitCode+")":"")+" at "+clock(action.endedAt)+".");
  var saved=slots.filter(function(slot){return slot.recovery}),live=slots.filter(function(slot){return!slot.recovery});
  live.forEach(function(slot){(slot.apps||[]).forEach(function(app){if(buildFailed(app))add("build:"+slot.branch+":"+app.app,"broken","Session",(APP_NAMES[app.app]||app.app||"App")+" build failed on "+slot.branch+"."+(app.build.errorCount?" "+app.build.errorCount+" error"+(app.build.errorCount===1?"":"s")+".":""))})});
  slots.forEach(function(slot){if(slot.error)add("slot:"+slot.branch,"down","Session",slot.branch+": "+slot.error)});
  live.forEach(function(slot){(slot.apps||[]).forEach(function(app){if(app.httpReady===false&&app.unitState&&app.unitState!=="active")add("app:down:"+slot.branch+":"+app.app,"down","Session",(APP_NAMES[app.app]||app.app||"App")+" is "+app.unitState+" on "+slot.branch+".")})});
  if(action&&action.state==="running")add("action:running:"+action.action+":"+(action.target||""),"busy",actionSubject(action),(ACTION_VERBS[action.action]||action.action)+(action.target?" "+action.target:"")+" running since "+clock(action.startedAt)+".");
  if(saved.length)add("recovery:saved","warn","Session",saved.length+" saved session"+(saved.length===1?"":"s")+" stopped since the restart. Choose Resume sessions or Start fresh.");
  if(backend){var starting=serviceNames("warn");if(starting.length)add("backend:starting","warn","Backend","Backend services starting: "+listed(starting)+".")}
  live.forEach(function(slot){(slot.apps||[]).forEach(function(app){var name=APP_NAMES[app.app]||app.app||"App";if(app.httpReady===false&&app.unitState==="active")add("app:starting:"+slot.branch+":"+app.app,"warn","Session",name+" is starting on "+slot.branch+".");if(app.build&&app.build.state==="building")add("app:rebuilding:"+slot.branch+":"+app.app,"warn","Session",name+" is rebuilding on "+slot.branch+".")})});
  if(backend&&/behind/i.test(backend.relation||"")){var count=(/behind\D*(\d+)/i.exec(backend.relation)||[])[1],verb=backend.branch==="develop"?"Update":"Switch to develop";add("backend:behind","warn","Backend",count?"Backend is "+count+" behind develop. "+verb+" is on the Backend card.":"Backend: "+backend.relation+".")}
  if(snapshot&&!backend)add("backend:none","unknown","Backend","No backend data.");
  else if(backend&&(!names.length||!backendHealthy(backend)||names.some(function(name){return serviceTone(services[name])==="unknown"}))) {
    if(!out.some(function(message){return message.key.indexOf("backend:")===0}))add("backend:unknown","unknown","Backend",names.length?"Backend readiness is unknown.":"No backend service data.");
  }
  var unknownApps=live.some(function(slot){return !(slot.apps||[]).length||(slot.apps||[]).some(function(app){return app.httpReady!==true&&(app.httpReady!==false||!app.unitState)})});
  if(unknownApps)add("apps:unknown","unknown","Session","Some app readiness is unknown.");
  if(!out.length&&snapshot&&backend&&names.length&&backendHealthy(backend))add(slots.length?"ok":"ok:empty","ok","Status",slots.length?"Backend is ready. "+slots.length+" session"+(slots.length===1?"":"s")+" running, all apps ready.":"Backend is ready. No sessions running.");
  return out;
}
function radioSelection(messages,view,oldKeys){
  var index=messages.findIndex(function(message){return message.key===view.key});if(index<0)index=0;
  var urgent={down:1,broken:1,attn:1};
  var incoming=messages.findIndex(function(message,i){return i<index&&urgent[message.tone]&&oldKeys.indexOf(message.key)<0});
  return {key:messages[incoming>=0?incoming:index].key,index:incoming>=0?incoming:index};
}
window.QA_RADIO={messages:radioMessages,select:radioSelection};
var radioView={key:null,index:0},radioRenderedKey=null,radioKeys=[],radioPainted=false,radioLoaded=false,radioIconTheme="",radioTiles={};
function radioStatic(){
  var key=QA_THEME.id()+":"+(QA_THEME.isDark()?"dark":"light");if(radioTiles[key])return radioTiles[key];
  var canvas=document.createElement("canvas");canvas.width=canvas.height=96;var ctx=canvas.getContext("2d"),image=ctx.createImageData(96,96),seed=hashText(key),horror=QA_THEME.id()==="horror";
  for(var i=0;i<image.data.length;i+=4){seed=Math.imul(seed^seed>>>13,1274126177)>>>0;var on=seed%9===0;image.data[i]=horror?179:QA_THEME.id()==="neon"?255:51;image.data[i+1]=horror?138:QA_THEME.id()==="neon"?62:255;image.data[i+2]=horror?82:QA_THEME.id()==="neon"?165:102;image.data[i+3]=on?40+seed%70:0}
  ctx.putImageData(image,0,0);return radioTiles[key]='url("'+canvas.toDataURL()+'")';
}
function renderRadio(){
  if(QA_THEME.sceneId()!=="radio")return;
  var plate=document.getElementById("radio"),messages=radioMessages(data,failure,actionError);if(!messages.length)return;
  var prior=radioRenderedKey,selection=radioSelection(messages,radioView,radioKeys),message=messages[selection.index],line=plate.querySelector(".radio-line"),said=plate.querySelector(".radio-said"),keyChanged=message.key!==prior,textChanged=line.dataset.text!==message.text;
  radioView=selection;radioKeys=messages.map(function(item){return item.key});
  plate.style.setProperty("--radio-static",radioStatic());
  var motion=radioPainted&&radioLoaded&&keyChanged&&!document.hidden&&!document.querySelector("dialog[open]")&&document.documentElement.getAttribute("data-logo-mode")==="full"&&!reducedMotion.matches;
  var subtle=radioPainted&&radioLoaded&&keyChanged&&!document.hidden&&!document.querySelector("dialog[open]")&&document.documentElement.getAttribute("data-logo-mode")==="subtle"&&!reducedMotion.matches;
  plate.classList.remove("burst","arrive","reveal");document.querySelector(".eye-card").classList.remove("radio-hail");
  if(keyChanged||textChanged){
    line.dataset.text=message.text;line.textContent="";
    if(motion){var mode=QA_THEME.current().radio.reveal,parts=mode==="word"?message.text.match(/\S+\s*/g)||[]:Array.from(message.text),max=Math.max(1,parts.length);parts.forEach(function(part,i){var span=document.createElement("span");span.textContent=part;span.style.setProperty("--delay",Math.min(i*(mode==="word"?70:18),740*i/max)+"ms");span.style.setProperty("--reveal-duration",mode==="word"?"160ms":"130ms");line.appendChild(span)})}
    else line.textContent=message.text;
    setText(said,message.text);
  }
  plate.classList.toggle("problem",message.tone==="down"||message.tone==="broken"||message.tone==="attn");
  setHtml(plate.querySelector(".radio-glyph"),dot(message.tone));setText(plate.querySelector(".radio-subject"),message.subject);
  var meter=plate.querySelector(".radio-meter"),services=data&&data.backend&&data.backend.services||{},names=Object.keys(services),ready=names.filter(function(name){return serviceTone(services[name])==="ok"}).length;
  meter.hidden=!names.length;if(names.length){meter.setAttribute("aria-label",ready+" of "+names.length+" services ready");setHtml(meter,names.map(function(name){return'<i class="'+(serviceTone(services[name])==="ok"?"ready":"")+'"></i>'}).join("")+'<span class="radio-meter-label">Services '+ready+'/'+names.length+'</span>')}
  var count=plate.querySelector(".radio-count"),nav=plate.querySelector(".radio-nav"),hide=messages.length<=1;
  if(hide&&nav.contains(document.activeElement))plate.focus();count.hidden=hide;nav.hidden=hide;if(!hide)setText(count,(selection.index+1)+" of "+messages.length);
  if(keyChanged||!radioPainted||radioIconTheme!==QA_THEME.id()){plate.querySelectorAll(".radio-nav button").forEach(function(button){button.innerHTML=QA_THEME.icon("chevron")});buttonFx(nav);radioIconTheme=QA_THEME.id()}
  if(motion||subtle){void plate.offsetWidth;plate.classList.add("arrive");if(motion){plate.classList.add("burst","reveal");document.querySelector(".eye-card").classList.add("radio-hail")}}
  radioRenderedKey=message.key;radioPainted=true;if(data)radioLoaded=true;
}
// A mode, visibility, or modal change leaves the currently viewed sentence fully readable.
// Remove reveal spans as well as classes so a later Full mode cannot restart their CSS animation.
function settleRadioMotion(){
  var plate=document.getElementById("radio");if(!plate)return;
  plate.classList.remove("reveal","burst","arrive");
  var portrait=document.querySelector(".eye-card");if(portrait)portrait.classList.remove("radio-hail");
  var line=plate.querySelector(".radio-line");if(line&&line.querySelector("span"))line.textContent=line.dataset.text||"";
}
document.addEventListener("qa-modal",function(e){if(e.detail)settleRadioMotion()});
document.addEventListener("visibilitychange",function(){if(document.hidden)settleRadioMotion()});
document.getElementById("radio").addEventListener("animationend",function(e){
  if(e.animationName==="radio-reveal"&&e.target===this.querySelector(".radio-line span:last-child"))settleRadioMotion();
});
document.getElementById("radio").addEventListener("animationcancel",function(e){
  if(e.animationName==="radio-reveal"&&reducedMotion.matches&&e.target.parentElement===this.querySelector(".radio-line"))settleRadioMotion();
});
// Keeps each card's element while its markup is unchanged; only cards whose data changed are touched, and the changed ones are returned.
function reconcileCards(box,cards){
  var existing={},wanted={},changed=[];
  Array.prototype.forEach.call(box.children,function(element){if(element.__key)existing[element.__key]=element});
  cards.forEach(function(card,index){
    var key=wanted[card.key]?card.key+"#"+index:card.key;card.key=key;wanted[key]=true;
    var element=existing[key];
    if(!element){element=document.createElement("div");element.__key=key;changed.push(element)}
    if(element.__html!==card.html){element.__html=card.html;element.innerHTML=card.html;if(changed.indexOf(element)<0)changed.push(element)}
    setClass(element,card.cls);
    if(box.children[index]!==element)box.insertBefore(element,box.children[index]||null);
  });
  Array.prototype.slice.call(box.children).forEach(function(element){if(!wanted[element.__key])element.remove()});
  return changed;
}
function updateAgo(){
  document.querySelectorAll("[data-since]").forEach(function(element){
    var text=agoText(element.getAttribute("data-since"));
    if(element.textContent!==text)element.textContent=text;
  });
}
function render(){
  document.querySelector("main").setAttribute("aria-busy",!data&&!failure?"true":"false");
  var backend=data&&data.backend,backendBox=document.getElementById("backend");
  var oldLog=document.getElementById("action-output"),active=document.activeElement;
  var detailsFocus=active&&active.hasAttribute&&active.hasAttribute("data-toggle"),outputFocus=active&&active.hasAttribute&&active.hasAttribute("data-output"),copyFocus=active&&active.hasAttribute&&active.hasAttribute("data-copy-output");
  var outputScroll=oldLog&&!oldLog.hidden?{top:oldLog.scrollTop,left:oldLog.scrollLeft,follow:oldLog.scrollHeight-oldLog.scrollTop-oldLog.clientHeight<4}:null;
  setClass(backendBox,"card backend"+(backend?(backendHealthy(backend)?"":" err"):" muted"));
  var backendChanged=setHtml(backendBox,renderBackend(backend));
  updateInlineOutput(outputScroll);
  if(backendChanged&&(detailsFocus||outputFocus||copyFocus)){
    var focusTarget=backendBox.querySelector(detailsFocus?"[data-toggle]":outputFocus?"[data-output]":"[data-copy-output]");
    if(focusTarget)focusTarget.focus();
  }
  var slots=(data&&data.slots)||[];
  // Saved recovery slots belong to the recovery picker only; the Sessions section lists everything else.
  var liveSlots=slots.filter(function(slot){return!slot.recovery}),savedOnly=!!data&&slots.length>0&&!liveSlots.length;
  setText(document.getElementById("sessions-count"),data?String(liveSlots.length):"");
  document.getElementById("sessions-title").hidden=savedOnly;
  if(stopDialog&&stopDialog.open&&!confirmAvailable())stopDialog.close();
  var hint=document.getElementById("hint"),hintHtml=liveSlots.length?"To start another session, "+START_HINT+".":"";
  hint.hidden=!liveSlots.length;setHtml(hint,hintHtml);
  var slotsBox=document.getElementById("slots");
  slotsBox.hidden=savedOnly;
  var cards=!data?[{key:"pending",cls:"card empty",html:'<span class="title">'+(failure?STATUS_RETRYING:LOADING_SESSIONS)+'</span><div class="muted">'+(failure?"Saved sessions and backend status will appear when it responds.":CHECKING_BACKEND)+'</div>'}]:
    liveSlots.length?sortedSlots(liveSlots).map(renderSlot):
    savedOnly?[]:
    [{key:"empty",cls:"card empty",html:'<span class="title">'+esc(QA_THEME.copy("emptyTitle","No sessions running"))+'</span><div class="muted">To start one, '+START_HINT+'.</div>'}];
  var changedCards=reconcileCards(slotsBox,cards);
  renderRecovery();
  if(backendChanged)buttonFx(backendBox);
  changedCards.forEach(buttonFx);
  settleUnderPointer();
  // The character's expression follows the backend rollup.
  var rollup=backend?backendTone(backend):"unknown";
  if(window.QA_ROLLUP!==rollup){window.QA_ROLLUP=rollup;document.documentElement.setAttribute("data-rollup",rollup);document.dispatchEvent(new CustomEvent("qa-status",{detail:rollup}))}
  if(window.QA_BRUSH)changedCards.forEach(function(card){QA_BRUSH.decorate(card)});
  updateAgo();
  if(QA_PERF){QA_PERF.renders++;QA_PERF.cardsRebuilt+=changedCards.length+(backendChanged?1:0)}
  var unhealthy=failure||(backend&&tone(backend.overall)!=="ok")||slots.some(function(slot){return(slot.apps||[]).some(buildFailed)});
  updateFavicon();
  var title=!data?(failure?"(!) Overseer · status unavailable":"Overseer · loading…"):(unhealthy?"(!) ":"")+"Overseer · "+liveSlots.length+" session"+(liveSlots.length===1?"":"s");
  if(document.title!==title)document.title=title;
  var b=document.getElementById("banner"),banner=failure?"Status unavailable"+(data?" - showing stale data":" - retrying")+": "+failure:"";
  setText(document.getElementById("updated"),updatedText());
  if(failure){b.style.display="block";setText(b,banner)}
  else if(b.style.display!=="none")b.style.display="none";
  renderRadio();
}
function setText(element,text){if(element.textContent!==text)element.textContent=text}
function copyText(text,button){
  function done(ok){
    var note=button.parentNode.querySelector(".copied");
    if(!note)return;
    note.textContent=ok?"Copied":"Copy failed";
    clearTimeout(note.timer);note.timer=setTimeout(function(){note.textContent=""},1500);
  }
  if(navigator.clipboard&&window.isSecureContext){navigator.clipboard.writeText(text).then(function(){done(true)},function(){done(false)});return}
  var area=document.createElement("textarea"),ok=false;
  area.value=text;(button.closest("dialog[open]")||document.body).appendChild(area);area.select();
  try{ok=document.execCommand("copy")}catch(e){}
  area.remove();button.focus();done(ok);
}
function runAction(name,branch,service){
  actionError=null;recoveryRequest=false;
  outputOpen=false;
  // The card dims at once; the optimistic action is undone if the request fails or brings no action state back.
  var before=data&&data.actions;
  if((branch||service)&&data){data.actions={action:service?"restart":"stop",target:service||branch,state:"running",startedAt:new Date().toISOString(),output:[]};render()}
  var request=branch?{url:"/api/slot/stop",body:JSON.stringify({branch:branch})}:service?{url:"/api/backend/restart",body:JSON.stringify({service:service})}:{url:"/api/backend/"+name,body:null};
  fetch(request.url,{method:"POST",headers:{"X-QA-Dashboard":"1","Content-Type":"application/json"},body:request.body,cache:"no-store"}).then(function(r){
    return r.json().then(function(j){
      if(data)data.actions=j.actions||before;
      if(!r.ok)actionError=j.error||("HTTP "+r.status);
      render();schedule(1000);
    });
  }).catch(function(e){if(data)data.actions=before;actionError=e.message;render();schedule(1000)});
}
// One confirm dialog serves Stop (a session's frontends) and Restart (one backend service); confirmKind says which.
var stopDialog=document.getElementById("stop-confirm"),stopBranch="",stopOpener=null,stopSubmitting=false,confirmKind="stop",restartService="";
function stopAvailable(branch){return!isRunning()&&!!((data&&data.slots)||[]).find(function(slot){return slot.branch===branch&&(slot.apps||[]).length})}
function confirmStop(branch,opener){
  if(!stopDialog||!stopDialog.showModal||stopDialog.open||!stopAvailable(branch))return;
  stopBranch=branch;stopOpener=opener;stopSubmitting=false;confirmKind="stop";
  confirmText("Stop frontends","Stop the frontends for "+branch+"?","Stop");
  stopDialog.showModal();document.dispatchEvent(new CustomEvent("qa-modal",{detail:true}));
  document.getElementById("stop-cancel").focus();
}
function confirmText(title,message,verb){
  document.getElementById("stop-title").textContent=title;document.getElementById("stop-message").textContent=message;
  stopDialog.querySelector(".danger").textContent=verb;buttonFx(stopDialog);
}
function restartAvailable(service){
  var services=data&&data.backend&&data.backend.services||{},t=services[service]&&serviceTone(services[service]);
  return!isRunning()&&(t==="down"||t==="broken"||t==="attn");
}
function confirmAvailable(){return confirmKind==="restart"?restartAvailable(restartService):stopAvailable(stopBranch)}
function confirmRestart(service,opener){
  if(!stopDialog||!stopDialog.showModal||stopDialog.open||!restartAvailable(service))return;
  restartService=service;stopOpener=opener;stopSubmitting=false;confirmKind="restart";
  confirmText("Restart service","Restart "+service+"? It is unavailable for a moment while it starts again.","Restart");
  stopDialog.showModal();document.dispatchEvent(new CustomEvent("qa-modal",{detail:true}));
  document.getElementById("stop-cancel").focus();
}
stopDialog.querySelector("form").addEventListener("submit",function(e){
  e.preventDefault();
  if(stopSubmitting||!stopDialog.open)return;
  if(confirmKind==="restart"){
    if(!restartAvailable(restartService)){stopDialog.close();return}
    stopSubmitting=true;var service=restartService;stopDialog.close();runAction("restart",null,service);return;
  }
  if(!stopAvailable(stopBranch)){stopDialog.close();return}
  stopSubmitting=true;var branch=stopBranch;stopDialog.close();runAction("stop",branch);
});
document.getElementById("stop-cancel").addEventListener("click",function(){stopDialog.close()});
stopDialog.addEventListener("click",function(e){
  var rect=stopDialog.getBoundingClientRect();
  if(e.target===stopDialog&&(e.clientX<rect.left||e.clientX>rect.right||e.clientY<rect.top||e.clientY>rect.bottom))stopDialog.close();
});
stopDialog.addEventListener("close",function(){
  document.dispatchEvent(new CustomEvent("qa-modal",{detail:false}));
  var opener=stopOpener;
  var attr=confirmKind==="restart"?"data-restart":"data-stop",value=confirmKind==="restart"?restartService:stopBranch;
  if(!opener||!opener.isConnected||opener.disabled)opener=Array.from(document.querySelectorAll("["+attr+"]")).find(function(button){return button.getAttribute(attr)===value&&!button.disabled});
  if(!opener)opener=document.getElementById("settings-open");
  if(opener)opener.focus();
  stopOpener=null;
});
var recoveryRequest=false;
// Saved sessions from before the restart. wt decides which slots qualify (slots[].recovery); the page only lists them.
var recoveryBox=document.getElementById("recovery"),recoveryRows=document.getElementById("recovery-rows"),recoveryPicks={};
function recoveryCandidates(){return((data&&data.slots)||[]).filter(function(s){return s.recovery&&s.recovery.fingerprint}).sort(function(a,b){return a.slot-b.slot})}
function recoveryPairs(list){return list.map(function(s){return{slot:s.slot,fingerprint:s.recovery.fingerprint}})}
function recoveryRow(s){
  var apps=(s.apps||[]).map(function(a){return APP_NAMES[a.app]||a.app}).join(", ")||"no apps",leaf=s.worktree?String(s.worktree).replace(/\/+$/,"").split("/").pop():"",
    body='<span class="branch">'+esc(s.branch||"(no branch)")+'</span><span class="small">'+esc(apps)+'</span>'+(leaf?'<span class="small" title="'+esc(s.worktree)+'">'+esc(leaf)+'</span>':"");
  if(!s.recovery.resumable)return'<div class="recovery-row"><span class="recovery-pad"></span><div class="recovery-plain">'+body+'<span class="why">'+dot("warn")+" Can&rsquo;t resume: "+esc(s.recovery.reason||"not available")+'. Start fresh forgets it.</span></div></div>';
  var pick=recoveryPicks[s.slot];
  return'<div class="recovery-row"><input type="checkbox" id="recovery-pick-'+s.slot+'" data-slot="'+s.slot+'"'+(pick&&!pick.checked?"":" checked")+'><label for="recovery-pick-'+s.slot+'">'+body+'</label></div>';
}
function recoveryFocusKey(){
  var el=document.activeElement;
  if(!el||el===document.body||!recoveryBox.contains(el))return null;
  return el.id==="recovery-resume"||el.id==="recovery-fresh"?el.id:el.dataset&&el.dataset.slot?"pick:"+el.dataset.slot:"other";
}
function recoveryFocusTarget(key){
  var wanted=key&&key.indexOf("pick:")===0?document.getElementById("recovery-pick-"+key.slice(5)):key&&key.indexOf("recovery-")===0?document.getElementById(key):null;
  if(wanted&&!wanted.disabled&&!recoveryBox.hidden)return wanted;
  var first=!recoveryBox.hidden&&recoveryRows.querySelector("input:not(:disabled)");
  if(first)return first;
  var fresh=document.getElementById("recovery-fresh");
  if(!recoveryBox.hidden&&!fresh.disabled)return fresh;
  return document.getElementById("sessions-title");
}
function renderRecovery(){
  var list=recoveryCandidates(),focusKey=recoveryFocusKey();
  // A pick lasts while its record's fingerprint is unchanged; a changed or new record starts checked again.
  var kept={};
  list.forEach(function(s){var old=recoveryPicks[s.slot];kept[s.slot]=old&&old.fingerprint===s.recovery.fingerprint?old:{fingerprint:s.recovery.fingerprint,checked:true}});
  recoveryPicks=kept;
  recoveryBox.hidden=!list.length;
  // The rows are rebuilt only when what they show changes, so polling never costs a checkbox its keyboard focus.
  var rowsHtml=list.map(recoveryRow).join("");
  if(recoveryRows.__html!==rowsHtml){recoveryRows.__html=rowsHtml;recoveryRows.innerHTML=rowsHtml}
  updateRecoveryButtons(list);
  var status=document.getElementById("recovery-status"),a=currentAction(),line="",tone="";
  if(a&&(a.action==="resume"||a.action==="forget")){var l=actionLine(a);line=l.text+". Details are on the Backend card.";tone=l.tone}
  if(recoveryRequest&&actionError){line=actionError;tone="down"}
  status.hidden=!line;setHtml(status,line?dot(tone)+esc(line):"");
  if(focusKey){
    var cur=document.activeElement;
    if(!cur||!recoveryBox.contains(cur)||cur.disabled||recoveryBox.hidden){var target=recoveryFocusTarget(focusKey);if(target)target.focus()}
  }
}
function checkedRecovery(list){return list.filter(function(s){return s.recovery.resumable&&recoveryPicks[s.slot]&&recoveryPicks[s.slot].checked})}
function updateRecoveryButtons(list){
  var resume=document.getElementById("recovery-resume"),fresh=document.getElementById("recovery-fresh"),n=checkedRecovery(list).length;
  resume.disabled=isRunning()||!n;fresh.disabled=isRunning()||!list.length;
  resume.setAttribute("aria-label",n?"Resume "+n+" session"+(n===1?"":"s"):"Resume sessions");
}
function runRecovery(action,pairs){
  actionError=null;recoveryRequest=true;
  outputOpen=false;
  var before=data&&data.actions;
  if(data){data.actions={action:action,target:null,state:"running",startedAt:new Date().toISOString(),output:[]};render()}
  fetch("/api/recovery/"+action,{method:"POST",headers:{"X-QA-Dashboard":"1","Content-Type":"application/json"},body:JSON.stringify({slots:pairs}),cache:"no-store"}).then(function(r){
    return r.json().then(function(j){
      if(data)data.actions=j.actions||before;
      if(!r.ok)actionError=j.error||("HTTP "+r.status);
      render();schedule(r.ok?1000:0);
    });
  }).catch(function(e){if(data)data.actions=before;actionError=e.message;render();schedule(1000)});
}
recoveryRows.addEventListener("change",function(e){
  var box=e.target;if(!box.dataset||!box.dataset.slot)return;
  var pick=recoveryPicks[box.dataset.slot];if(pick)pick.checked=box.checked;
  updateRecoveryButtons(recoveryCandidates());
});
document.getElementById("recovery-resume").addEventListener("click",function(){
  if(isRunning())return;
  var pairs=recoveryPairs(checkedRecovery(recoveryCandidates()));
  if(pairs.length)runRecovery("resume",pairs);
});
// One click forgets every listed saved session; the server re-checks each fingerprint and refuses any that changed.
document.getElementById("recovery-fresh").addEventListener("click",function(){
  var list=recoveryCandidates();
  if(isRunning()||!list.length)return;
  runRecovery("forget",recoveryPairs(list));
});
document.addEventListener("click",function(e){
  var t=e.target.closest("[data-action],[data-copy],[data-copy-output],[data-toggle],[data-stop],[data-restart],[data-output],[data-radio]");
  if(!t||t.disabled)return;
  if(t.hasAttribute("data-radio")){
    var messages=radioMessages(data,failure,actionError),step=t.dataset.radio==="prev"?-1:1;
    if(messages.length>1){var index=messages.findIndex(function(message){return message.key===radioView.key});radioView={key:messages[(index+step+messages.length)%messages.length].key,index:(index+step+messages.length)%messages.length};renderRadio()}
  }
  else if(t.hasAttribute("data-toggle")){
    var healthy=!data||!data.backend||backendHealthy(data.backend);
    detailsChoice={healthy:healthy,open:!detailsOpen(healthy)};
    try{sessionStorage.setItem("qaDashboardBackendDetails",JSON.stringify(detailsChoice))}catch(e){}
    render();var again=document.querySelector("[data-toggle]");if(again){again.classList.add("turned");again.focus()}
  }
  else if(t.hasAttribute("data-copy"))copyText(t.getAttribute("data-copy"),t);
  else if(t.hasAttribute("data-copy-output"))copyText((currentAction()&&currentAction().output||[]).join("\n"),t);
  else if(t.hasAttribute("data-stop")){
    var branch=t.getAttribute("data-stop");
    confirmStop(branch,t);
  }
  else if(t.hasAttribute("data-restart"))confirmRestart(t.getAttribute("data-restart"),t);
  else if(t.hasAttribute("data-output")){
    outputOpen=!outputOpen;
    render();var again=document.querySelector("[data-output]");if(again){again.classList.add("turned");again.focus()}
  }
  else runAction(t.getAttribute("data-action"));
});
// The log node stays in place across output-only polls. When another field rebuilds the card, keep its scroll position;
// follow new lines only when the reader was already at the bottom.
function updateInlineOutput(previous){
  var log=document.getElementById("action-output"),a=currentAction();
  if(!log||!a)return;
  var text=(a.output||[]).join("\n"),position=previous||(!log.hidden?{top:log.scrollTop,left:log.scrollLeft,follow:log.scrollHeight-log.scrollTop-log.clientHeight<4}:null);
  if(log.textContent!==text)log.textContent=text;
  if(position){log.scrollTop=position.follow?log.scrollHeight:position.top;log.scrollLeft=position.left}
}
// With no real snapshot, or one that says nothing known, the health is unknown, not healthy; a failed poll keeps what the last snapshot showed.
function pageHealth(){
  if(!data)return"unknown";
  var tones=[],backend=data.backend;
  if(backend)tones.push(backendTone(backend));
  (data.slots||[]).forEach(function(slot){(slot.apps||[]).forEach(function(a){tones.push(appStatus(a).tone)})});
  var worst=worstTone(tones);
  return worst==="unknown"?"unknown":worst==="broken"||worst==="attn"?"bad":worst==="down"?"down":worst==="warn"?"warn":"ok";
}
var reducedMotion=window.matchMedia("(prefers-reduced-motion: reduce)"),faviconTimer=null,faviconDim=false;
function updateFavicon(){
  var state=pageHealth(),alternate=state==="bad"&&!reducedMotion.matches&&!(document.visibilityState==="visible"&&document.hasFocus());
  if(alternate&&!faviconTimer)faviconTimer=setInterval(function(){faviconDim=!faviconDim;QA_THEME.favicon(faviconDim?"badDim":"bad")},1000);
  if(!alternate&&faviconTimer){clearInterval(faviconTimer);faviconTimer=null;faviconDim=false}
  if(!faviconTimer)QA_THEME.favicon(state);
}
window.addEventListener("focus",updateFavicon);window.addEventListener("blur",updateFavicon);
document.addEventListener("visibilitychange",updateFavicon);
// The seep hover lets one drop fall per pill or button (with a cooldown), and a press spatters a few drops; the pupil in the hover glyph follows the cursor.
(function pillLife(){
  // FX_HOVER bookkeeping (see settleUnderPointer): where the pointer is and which pill or button it is over.
  // A rebuild makes the browser send a synthetic pointerover that can land on the card behind the new button for a moment; judge by position.
  function pointerInside(element,e){var r=element.getBoundingClientRect();return e.clientX>=r.left&&e.clientX<=r.right&&e.clientY>=r.top&&e.clientY<=r.bottom}
  document.addEventListener("pointerover",function(e){
    var target=e.target.closest&&e.target.closest(FX_TARGETS);
    FX_HOVER.over=target||null;FX_HOVER.x=e.clientX;FX_HOVER.y=e.clientY;FX_HOVER.inside=true;
    FX_HOVER.settled=FX_HOVER.settled.filter(function(element){if(element.isConnected&&(element.contains(e.target)||pointerInside(element,e)))return true;element.classList.remove("fx-settled");return false});
  });
  document.addEventListener("pointermove",function(e){FX_HOVER.x=e.clientX;FX_HOVER.y=e.clientY;FX_HOVER.inside=true},{passive:true});
  document.addEventListener("pointerout",function(e){
    if(e.relatedTarget)return;
    FX_HOVER.inside=false;FX_HOVER.over=null;
    FX_HOVER.settled.forEach(function(element){element.classList.remove("fx-settled")});FX_HOVER.settled=[];
  });
  document.addEventListener("pointerover",function(e){
    var pill=e.target.closest&&e.target.closest("a.app-pill,"+FX_BUTTONS);
    if(!pill||pill.contains(e.relatedTarget)||reducedMotion.matches||pill.disabled)return;
    var drip=pill.querySelector(":scope > .pill-drip"),now=Date.now();
    if(!drip||now-(+pill.dataset.dripAt||0)<2500)return;
    pill.dataset.dripAt=now;drip.classList.remove("falling");void drip.offsetWidth;drip.classList.add("falling");
  });
  document.addEventListener("pointermove",function(e){
    var pill=e.target.closest&&e.target.closest("a.app-pill"),pupil=pill&&pill.querySelector(".fx-text .glyph-pupil");
    if(!pupil)return;
    var rect=pupil.ownerSVGElement.getBoundingClientRect(),dx=e.clientX-(rect.left+rect.width/2),dy=e.clientY-(rect.top+rect.height/2),d=Math.hypot(dx,dy)||1,reach=Math.min(1,d/60);
    pupil.setAttribute("transform","translate("+(dx/d*2*reach).toFixed(2)+" "+(dy/d*1.2*reach).toFixed(2)+")");
  },{passive:true});
  document.addEventListener("pointerdown",function(e){
    var pill=e.target.closest&&e.target.closest("a.app-pill");
    if(!pill||reducedMotion.matches||!pill.querySelector(".pill-drip"))return;
    // Only the seep hover spatters on press.
    for(var k=0;k<3;k++){
      var dot=document.createElement("span"),angle=Math.random()*Math.PI*2;
      dot.className="pill-splat";dot.style.left=(10+Math.random()*80)+"%";dot.style.top=(Math.random()<0.5?"-2px":"calc(100% - 1px)");
      dot.style.setProperty("--dx",(Math.cos(angle)*9).toFixed(1)+"px");dot.style.setProperty("--dy",(Math.sin(angle)*6).toFixed(1)+"px");
      dot.addEventListener("animationend",function(){this.remove()});pill.appendChild(dot);
    }
  });
})();
// Settings shows only real choices: a row whose select or radio group offers fewer than two values is hidden (Layout, while
// Radio is behind its flag). Runs whenever a picker's options are rebuilt and when the dialog opens.
function hideSingleChoiceRows(){
  Array.prototype.forEach.call(document.querySelectorAll("#settings .settings-row"),function(row){
    var select=row.querySelector("select"),radios=row.querySelectorAll('input[type="radio"]');
    var choices=select?select.options.length:radios.length?radios.length:2;
    row.hidden=choices<2;
  });
}
(function settingsDialog(){
  var dialog=document.getElementById("settings"),trigger=document.getElementById("settings-open");
  if(!dialog||!trigger||!dialog.showModal)return;
  trigger.addEventListener("click",function(){hideSingleChoiceRows();dialog.showModal();document.dispatchEvent(new CustomEvent("qa-modal",{detail:true}));if(window.QA_BRUSH)QA_BRUSH.dialogTitle();tenantInput.focus()});
  dialog.addEventListener("close",function(){document.dispatchEvent(new CustomEvent("qa-modal",{detail:false}));trigger.focus()});
  dialog.addEventListener("click",function(e){
    var rect=dialog.getBoundingClientRect();
    if(e.target===dialog&&(e.clientX<rect.left||e.clientX>rect.right||e.clientY<rect.top||e.clientY>rect.bottom))dialog.close();
  });
})();
tenantInput.addEventListener("input",function(){
  try{localStorage.setItem("qaDashboardTenant",tenantInput.value)}catch(e){}
  render();
});
var justFinished=false;
function schedule(ms){if(INITIAL)return;clearTimeout(pollTimer);pollTimer=setTimeout(poll,ms)}
// Only a snapshot with the expected shape replaces the last good data; anything else is a failed poll.
// It checks only the containers render() walks (slots, their apps, backend services, action output); unknown or missing fields are fine.
function plainObject(v){return!!v&&typeof v==="object"&&!Array.isArray(v)}
function validSnapshot(j){
  if(!plainObject(j)||!Array.isArray(j.slots)||!plainObject(j.backend))return false;
  var services=j.backend.services,actions=j.actions;
  if(services!=null&&(!plainObject(services)||!Object.keys(services).every(function(n){return plainObject(services[n])})))return false;
  if(actions!=null&&(!plainObject(actions)||(actions.output!=null&&!Array.isArray(actions.output))))return false;
  return j.slots.every(function(s){
    return plainObject(s)&&(s.apps==null||Array.isArray(s.apps)&&s.apps.every(function(a){return plainObject(a)&&(a.url==null||typeof a.url==="string")}));
  });
}
function poll(){
  return fetch("/api/status",{cache:"no-store"}).then(function(r){
    return r.json().catch(function(){return null}).then(function(j){
      if(!r.ok||(j&&j.error))throw new Error((j&&j.error)||("HTTP "+r.status));
      if(!validSnapshot(j))throw new Error("Unreadable status response");
      return j;
    });
  }).then(function(j){var wasRunning=isRunning();data=j;lastOk=new Date();failure=null;render();justFinished=wasRunning&&!isRunning()})
    .catch(function(e){failure=e.message;render()})
    .then(function(){schedule(isRunning()?1000:justFinished?1200:5000);justFinished=false});
}
// Only text that actually changed is written, so an idle second touches no layout.
setInterval(function(){if(document.hidden)return;setText(document.getElementById("updated"),updatedText());updateAgo()},1000);
if(INITIAL){data=INITIAL;lastOk=INITIAL.generatedAt?new Date(INITIAL.generatedAt):null}
render();buttonFx(document);
if(!INITIAL)poll();
// Procedural brushstrokes for underlines and drip accents; parameters come from the theme's brushStroke config.
var QA_BRUSH=(function(){
  var salt=(Math.random()*4294967296)>>>0;
  var reducedMotion=window.matchMedia("(prefers-reduced-motion: reduce)");
  function random(seed){return function(){seed=seed+0x6D2B79F5|0;var t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
  function smoothNoise(next,knots){
    var values=[];for(var i=0;i<=knots;i++)values.push(next());
    return function(u){var x=Math.max(0,Math.min(0.9999,u))*knots,i=Math.floor(x),f=x-i,s=(1-Math.cos(f*Math.PI))/2;return values[i]*(1-s)+values[i+1]*s};
  }
  function jitter(next,value){return value*(0.85+0.3*next())}
  function fixed(n){return n.toFixed(2)}
  // Blocks: a row of pixel blocks with seeded gaps and the odd light-shade block, like a line of block characters.
  function blocks(width,seed,opts,colors,height,baseline){
    var next=random(seed),size=opts.block||4,step=size+(opts.gap||1),out=[],end=width-next()*step*2;
    for(var x=next()*step;x+size<=end;x+=step){
      var roll=next();if(roll<(opts.drop||0))continue;
      var light=roll>1-(opts.light||0),lift=next()<0.06?-1:0;
      out.push('<rect x="'+fixed(x)+'" y="'+fixed(baseline-size/2+lift)+'" width="'+fixed(size)+'" height="'+fixed(size)+'" style="fill:'+(light?colors.edge:colors.core)+'"'+(light?' fill-opacity=".55"':"")+'/>');
    }
    return'<svg class="brush" viewBox="0 0 '+fixed(width)+" "+height+'" width="'+fixed(width)+'" height="'+height+'" shape-rendering="crispEdges" aria-hidden="true"><g opacity="'+(opts.opacity==null?1:opts.opacity)+'">'+out.join("")+"</g></svg>";
  }
  function svg(width,seed,scale,presetName){
    var config=QA_THEME.current().brushStroke;
    if(!config)return"";
    // A preset can carry its own colours.
    var next=random(seed),names=Object.keys(config.presets),pick=names[Math.floor(next()*names.length)],preset=config.presets[presetName]||config.presets[pick];
    var colors=preset.colors||config.colors,overprint=preset.overprint||config.overprint;
    if(preset.style==="blocks")return blocks(width,seed,preset,colors,Math.ceil((preset.block||4)*(scale||1)+4),Math.ceil((preset.block||4)*(scale||1)/2+2));
    var k=scale||1,weight=jitter(next,preset.weight)*k,dripLength=jitter(next,preset.dripLength)*k,wobble=jitter(next,preset.wobble)*k;
    var taperIn=jitter(next,preset.taperIn),taperOut=jitter(next,preset.taperOut),height=Math.ceil(weight+dripLength+6*k);
    var pressureA=smoothNoise(next,3),pressureB=smoothNoise(next,7),drift=smoothNoise(next,5),slope=Math.tan((next()*3-1.5)*Math.PI/180);
    var start=next()*2*k,end=width-(1+next()*3)*k,baseY=weight/2+1.5*k,samples=48,top=[],bottom=[],coreTop=[],coreBottom=[],centre=[],thickness=[];
    for(var i=0;i<=samples;i++){
      var u=i/samples,x=start+(end-start)*u;
      var w=weight*(0.42+0.9*pressureA(u)+0.32*(pressureB(u)-0.5))*Math.pow(Math.min(1,u/taperIn),0.6)*Math.pow(Math.min(1,(1-u)/taperOut),0.85);
      var y=baseY+slope*(x-width/2)+wobble*(drift(u)-0.5);
      centre.push([x,y]);thickness.push(w);
      top.push(fixed(x)+" "+fixed(y-w/2));bottom.unshift(fixed(x)+" "+fixed(y+w/2));
      coreTop.push(fixed(x)+" "+fixed(y-w*0.3));coreBottom.unshift(fixed(x)+" "+fixed(y+w*0.3));
    }
    var edge='style="fill:'+colors.edge+'"',core='style="fill:'+colors.core+'"',out=[];
    out.push('<path '+edge+' d="M'+top.join("L")+"L"+bottom.join("L")+'Z"/>');
    out.push('<path '+core+' d="M'+coreTop.join("L")+"L"+coreBottom.join("L")+'Z"/>');
    function at(u){var i=Math.round(Math.max(0,Math.min(1,u))*samples);return{x:centre[i][0],y:centre[i][1],w:thickness[i]}}
    for(var b=0;b<preset.bristles;b++){
      var offset=(b-(preset.bristles-1)/2)*0.32,line=[];
      for(var s=0.15;s<=0.78;s+=0.07){var p=at(s);line.push(fixed(p.x)+" "+fixed(p.y+offset*p.w))}
      out.push('<path style="stroke:'+colors.edge+'" fill="none" stroke-opacity=".45" stroke-width="'+fixed(0.45*k)+'" d="M'+line.join("L")+'"/>');
    }
    var dry=Math.round(jitter(next,preset.dryEnd));
    for(var d=0;d<dry;d++){
      var from=at(0.74+next()*0.06),reach=end+(next()*5-1)*k,dy=(d-(dry-1)/2)*weight*0.32+(next()-0.5)*k;
      out.push('<path style="stroke:'+colors.core+'" fill="none" stroke-linecap="round" stroke-width="'+fixed((0.5+next()*0.6)*k)+'" stroke-dasharray="'+fixed((3+next()*6)*k)+" "+fixed((0.8+next()*1.6)*k)+'" d="M'+fixed(from.x)+" "+fixed(from.y+dy)+"L"+fixed(reach)+" "+fixed(from.y+dy+slope*(reach-from.x)+(next()-0.5)*k)+'"/>');
    }
    if(next()<preset.hook){
      var tail=at(0.97);
      out.push('<path style="stroke:'+colors.core+'" fill="none" stroke-linecap="round" stroke-width="'+fixed(1.2*k)+'" d="M'+fixed(tail.x)+" "+fixed(tail.y)+"Q"+fixed(tail.x+3.5*k)+" "+fixed(tail.y-0.5*k)+" "+fixed(tail.x+2.2*k)+" "+fixed(tail.y-3*k)+'"/>');
    }
    var drips=preset.drips[0]+Math.floor(next()*(preset.drips[1]-preset.drips[0]+1));
    for(var j=0;j<drips;j++){
      var anchor=at(0.15+next()*0.62),length=(2*k+Math.pow(next(),1.6)*dripLength),dw=(1.1+next()*1.1)*k,y0=anchor.y+anchor.w*0.35;
      out.push('<path '+core+' d="M'+fixed(anchor.x-dw/2)+" "+fixed(y0)+"L"+fixed(anchor.x-dw*0.32)+" "+fixed(y0+length)+"L"+fixed(anchor.x+dw*0.32)+" "+fixed(y0+length)+"L"+fixed(anchor.x+dw/2)+" "+fixed(y0)+'Z"/>');
      if(next()<0.65)out.push('<circle '+core+' cx="'+fixed(anchor.x)+'" cy="'+fixed(y0+length)+'" r="'+fixed(dw*0.72)+'"/>');
    }
    var spatter=preset.spatter[0]+Math.floor(next()*(preset.spatter[1]-preset.spatter[0]+1));
    for(var m=0;m<spatter;m++){
      var nearEnd=next()<0.6,sx=nearEnd?end-next()*10*k+2*k:start+next()*8*k,sy=baseY+(next()*2-1)*5*k;
      out.push('<circle '+(next()<0.5?core:edge)+' cx="'+fixed(sx)+'" cy="'+fixed(Math.max(0.6,sy))+'" r="'+fixed((0.35+next()*0.5)*k)+'"/>');
    }
    var ink=out.join("");
    // A second ink prints the same stroke slightly off register, underneath the first.
    if(overprint)ink='<g transform="translate('+fixed(overprint.dx*k)+" "+fixed(overprint.dy*k)+')" opacity="'+(overprint.opacity==null?1:overprint.opacity)+'">'+ink.split(colors.core).join(overprint.color).split(colors.edge).join(overprint.color)+"</g>"+ink;
    return'<svg class="brush" viewBox="0 '+fixed(-3*k)+" "+fixed(width+6*k)+" "+fixed(height+3*k)+'" width="'+fixed(width+6*k)+'" height="'+fixed(height+3*k)+'" aria-hidden="true">'+ink+"</svg>";
  }
  function paint(host,width,seed,scale,animate,presetName){
    var old=host.querySelector(":scope > .brush");
    if(old)old.remove();
    host.insertAdjacentHTML("beforeend",svg(width,seed,scale,presetName));
    var brush=host.querySelector(":scope > .brush");
    if(brush&&animate&&!reducedMotion.matches){brush.classList.add("fresh");brush.addEventListener("animationend",function(){brush.classList.remove("fresh")},{once:true})}
    return brush;
  }
  function wordmark(){
    var mark=document.querySelector(".mark"),theme=QA_THEME.current();
    if(!mark)return;
    // A theme whose character already drips over the wordmark can skip the underline (wordmarkStroke: false); a character that
    // owns the floor under the wordmark (stage.wordmarkFloor) always does, so there is never a second line.
    if(!theme.brushStroke||theme.wordmarkStroke===false||(QA_THEME.character().stage||{}).wordmarkFloor){mark.classList.remove("has-brush");Array.prototype.forEach.call(mark.querySelectorAll(".brush"),function(b){b.remove()});return}
    mark.classList.add("has-brush");
    paint(mark,mark.getBoundingClientRect().width||110,(Math.random()*4294967296)>>>0,1,true);
  }
  function decorate(root){
    if(!QA_THEME.current().brushStroke)return;
    (root||document).querySelectorAll(".branch").forEach(function(branch){
      var name=branch.textContent;
      if(branch.dataset.brushFor===name&&branch.querySelector(":scope > .brush"))return;
      branch.dataset.brushFor=name;branch.classList.add("has-brush");
      paint(branch,Math.min(branch.getBoundingClientRect().width||120,200),hashText(name)^salt,0.7,false);
    });
  }
  function dialogTitle(){
    var title=document.getElementById("settings-title");
    if(!title||!QA_THEME.current().brushStroke)return;
    title.classList.add("has-brush");
    paint(title,96,(Math.random()*4294967296)>>>0,0.85,true);
  }
  return{svg:svg,paint:paint,wordmark:wordmark,decorate:decorate,dialogTitle:dialogTitle,hashText:hashText,salt:salt};
})();
// Shared eye engine: theme-agnostic; art, palette and modes come from the active theme.
// Test aids: ?frame=<seconds> freezes time, ?eye=<mode> picks a mode, ?pointer=<x>,<y> fakes the cursor.
(function eyes(){
  var query=new URLSearchParams(location.search);
  var frozen=parseFloat(query.get("frame")),isFrozen=!isNaN(frozen);
  var reduced=window.matchMedia("(prefers-reduced-motion: reduce)");
  var scheme=window.matchMedia("(prefers-color-scheme: dark)");
  var pointer={x:0,y:0,vx:0,vy:0,movedAt:-1e9,known:false};
  function clock(){return performance.now()}
  function mulberry(seed){return function(){seed=seed+0x6D2B79F5|0;var t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
  function findAt(starts,t){
    if(!starts.length||t<starts[0])return-1;
    var low=0,high=starts.length-1;
    while(low<high){var mid=(low+high+1)>>1;if(starts[mid]<=t)low=mid;else high=mid-1}
    return low;
  }
  function track(x,y){
    var now=clock(),elapsed=Math.max(1,now-pointer.movedAt);
    if(pointer.known&&elapsed<200){pointer.vx=(x-pointer.x)/elapsed;pointer.vy=(y-pointer.y)/elapsed}else{pointer.vx=pointer.vy=0}
    pointer.x=x;pointer.y=y;pointer.movedAt=now;pointer.known=true;
  }
  document.addEventListener("pointermove",function(e){if(e.pointerType!=="touch")track(e.clientX,e.clientY)},{passive:true});
  document.addEventListener("pointerdown",function(e){if(e.pointerType==="touch")track(e.clientX,e.clientY)},{passive:true});
  var fakePointer=query.get("pointer");
  if(fakePointer){var parts=fakePointer.split(",");pointer.x=+parts[0];pointer.y=+parts[1];pointer.known=true;pointer.movedAt=1e15}

  /* ---------- halftone grid engine ---------- */
  // The grid is laid out per character (its stage: canvas size, dot pitch and where logo unit 32 sits); layout() reallocates it.
  var canvas=document.getElementById("eye"),ctx=canvas.getContext("2d");
  var W=200,H=230,PITCH=4.5,SIZE=200,RES=512,SCALE=SIZE/64,CENTER_Y=92,FPS=12,LIGHT_FPS=24;
  var BAYER=[0,8,2,10,12,4,14,6,3,11,1,9,15,7,13,5];
  var cols=0,rows=0,count=0,offsetX=0,offsetY=0;
  var engine={veinPaths:[],veins:null,source:null,anatomy:null,track:{active:false,lastMoveAt:-1e9},inks:[[]],fps:FPS,status:window.QA_ROLLUP||"unknown"};
  var dotShade,dotRadius,drawnShade,drawnRadius,drawnBack,dotOrder,shadeStart=new Uint16Array(41),bucketCounts=new Uint16Array(40),forceDraw=true;
  // Floor under the wordmark (stage.wordmarkFloor): the pool spans the wordmark's own width, and the canvas hangs below the text
  // by --stage-room so nothing clips (the CRT screen clips at its edge). Measured on load, theme, character, scene, resize and
  // when fonts arrive; a change redraws the still frame once. Nothing here runs per frame.
  var floorKey="";
  function fitFloor(){
    var stage=QA_THEME.character().stage||{},title=document.querySelector(".masthead-title"),mark=document.querySelector(".mark");
    if(!stage.wordmarkFloor||!title||!mark){engine.floor=null;return}
    var c=canvas.getBoundingClientRect(),m=mark.getBoundingClientRect();
    if(!c.width||!m.width||!cols)return;
    var c0=Math.max(1,Math.ceil((m.left-c.left-offsetX)/PITCH)),c1=Math.min(cols-2,Math.floor((m.right-c.left-offsetX)/PITCH));
    if(c1<=c0)return;
    var room=Math.max(0,Math.round((stage.overlap||0)-title.getBoundingClientRect().height-(parseFloat(getComputedStyle(title).marginTop)||0))),key=c0+","+c1+","+room;
    if(key===floorKey)return;
    floorKey=key;engine.floor={c0:c0,c1:c1};
    document.documentElement.style.setProperty("--stage-room",room+"px");
    forceDraw=true;if(ready&&!running)update(true);
  }
  function layout(character){
    var stage=character.stage||{};
    W=stage.width||200;H=stage.height||230;PITCH=stage.pitch||4.5;SIZE=stage.size||W;CENTER_Y=stage.centerY!=null?stage.centerY:H/2;SCALE=SIZE/64;
    cols=Math.floor(W/PITCH)+1;rows=Math.floor(H/PITCH)+1;count=cols*rows;
    offsetX=(W-(cols-1)*PITCH)/2;offsetY=(H-(rows-1)*PITCH)/2;
    engine.cols=cols;engine.rows=rows;engine.count=count;engine.pitch=PITCH;engine.poolRow=rows-3;engine.floor=null;floorKey="";
    ["dotX","dotY","intensity","radiusScale","alpha","normalX","normalY","normalZ","angle"].forEach(function(name){engine[name]=new Float32Array(count)});
    ["hash","ink","back","dropout","inIris","edgeIn","edgeOut"].forEach(function(name){engine[name]=new Uint8Array(count)});
    for(var cell=0;cell<count;cell++){
      engine.dotX[cell]=offsetX+(cell%cols)*PITCH;engine.dotY[cell]=offsetY+Math.floor(cell/cols)*PITCH;
      engine.hash[cell]=(Math.imul(cell+1,2654435761)>>>24)&255;
    }
    dotShade=new Int8Array(count);dotRadius=new Uint8Array(count);drawnShade=new Int8Array(count);drawnRadius=new Uint8Array(count);drawnBack=new Uint8Array(count);dotOrder=new Uint16Array(count);
    forceDraw=true;
  }
  engine.colOf=function(u){return Math.round(((u-32)*SCALE+W/2-offsetX)/PITCH)};
  engine.rowOf=function(v){return Math.round(((v-32)*SCALE+CENTER_Y-offsetY)/PITCH)};
  engine.px=function(u){return(u-32)*SCALE+W/2};
  engine.py=function(v){return(v-32)*SCALE+CENTER_Y};
  // put raises a cell (the brighter mark wins); set overwrites it. ink picks the ramp: 0 is the palette, 1.. the theme's inks.
  engine.put=function(col,row,value,ink){
    if(col<0||row<0||col>=cols||row>=rows)return;
    var index=row*cols+col;
    if(value>engine.intensity[index]){engine.intensity[index]=value;engine.ink[index]=ink||0}
  };
  engine.set=function(col,row,value,ink){
    if(col<0||row<0||col>=cols||row>=rows)return;
    var index=row*cols+col;engine.intensity[index]=value;engine.ink[index]=ink||0;
  };
  // For custom renderers: the cursor's offset in CSS px while tracking, else null.
  // The result is one reused mutable sample; consume it immediately and do not retain it.
  var aimResult={dx:0,dy:0,distance:0};
  engine.aim=function(col,row){
    if(!engine.track.active||!pointer.known)return null;
    var rect=canvas.getBoundingClientRect(),dx=pointer.x-(rect.left+engine.dotX[0]+col*PITCH),dy=pointer.y-(rect.top+engine.dotY[0]+row*PITCH);
    aimResult.dx=dx;aimResult.dy=dy;aimResult.distance=Math.hypot(dx,dy);return aimResult;
  };
  engine.random=function(seed){return mulberry(seed)};
  engine.reduced=function(){return reduced.matches};
  // Grid-snapped ellipse: radii in whole cells, so every shape is a deliberate pixel pattern.
  engine.stamp=function(col,row,radiusX,radiusY,peak){
    for(var dr=-radiusY;dr<=radiusY;dr++)for(var dc=-radiusX;dc<=radiusX;dc++){
      var qx=radiusX?dc/radiusX:0,qy=radiusY?dr/radiusY:0,q=qx*qx+qy*qy;
      if(q<=1)engine.put(col+dc,row+dr,peak*(1-0.3*q));
    }
  };
  // Teardrops hang from their top row; dimmer corner cells round the halftone silhouette.
  var DROP_SHAPES=[
    [[0,1,0]],
    [[0,1,0],[0.55,1,0.55],[0.45,0.9,0.45]],
    [[0,1,0],[0.4,1,0.4],[0.85,1,0.85],[0.55,1,0.55],[0,0.7,0]],
    [[0,1,0],[0,1,0],[0.5,1,0.5],[0.8,1,0.8],[0.35,0.9,0.35],[0,0.5,0]]
  ];
  engine.drop=function(col,top,size,peak){
    var shape=DROP_SHAPES[size];
    for(var r=0;r<shape.length;r++)for(var c=0;c<3;c++)if(shape[r][c])engine.put(col+c-1,top+r,peak*shape[r][c]);
  };
  function blurField(values,radius){
    var temp=new Float32Array(values.length),out=new Float32Array(values.length),x,y,sum,span=2*radius+1;
    for(y=0;y<RES;y++){sum=0;for(x=-radius;x<RES+radius;x++){
      if(x+radius<RES)sum+=values[y*RES+x+radius];if(x-radius-1>=0)sum-=values[y*RES+x-radius-1];
      if(x>=0&&x<RES)temp[y*RES+x]=sum/span}}
    for(x=0;x<RES;x++){sum=0;for(y=-radius;y<RES+radius;y++){
      if(y+radius<RES)sum+=temp[(y+radius)*RES+x];if(y-radius-1>=0)sum-=temp[(y-radius-1)*RES+x];
      if(y>=0&&y<RES)out[y*RES+x]=sum/span}}
    return out;
  }
  function buildSource(image){
    var off=document.createElement("canvas");off.width=off.height=RES;
    var octx=off.getContext("2d");if(image)octx.drawImage(image,0,0,RES,RES);
    var pixels=octx.getImageData(0,0,RES,RES).data,total=RES*RES,alpha=new Float32Array(total),i;
    for(i=0;i<total;i++)alpha[i]=pixels[i*4+3]/255;
    var soft=blurField(blurField(alpha,4),4),normalX=new Float32Array(total),normalY=new Float32Array(total),normalZ=new Float32Array(total);
    for(i=0;i<total;i++){
      var col=i%RES,row=(i/RES)|0;
      if(col<1||row<1||col>=RES-1||row>=RES-1){normalZ[i]=1;continue}
      var gx=(soft[i+1]-soft[i-1])*9,gy=(soft[i+RES]-soft[i-RES])*9,length=Math.hypot(gx,gy,1);
      normalX[i]=-gx/length;normalY[i]=-gy/length;normalZ[i]=1/length;
    }
    engine.source={alpha:alpha,soft:soft,normalX:normalX,normalY:normalY,normalZ:normalZ};
    var anatomy=engine.anatomy=QA_THEME.character().anatomy||null;
    for(i=0;i<count;i++){
      var sx=Math.floor((engine.dotX[i]-W/2)*RES/SIZE+RES/2),sy=Math.floor((engine.dotY[i]-CENTER_Y)*RES/SIZE+RES/2),index=sy*RES+sx;
      var inside=sx>=0&&sy>=0&&sx<RES&&sy<RES;
      engine.alpha[i]=inside?alpha[index]:0;
      engine.normalX[i]=inside?normalX[index]:0;engine.normalY[i]=inside?normalY[index]:0;engine.normalZ[i]=inside?normalZ[index]:1;
      engine.dropout[i]=inside&&soft[index]>0.12&&soft[index]<0.86&&engine.hash[i]<64?1:0;
      var u=(engine.dotX[i]-W/2)/SCALE+32,v=(engine.dotY[i]-CENTER_Y)/SCALE+32;
      engine.inIris[i]=anatomy&&Math.hypot(u-anatomy.iris[0],v-anatomy.iris[1])<anatomy.iris[2]+0.4?1:0;
    }
    classifyEdges();
  }
  function classifyEdges(){
    var anatomy=engine.anatomy,centerU=anatomy?anatomy.iris[0]:32,centerV=anatomy?anatomy.iris[1]:30,i;
    for(i=0;i<count;i++){
      var col=i%cols,row=(i/cols)|0,lit=engine.alpha[i]>0.3,u=(engine.dotX[i]-W/2)/SCALE+32,v=(engine.dotY[i]-CENTER_Y)/SCALE+32;
      var distance=Math.hypot(u-centerU,v-centerV);
      // The pupil edge belongs to the moving pupil, so only the outer iris rim may wobble.
      var core=anatomy&&distance<anatomy.iris[2]-1.5;
      var litNeighbour=false,darkNeighbour=false;
      [[1,0],[-1,0],[0,1],[0,-1]].forEach(function(step){
        var c=col+step[0],r=row+step[1],neighbourLit=c>=0&&r>=0&&c<cols&&r<rows&&engine.alpha[r*cols+c]>0.3;
        if(neighbourLit)litNeighbour=true;else darkNeighbour=true;
      });
      engine.edgeIn[i]=!core&&lit&&darkNeighbour?1:0;
      engine.edgeOut[i]=!core&&!lit&&litNeighbour?1:0;
      engine.angle[i]=Math.atan2(v-centerV,u-centerU);
    }
    engine.veinPaths=[veinPath(-1,-1),veinPath(-1,1),veinPath(1,-1),veinPath(1,1)];
    engine.veins=schedules(71,4,[6,12],function(random){return{path:Math.floor(random()*4),length:3+Math.floor(random()*4)}});
  }
  // A vein starts at a lid corner and creeps inward along lit lid cells, preferring the upper or lower lid.
  function veinPath(side,vertical){
    var best=-1,path=[],visited={};
    for(var i=0;i<count;i++){
      if(engine.alpha[i]<=0.3||engine.inIris[i])continue;
      if(best<0||(side<0?engine.dotX[i]<engine.dotX[best]:engine.dotX[i]>engine.dotX[best]))best=i;
    }
    for(var stepCount=0;best>=0&&stepCount<8;stepCount++){
      path.push(best);visited[best]=true;
      var col=best%cols,row=(best/cols)|0,next=-1,score=-1e9;
      for(var dr=-1;dr<=1;dr++)for(var dc=-1;dc<=1;dc++){
        var c=col+dc,r=row+dr,index=r*cols+c;
        if(!(dc||dr)||c<0||r<0||c>=cols||r>=rows||visited[index]||engine.alpha[index]<=0.3||engine.inIris[index])continue;
        var gain=-side*dc*2+vertical*dr;
        if(gain>score){score=gain;next=index}
      }
      best=next;
    }
    return path;
  }
  // Edge life and veins; runs on the emblem before blood is drawn. Nothing here grows and shrinks on a regular beat.
  engine.living=function(t,edges){
    if(reduced.matches&&isNaN(frozen))return;
    var step=Math.floor(t*FPS)/FPS;
    // The lobes travel around the rim at an uneven, never-repeating pace; the speed stays positive so they only ever drift forward.
    var crawlA=1.2*step+1.4*Math.sin(step*0.41)+0.9*Math.sin(step*0.157+1.3),crawlB=0.85*step+1.1*Math.sin(step*0.29+0.5)+0.7*Math.sin(step*0.083+2.1),intensity=engine.intensity,radius=engine.radiusScale;
    for(var i=0;i<count;i++){
      var value=intensity[i];
      if(edges&&(engine.edgeIn[i]||engine.edgeOut[i])){
        var angle=engine.angle[i],bulge=0.6*Math.sin(5*angle-crawlA)+0.4*Math.sin(3*angle+crawlB+1.7)+(engine.hash[i]/255-0.5)*0.5;
        if(engine.inIris[i])bulge*=0.7;
        if(engine.edgeOut[i]&&bulge>0.62)value=Math.max(value,0.55);
        if(engine.edgeIn[i]&&bulge<-0.6)value*=0.2;
      }
      if(value>0){
        radius[i]*=1+Math.max(0,value-0.9)*0.6;
      }
      intensity[i]=value;
    }
    if(!edges||!engine.veins)return;
    var j=findAt(engine.veins.starts,step%HORIZON);
    if(j<0)return;
    var vein=engine.veins.data[j],path=engine.veinPaths[vein.path],age=step%HORIZON-engine.veins.starts[j];
    var length=Math.min(vein.length,path.length),creep=length/6,fade=age<creep+0.6?1:1-(age-creep-0.6)/0.8;
    if(fade<=0)return;
    var head=Math.min(length,Math.floor(age*6)+1);
    for(var k=0;k<head;k++){
      var cell=path[k];
      intensity[cell]=intensity[cell]+(1.1-intensity[cell])*fade;
      radius[cell]=Math.max(radius[cell],1+0.15*fade);
    }
  };
  engine.shade=function(index,lightX,lightY,lightZ,band,gain){
    var a=engine.alpha[index];
    if(a<0.05||engine.dropout[index])return 0;
    var lambert=Math.max(0,engine.normalX[index]*lightX+engine.normalY[index]*lightY+engine.normalZ[index]*lightZ);
    return a*(0.1+1.02*Math.pow(lambert,1.5)+0.36*band)*gain;
  };
  // Each dot's shade and radius are bucketed before drawing; a frame identical to the last one skips the canvas entirely.
  // Each dot's ink, shade and radius are bucketed before drawing; a frame identical to the last one skips the canvas entirely.
  // A bucket is ink*5+shade. Backdrop dots (engine.back, bucket+1) are drawn first at full size, under everything.
  function present(){
    var intensity=engine.intensity,radiusScale=engine.radiusScale,ink=engine.ink,back=engine.back,changed=forceDraw,i,buckets=Math.min(40,engine.inks.length*5);
    for(i=0;i<count;i++){
      var value=intensity[i],shade=-1,quantised=0;
      if(value>=0.08){
        var scaled=Math.min(6,value*6),level=Math.floor(scaled);
        if(scaled-level>BAYER[((i/cols|0)&3)*4+(i%cols&3)]/16)level++;
        level=Math.max(1,Math.min(6,level));
        shade=Math.min(buckets-1,ink[i]*5+(level>4?4:level-1));
        quantised=Math.round(Math.min(0.5*PITCH,0.45*PITCH*(0.25+0.75*level/6)*(radiusScale[i]||1))*32);
      }
      dotShade[i]=shade;dotRadius[i]=quantised;
      if(shade!==drawnShade[i]||quantised!==drawnRadius[i]||back[i]!==drawnBack[i])changed=true;
    }
    if(!changed)return;
    forceDraw=false;drawnShade.set(dotShade);drawnRadius.set(dotRadius);drawnBack.set(back);
    var inks=engine.inks,b,k;
    bucketCounts.fill(0);
    for(i=0;i<count;i++)if(dotShade[i]>=0)bucketCounts[dotShade[i]]++;
    shadeStart[0]=0;for(b=0;b<buckets;b++)shadeStart[b+1]=shadeStart[b]+bucketCounts[b];
    for(b=0;b<buckets;b++)bucketCounts[b]=shadeStart[b];
    for(i=0;i<count;i++)if(dotShade[i]>=0)dotOrder[bucketCounts[dotShade[i]]++]=i;
    ctx.clearRect(0,0,W,H);
    var full=0.5*PITCH;
    for(b=1;b<=buckets;b++){
      var started=false;
      for(i=0;i<count;i++){
        if(back[i]!==b)continue;
        if(!started){ctx.fillStyle=inks[(b-1)/5|0][(b-1)%5];ctx.beginPath();started=true}
        ctx.moveTo(engine.dotX[i]+full,engine.dotY[i]);ctx.arc(engine.dotX[i],engine.dotY[i],full,0,6.2832);
      }
      if(started)ctx.fill();
    }
    // Optional bloom (the theme's): soft halos in each ramp's brightest ink under the lit dots, one union per ink and pass.
    var bloom=engine.bloom;
    if(bloom){
      ctx.save();
      for(var pass=0;pass<bloom.length;pass++){
        var reach=bloom[pass][0]*PITCH,from=bloom[pass][2]||0;ctx.globalAlpha=bloom[pass][1];
        for(var inkIndex=0;inkIndex*5<buckets;inkIndex++){
          var any=false;
          for(b=inkIndex*5+from;b<Math.min(buckets,inkIndex*5+5);b++){
            if(shadeStart[b+1]===shadeStart[b])continue;
            if(!any){ctx.fillStyle=inks[inkIndex][4];ctx.beginPath();any=true}
            for(k=shadeStart[b];k<shadeStart[b+1];k++){var lit=dotOrder[k];ctx.moveTo(engine.dotX[lit]+reach,engine.dotY[lit]);ctx.arc(engine.dotX[lit],engine.dotY[lit],reach,0,6.2832)}
          }
          if(any)ctx.fill();
        }
      }
      ctx.restore();
    }
    for(b=0;b<buckets;b++){
      if(shadeStart[b+1]===shadeStart[b])continue;
      ctx.fillStyle=inks[b/5|0][b%5];ctx.beginPath();
      for(k=shadeStart[b];k<shadeStart[b+1];k++){
        var dot=dotOrder[k],radius=dotRadius[dot]/32;
        ctx.moveTo(engine.dotX[dot]+radius,engine.dotY[dot]);ctx.arc(engine.dotX[dot],engine.dotY[dot],radius,0,6.2832);
      }
      ctx.fill();
    }
    // Optional second ink: the same dots again, smaller and off register, composited on this small canvas only.
    var over=engine.overprint;
    if(over){
      ctx.save();ctx.globalCompositeOperation=over.blend||"source-over";ctx.globalAlpha=over.alpha==null?0.85:over.alpha;ctx.fillStyle=over.color;ctx.beginPath();
      for(i=0;i<count;i++){
        if(dotShade[i]<0||dotShade[i]%5<1)continue;
        var r2=dotRadius[i]/32*(over.scale||1),ox=engine.dotX[i]+over.dx,oy=engine.dotY[i]+over.dy;
        ctx.moveTo(ox+r2,oy);ctx.arc(ox,oy,r2,0,6.2832);
      }
      ctx.fill();ctx.restore();
    }
  }
  // Optional glitch: now and then a few horizontal slices of the finished frame slip sideways for a few frames.
  var glitch={next:0,until:0,bands:[],was:false},glitchBuffer=null;
  function glitchActive(real){
    var config=QA_THEME.current().glitch;
    if(!config||!real||reduced.matches)return false;
    function between(range){return range[0]+Math.random()*(range[1]-range[0])}
    if(real>=glitch.next&&real>=glitch.until){
      if(glitch.next){
        glitch.until=real+Math.round(between(config.frames))/FPS;glitch.bands=[];
        for(var b=Math.round(between(config.bands));b>0;b--)glitch.bands.push({y:Math.floor(Math.random()*(H-24)),h:4+Math.floor(Math.random()*18),dx:Math.round(between(config.shift))*(Math.random()<0.5?-1:1)});
      }
      glitch.next=real+between(config.every);
    }
    return real<glitch.until;
  }
  function drawGlitch(){
    var ratio=canvas.width/W;
    if(!glitchBuffer){glitchBuffer=document.createElement("canvas")}
    if(glitchBuffer.width!==canvas.width||glitchBuffer.height!==Math.ceil(24*ratio)){glitchBuffer.width=canvas.width;glitchBuffer.height=Math.ceil(24*ratio)}
    var g=glitchBuffer.getContext("2d");
    glitch.bands.forEach(function(band){
      var sy=Math.round(band.y*ratio),sh=Math.round(band.h*ratio);
      g.clearRect(0,0,glitchBuffer.width,glitchBuffer.height);g.drawImage(canvas,0,sy,canvas.width,sh,0,0,canvas.width,sh);
      ctx.clearRect(0,band.y,W,band.h);ctx.drawImage(glitchBuffer,0,0,canvas.width,sh,band.dx,band.y,W,band.h);
    });
  }
  engine.clear=function(){engine.intensity.fill(0);engine.radiusScale.fill(1);engine.ink.fill(0);engine.back.fill(0)};

  /* ---------- blood: drops, falls, pool (deterministic in time) ---------- */
  var GRAVITY=320,STRETCH=3/FPS,HORIZON=1800;
  function lidColumns(){
    var info={upperTop:new Int16Array(cols).fill(-1),upperBottom:new Int16Array(cols).fill(-1),lowerTop:new Int16Array(cols).fill(-1),lowerBottom:new Int16Array(cols).fill(-1)};
    var irisRow=engine.anatomy?engine.rowOf(engine.anatomy.iris[1]):rows/2;
    for(var col=0;col<cols;col++){
      for(var row=0;row<rows;row++){
        var i=row*cols+col,lit=engine.alpha[i]>0.3&&!engine.inIris[i];
        if(row<irisRow){
          if(lit&&info.upperTop[col]<0)info.upperTop[col]=row;
          if(lit&&info.upperTop[col]>=0&&(info.upperBottom[col]<0||info.upperBottom[col]===row-1))info.upperBottom[col]=row;
        }else{
          if(lit&&info.lowerTop[col]<0)info.lowerTop[col]=row;
          if(lit&&info.lowerTop[col]>=0&&(info.lowerBottom[col]<0||info.lowerBottom[col]===row-1))info.lowerBottom[col]=row;
        }
      }
    }
    return info;
  }
  function makeBlood(config,seed){
    var random=mulberry(seed),emitters=[],tips=engine.anatomy?engine.anatomy.tips:[],lids=lidColumns(),candidates=[];
    for(var col=0;col<cols;col++)if(lids.lowerTop[col]>=0&&lids.lowerBottom[col]-lids.lowerTop[col]<=3)candidates.push(col);
    function schedule(fixed,phase){
      var starts=[],cycles=[],t=phase;
      while(t<HORIZON){
        var col=fixed?fixed.col:candidates[Math.floor(random()*candidates.length)];
        var topRow=fixed?fixed.topRow:lids.lowerBottom[col]+1,tipRow=fixed?fixed.tipRow:topRow+2+Math.floor(random()*3);
        var trickle=!fixed||random()<config.trickle?(tipRow-topRow+1)*2/FPS:0;
        var swell=config.swell[0]+random()*(config.swell[1]-config.swell[0]);
        var fall=Math.sqrt(2*Math.max(1,engine.poolRow-tipRow-2)*PITCH/GRAVITY);
        var land=t+trickle+swell+STRETCH+fall;
        starts.push(t);cycles.push({col:col,topRow:topRow,tipRow:tipRow,trickle:trickle,swell:swell,land:land});
        t=land+config.rest[0]+random()*(config.rest[1]-config.rest[0]);
      }
      return{starts:new Float64Array(starts),cycles:cycles};
    }
    tips.forEach(function(tip,k){
      emitters.push(schedule({col:engine.colOf(tip[0]),tipRow:engine.rowOf(tip[1]),topRow:engine.rowOf(tip[2])},0.3+k*1.7+random()));
    });
    if(candidates.length)for(var r=0;r<config.runs;r++)emitters.push(schedule(null,2+r*3.1+random()*2));
    var span=[cols,0];
    for(col=0;col<cols;col++)if(lids.lowerTop[col]>=0){span[0]=Math.min(span[0],col);span[1]=Math.max(span[1],col)}
    return{config:config,emitters:emitters,pool:new Float32Array(cols),span:span,lids:lids};
  }
  function drawCycle(cycle,age){
    var col=cycle.col,tip=cycle.tipRow,step=Math.floor(age*FPS);
    if(age<cycle.trickle){
      var head=cycle.topRow+Math.floor(step/2);
      for(var row=cycle.topRow;row<head;row++)engine.put(col,row,0.42);
      engine.put(col,head,0.95);return;
    }
    age-=cycle.trickle;
    if(age<cycle.swell){
      var progress=age/cycle.swell;
      if(progress<0.35)engine.put(col,tip+1,0.62);
      else if(progress<0.75)engine.drop(col,tip+1,1,0.74);
      else engine.drop(col,tip+1,2,0.9);
      return;
    }
    age-=cycle.swell;
    if(age<STRETCH){
      var frame=Math.min(2,Math.floor(age*FPS)),top=tip+1+frame;
      if(frame<2)engine.drop(col,top,3,0.92);else engine.stamp(col,top+2,0,1,0.92);
      for(row=tip+1;row<top;row++)engine.put(col,row,0.58);
      return;
    }
    age-=STRETCH;
    var fallRow=tip+2+Math.round(0.5*GRAVITY*age*age/PITCH);
    if(fallRow<engine.poolRow-1){
      engine.stamp(col,fallRow,0,1,0.9);
      if(step%2===0&&age>0.15)engine.put(col,fallRow-2,0.5);
      if(age<2/FPS)engine.put(col,tip+1,0.55);
    }
  }
  function chance(a,b){return((Math.imul(a*73856093^b*19349663,2654435761)>>>0)%10007)/10007}
  // Impact squash, a crown of droplets, a double ripple, a brief bulge and the odd spatter onto the lower lid.
  function splash(blood,cycle,age,seed){
    var config=blood.config.splash,col=cycle.col,pool=engine.poolRow;
    // With a wordmark floor, ripples and droplets stay over the floor's span.
    function put(c,r,v){var f=engine.floor;if(!f||(c>=f.c0&&c<=f.c1))engine.put(c,r,v)}
    if(age>2.6)return;
    if(age<1/FPS){engine.stamp(col,pool-1,config.width,0,0.98);return}
    if(age<0.4){var rise=0.85*(1-age/0.4);put(col,pool-1,rise);put(col-1,pool-1,rise*0.7);put(col+1,pool-1,rise*0.7)}
    if(age<0.7){
      var reach=1+Math.floor(age*FPS/2),strength=0.8*(1-age/0.7);
      put(col-reach,pool,strength+0.25);put(col+reach,pool,strength+0.25);
      if(reach>3){put(col-reach+3,pool,strength);put(col+reach-3,pool,strength)}
    }
    var droplets=config.droplets[0]+Math.floor(chance(seed,1)*(config.droplets[1]-config.droplets[0]+1));
    for(var k=0;k<droplets;k++){
      var flight=0.5+0.3*chance(seed,10+k),side=(k%2?1:-1)*(config.side[0]+Math.floor(chance(seed,20+k)*(config.side[1]-config.side[0]+1)));
      var height=config.height[0]+Math.floor(chance(seed,30+k)*(config.height[1]-config.height[0]+1)),p=age/flight;
      var spatter=k===0&&chance(seed,40)<config.spatter&&blood.lids;
      if(spatter){
        var target=Math.max(blood.span[0],Math.min(blood.span[1],col+side)),lidRow=blood.lids.lowerBottom[target];
        if(lidRow<0)continue;
        var hop=0.55;
        if(age<hop){var q=age/hop;put(Math.round(col+(target-col)*q),Math.round(pool-1-(pool-1-lidRow)*Math.sin(q*Math.PI/2)-2*q*(1-q)),0.85)}
        else if(age<2.6){var run=Math.floor((age-hop)*FPS/3);put(target,lidRow+1+run,0.8*(1-(age-hop)/2.05)+0.15)}
        continue;
      }
      if(p>=1)continue;
      put(Math.round(col+side*p),Math.round(pool-1-4*height*p*(1-p)),0.85*(1-0.4*p));
    }
  }
  function bloodFrame(blood,t){
    var timeline=Math.floor(t*FPS)/FPS%HORIZON,config=blood.config,pool=blood.pool;
    pool.fill(0);
    var floor=engine.floor,lo=floor?floor.c0:blood.span[0],hi=floor?floor.c1:blood.span[1];
    // The eye's own pool is only a faint trace; as the wordmark's underline the floor is a visible, unbroken line.
    for(var c=lo;c<=hi;c++)pool[c]=floor?0.8:0.14;
    blood.emitters.forEach(function(emitter,index){
      var j=findAt(emitter.starts,timeline);
      if(j<0)return;
      drawCycle(emitter.cycles[j],timeline-emitter.starts[j]);
      for(var m=j;m>=Math.max(0,j-10);m--){
        var cycle=emitter.cycles[m],age=timeline-cycle.land;
        if(age<0)continue;
        if(age>config.evaporate*4)break;
        var amount=config.depth*Math.exp(-age/config.evaporate),spread=1.2+0.8*Math.sqrt(age);
        for(c=Math.max(0,cycle.col-8);c<=Math.min(cols-1,cycle.col+8);c++)pool[c]+=amount*Math.exp(-(c-cycle.col)*(c-cycle.col)/(2*spread*spread));
        splash(blood,cycle,age,m*7+index);
      }
    });
    for(c=floor?lo:0;c<=(floor?hi:cols-1);c++){
      var level=Math.tanh(pool[c]);
      engine.put(c,engine.poolRow,level);
      for(var depth=1;depth<config.poolRows;depth++)engine.put(c,engine.poolRow-depth,(level-0.55*depth)*1.6);
    }
  }

  /* ---------- modes ---------- */
  function schedules(seed,first,gap,extra){
    var random=mulberry(seed),starts=[],data=[],t=first;
    while(t<HORIZON){starts.push(t);data.push(extra(random));t+=gap[0]+random()*(gap[1]-gap[0])}
    return{starts:new Float64Array(starts),data:data};
  }
  var BLINK_FRAMES=[-1,-1,0.45,1,1,0.7,0.4,0.15];
  function blinkFraction(starts,data,t,forcedAt){
    var best=0,timeline=t%HORIZON;
    function sample(start,double,at){
      var frame=Math.floor((at-start)*FPS);
      if(frame>=0&&frame<BLINK_FRAMES.length)best=BLINK_FRAMES[frame];
      if(double){frame-=BLINK_FRAMES.length+2;if(frame>=0&&frame<BLINK_FRAMES.length)best=BLINK_FRAMES[frame]}
    }
    var j=findAt(starts,timeline);
    if(j>=0)sample(starts[j],data[j].double,timeline);
    if(forcedAt>-1e8)sample(forcedAt,false,t);
    return best;
  }
  // Full: blinks, saccades, a gaze that follows the cursor, light sweeping across the dots and the theme's drips.
  var full={
    id:"full",label:"Full",tracks:true,
    init:function(){
      this.lids=lidColumns();
      this.blood=makeBlood({swell:[2,5],rest:[1.5,4],trickle:0.3,evaporate:6,depth:0.75,poolRows:1,runs:0,
        splash:{width:2,droplets:[3,4],height:[2,4],side:[3,5],spatter:0.2}},11);
      this.blinks=schedules(23,6,[8,20],function(random){return{double:random()<0.3}});
      this.saccades=schedules(37,3,[9,15],function(random){return{cells:(random()<0.5?-1:1)*(2+Math.floor(random()*2)),hold:0.6+random()*0.4}});
      this.shift=new Int16Array(cols);this.bandTop=new Int16Array(cols);this.forcedBlink=-1e9;this.wasInside=false;this.gazeCol=0;this.gazeRow=0;this.gazePreviousCol=0;this.gazePreviousRow=0;this.gazeKey=-1;this.gazeScale=1;
    },
    // In Full animation the pupil follows the cursor anywhere in the window. The target is sampled once per 12fps step and the pupil
    // moves in whole cells, overshooting by one cell on a big jump. Returns [column, row, pupil scale]; without tracking, the saccade routine.
    pupilCells:function(t,real,previous){
      var tracking=engine.track,a=engine.anatomy;
      if(real&&tracking.active){
        var key=Math.floor(real*FPS);
        if(key!==this.gazeKey){
          this.gazePreviousCol=this.gazeCol;this.gazePreviousRow=this.gazeRow;this.gazeKey=key;
          var rect=canvas.getBoundingClientRect(),dx=pointer.x-(rect.left+engine.px(a.iris[0])),dy=pointer.y-(rect.top+engine.py(a.iris[1]));
          var distance=Math.hypot(dx,dy)||1,reach=Math.min(1,distance/140);
          var targetCol=Math.round(dx/distance*reach*3),targetRow=Math.round(dy/distance*reach*2);
          var jumpCol=targetCol-this.gazeCol,jumpRow=targetRow-this.gazeRow;
          this.gazeCol=Math.max(-3,Math.min(3,targetCol+(Math.abs(jumpCol)>=2?Math.sign(jumpCol):0)));
          this.gazeRow=Math.max(-2,Math.min(2,targetRow+(Math.abs(jumpRow)>=2?Math.sign(jumpRow):0)));
          this.gazeScale=1-0.25*(1-Math.min(1,distance/260));
        }
        return previous?[this.gazePreviousCol,this.gazePreviousRow,this.gazeScale]:[this.gazeCol,this.gazeRow,this.gazeScale];
      }
      this.gazeKey=-1;this.gazeCol=this.gazeRow=this.gazePreviousCol=this.gazePreviousRow=0;
      var j=findAt(this.saccades.starts,t%HORIZON);
      if(j<0)return[0,0,1];
      var saccade=this.saccades.data[j];
      return[t%HORIZON-this.saccades.starts[j]<saccade.hold?saccade.cells:0,0,1];
    },
    frame:function(t,real){
      var a=engine.anatomy,step=Math.floor(t*FPS)/FPS,soft=Math.floor(t*24)/24,phase=2*Math.PI*soft/14;
      if(real){
        if(engine.track.active&&!this.wasInside&&Math.random()<0.5)this.forcedBlink=real+0.35;
        this.wasInside=engine.track.active;
      }
      var lightX=-0.55+0.4*Math.sin(phase),lightY=-0.5+0.3*Math.cos(phase),lightZ=0.75,norm=Math.hypot(lightX,lightY,lightZ);
      lightX/=norm;lightY/=norm;lightZ/=norm;
      var sweep=150*Math.sin(phase);
      var now=this.pupilCells(step,real,false),before=this.pupilCells(step-1/FPS,real,true);
      var smear=Math.abs(now[0]-before[0])>=2;
      var blink=reduced.matches?0:blinkFraction(this.blinks.starts,this.blinks.data,step,real?this.forcedBlink-(real-t):-1e9);
      var lids=this.lids,shift=this.shift,bandTop=this.bandTop;
      for(var col=0;col<cols;col++){
        shift[col]=lids.upperTop[col]<0?0:blink<0?-1:lids.lowerTop[col]<0?0:Math.round(blink*Math.max(0,lids.lowerTop[col]-lids.upperBottom[col]-1));
        // A closing lid thins to two rows so the lid ends do not stand up at the corners.
        var thick=lids.upperBottom[col]-lids.upperTop[col]+1,keep=blink>0?Math.max(2,Math.round(thick-(thick-2)*blink)):thick;
        bandTop[col]=lids.upperBottom[col]+shift[col]-keep+1;
      }
      var irisX=engine.dotX[0]+engine.colOf(a.iris[0])*PITCH,irisY=engine.dotY[0]+engine.rowOf(a.iris[1])*PITCH;
      var pupilX=irisX+now[0]*PITCH,pupilY=irisY+now[1]*PITCH,lastX=irisX+before[0]*PITCH,lastY=irisY+before[1]*PITCH;
      var irisRadius=a.iris[2]*SCALE,pupilRadius=a.pupil*SCALE*now[2];
      engine.time=soft;
      for(var i=0;i<count;i++){
        col=i%cols;var row=(i/cols)|0,source=i,lidOnly=false,value=0,s=shift[col];
        engine.radiusScale[i]=1;
        if(blink!==0&&lids.upperTop[col]>=0&&row<=lids.upperBottom[col]+Math.max(0,s)){
          if(row<bandTop[col]){engine.intensity[i]=0;continue}
          source=(row-s)*cols+col;lidOnly=true;
        }
        if(lidOnly||!engine.inIris[i]){
          value=engine.inIris[source]?0:engine.shade(source,lightX,lightY,lightZ,Math.exp(-Math.pow((engine.dotX[source]-W/2+engine.dotY[source]-CENTER_Y)*0.707-sweep,2)/4050),1);
        }else{
          var dx=engine.dotX[i]-pupilX,dy=engine.dotY[i]-pupilY,toPupil=Math.hypot(dx,dy),toIris=Math.hypot(engine.dotX[i]-irisX,engine.dotY[i]-irisY);
          var hole=toPupil<pupilRadius;
          if(smear)hole=hole||Math.hypot(engine.dotX[i]-lastX,engine.dotY[i]-lastY)<pupilRadius||Math.hypot(engine.dotX[i]-(pupilX+lastX)/2,engine.dotY[i]-(pupilY+lastY)/2)<pupilRadius*0.8;
          if(hole)value=0;
          else if(toPupil<pupilRadius+PITCH*0.6)value=0.15;
          else{
            var ring=Math.min(1,Math.max(0,(toPupil-pupilRadius)/(irisRadius-pupilRadius))),slope=0.9*Math.cos(Math.PI*ring);
            var nx=-slope*dx/toPupil,ny=-slope*dy/toPupil,length=Math.hypot(nx,ny,1);
            var theta=Math.atan2(engine.dotY[i]-irisY,engine.dotX[i]-irisX),rim=irisRadius*(1+0.045*Math.sin(2*theta+1)+0.03*Math.sin(3*theta+0.4));
            var lambert=Math.max(0,(nx*lightX+ny*lightY+lightZ)/length),edge=Math.min(1,Math.max(0,(rim+0.5*PITCH-toIris)/PITCH));
            value=edge*(0.16+0.95*Math.pow(lambert,1.5)+0.34*Math.exp(-Math.pow((engine.dotX[i]-W/2+engine.dotY[i]-CENTER_Y)*0.707-sweep,2)/4050));
          }
        }
        engine.intensity[i]=value;
      }
      engine.living(t,blink===0);
      bloodFrame(this.blood,t);
    },
    still:0.6
  };
  // Subtle: the ambient motion only (drips, edge crawl); no blinks or gaze.
  var subtle={
    id:"subtle",label:"Subtle",
    init:function(){this.blood=makeBlood({swell:[0.8,2],rest:[0.2,0.8],trickle:0.45,evaporate:18,depth:0.55,poolRows:3,runs:2,
      splash:{width:3,droplets:[4,5],height:[3,5],side:[3,6],spatter:0.45}},53)},
    frame:function(t){
      engine.time=Math.floor(t*24)/24;
      var lightX=-0.5,lightY=-0.55,lightZ=0.67;
      for(var i=0;i<count;i++){engine.radiusScale[i]=1;engine.intensity[i]=engine.shade(i,lightX,lightY,lightZ,0.35,1)}
      engine.living(t,true);
      bloodFrame(this.blood,t);
    },
    still:4
  };
  // Static: Subtle's still frame, drawn once; idle, so no loop runs at all.
  var still={id:"static",label:"Static",init:subtle.init,frame:subtle.frame,still:subtle.still,idle:true};
  var blank={id:"",init:function(){},frame:function(){engine.clear()},still:0,idle:true};
  engine.schedules=schedules;engine.findAt=findAt;engine.horizon=HORIZON;
  var MODES={full:full,subtle:subtle,static:still},LEGACY_MODES={watcher:"full",coin:"full",bleeding:"subtle",off:"static"};

  /* ---------- engine lifecycle and controls ---------- */
  var mode=blank,ready=false,running=false,onScreen=true,modalOpen=false,frameTimer=0,lastKey=-1,start=clock(),modeSelect=document.getElementById("eye-mode"),themeSelect=document.getElementById("theme-pick");
  function availableModes(){
    var character=QA_THEME.character();
    return(character.modes||["static"]).map(function(entry){return typeof entry==="string"?MODES[LEGACY_MODES[entry]||entry]:entry})
      .filter(function(entry){return entry&&(!(entry===full||entry===subtle)||character.anatomy)});
  }
  function chooseMode(id){
    var modes=availableModes(),next=modes.filter(function(entry){return entry.id===id})[0]||modes[0]||still;
    if(mode.dispose)mode.dispose(engine);
    mode=next;engine.clear();
    if(ready)mode.init(engine);
    if(modeSelect)modeSelect.value=mode.id;
    if(mode.id)document.documentElement.setAttribute("data-logo-mode",mode.id);
    settleRadioMotion();
    update(true);
  }
  function renderOnce(t,real){
    if(real)engine.gazeExpire(real);
    if(debug)window.__eyeFrames=(window.__eyeFrames||0)+1;
    var glitching=glitchActive(real);
    if(glitching||glitch.was)forceDraw=true;
    engine.clear();mode.frame(t,real,engine);present();
    if(glitching)drawGlitch();
    glitch.was=glitching;
  }
  // The art moves in 12fps steps and its light in 24fps steps, so one timer step per 24th of a second is the finest change there is.
  function tick(){
    frameTimer=0;
    if(!running)return;
    var elapsed=clock()-start,key=Math.floor(elapsed*LIGHT_FPS/1000);
    if(key!==lastKey){lastKey=key;renderOnce(elapsed/1000,elapsed/1000)}
    frameTimer=setTimeout(tick,Math.max(4,(key+1)*1000/LIGHT_FPS-(clock()-start)+1));
  }
  function stopLoop(){running=false;clearTimeout(frameTimer);frameTimer=0}
  // A modal settings dialog freezes the art behind it, since its backdrop blur would be recomputed on every frame.
  function update(force){
    if(!ready)return;
    var wanted=onScreen&&!document.hidden&&!reduced.matches&&!isFrozen&&!mode.idle,animate=wanted&&!modalOpen;
    if(animate&&!running){running=true;lastKey=-1;tick()}
    else if(!animate){stopLoop();if(!(wanted&&modalOpen)||force)renderOnce(isFrozen?frozen:mode.still,0)}
  }
  // Inks come from the theme: its palette is ink 0, and the character's named ramps (inks: ["warn", "bad"]) are 1..n.
  function readPalette(){
    var theme=QA_THEME.current(),palette=theme.palette,over=theme.halftoneOverprint,scheme=QA_THEME.isDark()?"dark":"light",named=theme.inks&&theme.inks[scheme]||{};
    engine.inks=[palette[scheme]].concat((QA_THEME.character().inks||[]).map(function(name){return named[name]||palette[scheme]}));
    engine.bloom=theme.bloom||null;engine.screen=!!theme.screen;
    engine.overprint=over?{dx:over.dx,dy:over.dy,scale:over.scale,alpha:over.alpha,color:over[scheme].color,blend:over[scheme].blend}:null;
    forceDraw=true;
  }
  function setupCanvas(){
    var ratio=window.devicePixelRatio||1;
    canvas.width=Math.round(W*ratio);canvas.height=Math.round(H*ratio);ctx.setTransform(ratio,0,0,ratio,0,0);forceDraw=true;
  }
  function loadTheme(){
    ready=false;stopLoop();ctx.clearRect(0,0,canvas.width,canvas.height);layout(QA_THEME.character());fitFloor();readPalette();
    var settingsButton=document.getElementById("settings-open");
    if(settingsButton){settingsButton.innerHTML=QA_THEME.icon("settings");buttonFx(settingsButton.parentNode)}
    var image=new Image(),wanted=query.get("eye"),stored=null;
    try{stored=localStorage.getItem("qaDashboardEyeMode")}catch(e){}
    // Stored ids from before the three-option picker move to the nearest new option.
    if(stored&&LEGACY_MODES[stored]){stored=LEGACY_MODES[stored];try{localStorage.setItem("qaDashboardEyeMode",stored)}catch(e){}}
    wanted=LEGACY_MODES[wanted]||wanted||stored;
    var source=QA_THEME.character().logoSource,token=++loads;
    function begin(art){
      if(token!==loads)return;
      try{buildSource(art)}catch(e){return}
      ready=true;setupCanvas();
      if(modeSelect)modeSelect.innerHTML=availableModes().map(function(entry){return'<option value="'+entry.id+'" data-label="'+entry.label+'">'+entry.label+'</option>'}).join("");
      hideSingleChoiceRows();
      chooseMode(mode!==blank?mode.id:wanted||"full");
    }
    if(!source){begin(null);return}
    image.onload=function(){begin(image)};
    image.src="data:image/svg+xml,"+encodeURIComponent(source);
  }
  var loads=0;
  if(themeSelect){
    themeSelect.innerHTML=Object.keys(THEMES).map(function(id){return'<option value="'+id+'" data-label="'+THEMES[id].name+'">'+THEMES[id].name+'</option>'}).join("");
    themeSelect.value=QA_THEME.id();
    themeSelect.addEventListener("change",function(){QA_THEME.choose(themeSelect.value)});
  }
  // Blip appears first; every registered character gets one plain-label choice.
  var characterSelect=document.getElementById("character-pick");
  function characterOptions(){
    if(!characterSelect)return;
    characterSelect.innerHTML=["blip"].concat(Object.keys(CHARACTERS).filter(function(id){return id!=="blip"})).map(function(id){var label=CHARACTERS[id].name;return'<option value="'+id+'" data-label="'+esc(label)+'">'+esc(label)+'</option>'}).join("");
    characterSelect.value=QA_THEME.characterPick();
    hideSingleChoiceRows();
  }
  characterOptions();
  if(characterSelect)characterSelect.addEventListener("change",function(){QA_THEME.chooseCharacter(characterSelect.value)});
  var sceneSelect=document.getElementById("scene-pick");
  var SCENE_LABELS={desk:"Desk",radio:"Radio"};
  if(sceneSelect){
    sceneSelect.innerHTML=QA_THEME.scenes().map(function(id){return'<option value="'+id+'" data-label="'+SCENE_LABELS[id]+'">'+SCENE_LABELS[id]+'</option>'}).join("");
    sceneSelect.value=QA_THEME.sceneId();sceneSelect.addEventListener("change",function(){QA_THEME.chooseScene(sceneSelect.value)});
  }
  hideSingleChoiceRows();
  document.addEventListener("qa-scene",function(){radioPainted=false;render();buttonFx(document);QA_BRUSH.wordmark();QA_BRUSH.decorate(document);fitFloor()});
  var fitTimer=0;
  window.addEventListener("resize",function(){cancelAnimationFrame(fitTimer);fitTimer=requestAnimationFrame(fitFloor)});
  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(fitFloor);
  document.addEventListener("qa-character",function(){mode=blank;loadTheme();QA_BRUSH.wordmark()});
  if(modeSelect)modeSelect.addEventListener("change",function(){
    try{localStorage.setItem("qaDashboardEyeMode",modeSelect.value)}catch(e){}
    chooseMode(modeSelect.value);
  });
  document.addEventListener("qa-theme",function(){mode=blank;characterOptions();loadTheme();if(typeof render==="function")render();buttonFx(document);QA_BRUSH.wordmark();QA_BRUSH.decorate(document)});
  // The backend rollup reaches renderers as engine.status; a still frame is redrawn when it changes.
  document.addEventListener("qa-status",function(e){engine.status=e.detail||"unknown";if(!running)update(true)});
  QA_BRUSH.wordmark();QA_BRUSH.decorate(document);
  var titleMark=document.querySelector(".mark");
  if(titleMark)titleMark.addEventListener("click",QA_BRUSH.wordmark);
  // Tracking (Full's gaze) follows the cursor anywhere in the window and always ends: when it leaves the window, on blur,
  // when the tab is hidden, or after 4s without movement. Nothing else in the animation waits on it.
  var TRACK_IDLE=4,debug=/^(1|true)$/.test(query.get("debug")||query.get("perf")||"");
  function gazeLog(what,detail){if(debug)console.log("gaze "+what+" "+JSON.stringify(detail||{})+" t="+((clock()-start)/1000).toFixed(2)+" frames="+(window.__eyeFrames||0))}
  function gazeRelease(reason){
    if(!engine.track.active)return;
    engine.track.active=false;lastKey=-1;gazeLog("track release",{reason:reason});
  }
  engine.gazeExpire=function(real){if(engine.track.active&&real-engine.track.lastMoveAt>TRACK_IDLE)gazeRelease("idle")};
  // Pointer moves only store coordinates (see track() above) and flags; the canvas tick does the work at its own 24fps.
  document.addEventListener("pointermove",function(e){
    if(e.pointerType==="touch")return;
    engine.track.lastMoveAt=(clock()-start)/1000;
    if(!engine.track.active&&mode.tracks){engine.track.active=true;lastKey=-1;gazeLog("track engage")}
  },{passive:true});
  document.addEventListener("pointerout",function(e){if(!e.relatedTarget)gazeRelease("window-out")});
  document.documentElement.addEventListener("pointerleave",function(){gazeRelease("document-leave")});
  document.addEventListener("pointercancel",function(){gazeRelease("cancel")});
  window.addEventListener("blur",function(){gazeRelease("window-blur")});
  document.addEventListener("visibilitychange",function(){if(document.hidden)gazeRelease("hidden")});
  if(window.IntersectionObserver)new IntersectionObserver(function(entries){onScreen=entries[entries.length-1].isIntersecting;update()}).observe(canvas);
  document.addEventListener("qa-modal",function(e){modalOpen=!!e.detail;update()});
  document.addEventListener("visibilitychange",function(){update()});
  if(reduced.addEventListener)reduced.addEventListener("change",function(){settleRadioMotion();update()});
  function schemeChanged(){readPalette();if(!running)update(true)}
  if(scheme.addEventListener)scheme.addEventListener("change",schemeChanged);
  document.addEventListener("qa-scheme",schemeChanged);
  var schemeRadios=document.querySelectorAll('input[name="scheme"]');
  Array.prototype.forEach.call(schemeRadios,function(radio){
    radio.checked=radio.value===QA_THEME.schemePreference();
    radio.addEventListener("change",function(){if(radio.checked)QA_THEME.chooseScheme(radio.value)});
  });
  loadTheme();
})();
</script></body></html>
"""


def render_html(status=None):
    """Page HTML; a status embeds a static snapshot and disables polling."""
    blob = json.dumps(status).replace("<", "\\u003c") if status is not None else "null"
    return HTML.replace("/*INITIAL*/null/*END*/", blob)


def load_status_file(path):
    with open(path, encoding="utf-8") as handle:
        return json.load(handle)


def run_wt_status():
    result = subprocess.run(
        [WT, "status", "--json"], capture_output=True, text=True,
        timeout=TIMEOUT_SECONDS, cwd=HOME,
    )
    if result.returncode != 0:
        raise RuntimeError(f"wt status exited {result.returncode}: {result.stderr.strip()[:300]}")
    return json.loads(result.stdout)


class StatusSource:
    def __init__(self, status_file=None):
        self.status_file = status_file
        self.lock = threading.Lock()
        self.cached = None
        self.cached_at = 0.0

    def get(self):
        with self.lock:
            if self.cached is not None and time.monotonic() - self.cached_at < CACHE_SECONDS:
                return self.cached
            self.cached = load_status_file(self.status_file) if self.status_file else run_wt_status()
            self.cached_at = time.monotonic()
            return self.cached

    def invalidate(self):
        """Drops the cached status, so the next request sees the result of an action that just finished."""
        with self.lock:
            self.cached = None


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


class ActionRunner:
    """Runs one wt action at a time and remembers the latest run."""

    def __init__(self, wt=WT, timeout=ACTION_TIMEOUT_SECONDS, on_finish=None):
        self.wt = wt
        self.timeout = timeout
        self.on_finish = on_finish
        self.lock = threading.Lock()
        self.last = None

    def snapshot(self):
        with self.lock:
            if not self.last:
                return None
            return {key: value for key, value in dict(self.last, output=list(self.last["output"])).items() if key != "arguments"}

    def start(self, action, arguments=None, target=None):
        with self.lock:
            if self.last and self.last["state"] == "running":
                return False
            self.last = {"action": action, "target": target, "arguments": arguments or ["backend", action],
                         "state": "running", "startedAt": now_iso(), "endedAt": None,
                         "exitCode": None, "output": collections.deque(maxlen=ACTION_TAIL_LINES)}
            run = self.last
        threading.Thread(target=self._run, args=(run,), daemon=True).start()
        return True

    def _append(self, run, line):
        with self.lock:
            run["output"].append(line)

    def _finish(self, run, state, exit_code):
        with self.lock:
            run.update(state=state, exitCode=exit_code, endedAt=now_iso())
        if self.on_finish:
            self.on_finish()

    def _run(self, run):
        try:
            process = subprocess.Popen(
                [self.wt] + run["arguments"], cwd=HOME, stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace",
                start_new_session=True,
            )
        except OSError as error:
            self._append(run, f"could not start wt: {error}")
            self._finish(run, "failed", None)
            return
        timed_out = threading.Event()

        def kill_group():
            # wt starts child processes that inherit stdout; kill the whole group so the read loop ends.
            timed_out.set()
            try:
                os.killpg(process.pid, 9)
            except OSError:
                pass

        timer = threading.Timer(self.timeout, kill_group)
        timer.start()
        try:
            for line in process.stdout:
                self._append(run, line.rstrip("\n"))
            exit_code = process.wait()
        finally:
            timer.cancel()
        if timed_out.is_set():
            self._append(run, f"timed out after {self.timeout} seconds")
        self._finish(run, "ok" if exit_code == 0 and not timed_out.is_set() else "failed", exit_code)


def allowed_origins(port):
    return {f"http://localhost:{port}", f"http://127.0.0.1:{port}"}


def same_origin(headers, port):
    origin = headers.get("Origin")
    return headers.get("X-QA-Dashboard") == "1" and (origin is None or origin in allowed_origins(port))


def handle_action(runner, action, headers, port):
    """Starts a backend action for a same-origin page request; returns (status code, JSON body)."""
    if not same_origin(headers, port):
        return 403, {"error": "forbidden"}
    if action not in BACKEND_ACTIONS:
        return 404, {"error": "not found"}
    if not runner.start(action):
        return 409, {"error": "another backend action is still running", "actions": runner.snapshot()}
    return 202, {"actions": runner.snapshot()}


def handle_service_restart(runner, body, headers, port, known_services):
    """Restarts one backend service through `wt backend restart <service>`; the service must be one of the services in the
    current backend status, so no free text reaches the command. qa-stack still refuses foreign listeners and leaves shared
    external services running."""
    if not same_origin(headers, port):
        return 403, {"error": "forbidden"}
    service = body.get("service") if isinstance(body, dict) else None
    if not isinstance(service, str) or service not in known_services:
        return 400, {"error": "unknown service"}
    if not runner.start("restart", ["backend", "restart", service], target=service):
        return 409, {"error": "another action is still running", "actions": runner.snapshot()}
    return 202, {"actions": runner.snapshot()}


def handle_slot_stop(runner, body, headers, port, known_branches):
    """Stops one task slot's frontends; the branch must be a slot in the current status."""
    if not same_origin(headers, port):
        return 403, {"error": "forbidden"}
    branch = body.get("branch") if isinstance(body, dict) else None
    if not isinstance(branch, str) or branch not in known_branches:
        return 400, {"error": "unknown branch"}
    if not runner.start("stop", ["serve", "--stop", branch], target=branch):
        return 409, {"error": "another action is still running", "actions": runner.snapshot()}
    return 202, {"actions": runner.snapshot()}


def recovery_tokens(body):
    """Validates a recovery selection; returns {slot: fingerprint}, or None when it is malformed."""
    entries = body.get("slots") if isinstance(body, dict) else None
    if not isinstance(entries, list) or not 1 <= len(entries) <= 8:
        return None
    picks = {}
    for entry in entries:
        slot = entry.get("slot") if isinstance(entry, dict) else None
        fingerprint = entry.get("fingerprint") if isinstance(entry, dict) else None
        if type(slot) is not int or not 2 <= slot <= 9 or slot in picks:
            return None
        if not isinstance(fingerprint, str) or not RECOVERY_FINGERPRINT.fullmatch(fingerprint):
            return None
        picks[slot] = fingerprint
    return picks


def handle_recovery(runner, action, body, headers, port, status):
    """Resumes or forgets saved sessions from before the restart. The browser only names slots and the
    fingerprints it was shown; wt re-checks everything under its own lock and reads branch, path and apps itself."""
    if not same_origin(headers, port):
        return 403, {"error": "forbidden"}
    if action not in RECOVERY_ACTIONS:
        return 404, {"error": "not found"}
    picks = recovery_tokens(body)
    if picks is None:
        return 400, {"error": "invalid selection"}
    offered = {}
    for slot in (status.get("slots") or []) if isinstance(status, dict) else []:
        recovery = slot.get("recovery") if isinstance(slot, dict) else None
        if isinstance(recovery, dict) and type(slot.get("slot")) is int:
            offered[slot["slot"]] = recovery
    for slot, fingerprint in picks.items():
        recovery = offered.get(slot)
        if not recovery or recovery.get("fingerprint") != fingerprint or (action == "resume" and recovery.get("resumable") is not True):
            return 409, {"error": "sessions changed; refresh and choose again", "actions": runner.snapshot()}
    tokens = [f"{slot}:{picks[slot]}" for slot in sorted(picks)]
    if not runner.start(action, ["recover", action] + tokens, target=None):
        return 409, {"error": "another action is still running", "actions": runner.snapshot()}
    return 202, {"actions": runner.snapshot()}


def cached_status(source):
    try:
        return source.get()
    except Exception:  # an unreadable status offers nothing to act on
        return None


def backend_services(source):
    try:
        services = (source.get().get("backend") or {}).get("services") or {}
        return {name for name in services if isinstance(name, str)}
    except Exception:  # an unreadable status means no service can be confirmed
        return set()


def slot_branches(source):
    try:
        return {slot.get("branch") for slot in source.get().get("slots") or [] if slot.get("branch")}
    except Exception:  # an unreadable status means no branch can be confirmed
        return set()


def make_handler(source, runner, port):
    class Handler(BaseHTTPRequestHandler):
        def send(self, code, body, content_type):
            payload = body.encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(payload)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(payload)

        def do_GET(self):
            path = self.path.split("?", 1)[0]
            if path == "/":
                self.send(200, render_html(), "text/html; charset=utf-8")
            elif path == "/api/status":
                try:
                    self.send(200, json.dumps(dict(source.get(), actions=runner.snapshot())), "application/json")
                except Exception as error:  # report any failure as a 502 to the page
                    self.send(502, json.dumps({"error": str(error) or type(error).__name__}), "application/json")
            elif path == "/api/actions":
                self.send(200, json.dumps({"actions": runner.snapshot()}), "application/json")
            else:
                self.send(404, json.dumps({"error": "not found"}), "application/json")

        def do_POST(self):
            path = self.path.split("?", 1)[0]
            recovery_route = path in ("/api/recovery/resume", "/api/recovery/forget")
            if recovery_route and not same_origin(self.headers, port):
                # Refuse before reading the body or touching status; the connection closes so the unread body cannot linger.
                self.close_connection = True
                self.send(403, json.dumps({"error": "forbidden"}), "application/json")
                return
            raw = self.rfile.read(min(int(self.headers.get("Content-Length") or 0), 65536))
            if path == "/api/slot/stop":
                try:
                    body = json.loads(raw or b"{}")
                except ValueError:
                    body = None
                code, body = handle_slot_stop(runner, body, self.headers, port, slot_branches(source))
            elif path == "/api/backend/restart":
                try:
                    body = json.loads(raw or b"{}")
                except ValueError:
                    body = None
                code, body = handle_service_restart(runner, body, self.headers, port, backend_services(source))
            elif recovery_route:
                try:
                    body = json.loads(raw or b"{}")
                except ValueError:
                    body = None
                code, body = handle_recovery(runner, path.rsplit("/", 1)[1], body, self.headers, port, cached_status(source))
            elif path.startswith("/api/backend/"):
                code, body = handle_action(runner, path.rsplit("/", 1)[1], self.headers, port)
            else:
                code, body = 404, {"error": "not found"}
            self.send(code, json.dumps(body), "application/json")

        def log_message(self, format, *args):
            sys.stderr.write("qa-dashboard: " + format % args + "\n")

    return Handler


def main():
    parser = argparse.ArgumentParser(description="Overseer: local QA status dashboard")
    parser.add_argument("--render-once", action="store_true", help="print the HTML for the current status and exit")
    parser.add_argument("--status-file", help="read status JSON from this file instead of running wt")
    args = parser.parse_args()
    source = StatusSource(args.status_file)
    if args.render_once:
        try:
            sys.stdout.write(render_html(source.get()))
        except Exception as error:
            sys.stderr.write(f"qa-dashboard: {error}\n")
            return 1
        return 0
    port = int(os.environ.get("QA_DASHBOARD_PORT", "5100"))
    server = ThreadingHTTPServer(("127.0.0.1", port), make_handler(source, ActionRunner(on_finish=source.invalidate), port))
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
