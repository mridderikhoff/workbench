      ].join("\n");
    })(),
    // A wooden desk with a felt pad and putty plastic panels. No props: the floppies and the mug did not share the character's art.
    desk: {seed: 41, surface: "wood", blotter: "velvet", stock: "plastic",
      dark: {surface: {ramp: ["#0a0705", "#120c08", "#1a120c", "#24180f"], seam: "#050302"}, blotter: {ramp: ["#101410", "#151a15", "#1b211b"]},
        stock: {ramp: ["#322e27", "#36322a", "#3b372e"]}},
      light: {surface: {ramp: ["#8a6440", "#9c7449", "#ad8454", "#bd9462"], seam: "#6b4a2c"}, blotter: {ramp: ["#5d6a5b", "#677464", "#717e6e"]},
        stock: {ramp: ["#d6ceb7", "#ddd5bf", "#e3dcc8"]}}},
    copy: {emptyTitle: "No sessions running"}
  };
