/* ===== end THEMES ================================================================= */
var QA_THEME = (function () {
  var active = null, query = new URLSearchParams(location.search), systemDark = window.matchMedia("(prefers-color-scheme: dark)");
  // Appearance: "system" follows the OS live, "dark" and "light" force the scheme. Read here so it is applied before first paint.
  function pickScheme() {
    var value = query.get("scheme");
    if (!/^(system|dark|light)$/.test(value)) { try { value = localStorage.getItem("qaDashboardScheme") } catch (e) { value = null } }
    return /^(dark|light)$/.test(value) ? value : "system";
  }
  var schemePreference = pickScheme();
  var backgroundId = "plain";
  function pickBackground(theme) {
    var backgrounds = theme.backgrounds || {}, value = query.get("bg");
    if (!backgrounds[value]) { try { value = localStorage.getItem("qaDashboardBackground") } catch (e) { value = null } }
    return backgrounds[value] ? value : (backgrounds[theme.defaultBackground] ? theme.defaultBackground : "plain");
  }
  function showBackground(theme) {
    var entry = (theme.backgrounds || {})[backgroundId], root = document.documentElement;
    root.setAttribute("data-bg", backgroundId);
    root.setAttribute("data-bg-kind", entry ? entry.kind : "none");
  }
  function pick() {
    var name = query.get("theme");
    if (!THEMES[name]) { try { name = localStorage.getItem("qaDashboardTheme") } catch (e) { name = null } }
    return THEMES[name] ? name : "blood";
  }
  function block(vars) { return Object.keys(vars).map(function (key) { return key + ":" + vars[key] }).join(";") }
  // Film grain as one small pre-rendered tile of plain alpha noise. "multiply" grain darkens with black and "screen" grain
  // lightens with white; at these opacities that matches blending the noise with mix-blend-mode, without a full-page blend layer.
  function grainTile(vars) {
    try {
      var size = 128, canvas = document.createElement("canvas");
      canvas.width = canvas.height = size;
      var context = canvas.getContext("2d"), image = context.createImageData(size, size), seed = 1234567;
      var lighten = vars["--grain-blend"] === "screen", opacity = parseFloat(vars["--grain"]) || 0;
      var next = function () { seed = seed + 0x6D2B79F5 | 0; var t = Math.imul(seed ^ seed >>> 15, 1 | seed); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296 };
      var bell = function () { return (next() + next() + next()) / 3 };
      for (var i = 0; i < size * size; i++) {
        var tone = bell(), coverage = bell(), alpha = opacity * coverage * (lighten ? tone : 1 - tone);
        image.data[i * 4] = image.data[i * 4 + 1] = image.data[i * 4 + 2] = lighten ? 255 : 0;
        image.data[i * 4 + 3] = Math.round(alpha * 255);
      }
      context.putImageData(image, 0, 0);
      return 'url("' + canvas.toDataURL("image/png") + '")';
    } catch (e) { return "none" }
  }
  function apply(name) {
    var theme = THEMES[name] || THEMES.blood, fonts = theme.fonts;
    active = {id: THEMES[name] ? name : "blood", theme: theme};
    backgroundId = pickBackground(theme);showBackground(theme);
    var style = document.getElementById("theme-style");
    if (!style) { style = document.createElement("style"); style.id = "theme-style"; document.head.appendChild(style) }
    // data-scheme is "system", "dark" or "light": the media query applies only unless light is forced, and a forced dark wins by specificity.
    var dark = block(theme.css.dark) + ";--grain-image:" + grainTile(theme.css.dark);
    style.textContent = ":root{" + block(theme.css.light) + ";--grain-image:" + grainTile(theme.css.light) + ";--serif:" + fonts.serif + ";--mono:" + fonts.mono + ";--body:" + fonts.body + "}" +
      "@media (prefers-color-scheme:dark){:root:not([data-scheme=\"light\"]){" + dark + "}}" +
      ":root[data-scheme=\"dark\"]{color-scheme:dark;" + dark + "}:root[data-scheme=\"light\"]{color-scheme:light}" + (theme.headerMark.underlineCss || "");
    document.documentElement.setAttribute("data-scheme", schemePreference);
    document.documentElement.setAttribute("data-theme", active.id);
    var icon = document.querySelector('link[rel="icon"]');
    if (icon) { icon.href = "data:image/svg+xml," + encodeURIComponent(theme.favicon); icon.dataset.state = "" }
    document.dispatchEvent(new CustomEvent("qa-theme"));
  }
  apply(pick());
  return {
    current: function () { return active.theme },
    id: function () { return active.id },
    schemePreference: function () { return schemePreference },
    background: function () { return backgroundId },
    backgrounds: function () { return active.theme.backgrounds || {} },
    chooseBackground: function (id) {
      if (!(active.theme.backgrounds || {})[id]) return;
      try { localStorage.setItem("qaDashboardBackground", id) } catch (e) {}
      backgroundId = id;showBackground(active.theme);
      document.dispatchEvent(new CustomEvent("qa-bg"));
    },
    isDark: function () { return schemePreference === "dark" || (schemePreference === "system" && systemDark.matches) },
    chooseScheme: function (value) {
      if (!/^(system|dark|light)$/.test(value)) return;
      try { localStorage.setItem("qaDashboardScheme", value) } catch (e) {}
      schemePreference = value;
      document.documentElement.setAttribute("data-scheme", value);
      document.dispatchEvent(new CustomEvent("qa-scheme"));
    },
    choose: function (name) { try { localStorage.setItem("qaDashboardTheme", name) } catch (e) {} apply(name) },
    glyph: function (tone) { var glyphs = active.theme.statusGlyphs; return glyphs[tone] || glyphs.unknown },
    favicon: function (state) {
      var icons = active.theme.favicons, svg = icons && icons[state] || active.theme.favicon, icon = document.querySelector('link[rel="icon"]');
      if (icon && icon.dataset.state !== state) { icon.href = "data:image/svg+xml," + encodeURIComponent(svg); icon.dataset.state = state }
    },
    copy: function (key, fallback) { var copy = active.theme.copy; return copy && copy[key] || fallback }
  };
})();
</script>
</head><body class="loading">
<script>
"use strict";
// Pixel-art page background: one low-resolution canvas scaled with nearest-neighbour, drawn from the active theme's `backgrounds` entry.
var QA_BG=(function(){
  var canvas=document.createElement("canvas"),ctx=canvas.getContext("2d"),reduced=window.matchMedia("(prefers-reduced-motion: reduce)");
  canvas.id="bg-canvas";canvas.setAttribute("aria-hidden","true");document.body.insertBefore(canvas,document.body.firstChild);
  var BAYER=[0,8,2,10,12,4,14,6,3,11,1,9,15,7,13,5];
  var timer=0,cols=0,rows=0,cell=6,image=null,pixels=null,running=null,resizeTimer=0;
  function bayer(x,y){return(BAYER[(y&3)*4+(x&3)]+0.5)/16}
  function pack(hex){var n=parseInt(hex.slice(1),16);return(255<<24|(n&255)<<16|(n>>8&255)<<8|n>>16)>>>0}
  function seeded(seed){return function(){seed=seed+0x6D2B79F5|0;var t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
  function config(){var theme=QA_THEME.current();return theme.backgrounds&&theme.backgrounds[QA_THEME.background()]||{kind:"none"}}
  function sprite(width,height,paint){
    var piece=document.createElement("canvas");piece.width=width;piece.height=height;
    var pieceContext=piece.getContext("2d"),data=pieceContext.createImageData(width,height),words=new Uint32Array(data.data.buffer);
    for(var y=0;y<height;y++)for(var x=0;x<width;x++){var color=paint(x,y);if(color)words[y*width+x]=color}
    pieceContext.putImageData(data,0,0);return piece;
  }
  function resize(){
    var bookPage=config().kind==="book";
    cell=config().cell||6;cols=Math.ceil(innerWidth/cell);
    if(bookPage)canvas.style.height="0px";
    rows=Math.ceil((bookPage?Math.max(innerHeight,document.body.scrollHeight):innerHeight)/cell);
    canvas.width=cols;canvas.height=rows;canvas.style.width=cols*cell+"px";canvas.style.height=rows*cell+"px";
    image=ctx.createImageData(cols,rows);pixels=new Uint32Array(image.data.buffer);
  }
  function stop(){clearTimeout(timer);timer=0;running=null}

  /* ---- candles: many candles of varied size, each with a flickering flame and a wide dithered glow that swaps between pre-rendered frames at
     irregular moments; a static dithered wash along the bottom joins the glows into one warm ambient light ---- */
  var FLAMES=[[".c.",".a.","aba","aba",".a."],["c..",".a.","aba","aba",".a."],["..c",".a.","aba","aba",".a."],[".c.","aa.","aba","aba",".a."],[".c.",".aa","aba","aba",".a."]];
  var GLOW_RADII={2:[46,52,58],3:[62,70,78]},GLOW_PEAK=0.85;
  function candles(cfg,palette){
    var glowColors=palette.glow.map(pack),flameColors={a:pack(palette.flame[0]),b:pack(palette.flame[1]),c:pack(palette.flame[2])};
    function glowFrames(radii){
      return radii.map(function(radius){
        return sprite(radius*2+1,radius*2+1,function(x,y){
          var level=Math.floor((1-Math.hypot(x-radius,(y-radius)*1.15)/radius)*GLOW_PEAK*3.4+(bayer(x,y)-0.5));
          return level<=0?0:glowColors[Math.min(2,level-1)];
        });
      });
    }
    var glowSets={2:glowFrames(GLOW_RADII[2]),3:glowFrames(GLOW_RADII[3])};
    var flames=FLAMES.map(function(rowsOfFlame){return sprite(3,5,function(x,y){var key=rowsOfFlame[y].charAt(x);return flameColors[key]||0})});
    var washRows=Math.round(rows/3),wash=sprite(cols,washRows,function(x,y){
      var level=Math.floor((y/washRows)*1.6+(bayer(x,y)-0.5));
      return level<=0?0:glowColors[0];
    });
    var waxLight=pack(palette.wax[0]),waxDark=pack(palette.wax[1]);
    var list=cfg.candles.map(function(spec,index){
      var width=spec.width,body=sprite(width,spec.height,function(x,y){
        if(y===0&&x%2===0)return waxLight;
        if(y>0&&y%7===3&&x===width-2)return waxLight;
        return x<width-Math.max(2,Math.round(width/3))?waxLight:waxDark;
      });
      return{x:Math.round(cols*spec.x-width/2),width:width,height:spec.height,sink:spec.sink||0,scale:spec.flame||2,body:body,glow:1,flame:index%5,glowDue:0,flameDue:0};
    });
    function pick(count,not){var value=Math.floor(Math.random()*count);return value===not?(value+1)%count:value}
    function draw(){
      ctx.imageSmoothingEnabled=false;
      ctx.clearRect(0,0,cols,rows);
      ctx.drawImage(wash,0,rows-washRows);
      list.forEach(function(candle){
        var frames=glowSets[candle.scale]||glowSets[2],radius=GLOW_RADII[candle.scale===3?3:2][candle.glow];
        ctx.drawImage(frames[candle.glow],candle.x+(candle.width>>1)-radius,rows-candle.height+candle.sink-candle.scale*3-radius);
      });
      list.forEach(function(candle){
        var top=rows-candle.height+candle.sink;
        ctx.drawImage(candle.body,candle.x,top);
        ctx.drawImage(flames[candle.flame],candle.x+(candle.width>>1)-((candle.scale*3)>>1),top-candle.scale*5-1,candle.scale*3,candle.scale*5);
      });
    }
    function step(){
      var now=performance.now(),changed=false;
      list.forEach(function(candle){
        if(now>=candle.flameDue){candle.flame=pick(FLAMES.length,candle.flame);candle.flameDue=now+60+Math.random()*260;changed=true}
        if(now>=candle.glowDue){candle.glow=pick(3,candle.glow);candle.glowDue=now+200+Math.random()*1100;changed=true}
      });
      if(changed)draw();
      timer=setTimeout(step,100);
    }
    draw();
    return reduced.matches?null:step;
  }

  /* ---- book: an open spread of two aged pages with a gutter shadow, stacked page edges, deckled borders and one dog-eared corner. Drawn once. ---- */
  function book(cfg,palette){
    var next=seeded(cfg.seed||19),paper=palette.paper.map(pack),gutter=pack(palette.gutter),fox=pack(palette.fox),ink=pack(palette.ink);
    var edge=palette.edge.map(pack),desk=pack(palette.desk),underside=pack(palette.underside),shadow=pack(palette.shadow);
    var x,y,k,margin=6,stack=5,singlePage=innerWidth<900,centre=singlePage?margin+stack:cols>>1,gutterWidth=singlePage?6:Math.min(13,cols>>2);
    function walk(length,limit){var out=[],value=Math.floor(next()*limit);for(var i=0;i<length;i++){if(next()<0.35)value=Math.max(0,Math.min(limit,value+(next()<0.5?-1:1)));out.push(value)}return out}
    var left=walk(rows,3),right=walk(rows,3),top=walk(cols,3),bottom=walk(cols,3);
    function onPage(px,py){return px>=margin+stack+left[py]&&px<cols-margin-stack-right[py]&&py>=margin+top[px]&&py<rows-margin-bottom[px]}
    var fold=Math.min(18,rows>>3),cornerX=cols-margin-stack-2,cornerY=rows-margin-2;
    for(y=0;y<rows;y++)for(x=0;x<cols;x++){
      var color=desk;
      if(onPage(x,y)){
        var toEdge=Math.min(x-(margin+stack),cols-margin-stack-x,y-margin,rows-margin-y),toGutter=Math.abs(x-centre)/gutterWidth;
        var level=0;
        if(toGutter<1)level=Math.floor((1-toGutter)*3.4+bayer(x,y)-0.5);
        if(level>=3)color=gutter;
        else{
          var tone=Math.max(0,level);
          if(toEdge<14&&bayer(x,y)*14>toEdge)tone=Math.max(tone,1);
          if(toEdge<5&&bayer(x+2,y+1)*5>toEdge)tone=2;
          if(tone===0&&next()<0.04)tone=1;
          color=paper[Math.min(2,tone)];
        }
      }else{
        for(k=1;k<=stack;k++){
          var strip=(x===margin+stack-k+left[Math.min(rows-1,y)]&&y>margin+k&&y<rows-margin-k)||(x===cols-margin-stack+k-1-right[Math.min(rows-1,y)]&&y>margin+k&&y<rows-margin-k);
          if(strip){color=edge[k&1];break}
        }
      }
      pixels[y*cols+x]=color;
    }
    function put(px,py,value){if(px>=0&&py>=0&&px<cols&&py<rows)pixels[py*cols+px]=value}
    for(k=0;k<46;k++){
      var side=next()<0.5?-1:1,spread=Math.max(0,cols/2-gutterWidth-margin-stack-4);
      var spotX=singlePage?Math.round(margin+stack+5+next()*Math.max(0,cols-2*(margin+stack+5))):Math.round(centre+side*(gutterWidth+next()*spread));
      var spotY=Math.round(margin+4+next()*Math.max(0,rows-2*margin-8)),radius=1.5+next()*3.5;
      for(var j=-6;j<=6;j++)for(var i=-6;i<=6;i++){
        var fall=1-Math.hypot(i,j)/radius;
        if(fall>0&&onPage(spotX+i,spotY+j)&&fall>bayer(spotX+i,spotY+j)*0.9)put(spotX+i,spotY+j,fox);
      }
    }
    for(y=margin+12;y<rows-margin-10;y+=5){
      for(x=margin+stack+10;x<cols-margin-stack-10;x++){
        if((!singlePage&&Math.abs(x-centre)<gutterWidth*0.5)||!onPage(x,y))continue;
        put(x,y,ink);
      }
      var cursor=margin+stack+12;
      while(cursor<cols-margin-stack-12){
        var run=2+Math.floor(next()*6);
        if((singlePage||Math.abs(cursor-centre)>gutterWidth*0.6)&&next()<0.6)for(var d=0;d<run;d++)put(cursor+d,y-1,ink);
        cursor+=run+1+Math.floor(next()*3);
      }
    }
    // dog-ear: the corner beyond the fold line is gone, and its mirror image folds over as a lighter, shaded underside with a small cast shadow
    for(y=cornerY-fold-4;y<=cornerY;y++)for(x=cornerX-fold-4;x<=cornerX;x++){
      var across=(cornerX-x)+(cornerY-y);
      if(across<fold)put(x,y,desk);
      else if(x>=cornerX-fold&&y>=cornerY-fold&&across<fold*2){
        var gradient=Math.floor((across-fold)/fold*2.4+bayer(x,y));
        put(x,y,gradient>=2?paper[1]:underside);
      }else if(across<fold*2+3&&across>=fold&&bayer(x,y)>0.35)put(x,y,shadow);
    }
    ctx.putImageData(image,0,0);
    return null;
  }

  /* ---- fog: smoky grey-red bands from value noise, ordered-dithered at their edges, drifting in steps ---- */
  function fog(cfg,palette){
    var tones=palette.tones.map(pack),next=seeded(41),lattice=new Float32Array(4096),i;
    for(i=0;i<4096;i++)lattice[i]=next();
    function noise(x,y){
      var xi=Math.floor(x),yi=Math.floor(y),fx=x-xi,fy=y-yi;fx=fx*fx*(3-2*fx);fy=fy*fy*(3-2*fy);
      var a=lattice[(yi&63)*64+(xi&63)],b=lattice[(yi&63)*64+((xi+1)&63)],c=lattice[((yi+1)&63)*64+(xi&63)],d=lattice[((yi+1)&63)*64+((xi+1)&63)];
      return a+(b-a)*fx+(c-a)*fy+(a-b-c+d)*fx*fy;
    }
    function draw(seconds){
      var t=Math.floor(seconds*(cfg.fps||6))/(cfg.fps||6);
      for(var y=0;y<rows;y++){
        var lift=0.8+0.2*y/rows;
        for(var x=0;x<cols;x++){
          var n=(0.6*noise(x*0.06+t*0.05,y*0.085)+0.4*noise(x*0.13-t*0.07+31,y*0.17+t*0.02))*lift;
          var level=Math.floor((n-0.3)*5+(bayer(x,y)-0.5));
          pixels[y*cols+x]=level<=0?0:tones[Math.min(2,level-1)];
        }
      }
      ctx.putImageData(image,0,0);
    }
    draw(0);
    if(reduced.matches)return null;
    var begun=performance.now();
    return function step(){draw((performance.now()-begun)/1000);timer=setTimeout(step,1000/(cfg.fps||6))};
  }

  var KINDS={candles:candles,book:book,fog:fog};
  function start(){
    stop();
    var cfg=config(),make=KINDS[cfg.kind];
    if(!make)return;
    resize();
    var palette=cfg[QA_THEME.isDark()?"dark":"light"]||cfg.dark;
    running=make(cfg,palette);
    if(running&&!document.hidden)timer=setTimeout(running,100);
  }
  document.addEventListener("qa-scheme",start);document.addEventListener("qa-bg",start);document.addEventListener("qa-theme",start);
  document.addEventListener("qa-layout",function(){if(config().kind==="book")start()});
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change",start);
  if(reduced.addEventListener)reduced.addEventListener("change",start);
  window.addEventListener("resize",function(){clearTimeout(resizeTimer);resizeTimer=setTimeout(start,200)});
  document.addEventListener("visibilitychange",function(){
    if(document.hidden){clearTimeout(timer);timer=0}
    else if(running&&!timer)timer=setTimeout(running,50);
  });
  start();
  return{start:start};
})();
</script>
