<script>
"use strict";
// ?perf=1 logs animation-callback counts and long tasks to the console every 2s without adding frames of its own.
var QA_PERF=(function(){
  if(new URLSearchParams(location.search).get("perf")!=="1")return null;
  var raf=window.requestAnimationFrame.bind(window),stats={frames:0,busyMs:0,worstMs:0,longTasks:[],renders:0,cardsRebuilt:0};
  window.requestAnimationFrame=function(callback){return raf(function(time){var began=performance.now();callback(time);var spent=performance.now()-began;stats.frames++;stats.busyMs+=spent;if(spent>stats.worstMs)stats.worstMs=spent})};
  try{new PerformanceObserver(function(list){list.getEntries().forEach(function(entry){stats.longTasks.push(Math.round(entry.duration))})}).observe({entryTypes:["longtask"]})}catch(e){}
  setInterval(function(){
    console.log("perf "+JSON.stringify({animationCallbacksPerSecond:stats.frames/2,callbackMsAverage:+(stats.busyMs/Math.max(1,stats.frames)).toFixed(2),callbackMsWorst:+stats.worstMs.toFixed(1),longTasksMs:stats.longTasks,renders:stats.renders,cardsRebuilt:stats.cardsRebuilt}));
    stats.frames=stats.busyMs=stats.worstMs=stats.renders=stats.cardsRebuilt=0;stats.longTasks=[];
  },2000);
  return stats;
})();
/* ===== THEMES =====================================================================
How to add a theme: add one entry to THEMES below; the shared SCENES registry supplies layout and picker labels.
  name          label in the theme picker
  artPitch      shared eye and page-background pixel pitch in CSS px (Blood uses 4.5)
  css           {light:{...}, dark:{...}} custom properties; provide every key that "blood" provides
                (--grain is the noise opacity and --grain-blend is "multiply" or "screen"; both are baked into a tile)
  fonts         {serif, mono, body} font stacks
  favicon       SVG string for the tab icon
  headerMark    {eye, travel, lid, underlineCss}
                  eye: SVG string with hooks data-eye-iris (moved), data-eye-pupil (circle or stepped path, resized),
                       data-eye-lid (upper lid, flipped about lid.pivot to blink), data-eye-cover (rect hiding the iris)
                  travel: [rx, ry] pupil travel in viewBox units; lid: {pivot, top, closed} in viewBox units
                  underlineCss: CSS rules for .mark::after (the title underline art)
  logoSource    SVG string, 64x64 viewBox, transparent background; the halftone eye samples its opaque pixels
  anatomy       optional {iris:[x, y, r], pupil:r, tips:[[x, tipY, topY], ...]} in logo units;
                needed by the "watcher" and "bleeding" modes
  palette       {light:[5 colours], dark:[5 colours]} halftone ramp, darkest first
  statusGlyphs  {ok, warn, broken, down, attn, unknown} SVG strings drawn with currentColor, distinct shapes;
                coloured by --glyph-ok, --warn, --glyph-bad and --idle
  brushStroke   {colors:{core, edge}, presets:{name:{weight, taperIn, taperOut, wobble, bristles, dryEnd, hook,
                drips:[min,max], dripLength, spatter:[min,max]}}} for generated underlines; omit to keep underlineCss
  actionIcons   {copy, terminal, stop} SVG strings in the same 24-unit filled family as statusGlyphs
  folioArt      SVG mask source for the mirrored engraved title finials and framed plate corner
  settingsIcon  SVG string for the settings button in the same 24-unit family
  favicons      {ok, warn, bad, badDim, down} SVG strings: ok calm open eye, warn half-open, bad crying
                (alternates with badDim), down closed eye with a tear
  statusGlyphs.awake  optional open-eye glyph with a .glyph-pupil, shown when a ready app pill is hovered
  backgrounds   ambient assets used by scenes, not picker options. Supply "desk" for Desk, "book" for Book and "console" for
                Console; each has its kind; the Console painter takes its colours from consoleArt. Extra assets can remain unselected.
                The "desk" kind is painted once per scheme into tiles (no loop):
                  {kind: "desk", seed, surface, blotter, stock: material ids ("wood", "leather", "metal", "mat", "paper", "acrylic"),
                   deckle: true tears the eye card's bottom edge and folds a dog-ear, glow: {color, core} pre-renders a tube glow
                   under the wordmark, props: [{art: SVG, side: "left"|"right", offset, bottom, width, height, rotate, flip,
                   lights: [[x%, y%, size px], ...]}] (lights flicker; hidden below 1400px),
                   dark/light: {surface: {ramp, seam}, blotter: {ramp, grid, grid2}, stock: {ramp, fiber, fox}, fog: colour}}
                  ramps are 3-4 hex colours, darkest first. The painter exposes --desk-surface, --desk-blotter, --desk-stock,
                  --desk-fog, --desk-grit (a rubber-stamp mask), --desk-glow and --deckle to CSS.
  deskArt       optional {mount, badge, drip} SVG strings for Desk: mount holds the eye card down (tape, sticker), badge sits
                on its corner (a wax seal), drip hangs off the Sessions card's bottom edge
  deskCss       optional CSS string for this theme's Desk flourishes (lighting, blotter, tag shapes, dialog mounts); scope
                every rule to html[data-theme="<id>"][data-scene="desk"]. Desk also reads these css keys: --desk-floor,
                --desk-card, --desk-card2, --edge-*, --age, --contact, --lift, --emb-*, --well, --stamp-ok, --rule-ink*, --tag*,
                --btn-*, --head-case, --head-variant, --head-spacing, --dim, plus the lighting keys --pool* and --flicker-*
  inkGlyphs     optional statusGlyphs set (same keys, including awake) drawn as brush ink; Desk uses it instead of the
                pixel glyphs so marks match the halftone and brush language. inkIcons does the same for {copy, terminal, stop,
                settings}. Omit both to keep the pixel set in Desk too (Neon does, since pixels suit its retro-PC look).
  halftoneOverprint  optional {dx, dy, scale, alpha, dark: {color, blend}, light: {color, blend}}: a second ink pass of the
                halftone eye, offset by (dx, dy) px for misregistration; blend is a canvas composite mode ("screen", "multiply")
  glitch        optional {every: [min, max] s, frames: [min, max], shift: [min, max] px, bands: [min, max]}: the halftone
                eye occasionally slips a few horizontal slices sideways
  brushStroke.rule   optional preset (with optional colors) for the seeded dividers between sessions in Desk
  brushStroke.overprint   optional {color, dx, dy, opacity}: every stroke is also printed in a second, offset ink
  consoleArt    {dark, light} colours for the static control room, portrait window, and shared pixel plate frame.
  SCENES        shared {desk, book, console} registry maps each layout to an asset id. The default scene is Desk.
  eyeModes      ids from the shared modes ("watcher", "coin", "bleeding", "off"), or custom renderer objects
                {id, label, init(engine), frame(engine, t), dispose(engine)}; "coin" and "off" need only logoSource
  copy          optional text overrides: {emptyTitle, characterName}; characterName labels the Console portrait
Minimal skeleton:
  THEMES.cthulhu = {
    name: "Cthulhu",
    artPitch: 4.5,
    css: {light: {...}, dark: {...}},
