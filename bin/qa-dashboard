<script>
"use strict";
var INITIAL=/*INITIAL*/null/*END*/;
var APP_NAMES={ri:"RI","ds-demo":"ds-demo",strategy:"Strategy"};
var tenantInput=document.getElementById("tenant");
try{tenantInput.value=localStorage.getItem("qaDashboardTenant")||"mridderikhoff"}catch(e){}
var data=null,lastOk=null,failure=null,actionError=null,outputOpen=false,servicesOpen=false,pollTimer=null;
function esc(s){return String(s==null?"":s).replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
function tone(state,attn){
  if(attn)return"attn";
  var s=String(state||"").toLowerCase();
  if(/^ready|^active|healthy/.test(s))return"ok";
  if(/attention/.test(s))return"attn";
  if(/fail|down|error|unhealthy|not ready/.test(s))return"bad";
  if(/listening|degraded|starting|activating/.test(s))return"warn";
  return"";
}
function dot(t){return'<span class="dot '+(t||"unknown")+'">'+QA_THEME.glyph(t||"unknown")+'</span>'}
function agoText(iso){
  if(!iso)return"";var s=Math.max(0,Math.round((Date.now()-new Date(iso).getTime())/1000));
  return s<60?s+"s":s<3600?Math.floor(s/60)+"m":s<86400?Math.floor(s/3600)+"h":Math.floor(s/86400)+"d";
}
function clock(iso){return iso?new Date(iso).toLocaleTimeString():""}
function currentAction(){return data&&data.actions}
function isRunning(){var a=currentAction();return!!(a&&a.state==="running")}
var ACTION_LABELS={heal:["Heal","Healing&hellip;"],update:["Update to develop","Updating&hellip;"],ensure:["Start backend","Starting&hellip;"]};
var ACTION_VERBS={heal:"Heal",update:"Update",ensure:"Backend start",stop:"Stop"};
function actionButton(name,idle){
  var a=currentAction(),busy=isRunning()&&a.action===name,labels=ACTION_LABELS[name];
  var label=busy?labels[1]:(idle||labels[0]);
  return'<button type="button" class="act" data-action="'+name+'"'+(isRunning()?" disabled":"")+'>'+label+'</button>';
}
function renderActionResult(){
  var a=currentAction();
  if(!a&&!actionError)return"";
  var h='<div class="action-result" aria-live="polite">';
  if(a){
    var verb=(ACTION_VERBS[a.action]||a.action)+(a.target?" "+a.target:""),text,t;
    if(a.state==="running"){text=verb+" running since "+clock(a.startedAt);t="warn"}
    else if(a.state==="ok"){text=verb+" finished at "+clock(a.endedAt);t="ok"}
    else{text=verb+" failed"+(a.exitCode!=null?" (exit "+a.exitCode+")":"")+" at "+clock(a.endedAt);t="bad"}
    h+='<span>'+dot(t)+esc(text)+'</span>';
    if(a.output&&a.output.length)h+='<details id="action-output"'+(outputOpen?" open":"")+'><summary>show output</summary><pre>'+esc(a.output.join("\n"))+'</pre></details>';
  }
  if(actionError)h+='<span class="error">'+esc(actionError)+'</span>';
  return h+'</div>';
}
function renderBackend(b){
  if(!b)return'<div class="muted">No backend data.</div>';
  var behind=/behind|attached|not develop/i.test(b.relation||"");
  var h='<div class="head"><span class="title">Backend</span>'+
    (behind?actionButton("update",esc(b.relation.charAt(0).toUpperCase()+b.relation.slice(1))+" &middot; update"):'<span class="pill">'+esc(b.relation||"?")+'</span>')+
    '<span class="muted">sha <code>'+esc(b.sha||"?")+'</code></span>'+
    (b.dirty?'<span class="pill" style="color:var(--warn)">dirty: '+esc(b.dirty)+'</span>':"")+
    '<span class="state tone-'+(tone(b.overall)||"unknown")+'">'+dot(tone(b.overall)==="ok"?"ok":"bad")+esc(b.overall||"unknown")+'</span>'+
    (tone(b.overall)==="bad"?actionButton("ensure"):"")+(tone(b.overall)!=="ok"?actionButton("heal"):"")+'</div>'+renderActionResult();
  var svcs=b.services||{},names=Object.keys(svcs);
  var attnOf=function(s){return!!s.needsAttention||/attention/i.test(s.status||"")};
  var healthy=tone(b.overall)==="ok"&&names.every(function(n){var s=svcs[n];var t=tone(s.status||s.probe);return!attnOf(s)&&t!=="bad"&&t!=="attn"});
  if(healthy&&!servicesOpen){
    return h+'<div class="chips">'+names.map(function(n){var s=svcs[n];
      var t=tone(s.status||s.probe);
      return'<span class="chip tone-'+(t||"unknown")+'" title="'+esc(s.status||s.probe||s.unitState)+'">'+dot(t)+esc(n)+'</span>'}).join("")+
      '<button type="button" class="link" data-toggle="services" aria-expanded="false">show details</button></div>';
  }
  names.forEach(function(n){
    var s=svcs[n],attn=attnOf(s);
    var t=tone(s.status||s.probe,attn);
    h+='<div class="svc tone-'+(t||"unknown")+(attn?" attn":"")+'">'+dot(t)+
      '<span class="name">'+esc(n)+'</span><span>'+esc(s.status||s.probe||s.unitState)+'</span>'+
      (s.restartCount?'<span class="muted small">restarts '+esc(s.restartCount)+'</span>':"")+'</div>';
  });
  if(healthy)h+='<button type="button" class="link" data-toggle="services" aria-expanded="true">hide details</button>';
  return h;
}
function appUrl(a){
  var url=a.url||"";
  if(url.indexOf("<tenant>")>=0){
    var t=tenantInput.value.trim();
    url=t?url.split("<tenant>").join(encodeURIComponent(t)):url.split("<tenant>")[0];
  }
  return url;
}
// Down or not ready beats a failed build, which beats rebuilding, which beats ok.
function appStatus(a){
  var build=a.build&&a.build.state;
  if(!a.httpReady)return a.unitState==="active"?{tone:"warn",label:"starting"}:{tone:"bad",label:a.unitState||"down"};
  if(build==="failed"){var errors=a.build.errorCount;return{tone:"bad",label:"build failed"+(errors?" \u00b7 "+errors+" error"+(errors===1?"":"s"):""),failed:true}}
  if(build==="building")return{tone:"warn",label:"rebuilding"};
  return{tone:"ok",label:""};
}
function hashText(text){var h=2166136261;for(var i=0;i<text.length;i++){h^=text.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0}
// The fill's leading edge is ragged and wet; seeded per pill so each one seeps differently.
function seepFill(seed){
  var points=["0 0","100 0"],value=seed;
  for(var y=4;y<=40;y+=4){value=Math.imul(value^value>>>13,1274126177)>>>0;points.push((100+(value%1400)/100).toFixed(1)+" "+y)}
  points.push("0 40");
  return'<svg class="seep-fill" viewBox="0 0 114 40" preserveAspectRatio="none" aria-hidden="true"><path style="fill:var(--seep)" d="M'+points.join("L")+'Z"/></svg>';
}
function buildFailed(a){return!!(a.httpReady&&a.build&&a.build.state==="failed")}
function appPill(a){
  var name=APP_NAMES[a.app]||a.app||"app",url=appUrl(a),ready=!!a.httpReady&&!!url,status=appStatus(a);
  var state=status.label||(a.httpReady&&!url?"no link":"");
  var inner=dot(status.tone)+'<span class="app-name">'+esc(name)+'</span>'+
    (status.failed?'<span class="build-failed">'+esc(state)+'</span>':
    (state||a.startedAt?'<span class="port">'+[state&&esc(state),a.httpReady&&a.startedAt&&agoText(a.startedAt)+" alive"].filter(Boolean).join(" &middot; ")+'</span>':""));
  var since=a.startedAt?" (dev server started "+clock(a.startedAt)+"; if your tab is older, hard-refresh)":"";
  var title=status.failed?"Build failed: "+(a.build.error||"see the browser overlay"):"Open "+name+" on :"+a.port+since;
  if(ready){
    var seed=hashText(name+":"+a.port),awake=inner.replace(dot(status.tone),dot(status.tone==="ok"?"awake":status.tone));
    var seep='<span class="seep" aria-hidden="true">'+seepFill(seed)+'<span class="seep-text">'+awake+'</span></span><span class="pill-drip" aria-hidden="true" style="left:'+(28+seed%44)+'%"></span>';
    return'<a class="app-pill'+(status.failed?" failed":"")+'" href="'+esc(url)+'" target="_blank" rel="noopener" title="'+esc(title)+'">'+inner+seep+'</a>';
  }
  if(url)return'<a class="app-pill off" href="'+esc(url)+'" target="_blank" rel="noopener" title="'+esc(name)+' is not ready yet; opening anyway">'+inner+'</a>';
  return'<span class="app-pill off" title="'+esc(name)+' has no link">'+inner+'</span>';
}
