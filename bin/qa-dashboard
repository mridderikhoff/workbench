// Neon: magenta and cyan on near-black. The same eye, re-inked in magenta with an off-register cyan, on smoky acrylic and a
// cutting mat; red is kept for problems only, so a failure never reads as the main ink. Marks are a pixel set of their own.
THEMES.neon = (function () {
  var horror = THEMES.horror, N = 'html[data-theme="neon"]';
  var screw = function (x, y) { return "radial-gradient(circle at " + x + " " + y + ",var(--screw-hi) 0 1.3px,var(--screw) 1.9px 3.5px,var(--screw-lo) 4px 4.8px,transparent 5.3px)" };
  var screws = [screw("12px", "12px"), screw("calc(100% - 12px)", "12px"), screw("12px", "calc(100% - 12px)"), screw("calc(100% - 12px)", "calc(100% - 12px)")].join(",");
  var scan = "repeating-linear-gradient(0deg,var(--scan) 0 1px,transparent 1px 3px)";
  // Pixel status set: a different silhouette per state (diamond, hourglass, bolt, power, warning sign, question mark).
  var BITS = {
    ok: ["....##....", "...####...", "..######..", ".########.", "##########", "##########", ".########.", "..######..", "...####...", "....##...."],
    warn: ["##########", ".########.", "..######..", "...####...", "....##....", "....##....", "...#..#...", "..#....#..", ".#..##..#.", "##########"],
    broken: [".....####.", "....####..", "...####...", "..########", ".########.", "....####..", "...####...", "..###.....", ".##.......", "#........."],
    down: ["....##....", ".#..##..#.", "#...##...#", "#...##...#", "#...##...#", "#........#", "#........#", ".#......#.", "..######.."],
    attn: ["....##....", "....##....", "...####...", "...#..#...", "..##..##..", "..##..##..", ".###..###.", ".########.", "####..####", "##########"],
    unknown: ["..######..", ".##....##.", ".##....##.", "......##..", ".....##...", "....##....", "....##....", "..........", "....##....", "....##...."],
    reticle: ["....##....", "...#..#...", "..#....#..", ".#......#.", "#........#", "#........#", ".#......#.", "..#....#..", "...#..#...", "....##...."],
    pupil: ["..........", "..........", "..........", "..........", "....##....", "....##....", "..........", "..........", "..........", ".........."]
  };
  var plate = function (parts) { return '<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" fill-rule="evenodd" shape-rendering="crispEdges">' + parts + '</svg>' };
  var backing = "<rect width='64' height='64' rx='12' fill='#0a0a0c'/>";
  function fav(rows, ink) { return bitFavicon(rows, ink, backing, 10, 10, 44) }
  // Hazard tape holding the eye card down: printed magenta and black stripes under a fine dot screen, breaking up into
  // halftone dots at both torn ends, on the eye's 4.5px dot grid.
  var tape = (function () {
    var w = 136, h = 28, pitch = 4.5, solid = 26, dots = [];
    function stripe(x, y) { return Math.floor((x + y) / 8) % 2 ? "#0a0a0c" : "#ff3ea5" }
    for (var x = pitch / 2; x < solid; x += pitch) for (var y = pitch / 2; y < h; y += pitch) {
      var reach = x / solid, wobble = ((Math.floor(x) * 7 + Math.floor(y) * 13) % 9) / 9;
      var r = pitch * 0.56 * Math.min(1, Math.max(0, reach * 1.2 + (wobble - 0.5) * 0.28 - 0.05));
      if (r < 0.5) continue;
      dots.push('<circle cx="' + x.toFixed(2) + '" cy="' + y.toFixed(2) + '" r="' + r.toFixed(2) + '" fill="' + stripe(x, y) + '"/>');
      dots.push('<circle cx="' + (w - x).toFixed(2) + '" cy="' + y.toFixed(2) + '" r="' + r.toFixed(2) + '" fill="' + stripe(w - x, y) + '"/>');
    }
    return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ' + w + ' ' + (h + 2) + '"><defs>' +
      '<pattern id="z" width="16" height="16" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="16" height="16" fill="#ff3ea5"/><rect width="8" height="16" fill="#0a0a0c"/></pattern>' +
      '<pattern id="s" width="3" height="3" patternUnits="userSpaceOnUse"><circle cx="1.5" cy="1.5" r=".75" fill="#000" fill-opacity=".2"/></pattern></defs>' +
      '<rect x="' + (solid - 2) + '" y="2" width="' + (w - 2 * solid + 4) + '" height="' + h + '" fill="#000" fill-opacity=".4"/>' +
      '<rect x="' + (solid - 2) + '" y="0" width="' + (w - 2 * solid + 4) + '" height="' + h + '" fill="url(#z)"/>' +
      '<rect x="' + (solid - 2) + '" y="0" width="' + (w - 2 * solid + 4) + '" height="' + h + '" fill="url(#s)"/>' + dots.join("") + '</svg>';
  })();
  return {
    name: "Neon",
    radio: {reveal:"char",vars:{"--radio-tag":"var(--desk-card)","--radio-tag-ink":"var(--text)","--radio-problem-tag-ink":"var(--text)","--radio-problem-tag-glyph":"var(--text)"},css:'html[data-theme="neon"][data-scene="radio"] .radio{--radio-edge:var(--accent);border-width:3px;border-radius:10px;background:var(--stock)}html[data-theme="neon"][data-scene="radio"] .radio-tag{border:1px solid var(--accent);letter-spacing:.08em;text-transform:uppercase}html[data-theme="neon"][data-scene="radio"] .radio-meter i{border-radius:0;box-shadow:2px 2px 0 var(--edge-lo2)}'},
