/* ===== end THEMES ================================================================= */
/* ===== CHARACTERS =================================================================
The character is the animated figure on the eye card. It is its own setting (Settings > Character), separate from the theme:
each theme names a default character (`character`), and a stored pick wins. A character supplies its art and behaviour (source
art, face, idle animation, cursor-following, status expressions, and what Full, Subtle and Static do). The theme it appears in
supplies the inks (its palette plus named ramps), the card or screen it sits on, and print effects (halftoneOverprint, glitch,
bloom). So every character renders in every theme, in that theme's palette: Eye in Terminal is a phosphor eye on the CRT, Blip
in Horror is a blood-red face on card stock.
Characters: Eye (the halftone eye: Horror's and Neon's default) and Blip (an ASCII face: Terminal's default).
  name        label in the Character picker
  stage       {width, height}: the canvas in CSS px; pitch: the halftone dot pitch in px; overlap: px the wordmark tucks under
              the canvas; size and centerY map logoSource's 64-unit box onto the canvas (size px wide, unit 32 at y = centerY)
  logoSource  optional SVG string, 64x64 viewBox, transparent background; the halftone grid samples its opaque pixels (alpha[])
              and lights them with shade(). A character drawn entirely by its renderer (Blip) leaves it out.
  anatomy     optional {iris:[x, y, r], pupil:r, tips:[[x, tipY, topY], ...]} in logo units; needed by the built-in eye modes
  inks        optional names of the theme ramps it draws with besides the palette (ink 0): ink n is the theme's
              inks[scheme][inks[n - 1]]. Every theme supplies every name used here; ?debug=1 reports a missing one.
  modes       the Logo animation options. Always the three ids full / subtle / static, so a stored pick carries across
              characters and themes: "full" (cursor-following, blinks, all idle life), "subtle" (only the slow ambient motion)
              and "static" (subtle's still frame, no loop at all). Old stored values map over: watcher and coin to full,
              bleeding to subtle, off to static. Each entry is either a built-in eye mode by id (needs anatomy) or a custom
              renderer {id, label, tracks, init(engine), frame(t, real, engine), still, idle}. A renderer draws on the halftone
              grid through the engine: cols, rows, count, pitch, fps, horizon, alpha[] (sampled logoSource), shade(),
              intensity[], ink[], radiusScale[], back[] (a full-size backdrop dot, bucket ink*5+shade+1), put(col,row,value,ink)
              (raise), set(...) (overwrite), aim(col,row) (the cursor offset in px while tracking, else null), status (the
              backend rollup: ok, warn, broken, down, attn, unknown), screen (true when the theme seats the character on a lit
              screen), random(seed), schedules(seed, first, gap, extra), findAt(starts, t) and reduced(). tracks: true makes
              the cursor engage tracking; still is the time of the still frame; idle: true runs no loop.
              Status expressions: a renderer may change its face with engine.status (Blip does). The eye looks the same in
              every state; the backend card carries the status.
How to add a character: add one entry below; nothing else changes, and it shows up in the picker for every theme. To make it a
theme's default, set that theme's `character`. The owl from docs/THEME_IDEAS.md becomes one entry:
  CHARACTERS.owl = {
    name: "Owl",
    stage: {width: 200, height: 230, pitch: 4.5, size: 200, centerY: 96, overlap: 18},
    logoSource: "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'>...the head and its two eye discs...</svg>",
    inks: ["warn", "bad"],
    modes: [owl("full", {tracks: true}), owl("subtle", {}), owl("static", {idle: true})]   // custom renderers
  };
==================================================================================== */
var CHARACTERS = {
  // Eye: the halftone eye. It follows the cursor, blinks, and drips onto the wordmark.
  eye: {
    name: "Eye",
    stage: {width: 200, height: 230, pitch: 4.5, size: 200, centerY: 92, overlap: 22},
    logoSource: "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'><g fill='none' stroke='#e0061f' stroke-linecap='round' stroke-linejoin='round'><path d='M5 30C13 17 22 11 33 11s19 6 26 18' stroke-width='6'/><path d='M6 32c9 10 17 14 27 14 9 0 15-4 21-11' stroke-width='5'/><circle cx='32' cy='29' r='7.1' stroke-width='5.8'/></g><g fill='#e0061f'><path d='M17 40h5v13a2.5 2.5 0 0 1-5 0z'/><path d='M31 44h4.5v17a2.25 2.25 0 0 1-4.5 0z'/><path d='M45 41h4v9a2 2 0 0 1-4 0z'/><circle cx='19.5' cy='53.5' r='3'/><circle cx='33.25' cy='61' r='2.6'/><circle cx='47' cy='50.5' r='2.4'/></g></svg>",
    anatomy: {iris: [32, 29, 10], pupil: 4.2, tips: [[20.4, 56.9, 44], [32.4, 63.6, 47], [47.7, 53.3, 42]]},
    modes: ["full", "subtle", "static"]
  }
};
// Blip: an ASCII face drawn on the halftone grid. Each glyph pixel is a 2x2 block of dots (smoothed with scale2x), so the face
// is the main thing on its card. It looks a cell or two towards the cursor, leans on big moves, blinks (-_-), and its
// expression is the backend rollup. On a lit screen (the theme's `screen`) faint characters fall behind it; printed on a card,
// its ink now and then runs and drips off the bottom of the face instead.
CHARACTERS.blip = (function () {
  // Face glyphs: 5x7 (parentheses 3x7), and 3x5 for the falling characters.
  var G = {
    "(": ["..#", ".#.", "#..", "#..", "#..", ".#.", "..#"], ")": ["#..", ".#.", "..#", "..#", "..#", ".#.", "#.."],
    "^": [".....", "..#..", ".#.#.", "#...#", ".....", ".....", "....."],
    o: [".....", ".....", ".###.", "#...#", "#...#", "#...#", ".###."],
    O: [".###.", "#...#", "#...#", "#...#", "#...#", "#...#", ".###."],
    ">": [".....", "#....", ".##..", "...##", ".##..", "#....", "....."],
    "<": [".....", "....#", "..##.", "##...", "..##.", "....#", "....."],
    "?": [".###.", "#...#", "....#", "..##.", "..#..", ".....", "..#.."],
    "-": [".....", ".....", ".....", "#####", ".....", ".....", "....."],
    _: [".....", ".....", ".....", ".....", ".....", ".....", "#####"],
    Z: ["#####", "....#", "...#.", "..#..", ".#...", "#....", "#####"],
    z: ["#####", "...#.", "..#..", ".#...", "#####"]
  };
  // scale2x (EPX): doubles a glyph and fills the inside corners of its diagonals, so big strokes stay smooth.
  function scale2x(rows) {
    var h = rows.length, w = rows[0].length, out = [];
    function at(x, y) { return x < 0 || y < 0 || x >= w || y >= h ? "." : rows[y][x] }
    for (var y = 0; y < h; y++) {
      var top = "", bottom = "";
      for (var x = 0; x < w; x++) {
        var P = at(x, y), A = at(x, y - 1), B = at(x + 1, y), C = at(x - 1, y), D = at(x, y + 1);
        top += (C === A && C !== D && A !== B ? A : P) + (A === B && A !== C && B !== D ? B : P);
        bottom += (D === C && D !== B && C !== A ? C : P) + (B === D && B !== A && D !== C ? D : P);
      }
      out.push(top, bottom);
    }
    return out;
  }
  var BIG = {};
  Object.keys(G).forEach(function (key) { BIG[key] = scale2x(G[key]) });
  // Ink 0 is the theme's palette; 1 and 2 are its warn and bad ramps. Faces per backend rollup (down is drawn on its own).
  var WARN = 1, BAD = 2;
  var FACES = {ok: ["^", "^", 0], warn: ["o", "O", WARN], broken: [">", "<", BAD], attn: ["O", "O", BAD], unknown: ["?", "?", 0]};
  // Layout in grid cells: ( at 0, eyes at 10 and 34, the mouth at 22, ) at 48; 54 cells wide and 14 tall.
  var WIDTH = 54, HEIGHT = 14;
  function renderer(config) {
    var E, cols, rows, fgVal, fgInk, nonsense, rain, blinks, drips, faceLeft, faceTop;
    var mode = {id: config.id, label: config.label, tracks: !!config.tracks, still: config.still, idle: !!config.idle, lean: 0, leanAt: -1};
    function stamp(glyph, c0, r0, value, ink) {
      for (var y = 0; y < glyph.length; y++) for (var x = 0; x < glyph[y].length; x++) {
        if (glyph[y][x] !== "#") continue;
        var cc = c0 + x, rr = r0 + y;
        if (cc >= 0 && cc < cols && rr >= 0 && rr < rows) { var i = rr * cols + cc; fgVal[i] = value; fgInk[i] = ink }
      }
    }
    // Drop shapes, 3 cells wide, hanging from their top row: a bead, swelling, swollen, and tall while it falls.
    var DROPS = [[[0, 1, 0]], [[0, 1, 0], [0.55, 1, 0.55]], [[0, 1, 0], [0.5, 1, 0.5], [0.45, 0.9, 0.45]], [[0, 1, 0], [0.4, 1, 0.4], [0.85, 1, 0.85], [0.55, 1, 0.55], [0, 0.7, 0]]];
    function blot(col, top, size, value, ink) { var shape = DROPS[size]; for (var r = 0; r < shape.length; r++) for (var c = 0; c < 3; c++) if (shape[r][c]) E.put(col + c - 1, top + r, value * shape[r][c], ink) }
    // Falling characters keep a one-cell gap around the face so it always reads.
    function near(i) { return fgVal[i] || fgVal[i - 1] || fgVal[i + 1] || fgVal[i - cols] || fgVal[i + cols] || fgVal[i - cols - 1] || fgVal[i - cols + 1] || fgVal[i + cols - 1] || fgVal[i + cols + 1] }
    mode.init = function (engine) {
      E = engine; cols = E.cols; rows = E.rows;
      fgVal = new Float32Array(E.count + cols + 1); fgInk = new Uint8Array(E.count);
      faceLeft = Math.floor((cols - WIDTH) / 2); faceTop = Math.floor((rows - HEIGHT) / 2) - 1;
      var random = E.random(config.seed), i, cc;
      nonsense = [];
      for (i = 0; i < 64; i++) { var glyph = []; for (var k = 0; k < 5; k++) { var bits = 1 + Math.floor(random() * 7); glyph.push((bits & 4 ? "#" : ".") + (bits & 2 ? "#" : ".") + (bits & 1 ? "#" : ".")) } nonsense.push(glyph) }
      // Rain: each column runs its own seeded schedule of drops with uneven speeds, trails and rests, so it never repeats.
      rain = [];
      for (cc = 1; cc + 3 <= cols - 1; cc += config.rainStep) {
        var next = E.random(config.seed * 31 + cc), starts = [], drops = [], t = next() * config.rainRest[1];
        while (t < E.horizon) {
          var speed = config.rainSpeed[0] + next() * (config.rainSpeed[1] - config.rainSpeed[0]), trail = 1 + Math.floor(next() * 3), life = (rows + 12 + trail * 6) / speed;
          starts.push(t); drops.push({speed: speed, trail: trail, life: life, seed: Math.floor(next() * 1e6)});
          t += life + config.rainRest[0] + next() * (config.rainRest[1] - config.rainRest[0]);
        }
        rain.push({col: cc, starts: new Float64Array(starts), drops: drops});
      }
      blinks = E.schedules(config.seed + 5, 5 + random() * 4, config.blinkGap, function () { return null });
      // Drips hang from the bottom of the parentheses and the mouth: they swell, stretch, fall in whole cells and soak away.
      drips = [[3, 12], [27, 14], [51, 12]].map(function (spot, n) {
        return {dx: spot[0], dy: spot[1], plan: E.schedules(config.seed * 7 + n * 13, 0.6 + n * 1.3, config.dripGap, function (next) { return {swell: 0.7 + next() * 0.9, wobble: Math.floor(next() * 3) - 1} })};
      });
      this.lean = 0; this.leanAt = -1;
    };
    mode.frame = function (t, real) {
      var step = Math.floor(t * E.fps) / E.fps, timeline = step % E.horizon, status = E.status || "unknown", i;
      fgVal.fill(0);
      // The eyes look up to two cells towards the cursor; a big sideways move leans the whole face two cells, overshooting first.
      var lookC = 0, lookR = 0, leanTarget = 0, aim = this.tracks && real ? E.aim(faceLeft + WIDTH / 2, faceTop + HEIGHT / 2) : null;
      if (aim) {
        var reach = Math.min(1, aim.distance / 120), d = aim.distance || 1;
        lookC = Math.max(-2, Math.min(2, Math.round(aim.dx / d * reach * 2.4)));
        lookR = Math.max(-2, Math.min(2, Math.round(aim.dy / d * reach * 2.2)));
        leanTarget = Math.abs(aim.dx) > 260 ? (aim.dx > 0 ? 2 : -2) : 0;
      }
      if (leanTarget !== this.lean) { this.lean = leanTarget; this.leanAt = step }
      var lean = this.lean && step - this.leanAt < 2 / E.fps ? this.lean + Math.sign(this.lean) : this.lean, left = faceLeft + lean, faceInk = (FACES[status] || FACES.unknown)[2];
      if (status === "down") {
        // Down: the face is asleep, a slow zZ drifting up.
        var drift = (Math.floor(step * 0.7 + 0.8 * Math.sin(step * 0.31)) % 3) * 2;
        stamp(BIG.z, left + 12, faceTop + 6 - drift, 0.5, 0);
        stamp(BIG.Z, left + 28, faceTop - 2 - drift, 0.62, 0);
      } else {
        var face = FACES[status] || FACES.unknown, ink = face[2], blinkFrame = -1;
        if (!E.reduced()) { var j = E.findAt(blinks.starts, timeline); if (j >= 0) blinkFrame = Math.floor((timeline - blinks.starts[j]) * E.fps) }
        // A slow blink, (-_-), with one squashed frame either side.
        var squash = blinkFrame === 0 || blinkFrame === 6, shut = blinkFrame >= 1 && blinkFrame <= 5;
        stamp(BIG["("], left, faceTop, 1, ink); stamp(BIG[")"], left + 48, faceTop, 1, ink);
        for (var k = 0; k < 2; k++) {
          var glyphRows = shut ? BIG["-"] : BIG[face[k]];
          if (squash) glyphRows = glyphRows.map(function (row, y) { return y < 6 ? ".........." : row });
          stamp(glyphRows, left + 10 + k * 24 + lookC, faceTop + lookR, 1, ink);
        }
        stamp(BIG._, left + 22 + lookC, faceTop, 1, ink);
      }
      if (!E.screen && status !== "down") drips.forEach(function (drip) {
        var j = E.findAt(drip.plan.starts, timeline);
        if (j < 0) return;
        var plan = drip.plan.data[j], age = timeline - drip.plan.starts[j], col = left + drip.dx, top = faceTop + drip.dy, floor = rows - 2;
        if (age < plan.swell) { blot(col, top, age < plan.swell * 0.45 ? 0 : age < plan.swell * 0.8 ? 1 : 2, 0.85, faceInk); return }
        age -= plan.swell;
        var fall = Math.round(0.5 * 70 * age * age), row = top + 2 + fall;
        if (row < floor - 1) {
          // Tall while it falls, with a thin trail for the first few frames.
          blot(col, row, 3, 0.9, faceInk);
          if (age < 3 / E.fps) for (var r = top; r < row; r++) E.put(col, r, 0.5, faceInk);
          return;
        }
        var landed = age - Math.sqrt(2 * Math.max(1, floor - 3 - top) / 70);
        if (landed > 1.6) return;
        // Wide on impact, then the spot soaks into the card.
        var soak = Math.max(0, 1 - landed / 1.6);
        for (var dc = -2; dc <= 2; dc++) E.put(col + dc + (landed < 1 / E.fps ? 0 : plan.wobble * (dc === 2 ? 1 : 0)), floor, (Math.abs(dc) === 2 ? 0.5 : 0.85) * soak, faceInk);
        if (landed < 2 / E.fps) { E.put(col - 3, floor - 1, 0.6, faceInk); E.put(col + 3, floor - 2, 0.55, faceInk) }
      });
      if (E.screen) rain.forEach(function (column) {
        var j = E.findAt(column.starts, timeline);
        if (j < 0) return;
        var drop = column.drops[j], age = timeline - column.starts[j];
        if (age > drop.life) return;
        var head = -6 + Math.floor(age * drop.speed);
        for (var k = 0; k <= drop.trail; k++) {
          var top = head - k * 6, glyph = nonsense[(drop.seed + k * 7 + Math.floor((timeline + k * 0.37 + drop.seed % 5) / (0.6 + (drop.seed % 7) * 0.15))) % 64];
          var value = (k === 0 ? 0.46 : 0.36 - k * 0.06) * (status === "down" ? 0.6 : 1);
          for (var y = 0; y < 5; y++) for (var x = 0; x < 3; x++) {
            var rr = top + y;
            if (glyph[y][x] !== "#" || rr < 0 || rr >= rows) continue;
            var index = rr * cols + column.col + x;
            if (near(index)) continue;
            E.intensity[index] = value; E.ink[index] = 0;
          }
        }
      });
      for (i = 0; i < E.count; i++) if (fgVal[i]) { E.intensity[i] = fgVal[i]; E.ink[i] = fgInk[i]; E.radiusScale[i] = 1.08 }
    };
    return mode;
  }
  var calm = {seed: 19, rainStep: 9, rainSpeed: [2, 4], rainRest: [2, 7], blinkGap: [14, 30], dripGap: [5, 11], still: 2.1};
  function extend(base, own) { var out = {}; Object.keys(base).forEach(function (k) { out[k] = base[k] }); Object.keys(own).forEach(function (k) { out[k] = own[k] }); return out }
  return {
    name: "Blip",
    stage: {width: 242, height: 150, pitch: 4, overlap: 0},
    inks: ["warn", "bad"],
    modes: [
      renderer({id: "full", label: "Full", tracks: true, seed: 7, rainStep: 6, rainSpeed: [3, 6], rainRest: [0.8, 4.5], blinkGap: [7, 18], dripGap: [7, 16], still: 2.9}),
      renderer(extend(calm, {id: "subtle", label: "Subtle"})),
      renderer(extend(calm, {id: "static", label: "Static", idle: true}))
    ]
  };
})();
/* ===== end CHARACTERS ============================================================= */
var QA_THEME = (function () {
  var active = null, query = new URLSearchParams(location.search), systemDark = window.matchMedia("(prefers-color-scheme: dark)");
  var DEFAULT = "terminal", RENAMED = {blood: "horror"};
  // Appearance: "system" follows the OS live, "dark" and "light" force the scheme. Read here so it is applied before first paint.
  function pickScheme() {
    var value = query.get("scheme");
    if (!/^(system|dark|light)$/.test(value)) { try { value = localStorage.getItem("qaDashboardScheme") } catch (e) { value = null } }
    return /^(dark|light)$/.test(value) ? value : "system";
  }
  var schemePreference = pickScheme();
  // Desk is the only layout now; forget the scene and background picks of older visits.
  try { localStorage.removeItem("qaDashboardScene"); localStorage.removeItem("qaDashboardBackground") } catch (e) {}
  // A stored pick always wins over the default; renamed themes carry over (Blood is now Horror).
  function pick() {
    var name = query.get("theme");
    name = RENAMED[name] || name;
    if (!THEMES[name]) {
      try { name = localStorage.getItem("qaDashboardTheme") } catch (e) { name = null }
      if (RENAMED[name]) { name = RENAMED[name]; try { localStorage.setItem("qaDashboardTheme", name) } catch (e) {} }
    }
    return THEMES[name] ? name : DEFAULT;
  }
  // Character: null follows the theme's default; a stored pick (or ?character=) wins. An unknown stored id is dropped.
  function pickCharacter() {
    var id = query.get("character");
    if (CHARACTERS[id]) return id;
    try { id = localStorage.getItem("qaDashboardCharacter") } catch (e) { id = null }
    if (id && !CHARACTERS[id]) { try { localStorage.removeItem("qaDashboardCharacter") } catch (e) {} id = null }
    return id || null;
  }
  var characterPick = pickCharacter();
  function characterId() { var id = characterPick || (active && active.theme.character); return CHARACTERS[id] ? id : "eye" }
  // The canvas size comes from the character and is set before first paint, so the card never jumps.
  function applyCharacter() {
    var id = characterId(), stage = CHARACTERS[id].stage || {}, root = document.documentElement;
    root.setAttribute("data-character", id);
    root.style.setProperty("--stage-w", (stage.width || 200) + "px");
    root.style.setProperty("--stage-h", (stage.height || 230) + "px");
    root.style.setProperty("--stage-overlap", (stage.overlap || 0) + "px");
  }
  // The Logo animation pick is read here too, so CSS-driven character effects (the CRT's band and flicker) start right.
  (function () {
    var stored = null, legacy = {watcher: "full", coin: "full", bleeding: "subtle", off: "static"};
    try { stored = query.get("eye") || localStorage.getItem("qaDashboardEyeMode") } catch (e) {}
    stored = legacy[stored] || stored;
    document.documentElement.setAttribute("data-logo-mode", /^(full|subtle|static)$/.test(stored || "") ? stored : "full");
  })();
  function deskArtVars(theme) {
    var art = theme.deskArt || {};
    var check = theme.actionIcons && theme.actionIcons.check;
    // The selected-option tick is a mask, so a theme's check icon needs the SVG namespace to load as an image.
    if (check && check.indexOf("xmlns") < 0) check = check.replace("<svg ", "<svg xmlns=\"http://www.w3.org/2000/svg\" ");
    return ";--check-icon:" + (check ? svgAsset(check) : "none") + ";--desk-mount:" + (art.mount ? svgAsset(art.mount) : "none") + ";--desk-badge:" + (art.badge ? svgAsset(art.badge) : "none") + ";--desk-drip:" + (art.drip ? svgAsset(art.drip) : "none");
  }
  function merged(theme, scheme) { var out = {}, own = theme.css[scheme] || {}; Object.keys(BASE[scheme]).forEach(function (k) { out[k] = BASE[scheme][k] }); Object.keys(own).forEach(function (k) { out[k] = own[k] }); return out }
  function block(vars) { return Object.keys(vars).map(function (key) { return key + ":" + vars[key] }).join(";") }
  function apply(name) {
    var theme = THEMES[name] || THEMES[DEFAULT], fonts = theme.fonts, root = document.documentElement;
    active = {id: THEMES[name] ? name : DEFAULT, theme: theme};
    var style = document.getElementById("theme-style");
    if (!style) { style = document.createElement("style"); style.id = "theme-style"; document.head.appendChild(style) }
    // data-scheme is "system", "dark" or "light": the media query applies only unless light is forced, and a forced dark wins by specificity.
    var dark = block(merged(theme, "dark"));
    style.textContent = ":root{" + block(merged(theme, "light")) + deskArtVars(theme) + ";--serif:" + fonts.serif + ";--mono:" + fonts.mono + ";--body:" + fonts.body + "}" +
      "@media (prefers-color-scheme:dark){:root:not([data-scheme=\"light\"]){" + dark + "}}" +
      ":root[data-scheme=\"dark\"]{color-scheme:dark;" + dark + "}:root[data-scheme=\"light\"]{color-scheme:light}\n" + (theme.deskCss || "");
    root.setAttribute("data-scheme", schemePreference);
    root.setAttribute("data-theme", active.id);
    root.setAttribute("data-pill-hover", theme.pillHover || "seep");
    root.setAttribute("data-button-hover", theme.buttonHover || "seep");
    root.setAttribute("data-screen", theme.screen ? "1" : "0");
    applyCharacter();
    var icon = document.querySelector('link[rel="icon"]');
    if (icon) { icon.href = "data:image/svg+xml," + encodeURIComponent(theme.favicon); icon.dataset.state = "" }
    document.dispatchEvent(new CustomEvent("qa-theme"));
  }
  apply(pick());
  return {
    current: function () { return active.theme },
    id: function () { return active.id },
    character: function () { return CHARACTERS[characterId()] },
    characterId: characterId,
    characterPick: function () { return characterPick || "" },
    // "" follows the theme again.
    chooseCharacter: function (id) {
      characterPick = CHARACTERS[id] ? id : null;
      try { if (characterPick) localStorage.setItem("qaDashboardCharacter", id); else localStorage.removeItem("qaDashboardCharacter") } catch (e) {}
      applyCharacter();
      document.dispatchEvent(new CustomEvent("qa-character"));
    },
    has: function (id) { return Object.prototype.hasOwnProperty.call(THEMES, id) },
    merged: merged,
    schemePreference: function () { return schemePreference },
    isDark: function () { return schemePreference === "dark" || (schemePreference === "system" && systemDark.matches) },
    chooseScheme: function (value) {
      if (!/^(system|dark|light)$/.test(value)) return;
      try { localStorage.setItem("qaDashboardScheme", value) } catch (e) {}
      schemePreference = value;
      document.documentElement.setAttribute("data-scheme", value);
      document.dispatchEvent(new CustomEvent("qa-scheme"));
    },
    choose: function (name) { try { localStorage.setItem("qaDashboardTheme", name) } catch (e) {} apply(name) },
    glyph: function (tone) { var glyphs = active.theme.statusGlyphs; return glyphs[tone] || glyphs.unknown },
    icon: function (name) {
      var theme = active.theme;
      if (name === "settings") return theme.settingsIcon || "";
      if (name === "chevron") return theme.chevron || THEMES.horror.chevron;
      return theme.actionIcons[name] || "";
    },
    pillHover: function () { return active.theme.pillHover || "seep" },
    buttonHover: function () { return active.theme.buttonHover || "seep" },
    favicon: function (state) {
      var icons = active.theme.favicons, svg = icons && icons[state] || active.theme.favicon, icon = document.querySelector('link[rel="icon"]');
      if (icon && icon.dataset.state !== state) { icon.href = "data:image/svg+xml," + encodeURIComponent(svg); icon.dataset.state = state }
    },
    copy: function (key, fallback) { var copy = active.theme.copy; return copy && copy[key] || fallback }
  };
})();
// ?debug=1: check every theme once at startup. Logs missing required keys, icons and art, icons shared with another theme
// (a leak), and WCAG contrast failures for text and paired inks in both schemes. A clean run logs one summary line per check.
(function themeCheck() {
  if (!/^(1|true)$/.test(new URLSearchParams(location.search).get("debug") || "")) return;
  var ICONS = {statusGlyphs: ["ok", "warn", "broken", "down", "attn", "unknown"], actionIcons: ["copy", "terminal", "stop", "check"], favicons: ["ok", "warn", "bad", "badDim", "down"]};
  var problems = [], seen = {};
  Object.keys(THEMES).forEach(function (id) {
    var theme = THEMES[id];
    ["light", "dark"].forEach(function (scheme) { REQUIRED_KEYS.forEach(function (key) { if (!(theme.css[scheme] || {})[key]) problems.push(id + " " + scheme + " is missing " + key) }) });
    ["name", "fonts", "favicon", "palette", "desk", "settingsIcon", "brushStroke"].forEach(function (key) { if (!theme[key]) problems.push(id + " is missing " + key) });
    if (!CHARACTERS[theme.character]) problems.push(id + " names an unknown default character " + JSON.stringify(theme.character));
    // Every character renders in every theme, so the theme needs each named ramp any character draws with.
    Object.keys(CHARACTERS).forEach(function (cid) { (CHARACTERS[cid].inks || []).forEach(function (ink) { ["light", "dark"].forEach(function (scheme) {
      var ramp = theme.inks && theme.inks[scheme] && theme.inks[scheme][ink];
      if (!ramp || ramp.length !== 5) problems.push(id + " inks." + scheme + "." + ink + " (5 colours) is missing; " + cid + " needs it");
    }) }) });
    ["light", "dark"].forEach(function (scheme) { if (!theme.palette || (theme.palette[scheme] || []).length !== 5) problems.push(id + " palette." + scheme + " needs 5 colours") });
    var marks = [["settingsIcon", theme.settingsIcon], ["chevron", theme.chevron], ["favicon", theme.favicon]];
    Object.keys(ICONS).forEach(function (set) { ICONS[set].forEach(function (key) {
      var svg = theme[set] && theme[set][key];
      if (!svg) problems.push(id + " is missing " + set + "." + key); else marks.push([set + "." + key, svg]);
    }) });
    marks.forEach(function (mark) { if (!mark[1]) return; if (seen[mark[1]] && seen[mark[1]].id !== id) problems.push(id + " inherits " + mark[0] + " from " + seen[mark[1]].id + " (" + seen[mark[1]].name + ")"); else seen[mark[1]] = {id: id, name: mark[0]} });
  });
  Object.keys(CHARACTERS).forEach(function (cid) {
    var character = CHARACTERS[cid], stage = character.stage || {};
    if (!character.name) problems.push("character " + cid + " is missing name");
    if (!(stage.width > 0 && stage.height > 0 && stage.pitch > 0)) problems.push("character " + cid + " needs stage.width, height and pitch");
    var ids = (character.modes || []).map(function (entry) { return typeof entry === "string" ? entry : entry && entry.id });
    ["full", "subtle", "static"].forEach(function (mode) { if (ids.indexOf(mode) < 0) problems.push("character " + cid + " is missing the " + mode + " mode") });
    if (ids.some(function (mode) { return mode === "full" || mode === "subtle" }) && (character.modes || []).some(function (entry) { return typeof entry === "string" && entry !== "static" }) && !character.anatomy) problems.push("character " + cid + " uses the built-in eye modes without anatomy");
  });
  console.log("theme check: " + Object.keys(THEMES).length + " themes, " + Object.keys(CHARACTERS).length + " characters, " + problems.length + " problems");
  problems.forEach(function (p) { console.warn("theme check: " + p) });
  // Contrast: resolve var() chains in the merged map, composite translucent inks over their fill, and compare luminance.
  function resolve(map, key) { var v = map[key], m; for (var n = 0; n < 8 && v && (m = /^var\((--[\w-]+)(?:,\s*(.+))?\)$/.exec(v)); n++) v = map[m[1]] || m[2]; return v }
  function rgba(v) {
    var m = v && /#([0-9a-f]{3,8})\b|rgba?\(([^)]+)\)/i.exec(v); if (!m) return null;
    if (m[2]) { var p = m[2].split(",").map(parseFloat); return [p[0], p[1], p[2], p.length > 3 ? p[3] : 1] }
    var h = m[1].length < 6 ? m[1].replace(/./g, "$&$&") : m[1]; return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16), h.length > 6 ? parseInt(h.slice(6, 8), 16) / 255 : 1];
  }
  function lum(c) { return [0, 1, 2].reduce(function (sum, i) { var s = c[i] / 255; return sum + [0.2126, 0.7152, 0.0722][i] * (s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4)) }, 0) }
  function ratio(fg, bg) { fg = [0, 1, 2].map(function (i) { return fg[i] * fg[3] + bg[i] * (1 - fg[3]) }); var a = lum(fg) + 0.05, b = lum(bg) + 0.05; return a > b ? a / b : b / a }
  var PAIRS = [["--text", "--desk-card"], ["--text", "--inset"], ["--muted", "--desk-card"], ["--muted", "--inset"], ["--accent", "--desk-card"], ["--ok", "--desk-card"], ["--bad", "--desk-card"],
    ["--warn", "--desk-card"], ["--bad", "--hl"], ["--tag-muted", "--tag"], ["--tag-bad", "--tag"], ["--banner-text", "--banner"], ["--glyph-ok", "--desk-card", 3], ["--glyph-bad", "--desk-card", 3],
    ["--focus-outer", "--desk-card", 3], ["--focus-outer", "--desk-floor", 3], ["--focus-outer", "--focus-inner", 3],
    // Foil-stamped headings (Horror): every stop of the foil gradient has to read on the stock on its own.
    ["--foil-hi", "--desk-card"], ["--foil-mid", "--desk-card"], ["--foil-lo", "--desk-card"],
    // Lit keycap legends (the press hover): on the caps and keys they light up on.
    ["--legend-lit", "--tag"], ["--legend-lit", "--btn-face"], ["--legend-lit", "--key-face"], ["--legend-lit-bad", "--tag"],
    // Text on the CRT screen (Terminal's wordmark).
    ["--screen-ink", "--screen"]];
  // Decorative inks (divider strokes, the index card's margin line) are not text; a few inks sit on a fill with another name.
  var DECOR = {"--rule-ink": 1, "--margin-ink": 1}, FILL = {"--btn-ink": "--btn-face", "--stamp-ink": "--tag"};
  var failures = [], checked = 0, table = [];
  Object.keys(THEMES).forEach(function (id) { ["light", "dark"].forEach(function (scheme) {
    var map = QA_THEME.merged(THEMES[id], scheme), pairs = PAIRS.slice();
    Object.keys(map).forEach(function (key) { var fill = key.replace(/-ink$/, ""); if (fill !== key && !DECOR[key]) pairs.push([key, FILL[key] || [fill, fill + "-face", fill + "-bg"].filter(function (k) { return map[k] })[0] || "--desk-card"]) });
    pairs.forEach(function (pair) {
      var bg = rgba(resolve(map, pair[1])), fg = rgba(resolve(map, pair[0])), need = pair[2] || 4.5;
      if (!bg || !fg) return; checked++;
      var r = ratio(fg, bg); table.push(id + " " + scheme + " " + pair[0] + " on " + pair[1] + " " + r.toFixed(2));
      if (r < need) failures.push(id + " " + scheme + ": " + pair[0] + " on " + pair[1] + " is " + r.toFixed(2) + ":1, needs " + need);
    });
  }) });
  window.__contrastTable = table;
  console.log("contrast check: " + checked + " pairs, " + failures.length + " failures");
  failures.forEach(function (f) { console.warn("contrast check: " + f) });
})();
</script>
</head><body class="loading">
<script>
"use strict";
// The desk: a real surface under every panel, drawn from the active theme's `desk` entry.
var QA_DESK=(function(){
  function seeded(seed){return function(){seed=seed+0x6D2B79F5|0;var t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
  /* Each material is painted once per theme and scheme into a full-resolution tile
     and handed to CSS as a background, so nothing is filtered or blended live. Light, fog and flames move by opacity and transform. ---- */
  var deskLayer=document.createElement("div"),deskTiles={};
  deskLayer.id="desk";deskLayer.setAttribute("aria-hidden","true");
  deskLayer.innerHTML='<i class="desk-light"></i><i class="desk-flicker"></i><i class="desk-flicker b"></i><i class="desk-fog a"></i><i class="desk-fog b"></i><i class="desk-overlay"></i><div class="desk-props"></div>';
  document.body.insertBefore(deskLayer,document.body.firstChild);
  document.addEventListener("qa-modal",function(e){document.documentElement.classList.toggle("modal-open",!!e.detail)});
  function rgb(hex){var n=parseInt(hex.slice(1),16);return[n>>16&255,n>>8&255,n&255]}
  function rgba(hex,alpha){return"rgba("+rgb(hex).join(",")+","+alpha+")"}
  function ramp(colors){
    var stops=colors.map(rgb),last=stops.length-1;
    return function(t,out){
      t=Math.max(0,Math.min(0.9999,t))*last;var i=Math.floor(t),f=t-i,a=stops[i],b=stops[Math.min(last,i+1)];
      out[0]=a[0]+(b[0]-a[0])*f;out[1]=a[1]+(b[1]-a[1])*f;out[2]=a[2]+(b[2]-a[2])*f;return out;
    };
  }
  // Seamless value noise: periods are whole lattice cells (at most 256), so every tile wraps without a seam.
  function noiseField(seed){
    var next=seeded(seed),lattice=new Float32Array(65536);
    for(var i=0;i<65536;i++)lattice[i]=next();
    function value(x,y,px,py){
      var xi=Math.floor(x),yi=Math.floor(y),fx=x-xi,fy=y-yi;fx=fx*fx*(3-2*fx);fy=fy*fy*(3-2*fy);
      var x0=((xi%px)+px)%px,x1=(x0+1)%px,y0=((yi%py)+py)%py,y1=(y0+1)%py;
      var a=lattice[y0<<8|x0],b=lattice[y0<<8|x1],c=lattice[y1<<8|x0],d=lattice[y1<<8|x1];
      return a+(b-a)*fx+(c-a)*fy+(a-b-c+d)*fx*fy;
    }
    function fbm(u,v,fx,fy,octaves){
      var sum=0,amp=0.5,norm=0;
      for(var o=0;o<octaves;o++){sum+=amp*value(u*fx,v*fy,fx,fy);norm+=amp;amp*=0.5;fx=Math.min(256,fx*2);fy=Math.min(256,fy*2)}
      return sum/norm;
    }
    return{value:value,fbm:fbm,next:next};
  }
  function paintTile(width,height,shade){
    var piece=document.createElement("canvas");piece.width=width;piece.height=height;
    var context=piece.getContext("2d"),data=context.createImageData(width,height),bytes=data.data,out=[0,0,0,255];
    for(var y=0;y<height;y++)for(var x=0;x<width;x++){
      out[3]=255;shade(x,y,x/width,y/height,out);
      var k=(y*width+x)*4;bytes[k]=out[0];bytes[k+1]=out[1];bytes[k+2]=out[2];bytes[k+3]=out[3];
    }
    context.putImageData(data,0,0);
    return{canvas:piece,context:context};
  }
  // Small marks (pores, fibres, scratches, foxing) drawn on top, repeated across the edges so the tile still wraps.
  function scatter(tile,count,n,draw){
    var c=tile.context,w=tile.canvas.width,h=tile.canvas.height;
    for(var i=0;i<count;i++){
      var x=n.next()*w,y=n.next()*h,r=n.next(),s=n.next();
      // Only marks near an edge need a wrapped copy; reach covers the longest mark.
      var xs=[0],ys=[0],reach=170;
      if(x<reach)xs.push(1);if(x>w-reach)xs.push(-1);if(y<reach)ys.push(1);if(y>h-reach)ys.push(-1);
      for(var a=0;a<xs.length;a++)for(var b=0;b<ys.length;b++){c.save();c.translate(x+xs[a]*w,y+ys[b]*h);draw(c,r,s);c.restore()}
    }
  }
  function scratches(tile,n,count,color,alpha){
    scatter(tile,count,n,function(c,r,s){c.rotate(r*Math.PI*2);c.globalAlpha=alpha*(0.4+s);c.strokeStyle=color;c.lineWidth=0.6;c.beginPath();c.moveTo(0,0);c.quadraticCurveTo(20+s*40,(r-0.5)*8,30+r*130,(s-0.5)*6);c.stroke()});
  }
  var MATERIALS={
    // Black velvet: a fine nap with soft, uneven pile and a few crushed streaks. No pattern to read, so the blotter owns the eye.
    velvet:function(p,n){
      var R=ramp(p.ramp),tile=paintTile(384,384,function(x,y,u,v,out){
        R(0.42+(n.fbm(u,v,3,3,3)-0.5)*0.55+(n.fbm(u,v,24,24,2)-0.5)*0.18+(n.next()-0.5)*0.16,out);
      });
      scratches(tile,n,10,p.ramp[p.ramp.length-1],0.07);
      return tile;
    },
    // Planks of stained wood: figure from warped rings, long fibre streaks, seams, pores and wear.
    wood:function(p,n){
      var w=768,h=384,planks=4,ph=h/planks,R=ramp(p.ramp),seam=rgb(p.seam||p.ramp[0]),offsets=[],tones=[],joints=[];
      for(var k=0;k<planks;k++){offsets.push(n.next()*10);tones.push((n.next()-0.5)*0.14);joints.push(Math.floor(n.next()*w))}
      var tile=paintTile(w,h,function(x,y,u,v,out){
        var plank=Math.floor(y/ph),ly=y-plank*ph;
        if(ly<2||(x>=joints[plank]&&x<joints[plank]+2)){out[0]=seam[0];out[1]=seam[1];out[2]=seam[2];return}
        var warp=n.fbm(u,v,4,4,2),figure=ly/ph*2.6+warp*2.2+offsets[plank]+n.value(u*2,v*16,2,16)*0.8;
        var ring=0.5+0.5*Math.sin(figure*Math.PI*2);ring=ring*ring*ring;
        var streak=n.fbm(u,v,8,256,2);
        R(0.1+0.52*streak+0.3*ring+0.16*(warp-0.5)+tones[plank]+(ly<5?0.1:0),out);
      });
      scatter(tile,1300,n,function(c,r,s){c.globalAlpha=0.25+0.35*s;c.fillStyle=p.seam||p.ramp[0];c.fillRect(0,0,2+r*9,1)});
      scratches(tile,n,46,p.ramp[p.ramp.length-1],0.12);
      return tile;
    },
    // Pebbled leather with soft mottling, creases and scuffs.
    leather:function(p,n){
      var s=384,R=ramp(p.ramp);
      var tile=paintTile(s,s,function(x,y,u,v,out){
        var mottle=n.fbm(u,v,4,4,3),pebble=n.value(u*112,v*112,112,112);
        R(0.18+0.64*mottle+(pebble>0.68?-0.12:pebble<0.24?0.07:0)+(n.next()-0.5)*0.08,out);
      });
      scratches(tile,n,30,p.ramp[p.ramp.length-1],0.1);
      scatter(tile,70,n,function(c,r,s){c.globalAlpha=0.1+0.15*s;c.fillStyle=p.ramp[0];c.beginPath();c.ellipse(0,0,2+r*7,1+s*3,r*3,0,Math.PI*2);c.fill()});
      return tile;
    },
    // Brushed metal: fine horizontal grain over a slow sheen.
    metal:function(p,n){
      var R=ramp(p.ramp),tile=paintTile(512,256,function(x,y,u,v,out){
        R(0.22+0.4*n.fbm(u,v,4,256,2)+0.34*(n.value(u*2,v*2,2,2)-0.5)+(n.next()-0.5)*0.1,out);
      });
      scratches(tile,n,34,p.ramp[p.ramp.length-1],0.12);
      return tile;
    },
    // A rubber cutting mat with a printed grid and the knife marks of earlier jobs.
    mat:function(p,n){
      var s=320,R=ramp(p.ramp),tile=paintTile(s,s,function(x,y,u,v,out){R(0.5+(n.fbm(u,v,8,8,3)-0.5)*0.5+(n.next()-0.5)*0.12,out)});
      var c=tile.context,i;
      c.fillStyle=p.grid;for(i=0;i<s;i+=16){c.fillRect(i,0,1,s);c.fillRect(0,i,s,1)}
      c.fillStyle=p.grid2;for(i=0;i<s;i+=80){c.fillRect(i,0,1.5,s);c.fillRect(0,i,s,1.5)}
      for(i=0;i<s;i+=80){c.fillRect(i+38,i+39,4,2);c.fillRect(i+39,i+38,2,4)}
      scratches(tile,n,40,p.ramp[p.ramp.length-1],0.16);
      return tile;
    },
    // Card stock: cloudy mottling, grain, short fibres and a few foxing spots.
    paper:function(p,n){
      var s=320,R=ramp(p.ramp);
      var tile=paintTile(s,s,function(x,y,u,v,out){
        R(0.5+(n.fbm(u,v,5,5,3)-0.5)*0.8+(n.value(u*2,v*2,2,2)-0.5)*0.4+(n.next()-0.5)*0.1,out);
      });
      scatter(tile,360,n,function(c,r,s){c.rotate(r*Math.PI*2);c.globalAlpha=0.1+0.22*s;c.strokeStyle=p.fiber;c.lineWidth=0.7;c.beginPath();c.moveTo(0,0);c.quadraticCurveTo(3+r*4,(s-0.5)*4,4+s*9,(r-0.5)*3);c.stroke()});
      scatter(tile,8,n,function(c,r,s){
        var radius=1.5+r*6,glow=c.createRadialGradient(0,0,0,0,0,radius);
        glow.addColorStop(0,rgba(p.fox,0.55));glow.addColorStop(0.6,rgba(p.fox,0.22));glow.addColorStop(1,rgba(p.fox,0));
        c.fillStyle=glow;c.beginPath();c.arc(0,0,radius,0,Math.PI*2);c.fill();
        c.fillStyle=rgba(p.fox,0.4);for(var k=0;k<3;k++){c.beginPath();c.arc((s-0.5)*radius*3+k*2,(r-0.5)*radius*2-k,0.6+s,0,Math.PI*2);c.fill()}
      });
      return tile;
    },
    // Moulded plastic: a fine matte stipple from the mould over a faint cloud, with a few scuffs.
    plastic:function(p,n){
      var R=ramp(p.ramp),tile=paintTile(256,256,function(x,y,u,v,out){R(0.5+(n.fbm(u,v,4,4,2)-0.5)*0.3+(n.value(u*128,v*128,128,128)-0.5)*0.32+(n.next()-0.5)*0.16,out)});
      scratches(tile,n,6,p.ramp[p.ramp.length-1],0.08);
      return tile;
    },
    // Smoky acrylic: almost flat, with faint cloud and hairline scratches.
    acrylic:function(p,n){
      var R=ramp(p.ramp),tile=paintTile(256,256,function(x,y,u,v,out){R(0.5+(n.fbm(u,v,4,4,2)-0.5)*0.35+(n.next()-0.5)*0.08,out)});
      scratches(tile,n,14,p.ramp[p.ramp.length-1],0.12);
      return tile;
    }
  };
  function fogTile(color,n){
    var c=rgb(color);
    return paintTile(512,128,function(x,y,u,v,out){
      var a=n.fbm(u,v,4,2,3),body=Math.pow(Math.sin(Math.PI*v),1.4);
      out[0]=c[0];out[1]=c[1];out[2]=c[2];out[3]=Math.max(0,Math.min(255,(a-0.36)*2.8*body*230));
    });
  }
  // An alpha mask that knocks small gaps and worn streaks out of a rubber stamp's ink.
  function gritTile(n){
    return paintTile(150,150,function(x,y,u,v,out){
      var blot=n.value(u*30,v*30,30,30),streak=n.fbm(u,v,3,48,2);
      out[0]=out[1]=out[2]=255;out[3]=blot>0.84||n.next()<0.02?40:streak>0.74?150:255;
    });
  }
  function glowSprite(glow){
    var piece=document.createElement("canvas");piece.width=360;piece.height=64;
    var c=piece.getContext("2d");c.lineCap="round";
    c.shadowColor=glow.color;c.shadowBlur=18;c.strokeStyle=glow.color;c.lineWidth=4;
    c.beginPath();c.moveTo(42,36);c.lineTo(318,36);c.stroke();c.stroke();
    c.shadowBlur=5;c.strokeStyle=glow.core;c.lineWidth=1.6;c.beginPath();c.moveTo(46,36);c.lineTo(314,36);c.stroke();
    return{canvas:piece};
  }
  // A torn bottom edge with a dog-eared corner, for the eye card's clip-path.
  function deckle(n){
    var points=["0 0","100% 0","100% calc(100% - 30px)","calc(100% - 30px) 100%"];
    for(var x=86;x>0;x-=3.4)points.push(x.toFixed(1)+"% calc(100% - "+(n.next()*5).toFixed(1)+"px)");
    points.push("0 calc(100% - 2px)");
    return"polygon("+points.join(",")+")";
  }
  // Screens a prop into round dots on the eye's grid: each cell's dot takes the cell's colour, sized by its coverage.
  var screened={};
  function screenProp(element,svg,width,height){
    var pitch=QA_THEME.current().artPitch,hash=2166136261;
    for(var i=0;i<svg.length;i++){hash^=svg.charCodeAt(i);hash=Math.imul(hash,16777619)}
    var key=pitch+":"+width+"x"+height+":"+(hash>>>0);
    if(screened[key]){element.style.backgroundImage=screened[key];return}
    var image=new Image();
    image.onload=function(){
      var scale=2,cols=Math.ceil(width/pitch),rows=Math.ceil(height/pitch),src=document.createElement("canvas");
      src.width=cols;src.height=rows;var sc=src.getContext("2d");sc.drawImage(image,0,0,cols,rows);
      var px=sc.getImageData(0,0,cols,rows).data,out=document.createElement("canvas");
      out.width=width*scale;out.height=height*scale;var c=out.getContext("2d");c.scale(scale,scale);
      for(var y=0;y<rows;y++)for(var x=0;x<cols;x++){
        var k=(y*cols+x)*4,a=px[k+3]/255;if(a<0.08)continue;
        var lum=(0.3*px[k]+0.59*px[k+1]+0.11*px[k+2])/255,r=pitch*0.52*Math.sqrt(a)*Math.min(1,Math.pow(lum,1.3)*1.35);
        if(r<0.45)continue;
        c.fillStyle="rgb("+px[k]+","+px[k+1]+","+px[k+2]+")";c.beginPath();c.arc((x+0.5)*pitch,(y+0.5)*pitch,r,0,Math.PI*2);c.fill();
      }
      screened[key]='url("'+out.toDataURL("image/png")+'")';element.style.backgroundImage=screened[key];
    };
    image.src="data:image/svg+xml,"+encodeURIComponent(svg);
  }
  // Halftone flames: a sprite of pre-screened frames on the eye's dot grid. Dots never move; a frame swap only changes
  // which dots are lit and how big they are, at an irregular 6-12fps, like the eye.
  var FLAME_FRAMES=7,flameSprites={},flames=[],flameTimer=0;
  function flameSprite(size,pitch){
    var key=size+":"+pitch;if(flameSprites[key])return flameSprites[key];
    var cols=2*Math.round(size*4.2/pitch),rows=Math.round(size*5.6/pitch),base=Math.round(rows*0.62),scale=2;
    var w=cols*pitch,h=rows*pitch,canvas=document.createElement("canvas");canvas.width=w*FLAME_FRAMES*scale;canvas.height=h*scale;
    var c=canvas.getContext("2d"),seed=size*97+13,rand=function(){seed=(seed*16807)%2147483647;return seed/2147483647};
    c.scale(scale,scale);
    for(var f=0;f<FLAME_FRAMES;f++){
      var lean=(rand()-0.5)*0.9,tall=0.8+rand()*0.45,wide=0.85+rand()*0.3,glow=0.8+rand()*0.35,flameH=size*2*tall/pitch,flameW=size*0.62*wide/pitch;
      for(var y=0;y<rows;y++)for(var x=0;x<cols;x++){
        var dx=x+0.5-cols/2,dy=base-(y+0.5),cx=dx-lean*Math.max(0,dy)*0.35;
        // Teardrop: wide near the wick, pointed at the top.
        var t=dy/flameH,half=flameW*(t<0?Math.sqrt(Math.max(0,1+t*3)):Math.pow(Math.max(0,1-t),0.8)*(1+t*1.2)),core=half>0?1-Math.abs(cx)/half:0;
        var inFlame=dy>-1.2&&t<1&&core>0,distance=Math.hypot(dx,(dy-flameH*0.35)*0.9)/(cols*0.5*glow),light=Math.max(0,1-distance)*Math.sin(Math.PI*(x+0.5)/cols)*Math.sin(Math.PI*(y+0.5)/rows);
        var x0=f*w+(x+0.5)*pitch,y0=(y+0.5)*pitch,r,color;
        if(inFlame){var heat=Math.min(1,core*1.3)*(1-Math.max(0,t)*0.45);r=pitch*0.5*Math.sqrt(0.45+0.55*heat);color=heat>0.72?"#fff3c4":heat>0.42?"#ffc85a":"#ee7a26"}
        else{r=pitch*0.5*Math.sqrt(light*light*0.55);color="rgba(255,165,75,"+(0.25+light*0.5).toFixed(2)+")"}
        if(r<0.4)continue;
        c.fillStyle=color;c.beginPath();c.arc(x0,y0,r,0,Math.PI*2);c.fill();
      }
    }
    flameSprites[key]={url:'url("'+canvas.toDataURL("image/png")+'")',w:w,h:h,base:base};
    return flameSprites[key];
  }
  function dotFlame(light,width,height){
    var pitch=QA_THEME.current().artPitch,sprite=flameSprite(light[2],pitch),element=document.createElement("i"),strip=document.createElement("b");
    // Snap the wick to the prop's dot grid so the flame's dots line up with the candle's.
    var left=Math.round(light[0]/100*width/pitch)*pitch,top=Math.round(light[1]/100*height/pitch)*pitch;
    element.className="dot-flame";
    element.style.cssText="left:"+(left-sprite.w/2)+"px;top:"+(top-sprite.base*pitch)+"px;width:"+sprite.w+"px;height:"+sprite.h+"px";
    strip.style.cssText="width:"+sprite.w*FLAME_FRAMES+"px;background-image:"+sprite.url;
    element.appendChild(strip);
    flames.push({strip:strip,w:sprite.w,frame:0,due:0});
    return element;
  }
  var flameStill=window.matchMedia("(prefers-reduced-motion: reduce)");
  function flicker(){
    flameTimer=0;
    if(!flames.length||flameStill.matches||document.hidden||document.documentElement.classList.contains("modal-open"))return;
    var now=performance.now();
    flames.forEach(function(flame){
      if(now<flame.due)return;
      var next=Math.floor(Math.random()*(FLAME_FRAMES-1));flame.frame=next>=flame.frame?next+1:next;
      flame.strip.style.transform="translateX("+(-flame.frame*flame.w)+"px)";
      flame.due=now+80+Math.random()*90;
    });
    flameTimer=setTimeout(flicker,40);
  }
  function startFlicker(){if(!flameTimer)flicker()}
  document.addEventListener("visibilitychange",startFlicker);document.addEventListener("qa-modal",function(){setTimeout(startFlicker,0)});
  flameStill.addEventListener("change",startFlicker);
  function deskProps(cfg){
    var box=deskLayer.querySelector(".desk-props"),art=cfg.art||{};
    box.textContent="";flames=[];
    (cfg.props||[]).forEach(function(prop){
      var element=document.createElement("div"),svg=art[prop.art]||prop.art;
      element.className="desk-prop"+(prop.halftone?" dots":"");
      element.style.cssText=prop.side+":"+(prop.offset||0)+"px;bottom:"+(prop.bottom||0)+"px;width:"+prop.width+"px;height:"+prop.height+"px;background-image:"+svgAsset(svg)+
        (prop.rotate||prop.flip?";transform:"+(prop.flip?"scaleX(-1) ":"")+(prop.rotate?"rotate("+prop.rotate+"deg)":""):"");
      if(prop.halftone)screenProp(element,svg,prop.width,prop.height);
      (prop.lights||[]).forEach(function(light,index){
        if(prop.halftone){element.appendChild(dotFlame(light,prop.width,prop.height));return}
        var flame=document.createElement("i");flame.className="light";
        flame.style.cssText="left:"+light[0]+"%;top:"+light[1]+"%;--s:"+light[2]+"px;animation-delay:-"+((index*0.77+light[0]*0.031)%2).toFixed(2)+"s";
        element.appendChild(flame);
      });
      box.appendChild(element);
    });
    startFlicker();
  }
  // Finished tiles are cached in memory and in localStorage (keyed by a hash of the theme's desk entry), so a reload paints nothing.
  var DESK_CACHE_VERSION=4;
  function deskStoreKey(cfg,scheme){
    var text=JSON.stringify({v:DESK_CACHE_VERSION,cfg:cfg,scheme:scheme}),hash=2166136261;
    for(var i=0;i<text.length;i++){hash^=text.charCodeAt(i);hash=Math.imul(hash,16777619)}
    return"qaDashboardDesk:"+QA_THEME.id()+":"+scheme+":"+(hash>>>0).toString(36);
  }
  // Keep at most one tile set per known theme and scheme: drop stale hashes, old versions and removed themes.
  function sweepDeskCache(prefix,keep){
    try{
      Object.keys(localStorage).forEach(function(name){
        if(name.indexOf("qaDashboardDesk:")!==0||name===keep)return;
        var id=name.split(":")[1];
        if(name.indexOf("qaDashboardDesk:"+prefix)===0||!QA_THEME.has(id))localStorage.removeItem(name);
      });
    }catch(e){}
  }
  function desk(cfg,palette){
    var scheme=QA_THEME.isDark()?"dark":"light",key=QA_THEME.id()+":"+scheme,vars=deskTiles[key],root=document.documentElement,storeKey=deskStoreKey(cfg,scheme);
    if(!vars){try{vars=JSON.parse(localStorage.getItem(storeKey)||"null")}catch(e){vars=null}if(vars)deskTiles[key]=vars}
    if(!vars){
      var n=noiseField(cfg.seed||7);vars={};
      var put=function(name,tile,type){vars["--desk-"+name]='url("'+tile.canvas.toDataURL(type||"image/png",0.92)+'")';vars["--desk-"+name+"-size"]=tile.canvas.width+"px "+tile.canvas.height+"px"};
      try{
        if(MATERIALS[cfg.surface])put("surface",MATERIALS[cfg.surface](palette.surface,n),"image/jpeg");
        if(MATERIALS[cfg.blotter]){put("blotter",MATERIALS[cfg.blotter](palette.blotter,n),"image/jpeg");vars["--desk-blotter-color"]=palette.blotter.ramp[1]}
        if(MATERIALS[cfg.stock])put("stock",MATERIALS[cfg.stock](palette.stock,n),"image/jpeg");
        if(palette.tag&&MATERIALS[cfg.stock])put("tag",MATERIALS[cfg.stock](palette.tag,n),"image/jpeg");
        if(palette.fog)put("fog",fogTile(palette.fog,n));
        put("grit",gritTile(n));
        if(cfg.glow)put("glow",glowSprite(cfg.glow));
        vars["--deckle"]=cfg.deckle?deckle(n):"none";
      }catch(e){}
      deskTiles[key]=vars;
      try{
        localStorage.setItem(storeKey,JSON.stringify(vars));
      }catch(e){}
    }
    sweepDeskCache(QA_THEME.id()+":"+scheme+":",storeKey);
    Object.keys(vars).forEach(function(name){root.style.setProperty(name,vars[name])});
    ["--desk-fog","--desk-glow","--desk-blotter","--desk-tag"].forEach(function(name){if(!vars[name])root.style.setProperty(name,"none")});
    root.setAttribute("data-deckle",cfg.deckle?"1":"0");
    deskProps(cfg);
    return null;
  }

  function start(){var cfg=QA_THEME.current().desk;if(cfg)desk(cfg,cfg[QA_THEME.isDark()?"dark":"light"]||cfg.dark)}
  document.addEventListener("qa-scheme",start);document.addEventListener("qa-theme",start);
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change",start);
  start();
  return{start:start};
})();
</script>
