// All dashboard controls and status marks use one 24-cell engraved silhouette language.
function plateIcon(parts){return '<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor" fill-rule="evenodd">'+parts+'</svg>'}
// Scenes choose composition and an ambient asset; themes provide the visual language for both.
var SCENES={desk:{label:"Desk",layout:"desk",background:"desk"},book:{label:"Book",layout:"book",background:"book"},console:{label:"Console",layout:"console",background:"console"}};
function svgAsset(svg){return 'url("data:image/svg+xml,'+encodeURIComponent(svg)+'")'}
// Brush-ink marks in the same 24-unit box as plateIcon; strokes vary in weight so they read hand-drawn.
function inkIcon(parts){return '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">'+parts+'</svg>'}
// Re-inks an SVG string by swapping exact colour literals, so a theme can reuse another theme's art in its own palette.
function retone(svg,map){return Object.keys(map).reduce(function(out,from){return out.split(from).join(map[from])},svg)}
// A lumpy closed outline (wax, blobs): r is the mean radius, bumps the number of lobes, amp their depth as a fraction of r.
function blobPath(cx,cy,r,bumps,amp,phase){
  var points=[];
  for(var i=0;i<48;i++){var a=i/48*Math.PI*2,k=r*(1+amp*Math.sin(a*bumps+phase)+amp*0.45*Math.sin(a*(bumps*2+1)+phase*1.7));points.push((cx+Math.cos(a)*k).toFixed(2)+" "+(cy+Math.sin(a)*k).toFixed(2))}
  return "M"+points.join("L")+"Z";
}
// A 36-unit 9-slice plate: four-unit stair cuts, a continuous raised edge, an inner light band and a bottom shadow.
function consoleFrame(art,fill){
  return '<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 36 36" shape-rendering="crispEdges"><path fill="'+art.rim+'" d="M8 0h20v4h4v4h4v20h-4v4h-4v4H8v-4H4v-4H0V8h4V4h4z"/><path fill="'+art.shadow+'" d="M8 4h20v4h4v20h-4v4H8v-4H4V8h4z"/><path fill="'+art.edge+'" d="M8 4h20v4H8zM4 8h4v20H4z"/><path fill="'+fill+'" d="M12 8h12v4h4v12h-4v4H12v-4H8V12h4z"/>'+(fill==="none"?"":'<rect x="12" y="12" width="12" height="12" fill="'+fill+'"/>')+'<path fill="'+art.shine+'" d="M12 8h12v4H12zM8 12h4v12H8z"/><path fill="'+art.rim+'" d="M24 12h4v12h-4zM12 24h12v4H12z"/></svg>';
}
