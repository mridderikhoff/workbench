<script>
"use strict";
// ?perf=1 logs animation-callback counts and long tasks to the console every 2s without adding frames of its own.
var QA_PERF=(function(){
  if(new URLSearchParams(location.search).get("perf")!=="1")return null;
  var raf=window.requestAnimationFrame.bind(window),stats={frames:0,busyMs:0,worstMs:0,longTasks:[],renders:0,cardsRebuilt:0};
  window.requestAnimationFrame=function(callback){return raf(function(time){var began=performance.now();callback(time);var spent=performance.now()-began;stats.frames++;stats.busyMs+=spent;if(spent>stats.worstMs)stats.worstMs=spent})};
  try{new PerformanceObserver(function(list){list.getEntries().forEach(function(entry){stats.longTasks.push(Math.round(entry.duration))})}).observe({entryTypes:["longtask"]})}catch(e){}
  setInterval(function(){
    console.log("perf "+JSON.stringify({animationCallbacksPerSecond:stats.frames/2,callbackMsAverage:+(stats.busyMs/Math.max(1,stats.frames)).toFixed(2),callbackMsWorst:+stats.worstMs.toFixed(1),longTasksMs:stats.longTasks,renders:stats.renders,cardsRebuilt:stats.cardsRebuilt}));
    stats.frames=stats.busyMs=stats.worstMs=stats.renders=stats.cardsRebuilt=0;stats.longTasks=[];
  },2000);
  return stats;
})();
/* ===== THEMES =====================================================================
Overseer has two layouts, Desk and Radio (Radio is behind QA_FEATURES.radioScene). A theme supplies its whole visual world.
Themes: Terminal (the default when nothing is stored), Horror and Neon. A stored pick always wins; the old id "blood" maps
to "horror". How to add a theme: add one entry to THEMES below. Its css merges over BASE, so it lists only what differs.
On ?debug=1 a startup check logs any required key, icon or art a theme is missing, any icon it shares with another theme,
and every text/ink pair under 4.5:1 (3:1 for the focus ring), for every theme in both schemes.
  name          label in the theme picker
  artPitch      shared halftone dot pitch in CSS px for the character and screened props (all themes use 4.5)
  css           {light:{...}, dark:{...}} custom properties merged over BASE (every engine key, with defaults). REQUIRED_KEYS
                have no useful default. Each theme's deskCss may read extra keys of its own (Horror's --margin-ink, --foil-*, --patch-*
                and --tooled, Neon's --led-*). --foil-hi, --foil-mid and --foil-lo are contrast-checked against --desk-card.
                text and UI: --text, --muted, --inset, --border, --rule, --ok, --bad, --warn, --idle, --glyph-ok, --glyph-bad,
                  --accent (links), --hl (problem background), --banner, --banner-text, --shade, --dim (modal backdrop)
                paired inks: every solid fill has its on-colour, named <fill>-ink (or <fill>-text): --ok-ink, --warn-ink,
                  --bad-ink, --accent-ink, --seep-ink, --charge-ink, --danger-ink, --btn-ink, --tag-ink, --badge-ink, --key-ink...
                focus: --focus-inner (the surface colour) and --focus-outer (3:1 against card and desk), drawn as two rings
                motion: --dur-fast, --dur, --ease, --ease-out; reduced motion zeroes the durations in one place
                derived (new keys only, mixed from --text): --hover-fill, --line-soft
                ink: --brush (brush core), --brush-deep, --drip (optional; the error marker beside a session, default --brush),
                  --seep and --seep-ink (the seep hovers), --danger and --danger-ink (the Stop button, default --seep), and
                  --charge, --charge-ink, --charge-edge, --charge-scan (the charge and blocks hovers)
                materials: --desk-floor, --desk-card, --desk-card2, --edge-hi, --edge-line, --edge-lo, --edge-lo2, --age, --contact,
                  --lift, --emb-hi, --emb-lo, --well, --stamp-ok, --btn-face, --btn-ink, --btn-hi,
                  --btn-edge, --head-case, --head-variant, --head-spacing, the lighting keys --pool* and --flicker-*, and the
                  tag keys --tag, --tag-edge, --tag-ink, --tag-muted, --tag-ok, --tag-warn, --tag-bad, --tag-off, --tag-off-ink, --tag-off-bad
                update key and details toggle: --key-face, --key-hover-face, --key-rim (border gradient), --key-ink,
                  --key-hover-ink, --key-wall, --badge-bg, --badge-ink, --toggle-edge
                sessions: the tray in the Sessions card (--tray, --tray-radius, --tray-shadow; none by default, so sessions lie on the card) and each session on it (--item-face,
                  --item-radius, --item-shadow; --item-card is its solid colour, the contrast reference and focus-ring inner colour;
                  --item-text and --item-muted are the inks inside it)
                select popups: --picker-face, --picker-radius, --picker-hl, --picker-hl-ink, --picker-hl-shadow, --picker-check,
                  --picker-hl-check
  fonts         {serif, mono, body} font stacks
  favicon       SVG string for the theme's icon, the fallback when favicons has no entry for a state
  favicons      {ok, warn, bad, badDim, down} SVG strings for the page health; bad alternates with badDim in a background tab
  logoSource    SVG string, 64x64 viewBox, transparent background; the halftone grid samples its opaque pixels
  anatomy       optional {iris:[x, y, r], pupil:r, tips:[[x, tipY, topY], ...]} in logo units; needed by the built-in eye modes
  palette       {light:[5 colours], dark:[5 colours]} halftone ramp from least to most lit (ink 0)
  inks          optional {light:[[5 colours], ...], dark:[...]}: extra ramps, inks 1..n, for custom renderers
  statusGlyphs  {ok, warn, broken, down, attn, unknown, busy, awake} SVG strings drawn with currentColor, each a distinct shape;
                busy is a loader for an action in progress (elements .busy-a/.busy-b/.busy-c step in turn, .busy-spin turns),
                coloured by --glyph-ok, --warn, --glyph-bad and --idle; awake (optional) has a .glyph-pupil group that follows
                the cursor while a ready app pill is hovered
  actionIcons   {copy, terminal, stop, check} SVG strings in the theme's own mark language (24-unit box); check is the tick on
                the selected option in a select list, drawn as a mask in --picker-check (sized by --check-size, default 14px)
  settingsIcon  SVG string for the settings button; chevron (optional) the details toggle arrow (12-unit box)
  wordmarkStroke  optional false: no brush underline under the wordmark (Horror: the eye already drips onto it)
  brushStroke   {colors:{core, edge}, presets:{name:{style?, weight, taperIn, taperOut, wobble, bristles, dryEnd, hook,
                drips:[min,max], dripLength, spatter:[min,max]}}} for the wordmark and branch underlines; style "blocks" draws a
                seeded row of pixel blocks instead of a brush (keys: block, gap, drop, light)
  brushStroke.overprint   optional {color, dx, dy, opacity}: every stroke is also printed in a second, offset ink
  halftoneOverprint  optional {dx, dy, scale, alpha, dark: {color, blend}, light: {color, blend}}: a second ink pass of the
                halftone character, offset by (dx, dy) px for misregistration; blend is a canvas composite mode
  glitch        optional {every: [min, max] s, frames: [min, max], shift: [min, max] px, bands: [min, max]}: the halftone
                character occasionally slips a few horizontal slices sideways
  pillHover     the app pill hover: "seep" (a wet band of --seep ink fills the bottom third, and a drop falls), "charge" (a
                stepped bar of --charge fills behind the label and the label inverts to --charge-ink), "blocks" (a DOS block
                fill, the same bar with a ▓▒░ leading edge) or "none". Default "seep".
  buttonHover   the same effects for every other button (icon buttons, Update, Show details, Done, Stop, the segmented
                control and the select options): "seep", "charge" or "blocks". Default "seep". Keyboard focus shows the same
                effect; the label stays readable mid-animation (a copy in the effect's ink is clipped to the fill); reduced
                motion shows the end state without moving.
  eyeModes      the Logo animation options: "full" (blinks, gaze that follows the cursor, drips), "subtle" (only the slow
                ambient motion) and "static" (subtle's still frame, no loop), or custom renderers
                {id, label, tracks, init(engine), frame(t, real, engine), still, idle}. A custom renderer draws on the halftone
                grid through the engine: cols, rows, pitch, fps, alpha[] (sampled logoSource), shade(), intensity[], ink[],
                back[] (a full-size backdrop dot, bucket ink*5+shade+1), put(col,row,value,ink) (raise), set(...) (overwrite),
                aim(col,row) (the cursor offset in px while tracking, else null), status (the backend rollup), random(seed),
                schedules(seed, first, gap, extra), reduced(). tracks: true makes the cursor engage tracking. Keep the ids
                full/subtle/static so a stored pick carries across themes. Old stored values map over: watcher and coin to
                full, bleeding to subtle, off to static.
  desk          painted once per scheme into cached tiles (no loop):
                  {seed, surface, blotter, stock: material ids ("velvet", "wood", "leather", "metal", "mat", "paper", "acrylic",
                   "plastic"), deckle: true tears the eye card's bottom edge and folds a dog-ear, glow: {color, core} pre-renders
                   a tube glow under the wordmark, props: [{art: SVG or an id in art, halftone: true screens it into dots on the
                   eye grid, side: "left"|"right", offset, bottom, width, height, rotate, flip, lights: [[x%, y%, size px], ...]}]
                   (lights flicker; hidden below 1400px), art: {id: SVG},
                   dark/light: {surface: {ramp, seam}, blotter: {ramp, grid, grid2}, stock: {ramp, fiber, fox}, tag, fog: colour}}
                  ramps are 3-4 hex colours, darkest first. The painter exposes --desk-surface, --desk-blotter, --desk-stock,
                  --desk-tag, --desk-fog, --desk-grit (a rubber-stamp mask), --desk-glow and --deckle to CSS.
  deskArt       optional {mount, badge, drip} SVG strings: mount holds the eye card down (tape), badge sits on its corner
                (a wax seal), drip hangs off the Sessions card's bottom edge
  deskCss       optional CSS string for this theme's flourishes (lighting, blotter, tag shapes, dialog mounts); scope
                every rule to html[data-theme="<id>"]
  radio         {reveal:"char"|"word", css: scoped Radio material rules, vars?: palette overrides, tube?: SVG}; BASE supplies --radio-plate,
                --radio-plate-ink, --radio-alert, --radio-tag, --radio-tag-ink, and paired --radio-problem-tag-ink/glyph.
  copy          optional text overrides: {emptyTitle}
Minimal skeleton:
  THEMES.owl = {
    name: "Owl",
    artPitch: 4.5,
    css: {light: {...REQUIRED_KEYS}, dark: {...}},
    fonts: {...},
    favicon: "<svg ...>", favicons: {ok, warn, bad, badDim, down},
    logoSource: "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'>...</svg>",
    palette: {light: [...], dark: [...]},
    desk: {seed: 3, surface: "wood", blotter: "leather", stock: "paper", dark: {...}, light: {...}},
    statusGlyphs: {...}, actionIcons: {...}, settingsIcon: "<svg ...>",
    brushStroke: {...}, pillHover: "seep", buttonHover: "seep",
    eyeModes: ["static"]
  };
==================================================================================== */
// Feature flags for work that is not ready to show. radioScene: offer the Radio layout in Settings (set true to bring it back;
// ?scene=radio shows it for one visit). While it is off, a stored Radio pick falls back to Desk.
var QA_FEATURES = {radioScene: false};
function svgAsset(svg){return 'url("data:image/svg+xml,'+encodeURIComponent(svg)+'")'}
// Brush-ink marks in a 24-unit box; strokes vary in weight so they read hand-drawn.
function inkIcon(parts){return '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">'+parts+'</svg>'}
// Pixel marks: rows of "#" (ink) and "." (empty), centred in a 24-unit box; pupil rows go in a .glyph-pupil group.
function bitPath(rows,cell,x0,y0){
  var d="";
  rows.forEach(function(row,y){for(var x=0;x<row.length;){if(row[x]!=="#"){x++;continue}var run=0;while(row[x+run]==="#")run++;
    d+="M"+(+(x0+x*cell).toFixed(2))+" "+(+(y0+y*cell).toFixed(2))+"h"+(+(run*cell).toFixed(2))+"v"+(+cell.toFixed(2))+"h"+(+(-run*cell).toFixed(2))+"z";x+=run}});
  return d;
}
function bitIcon(rows,pupil,box){
  box=box||24;var width=rows[0].length,cell=box/Math.max(rows.length,width),x0=(box-width*cell)/2,y0=(box-rows.length*cell)/2;
  return '<svg viewBox="0 0 '+box+' '+box+'" aria-hidden="true" fill="currentColor" shape-rendering="crispEdges"><path d="'+bitPath(rows,cell,x0,y0)+'"/>'+
    (pupil?'<g class="glyph-pupil"><path d="'+bitPath(pupil,cell,x0,y0)+'"/></g>':"")+'</svg>';
}
// A favicon from the same pixel rows: a backing shape (an SVG fragment) plus the rows in one ink, inside a box at (x, y, size).
function bitFavicon(rows,ink,backing,x,y,size){
  var width=rows[0].length,cell=size/Math.max(rows.length,width);
  return "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'>"+backing+"<path fill='"+ink+"' d='"+bitPath(rows,cell,x+(size-width*cell)/2,y+(size-rows.length*cell)/2)+"'/></svg>";
}
// Re-inks an SVG string by swapping exact colour literals, so a theme can reuse another theme's art in its own palette.
function retone(svg,map){return Object.keys(map).reduce(function(out,from){return out.split(from).join(map[from])},svg)}
// A lumpy closed outline (wax, blobs): r is the mean radius, bumps the number of lobes, amp their depth as a fraction of r.
function blobPath(cx,cy,r,bumps,amp,phase){
  var points=[];
  for(var i=0;i<48;i++){var a=i/48*Math.PI*2,k=r*(1+amp*Math.sin(a*bumps+phase)+amp*0.45*Math.sin(a*(bumps*2+1)+phase*1.7));points.push((cx+Math.cos(a)*k).toFixed(2)+" "+(cy+Math.sin(a)*k).toFixed(2))}
  return "M"+points.join("L")+"Z";
}
// A saddle-stitched edge for border-image (slice 8, about 4px wide): a pressed groove around the shape, a stitch hole at each end
// of every stitch and an angled waxed-thread stitch per 12-unit edge segment. thread and sheen colour the thread; groove the hollow.
function stitchBorder(thread, sheen, groove, lip) {
  var stitch = function (x, y, angle) { return '<g transform="translate(' + x + ' ' + y + ') rotate(' + angle + ')"><rect x="-3.9" y="-1.25" width="7.8" height="2.5" rx="1.25" fill="' + thread + '"/><rect x="-2.9" y="-1" width="5.6" height=".8" rx=".4" fill="' + sheen + '"/></g>' };
  var holes = function (points) { return points.map(function (p) { return '<circle cx="' + p[0] + '" cy="' + p[1] + '" r="1" fill="' + groove + '"/>' }).join("") };
  return svgAsset('<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 28 28">' +
    '<rect x="4" y="4.7" width="20" height="20" rx="4" fill="none" stroke="' + lip + '" stroke-width=".8"/>' +
    '<rect x="4" y="4" width="20" height="20" rx="4" fill="none" stroke="' + groove + '" stroke-width="1.5"/>' +
    holes([[9.5, 4], [18.5, 4], [9.5, 24], [18.5, 24], [4, 9.5], [4, 18.5], [24, 9.5], [24, 18.5]]) +
    stitch(14, 4, -9) + stitch(14, 24, -9) + stitch(4, 14, 81) + stitch(24, 14, 81) + '</svg>');
}
