/* ===== end THEMES ================================================================= */
var QA_THEME = (function () {
  var active = null, query = new URLSearchParams(location.search), systemDark = window.matchMedia("(prefers-color-scheme: dark)");
  // Appearance: "system" follows the OS live, "dark" and "light" force the scheme. Read here so it is applied before first paint.
  function pickScheme() {
    var value = query.get("scheme");
    if (!/^(system|dark|light)$/.test(value)) { try { value = localStorage.getItem("qaDashboardScheme") } catch (e) { value = null } }
    return /^(dark|light)$/.test(value) ? value : "system";
  }
  var schemePreference = pickScheme();
  var sceneId = "desk";
  function mapScene(value) {
    if (SCENES[value]) return value;
    if (value === "plain" || value === "candlelight" || value === "fog") return "console";
    return null;
  }
  function pickScene() {
    if (active && SCENES[sceneId]) return sceneId;
    var value = mapScene(query.get("scene")) || mapScene(query.get("bg"));
    if (!value) { try { value = mapScene(localStorage.getItem("qaDashboardScene")) || mapScene(localStorage.getItem("qaDashboardBackground")) } catch (e) {} }
    return value || "desk";
  }
  function showBackground(theme) {
    var scene = SCENES[sceneId],asset = scene.background,entry = (theme.backgrounds || {})[asset],root = document.documentElement;
    root.setAttribute("data-scene", scene.layout);
    root.setAttribute("data-bg", asset);
    root.setAttribute("data-bg-kind", entry ? entry.kind : "none");
  }
  function pick() {
    var name = query.get("theme");
    if (!THEMES[name]) { try { name = localStorage.getItem("qaDashboardTheme") } catch (e) { name = null } }
    return THEMES[name] ? name : "blood";
  }
  function deskArtVars(theme) {
    var art = theme.deskArt || {};
    return ";--desk-mount:" + (art.mount ? svgAsset(art.mount) : "none") + ";--desk-badge:" + (art.badge ? svgAsset(art.badge) : "none") + ";--desk-drip:" + (art.drip ? svgAsset(art.drip) : "none");
  }
  function block(vars) { return Object.keys(vars).map(function (key) { return key + ":" + vars[key] }).join(";") }
  // Film grain as one small pre-rendered tile of plain alpha noise. "multiply" grain darkens with black and "screen" grain
  // lightens with white; at these opacities that matches blending the noise with mix-blend-mode, without a full-page blend layer.
  function grainTile(vars) {
    try {
      var size = 128, canvas = document.createElement("canvas");
      canvas.width = canvas.height = size;
      var context = canvas.getContext("2d"), image = context.createImageData(size, size), seed = 1234567;
      var lighten = vars["--grain-blend"] === "screen", opacity = parseFloat(vars["--grain"]) || 0;
      var next = function () { seed = seed + 0x6D2B79F5 | 0; var t = Math.imul(seed ^ seed >>> 15, 1 | seed); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296 };
      var bell = function () { return (next() + next() + next()) / 3 };
      for (var i = 0; i < size * size; i++) {
        var tone = bell(), coverage = bell(), alpha = opacity * coverage * (lighten ? tone : 1 - tone);
        image.data[i * 4] = image.data[i * 4 + 1] = image.data[i * 4 + 2] = lighten ? 255 : 0;
        image.data[i * 4 + 3] = Math.round(alpha * 255);
      }
      context.putImageData(image, 0, 0);
      return 'url("' + canvas.toDataURL("image/png") + '")';
    } catch (e) { return "none" }
  }
  function consoleVars(theme,scheme) {
    var art=(theme.consoleArt||THEMES.blood.consoleArt)[scheme],css=theme.css[scheme];
    return ";--console-frame-board:"+svgAsset(consoleFrame(art,css["--inset"]))+
      ";--console-frame-panel:"+svgAsset(consoleFrame(art,css["--card"]))+
      ";--console-frame-inset:"+svgAsset(consoleFrame(art,css["--inset"]))+
      ";--console-frame-open:"+svgAsset(consoleFrame(art,"none"))+
      ";--console-frame-paper:"+svgAsset(consoleFrame(art,css["--parchment"]))+
      ";--console-frame-field:"+svgAsset(consoleFrame(art,css["--parchment-field"]))+
      ";--console-window:"+svgAsset(consoleWindow(art));
  }
  function apply(name) {
    var theme = THEMES[name] || THEMES.blood, fonts = theme.fonts, selected = pickScene();
    active = {id: THEMES[name] ? name : "blood", theme: theme};
    sceneId = selected;showBackground(theme);
    var style = document.getElementById("theme-style");
    if (!style) { style = document.createElement("style"); style.id = "theme-style"; document.head.appendChild(style) }
    // data-scheme is "system", "dark" or "light": the media query applies only unless light is forced, and a forced dark wins by specificity.
    var dark = block(theme.css.dark) + ";--grain-image:" + grainTile(theme.css.dark) + consoleVars(theme,"dark");
    style.textContent = ":root{" + block(theme.css.light) + ";--grain-image:" + grainTile(theme.css.light) + consoleVars(theme,"light") + ";--folio-art:url(\"data:image/svg+xml," + encodeURIComponent(theme.folioArt || "") + "\")" + deskArtVars(theme) + ";--serif:" + fonts.serif + ";--mono:" + fonts.mono + ";--body:" + fonts.body + "}" +
      "@media (prefers-color-scheme:dark){:root:not([data-scheme=\"light\"]){" + dark + "}}" +
      ":root[data-scheme=\"dark\"]{color-scheme:dark;" + dark + "}:root[data-scheme=\"light\"]{color-scheme:light}" + (theme.headerMark.underlineCss || "") + "\n" + (theme.deskCss || "");
    document.documentElement.setAttribute("data-scheme", schemePreference);
    document.documentElement.setAttribute("data-theme", active.id);
    var icon = document.querySelector('link[rel="icon"]');
    if (icon) { icon.href = "data:image/svg+xml," + encodeURIComponent(theme.favicon); icon.dataset.state = "" }
    document.dispatchEvent(new CustomEvent("qa-theme"));
  }
  apply(pick());
  return {
    current: function () { return active.theme },
    id: function () { return active.id },
    has: function (id) { return Object.prototype.hasOwnProperty.call(THEMES, id) },
    schemePreference: function () { return schemePreference },
    scene: function () { return sceneId },
    scenes: function () { return SCENES },
    background: function () { return SCENES[sceneId].background },
    backgrounds: function () { return active.theme.backgrounds || {} },
    chooseScene: function (id) {
      if (!SCENES[id]) return;
      try { localStorage.setItem("qaDashboardScene", id); localStorage.setItem("qaDashboardBackground", SCENES[id].background) } catch (e) {}
      sceneId = id;showBackground(active.theme);
      var picker = document.getElementById("bg-pick"); if (picker) picker.value = id;
      document.dispatchEvent(new CustomEvent("qa-bg"));
    },
    chooseBackground: function (id) { this.chooseScene(mapScene(id)) },
    isDark: function () { return schemePreference === "dark" || (schemePreference === "system" && systemDark.matches) },
    chooseScheme: function (value) {
      if (!/^(system|dark|light)$/.test(value)) return;
      try { localStorage.setItem("qaDashboardScheme", value) } catch (e) {}
      schemePreference = value;
      document.documentElement.setAttribute("data-scheme", value);
      document.dispatchEvent(new CustomEvent("qa-scheme"));
    },
    choose: function (name) { try { localStorage.setItem("qaDashboardTheme", name) } catch (e) {} apply(name) },
    // Desk swaps in the theme's brush-ink marks when it has them, so marks match the halftone and brush art around them.
    glyph: function (tone) { var ink = sceneId === "desk" && active.theme.inkGlyphs, glyphs = ink || active.theme.statusGlyphs; return glyphs[tone] || glyphs.unknown },
    icon: function (name) {
      var ink = sceneId === "desk" && active.theme.inkIcons;
      if (ink && ink[name]) return ink[name];
      return name === "settings" ? active.theme.settingsIcon || "" : active.theme.actionIcons[name];
    },
    favicon: function (state) {
      var icons = active.theme.favicons, svg = icons && icons[state] || active.theme.favicon, icon = document.querySelector('link[rel="icon"]');
      if (icon && icon.dataset.state !== state) { icon.href = "data:image/svg+xml," + encodeURIComponent(svg); icon.dataset.state = state }
    },
    copy: function (key, fallback) { var copy = active.theme.copy; return copy && copy[key] || fallback }
  };
})();
</script>
</head><body class="loading">
<script>
"use strict";
// Pixel-art page background: one low-resolution canvas scaled with nearest-neighbour, drawn from the active theme's `backgrounds` entry.
var QA_BG=(function(){
  var canvas=document.createElement("canvas"),ctx=canvas.getContext("2d"),reduced=window.matchMedia("(prefers-reduced-motion: reduce)");
  canvas.id="bg-canvas";canvas.setAttribute("aria-hidden","true");document.body.insertBefore(canvas,document.body.firstChild);
  var BAYER=[0,8,2,10,12,4,14,6,3,11,1,9,15,7,13,5];
  var timer=0,cols=0,rows=0,cell=QA_THEME.current().artPitch,image=null,pixels=null,running=null,resizeTimer=0;
  function bayer(x,y){return(BAYER[(y&3)*4+(x&3)]+0.5)/16}
  function pack(hex){var n=parseInt(hex.slice(1),16);return(255<<24|(n&255)<<16|(n>>8&255)<<8|n>>16)>>>0}
  function seeded(seed){return function(){seed=seed+0x6D2B79F5|0;var t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
  function config(){var theme=QA_THEME.current();return theme.backgrounds&&theme.backgrounds[QA_THEME.background()]||{kind:"none"}}
  function sprite(width,height,paint){
    var piece=document.createElement("canvas");piece.width=width;piece.height=height;
    var pieceContext=piece.getContext("2d"),data=pieceContext.createImageData(width,height),words=new Uint32Array(data.data.buffer);
    for(var y=0;y<height;y++)for(var x=0;x<width;x++){var color=paint(x,y);if(color)words[y*width+x]=color}
    pieceContext.putImageData(data,0,0);return piece;
  }
  function resize(){
    var bookPage=config().kind==="book";
    var viewWidth=document.documentElement.clientWidth||innerWidth;
    cell=QA_THEME.current().artPitch;cols=Math.ceil(viewWidth/cell);
    if(bookPage)canvas.style.height="0px";
    rows=Math.ceil((bookPage?Math.max(innerHeight,document.body.scrollHeight):innerHeight)/cell);
    canvas.width=cols;canvas.height=rows;canvas.style.width=viewWidth+"px";canvas.style.height=rows*cell+"px";
    image=ctx.createImageData(cols,rows);pixels=new Uint32Array(image.data.buffer);
  }
  function stop(){clearTimeout(timer);timer=0;running=null}

  /* ---- candles: many candles of varied size, each with a flickering flame and a wide dithered glow that swaps between pre-rendered frames at
     irregular moments; a static dithered wash along the bottom joins the glows into one warm ambient light ---- */
  var FLAME_SIZES={2:[8,13],3:[12,20]},FLAME_FRAMES=5;
  var GLOW_RADII={2:[61,69,77],3:[83,93,104]},GLOW_PEAK=0.85;
  function candles(cfg,palette){
    var glowColors=palette.glow.map(pack),flameColors={a:pack(palette.flame[0]),b:pack(palette.flame[1]),c:pack(palette.flame[2])};
    function glowFrames(radii){
      return radii.map(function(radius){
        return sprite(radius*2+1,radius*2+1,function(x,y){
          var level=Math.floor((1-Math.hypot(x-radius,(y-radius)*1.15)/radius)*GLOW_PEAK*3.4+(bayer(x,y)-0.5));
          return level<=0?0:glowColors[Math.min(2,level-1)];
        });
      });
    }
    var glowSets={2:glowFrames(GLOW_RADII[2]),3:glowFrames(GLOW_RADII[3])};
    // Each flame frame is drawn directly on the shared lattice, with a held, stepped lean and a small bright core.
    var flames={};
    Object.keys(FLAME_SIZES).forEach(function(size){
      var width=FLAME_SIZES[size][0],height=FLAME_SIZES[size][1];
      flames[size]=Array.from({length:FLAME_FRAMES},function(_,frame){return sprite(width,height,function(x,y){
        var progress=(y+1)/height,lean=Math.round(Math.sin(frame*1.35+y*0.52)*(1-progress)*1.5);
        var centre=(width-1)/2+lean,radius=Math.max(1,Math.round(width*(0.08+0.42*Math.sin(progress*Math.PI*0.9))));
        var distance=Math.abs(x-centre);
        if(distance>radius)return 0;
        if(progress<0.16)return flameColors.c;
        return distance<Math.max(1,radius*0.4)&&progress>0.23?flameColors.b:flameColors.a;
      })});
    });
    var washRows=Math.round(rows/3),wash=sprite(cols,washRows,function(x,y){
      var level=Math.floor((y/washRows)*1.6+(bayer(x,y)-0.5));
      return level<=0?0:glowColors[0];
    });
    var waxLight=pack(palette.wax[0]),waxDark=pack(palette.wax[1]);
    var list=cfg.candles.map(function(spec,index){
      var width=Math.max(1,Math.round(spec.width/cell)),height=Math.max(1,Math.round(spec.height/cell));
      var body=sprite(width,height,function(x,y){
        if(y===0&&x%2===0)return waxLight;
        if(y>0&&y%Math.round(42/cell)===3&&x===width-2)return waxLight;
        return x<width-Math.max(2,Math.round(width/3))?waxLight:waxDark;
      });
      return{x:Math.round(cols*spec.x-width/2),width:width,height:height,sink:Math.round((spec.sink||0)/cell),scale:spec.flame||2,body:body,glow:1,flame:index%FLAME_FRAMES,glowDue:0,flameDue:0};
    });
    function pick(count,not){var value=Math.floor(Math.random()*count);return value===not?(value+1)%count:value}
    function draw(){
      ctx.imageSmoothingEnabled=false;
      ctx.clearRect(0,0,cols,rows);
      ctx.drawImage(wash,0,rows-washRows);
      list.forEach(function(candle){
        var frames=glowSets[candle.scale]||glowSets[2],radius=GLOW_RADII[candle.scale===3?3:2][candle.glow];
        var flame=flames[candle.scale][candle.flame];
        ctx.drawImage(frames[candle.glow],candle.x+(candle.width>>1)-radius,rows-candle.height+candle.sink-Math.round(flame.height*0.6)-radius);
      });
      list.forEach(function(candle){
        var top=rows-candle.height+candle.sink;
        ctx.drawImage(candle.body,candle.x,top);
        var flame=flames[candle.scale][candle.flame];
        ctx.drawImage(flame,candle.x+(candle.width>>1)-(flame.width>>1),top-flame.height-1);
      });
    }
    function step(){
      var now=performance.now(),changed=false;
      list.forEach(function(candle){
        if(now>=candle.flameDue){candle.flame=pick(FLAME_FRAMES,candle.flame);candle.flameDue=now+60+Math.random()*260;changed=true}
        if(now>=candle.glowDue){candle.glow=pick(3,candle.glow);candle.glowDue=now+200+Math.random()*1100;changed=true}
      });
      if(changed)draw();
      timer=setTimeout(step,100);
    }
    draw();
    return reduced.matches?null:step;
  }

  /* ---- book: an open spread of two aged pages with a gutter shadow, stacked page edges, deckled borders and one dog-eared corner. Drawn once. ---- */
  function book(cfg,palette){
    var next=seeded(cfg.seed||19),paper=palette.paper.map(pack),gutter=pack(palette.gutter),fox=pack(palette.fox),ink=pack(palette.ink);
    var edge=palette.edge.map(pack),desk=pack(palette.desk),underside=pack(palette.underside),shadow=pack(palette.shadow);
    var x,y,k,singlePage=window.matchMedia("(max-width:1099px)").matches;
    var margin=singlePage?4:7,stack=singlePage?3:8,centre=singlePage?margin+stack:cols>>1,gutterWidth=singlePage?4:Math.min(17,cols>>2);
    var edgeSoft=singlePage?9:19,edgeDark=singlePage?3:7,inkStep=singlePage?3:7,lineInset=singlePage?7:13;
    function walk(length,limit){var out=[],value=Math.floor(next()*limit);for(var i=0;i<length;i++){if(next()<0.35)value=Math.max(0,Math.min(limit,value+(next()<0.5?-1:1)));out.push(value)}return out}
    var edgeJitter=singlePage?2:4,left=walk(rows,edgeJitter),right=walk(rows,edgeJitter),top=walk(cols,edgeJitter),bottom=walk(cols,edgeJitter);
    function onPage(px,py){return px>=margin+stack+left[py]&&px<cols-margin-stack-right[py]&&py>=margin+top[px]&&py<rows-margin-bottom[px]}
    var fold=Math.min(singlePage?12:24,rows>>3),cornerX=cols-margin-stack-2,cornerY=rows-margin-2;
    for(y=0;y<rows;y++)for(x=0;x<cols;x++){
      var color=desk;
      if(onPage(x,y)){
        var toEdge=Math.min(x-(margin+stack),cols-margin-stack-x,y-margin,rows-margin-y),toGutter=Math.abs(x-centre)/gutterWidth;
        var level=0;
        if(toGutter<1)level=Math.floor((1-toGutter)*3.4+bayer(x,y)-0.5);
        if(level>=3)color=gutter;
        else{
          var tone=Math.max(0,level);
          if(toEdge<edgeSoft&&bayer(x,y)*edgeSoft>toEdge)tone=Math.max(tone,1);
          if(toEdge<edgeDark&&bayer(x+2,y+1)*edgeDark>toEdge)tone=2;
          if(tone===0&&next()<0.04)tone=1;
          color=paper[Math.min(2,tone)];
        }
      }else{
        for(k=1;k<=stack;k++){
          var strip=(x===margin+stack-k+left[Math.min(rows-1,y)]&&y>margin+k&&y<rows-margin-k)||(x===cols-margin-stack+k-1-right[Math.min(rows-1,y)]&&y>margin+k&&y<rows-margin-k);
          if(strip){color=edge[k&1];break}
        }
      }
      pixels[y*cols+x]=color;
    }
    function put(px,py,value){if(px>=0&&py>=0&&px<cols&&py<rows)pixels[py*cols+px]=value}
    for(k=0;k<46;k++){
      var side=next()<0.5?-1:1,spread=Math.max(0,cols/2-gutterWidth-margin-stack-4);
      var spotX=singlePage?Math.round(margin+stack+5+next()*Math.max(0,cols-2*(margin+stack+5))):Math.round(centre+side*(gutterWidth+next()*spread));
      var spotY=Math.round(margin+4+next()*Math.max(0,rows-2*margin-8)),radius=(1.5+next()*3.5)*(singlePage?0.67:1.33);
      var reach=singlePage?5:9;
      for(var j=-reach;j<=reach;j++)for(var i=-reach;i<=reach;i++){
        var fall=1-Math.hypot(i,j)/radius;
        if(fall>0&&onPage(spotX+i,spotY+j)&&fall>bayer(spotX+i,spotY+j)*0.9)put(spotX+i,spotY+j,fox);
      }
    }
    for(y=margin+lineInset;y<rows-margin-lineInset;y+=inkStep){
      for(x=margin+stack+lineInset;x<cols-margin-stack-lineInset;x++){
        if((!singlePage&&Math.abs(x-centre)<gutterWidth*0.5)||!onPage(x,y))continue;
        put(x,y,ink);
      }
      var cursor=margin+stack+lineInset;
      while(cursor<cols-margin-stack-lineInset){
        var run=singlePage?1+Math.floor(next()*5):3+Math.floor(next()*8);
        if((singlePage||Math.abs(cursor-centre)>gutterWidth*0.6)&&next()<0.6)for(var d=0;d<run;d++)put(cursor+d,y-1,ink);
        cursor+=run+1+Math.floor(next()*3);
      }
    }
    // dog-ear: the corner beyond the fold line is gone, and its mirror image folds over as a lighter, shaded underside with a small cast shadow
    for(y=cornerY-fold-4;y<=cornerY;y++)for(x=cornerX-fold-4;x<=cornerX;x++){
      var across=(cornerX-x)+(cornerY-y);
      if(across<fold)put(x,y,desk);
      else if(x>=cornerX-fold&&y>=cornerY-fold&&across<fold*2){
        var gradient=Math.floor((across-fold)/fold*2.4+bayer(x,y));
        put(x,y,gradient>=2?paper[1]:underside);
      }else if(across<fold*2+3&&across>=fold&&bayer(x,y)>0.35)put(x,y,shadow);
    }
    ctx.putImageData(image,0,0);
    return null;
  }

  /* ---- console: a fixed control room window, ribbed bulkheads and a low deck, painted once on the common 4.5px lattice. ---- */
  function consoleRoom(cfg,palette){
    var color={room:pack(palette.room),void:pack(palette.void),rib:pack(palette.rib),edge:pack(palette.edge),
      shine:pack(palette.shine),deck:pack(palette.deck),vent:pack(palette.vent),star:pack(palette.star)};
    pixels.fill(color.room);
    function rect(x,y,w,h,ink){
      var x0=Math.max(0,Math.round(x)),y0=Math.max(0,Math.round(y)),x1=Math.min(cols,Math.round(x+w)),y1=Math.min(rows,Math.round(y+h));
      for(var row=y0;row<y1;row++)pixels.fill(ink,row*cols+x0,row*cols+x1);
    }
    var left=Math.max(7,Math.round(cols*.085)),right=cols-left,top=Math.max(5,Math.round(rows*.09)),deckY=Math.max(top+20,Math.round(rows*.72));
    rect(left,top,right-left,deckY-top,color.void);
    rect(0,0,cols,3,color.rib);rect(0,3,cols,1,color.edge);
    rect(0,top,left,deckY-top,color.rib);rect(right,top,cols-right,deckY-top,color.rib);
    rect(left-2,top,2,deckY-top,color.edge);rect(right,top,2,deckY-top,color.edge);
    rect(left+3,top+3,right-left-6,1,color.vent);
    // Unequal conduits and ribs keep the room authored without filling its quiet viewport.
    rect(3,top+4,2,deckY-top-8,color.edge);rect(7,top+11,1,deckY-top-20,color.shine);
    rect(right+5,top+5,2,deckY-top-9,color.edge);rect(right+10,top+17,1,deckY-top-28,color.vent);
    for(var rib=top+9;rib<deckY-5;rib+=22){
      rect(0,rib,left-2,2,color.vent);rect(right+2,rib+7,cols-right-2,2,color.vent);
      rect(left-3,rib,3,4,color.shine);rect(right,rib+7,3,4,color.shine);
    }
    var next=seeded(173);
    for(var star=0;star<32;star++){
      var sx=left+5+Math.floor(next()*Math.max(1,right-left-10)),sy=top+5+Math.floor(next()*Math.max(1,deckY-top-13));
      rect(sx,sy,star%7===0?2:1,1,color.star);
    }
    rect(0,deckY,cols,rows-deckY,color.deck);rect(0,deckY,cols,3,color.rib);rect(0,deckY+3,cols,1,color.edge);
    for(var tile=0;tile<cols;tile+=18){
      rect(tile,deckY+7,2,Math.max(0,rows-deckY-7),color.rib);
      rect(tile+5,deckY+11,8,1,color.vent);
      if(tile%36===0)rect(tile+5,deckY+14,5,1,color.edge);
    }
    for(var band=deckY+20;band<rows;band+=24)rect(0,band,cols,2,color.rib);
    ctx.putImageData(image,0,0);
    return null;
  }

  /* ---- fog: smoky grey-red bands from value noise, ordered-dithered at their edges, drifting in steps ---- */
  function fog(cfg,palette){
    var tones=palette.tones.map(pack),next=seeded(41),lattice=new Float32Array(4096),i;
    for(i=0;i<4096;i++)lattice[i]=next();
    function noise(x,y){
      var xi=Math.floor(x),yi=Math.floor(y),fx=x-xi,fy=y-yi;fx=fx*fx*(3-2*fx);fy=fy*fy*(3-2*fy);
      var a=lattice[(yi&63)*64+(xi&63)],b=lattice[(yi&63)*64+((xi+1)&63)],c=lattice[((yi+1)&63)*64+(xi&63)],d=lattice[((yi+1)&63)*64+((xi+1)&63)];
      return a+(b-a)*fx+(c-a)*fy+(a-b-c+d)*fx*fy;
    }
    function draw(seconds){
      var t=Math.floor(seconds*(cfg.fps||6))/(cfg.fps||6);
      for(var y=0;y<rows;y++){
        var lift=0.8+0.2*y/rows;
        for(var x=0;x<cols;x++){
          var n=(0.6*noise(x*cell*0.0075+t*0.05,y*cell*0.010625)+0.4*noise(x*cell*0.01625-t*0.07+31,y*cell*0.02125+t*0.02))*lift;
          var level=Math.floor((n-0.3)*5+(bayer(x,y)-0.5));
          pixels[y*cols+x]=level<=0?0:tones[Math.min(2,level-1)];
        }
      }
      ctx.putImageData(image,0,0);
    }
    draw(0);
    if(reduced.matches)return null;
    var begun=performance.now();
    return function step(){draw((performance.now()-begun)/1000);timer=setTimeout(step,1000/(cfg.fps||6))};
  }

  /* ---- desk: a real surface for the Desk scene. Each material is painted once per theme and scheme into a full-resolution tile
     and handed to CSS as a background, so nothing is filtered or blended live. Light, fog and flames move by opacity and transform. ---- */
  var deskLayer=document.createElement("div"),deskTiles={};
  deskLayer.id="desk";deskLayer.setAttribute("aria-hidden","true");
  deskLayer.innerHTML='<i class="desk-light"></i><i class="desk-flicker"></i><i class="desk-flicker b"></i><i class="desk-fog a"></i><i class="desk-fog b"></i><i class="desk-overlay"></i><div class="desk-props"></div>';
  document.body.insertBefore(deskLayer,canvas);
  document.addEventListener("qa-modal",function(e){document.documentElement.classList.toggle("modal-open",!!e.detail)});
  function rgb(hex){var n=parseInt(hex.slice(1),16);return[n>>16&255,n>>8&255,n&255]}
  function rgba(hex,alpha){return"rgba("+rgb(hex).join(",")+","+alpha+")"}
  function ramp(colors){
    var stops=colors.map(rgb),last=stops.length-1;
    return function(t,out){
      t=Math.max(0,Math.min(0.9999,t))*last;var i=Math.floor(t),f=t-i,a=stops[i],b=stops[Math.min(last,i+1)];
      out[0]=a[0]+(b[0]-a[0])*f;out[1]=a[1]+(b[1]-a[1])*f;out[2]=a[2]+(b[2]-a[2])*f;return out;
    };
  }
  // Seamless value noise: periods are whole lattice cells (at most 256), so every tile wraps without a seam.
  function noiseField(seed){
    var next=seeded(seed),lattice=new Float32Array(65536);
    for(var i=0;i<65536;i++)lattice[i]=next();
    function value(x,y,px,py){
      var xi=Math.floor(x),yi=Math.floor(y),fx=x-xi,fy=y-yi;fx=fx*fx*(3-2*fx);fy=fy*fy*(3-2*fy);
      var x0=((xi%px)+px)%px,x1=(x0+1)%px,y0=((yi%py)+py)%py,y1=(y0+1)%py;
      var a=lattice[y0<<8|x0],b=lattice[y0<<8|x1],c=lattice[y1<<8|x0],d=lattice[y1<<8|x1];
      return a+(b-a)*fx+(c-a)*fy+(a-b-c+d)*fx*fy;
    }
    function fbm(u,v,fx,fy,octaves){
      var sum=0,amp=0.5,norm=0;
      for(var o=0;o<octaves;o++){sum+=amp*value(u*fx,v*fy,fx,fy);norm+=amp;amp*=0.5;fx=Math.min(256,fx*2);fy=Math.min(256,fy*2)}
      return sum/norm;
    }
    return{value:value,fbm:fbm,next:next};
  }
  function paintTile(width,height,shade){
    var piece=document.createElement("canvas");piece.width=width;piece.height=height;
    var context=piece.getContext("2d"),data=context.createImageData(width,height),bytes=data.data,out=[0,0,0,255];
    for(var y=0;y<height;y++)for(var x=0;x<width;x++){
      out[3]=255;shade(x,y,x/width,y/height,out);
      var k=(y*width+x)*4;bytes[k]=out[0];bytes[k+1]=out[1];bytes[k+2]=out[2];bytes[k+3]=out[3];
    }
    context.putImageData(data,0,0);
    return{canvas:piece,context:context};
  }
  // Small marks (pores, fibres, scratches, foxing) drawn on top, repeated across the edges so the tile still wraps.
  function scatter(tile,count,n,draw){
    var c=tile.context,w=tile.canvas.width,h=tile.canvas.height;
    for(var i=0;i<count;i++){
      var x=n.next()*w,y=n.next()*h,r=n.next(),s=n.next();
      // Only marks near an edge need a wrapped copy; reach covers the longest mark.
      var xs=[0],ys=[0],reach=170;
      if(x<reach)xs.push(1);if(x>w-reach)xs.push(-1);if(y<reach)ys.push(1);if(y>h-reach)ys.push(-1);
      for(var a=0;a<xs.length;a++)for(var b=0;b<ys.length;b++){c.save();c.translate(x+xs[a]*w,y+ys[b]*h);draw(c,r,s);c.restore()}
    }
  }
  function scratches(tile,n,count,color,alpha){
    scatter(tile,count,n,function(c,r,s){c.rotate(r*Math.PI*2);c.globalAlpha=alpha*(0.4+s);c.strokeStyle=color;c.lineWidth=0.6;c.beginPath();c.moveTo(0,0);c.quadraticCurveTo(20+s*40,(r-0.5)*8,30+r*130,(s-0.5)*6);c.stroke()});
  }
  var MATERIALS={
    // Planks of stained wood: figure from warped rings, long fibre streaks, seams, pores and wear.
    wood:function(p,n){
      var w=768,h=384,planks=4,ph=h/planks,R=ramp(p.ramp),seam=rgb(p.seam||p.ramp[0]),offsets=[],tones=[],joints=[];
      for(var k=0;k<planks;k++){offsets.push(n.next()*10);tones.push((n.next()-0.5)*0.14);joints.push(Math.floor(n.next()*w))}
      var tile=paintTile(w,h,function(x,y,u,v,out){
        var plank=Math.floor(y/ph),ly=y-plank*ph;
        if(ly<2||(x>=joints[plank]&&x<joints[plank]+2)){out[0]=seam[0];out[1]=seam[1];out[2]=seam[2];return}
        var warp=n.fbm(u,v,4,4,2),figure=ly/ph*2.6+warp*2.2+offsets[plank]+n.value(u*2,v*16,2,16)*0.8;
        var ring=0.5+0.5*Math.sin(figure*Math.PI*2);ring=ring*ring*ring;
        var streak=n.fbm(u,v,8,256,2);
        R(0.1+0.52*streak+0.3*ring+0.16*(warp-0.5)+tones[plank]+(ly<5?0.1:0),out);
      });
      scatter(tile,1300,n,function(c,r,s){c.globalAlpha=0.25+0.35*s;c.fillStyle=p.seam||p.ramp[0];c.fillRect(0,0,2+r*9,1)});
      scratches(tile,n,46,p.ramp[p.ramp.length-1],0.12);
      return tile;
    },
    // Pebbled leather with soft mottling, creases and scuffs.
    leather:function(p,n){
      var s=384,R=ramp(p.ramp);
      var tile=paintTile(s,s,function(x,y,u,v,out){
        var mottle=n.fbm(u,v,4,4,3),pebble=n.value(u*112,v*112,112,112);
        R(0.18+0.64*mottle+(pebble>0.68?-0.12:pebble<0.24?0.07:0)+(n.next()-0.5)*0.08,out);
      });
      scratches(tile,n,30,p.ramp[p.ramp.length-1],0.1);
      scatter(tile,70,n,function(c,r,s){c.globalAlpha=0.1+0.15*s;c.fillStyle=p.ramp[0];c.beginPath();c.ellipse(0,0,2+r*7,1+s*3,r*3,0,Math.PI*2);c.fill()});
      return tile;
    },
    // Brushed metal: fine horizontal grain over a slow sheen.
    metal:function(p,n){
      var R=ramp(p.ramp),tile=paintTile(512,256,function(x,y,u,v,out){
        R(0.22+0.4*n.fbm(u,v,4,256,2)+0.34*(n.value(u*2,v*2,2,2)-0.5)+(n.next()-0.5)*0.1,out);
      });
      scratches(tile,n,34,p.ramp[p.ramp.length-1],0.12);
      return tile;
    },
    // A rubber cutting mat with a printed grid and the knife marks of earlier jobs.
    mat:function(p,n){
      var s=320,R=ramp(p.ramp),tile=paintTile(s,s,function(x,y,u,v,out){R(0.5+(n.fbm(u,v,8,8,3)-0.5)*0.5+(n.next()-0.5)*0.12,out)});
      var c=tile.context,i;
      c.fillStyle=p.grid;for(i=0;i<s;i+=16){c.fillRect(i,0,1,s);c.fillRect(0,i,s,1)}
      c.fillStyle=p.grid2;for(i=0;i<s;i+=80){c.fillRect(i,0,1.5,s);c.fillRect(0,i,s,1.5)}
      for(i=0;i<s;i+=80){c.fillRect(i+38,i+39,4,2);c.fillRect(i+39,i+38,2,4)}
      scratches(tile,n,40,p.ramp[p.ramp.length-1],0.16);
      return tile;
    },
    // Card stock: cloudy mottling, grain, short fibres and a few foxing spots.
    paper:function(p,n){
      var s=320,R=ramp(p.ramp);
      var tile=paintTile(s,s,function(x,y,u,v,out){
        R(0.5+(n.fbm(u,v,5,5,3)-0.5)*0.8+(n.value(u*2,v*2,2,2)-0.5)*0.4+(n.next()-0.5)*0.1,out);
      });
      scatter(tile,360,n,function(c,r,s){c.rotate(r*Math.PI*2);c.globalAlpha=0.1+0.22*s;c.strokeStyle=p.fiber;c.lineWidth=0.7;c.beginPath();c.moveTo(0,0);c.quadraticCurveTo(3+r*4,(s-0.5)*4,4+s*9,(r-0.5)*3);c.stroke()});
      scatter(tile,8,n,function(c,r,s){
        var radius=1.5+r*6,glow=c.createRadialGradient(0,0,0,0,0,radius);
        glow.addColorStop(0,rgba(p.fox,0.55));glow.addColorStop(0.6,rgba(p.fox,0.22));glow.addColorStop(1,rgba(p.fox,0));
        c.fillStyle=glow;c.beginPath();c.arc(0,0,radius,0,Math.PI*2);c.fill();
        c.fillStyle=rgba(p.fox,0.4);for(var k=0;k<3;k++){c.beginPath();c.arc((s-0.5)*radius*3+k*2,(r-0.5)*radius*2-k,0.6+s,0,Math.PI*2);c.fill()}
      });
      return tile;
    },
    // Smoky acrylic: almost flat, with faint cloud and hairline scratches.
    acrylic:function(p,n){
      var R=ramp(p.ramp),tile=paintTile(256,256,function(x,y,u,v,out){R(0.5+(n.fbm(u,v,4,4,2)-0.5)*0.35+(n.next()-0.5)*0.08,out)});
      scratches(tile,n,14,p.ramp[p.ramp.length-1],0.12);
      return tile;
    }
  };
  function fogTile(color,n){
    var c=rgb(color);
    return paintTile(512,128,function(x,y,u,v,out){
      var a=n.fbm(u,v,4,2,3),body=Math.pow(Math.sin(Math.PI*v),1.4);
      out[0]=c[0];out[1]=c[1];out[2]=c[2];out[3]=Math.max(0,Math.min(255,(a-0.36)*2.8*body*230));
    });
  }
  // An alpha mask that knocks small gaps and worn streaks out of a rubber stamp's ink.
  function gritTile(n){
    return paintTile(150,150,function(x,y,u,v,out){
      var blot=n.value(u*30,v*30,30,30),streak=n.fbm(u,v,3,48,2);
      out[0]=out[1]=out[2]=255;out[3]=blot>0.84||n.next()<0.02?40:streak>0.74?150:255;
    });
  }
  function glowSprite(glow){
    var piece=document.createElement("canvas");piece.width=360;piece.height=64;
    var c=piece.getContext("2d");c.lineCap="round";
    c.shadowColor=glow.color;c.shadowBlur=18;c.strokeStyle=glow.color;c.lineWidth=4;
    c.beginPath();c.moveTo(42,36);c.lineTo(318,36);c.stroke();c.stroke();
    c.shadowBlur=5;c.strokeStyle=glow.core;c.lineWidth=1.6;c.beginPath();c.moveTo(46,36);c.lineTo(314,36);c.stroke();
    return{canvas:piece};
  }
  // A torn bottom edge with a dog-eared corner, for the eye card's clip-path.
  function deckle(n){
    var points=["0 0","100% 0","100% calc(100% - 30px)","calc(100% - 30px) 100%"];
    for(var x=86;x>0;x-=3.4)points.push(x.toFixed(1)+"% calc(100% - "+(n.next()*5).toFixed(1)+"px)");
    points.push("0 calc(100% - 2px)");
    return"polygon("+points.join(",")+")";
  }
  function deskProps(cfg){
    var box=deskLayer.querySelector(".desk-props"),art=cfg.art||{};
    box.textContent="";
    (cfg.props||[]).forEach(function(prop){
      var element=document.createElement("div"),svg=art[prop.art]||prop.art;
      element.className="desk-prop";
      element.style.cssText=prop.side+":"+(prop.offset||0)+"px;bottom:"+(prop.bottom||0)+"px;width:"+prop.width+"px;height:"+prop.height+"px;background-image:"+svgAsset(svg)+
        (prop.rotate||prop.flip?";transform:"+(prop.flip?"scaleX(-1) ":"")+(prop.rotate?"rotate("+prop.rotate+"deg)":""):"");
      (prop.lights||[]).forEach(function(light,index){
        var flame=document.createElement("i");flame.className="light";
        flame.style.cssText="left:"+light[0]+"%;top:"+light[1]+"%;--s:"+light[2]+"px;animation-delay:-"+((index*0.77+light[0]*0.031)%2).toFixed(2)+"s";
        element.appendChild(flame);
      });
      box.appendChild(element);
    });
  }
  // Finished tiles are cached in memory and in localStorage (keyed by a hash of the theme's desk entry), so a reload paints nothing.
  var DESK_CACHE_VERSION=1;
  function deskStoreKey(cfg,scheme){
    var text=JSON.stringify({v:DESK_CACHE_VERSION,cfg:cfg,scheme:scheme}),hash=2166136261;
    for(var i=0;i<text.length;i++){hash^=text.charCodeAt(i);hash=Math.imul(hash,16777619)}
    return"qaDashboardDesk:"+QA_THEME.id()+":"+scheme+":"+(hash>>>0).toString(36);
  }
  // Keep at most one tile set per known theme and scheme: drop stale hashes, old versions and removed themes.
  function sweepDeskCache(prefix,keep){
    try{
      Object.keys(localStorage).forEach(function(name){
        if(name.indexOf("qaDashboardDesk:")!==0||name===keep)return;
        var id=name.split(":")[1];
        if(name.indexOf("qaDashboardDesk:"+prefix)===0||!QA_THEME.has(id))localStorage.removeItem(name);
      });
    }catch(e){}
  }
  function desk(cfg,palette){
    var scheme=QA_THEME.isDark()?"dark":"light",key=QA_THEME.id()+":"+scheme,vars=deskTiles[key],root=document.documentElement,storeKey=deskStoreKey(cfg,scheme);
    if(!vars){try{vars=JSON.parse(localStorage.getItem(storeKey)||"null")}catch(e){vars=null}if(vars)deskTiles[key]=vars}
    if(!vars){
      var n=noiseField(cfg.seed||7);vars={};
      var put=function(name,tile,type){vars["--desk-"+name]='url("'+tile.canvas.toDataURL(type||"image/png",0.92)+'")';vars["--desk-"+name+"-size"]=tile.canvas.width+"px "+tile.canvas.height+"px"};
      try{
        if(MATERIALS[cfg.surface])put("surface",MATERIALS[cfg.surface](palette.surface,n),"image/jpeg");
        if(MATERIALS[cfg.blotter]){put("blotter",MATERIALS[cfg.blotter](palette.blotter,n),"image/jpeg");vars["--desk-blotter-color"]=palette.blotter.ramp[1]}
        if(MATERIALS[cfg.stock])put("stock",MATERIALS[cfg.stock](palette.stock,n),"image/jpeg");
        if(palette.tag&&MATERIALS[cfg.stock])put("tag",MATERIALS[cfg.stock](palette.tag,n),"image/jpeg");
        if(palette.fog)put("fog",fogTile(palette.fog,n));
        put("grit",gritTile(n));
        if(cfg.glow)put("glow",glowSprite(cfg.glow));
        vars["--deckle"]=cfg.deckle?deckle(n):"none";
      }catch(e){}
      deskTiles[key]=vars;
      try{
        localStorage.setItem(storeKey,JSON.stringify(vars));
      }catch(e){}
    }
    sweepDeskCache(QA_THEME.id()+":"+scheme+":",storeKey);
    Object.keys(vars).forEach(function(name){root.style.setProperty(name,vars[name])});
    ["--desk-fog","--desk-glow","--desk-blotter","--desk-tag"].forEach(function(name){if(!vars[name])root.style.setProperty(name,"none")});
    root.setAttribute("data-deckle",cfg.deckle?"1":"0");
    deskProps(cfg);
    return null;
  }

  var KINDS={candles:candles,book:book,console:consoleRoom,fog:fog,desk:desk};
  function start(){
    stop();
    var cfg=config(),make=KINDS[cfg.kind];
    if(!make)return;
    if(cfg.kind==="desk"){desk(cfg,cfg[QA_THEME.isDark()?"dark":"light"]||cfg.dark);return}
    resize();
    var scheme=QA_THEME.isDark()?"dark":"light",palette=cfg.kind==="console"?QA_THEME.current().consoleArt[scheme]:cfg[scheme]||cfg.dark;
    running=make(cfg,palette);
    if(running&&!document.hidden)timer=setTimeout(running,100);
  }
  document.addEventListener("qa-scheme",start);document.addEventListener("qa-bg",start);document.addEventListener("qa-theme",start);
  document.addEventListener("qa-layout",function(){if(config().kind==="book")start()});
  window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change",start);
  if(reduced.addEventListener)reduced.addEventListener("change",start);
  window.addEventListener("resize",function(){clearTimeout(resizeTimer);resizeTimer=setTimeout(start,200)});
  document.addEventListener("visibilitychange",function(){
    if(document.hidden){clearTimeout(timer);timer=0}
    else if(running&&!timer)timer=setTimeout(running,50);
  });
  start();
  return{start:start};
})();
</script>
