// Neon: magenta and cyan on near-black. The same eye, re-inked in magenta with an off-register cyan, on smoky acrylic and a
// cutting mat; red is kept for problems only, so a failure never reads as the main ink. Marks are a pixel set of their own.
THEMES.neon = (function () {
  var horror = THEMES.horror, N = 'html[data-theme="neon"]';
  var screw = function (x, y) { return "radial-gradient(circle at " + x + " " + y + ",var(--screw-hi) 0 1.3px,var(--screw) 1.9px 3.5px,var(--screw-lo) 4px 4.8px,transparent 5.3px)" };
  var screws = [screw("12px", "12px"), screw("calc(100% - 12px)", "12px"), screw("12px", "calc(100% - 12px)"), screw("calc(100% - 12px)", "calc(100% - 12px)")].join(",");
  var scan = "repeating-linear-gradient(0deg,var(--scan) 0 1px,transparent 1px 3px)";
  // Pixel status set: a different silhouette per state (diamond, hourglass, bolt, power, warning sign, question mark).
  var BITS = {
    ok: ["....##....", "...####...", "..######..", ".########.", "##########", "##########", ".########.", "..######..", "...####...", "....##...."],
