#!/usr/bin/env python3
"""Post a user message into a running T3 Code thread (local server, short-lived token)."""
import argparse, json, os, subprocess, sys, tempfile, urllib.error, urllib.request, uuid
from datetime import datetime, timezone

DEFAULT_ORIGIN = "http://127.0.0.1:3773"
LABEL = "t3-post"


def origin():
    if os.environ.get("T3_ORIGIN"):
        return os.environ["T3_ORIGIN"].rstrip("/")
    try:
        path = os.path.expanduser("~/.t3/userdata/server-runtime.json")
        with open(path) as f:
            return json.load(f).get("origin", DEFAULT_ORIGIN).rstrip("/")
    except (OSError, ValueError):
        return DEFAULT_ORIGIN


def call(method, url, token, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method, headers={
        "authorization": f"Bearer {token}", "content-type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.status, resp.read().decode()
    except urllib.error.HTTPError as err:
        return err.code, err.read().decode(errors="replace")


def build_command(args, token, base, text):
    status, raw = call("GET", f"{base}/api/orchestration/snapshot", token)
    if status != 200:
        sys.exit(f"t3-post: snapshot failed ({status}): {raw[:300]}")
    thread = next((t for t in json.loads(raw)["threads"] if t["id"] == args.thread_id), None)
    if thread is None:
        sys.exit(f"t3-post: thread {args.thread_id} not found")
    if thread.get("deletedAt") or thread.get("archivedAt"):
        sys.exit(f"t3-post: thread {args.thread_id} is deleted or archived")
    now = datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")
    return {
        "type": "thread.turn.start", "commandId": str(uuid.uuid4()), "threadId": args.thread_id,
        "message": {"messageId": str(uuid.uuid4()), "role": "user", "text": text, "attachments": []},
        "modelSelection": thread["modelSelection"], "runtimeMode": thread["runtimeMode"],
        "interactionMode": thread["interactionMode"], "createdAt": now,
    }


def main():
    ap = argparse.ArgumentParser(description="Post a user message into a T3 Code thread.")
    ap.add_argument("thread_id")
    ap.add_argument("--file", help="read the message from this file (default: stdin)")
    ap.add_argument("--dry-run", action="store_true", help="print the command instead of sending it")
    args = ap.parse_args()
    if args.file:
        with open(args.file) as f:
            text = f.read()
    else:
        text = sys.stdin.read()
    if not text.strip():
        sys.exit("t3-post: refusing to send an empty message")

    session_id = None
    with tempfile.TemporaryDirectory(prefix="t3-post-") as tmp:
        os.chmod(tmp, 0o700)
        try:
            issued = subprocess.run(
                ["t3", "auth", "session", "issue", "--ttl", "5m", "--label", LABEL, "--json"],
                capture_output=True, text=True, check=True, cwd=tmp).stdout
            session = json.loads(issued)
            session_id, token = session["sessionId"], session["token"]
            command = build_command(args, token, origin(), text)
            if args.dry_run:
                print(json.dumps(command, indent=2))
                return
            status, body = call("POST", f"{origin()}/api/orchestration/dispatch", token, command)
            if not 200 <= status < 300:
                sys.exit(f"t3-post: dispatch failed ({status}): {body[:500]}")
            print(f"thread={args.thread_id} message={command['message']['messageId']} status={status}")
        except subprocess.CalledProcessError as err:
            sys.exit(f"t3-post: could not issue a token: {err.stderr.strip()[:300]}")
        finally:
            if session_id:
                subprocess.run(["t3", "auth", "session", "revoke", session_id],
                               capture_output=True, text=True, cwd=tmp)


if __name__ == "__main__":
    main()
