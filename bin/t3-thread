#!/usr/bin/env python3
"""Manage T3 Code threads from an agent: post, self, spawn, settle (local server, short-lived token)."""
import argparse, contextlib, json, os, sqlite3, subprocess, sys, tempfile, time, urllib.error, urllib.request, uuid
from datetime import datetime, timezone

DEFAULT_ORIGIN = "http://127.0.0.1:3773"
LABEL = "t3-thread"
STATE_DB = os.path.expanduser("~/.t3/userdata/state.sqlite")


def origin():
    if os.environ.get("T3_ORIGIN"):
        return os.environ["T3_ORIGIN"].rstrip("/")
    try:
        path = os.path.expanduser("~/.t3/userdata/server-runtime.json")
        with open(path) as f:
            return json.load(f).get("origin", DEFAULT_ORIGIN).rstrip("/")
    except (OSError, ValueError):
        return DEFAULT_ORIGIN


def call(method, url, token, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(url, data=data, method=method, headers={
        "authorization": f"Bearer {token}", "content-type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            return resp.status, resp.read().decode()
    except urllib.error.HTTPError as err:
        return err.code, err.read().decode(errors="replace")


def die(msg):
    sys.exit(f"t3-thread: {msg}")


def now_iso():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z")


@contextlib.contextmanager
def session():
    """Yield a 5-minute token; always revoke it."""
    session_id = None
    with tempfile.TemporaryDirectory(prefix="t3-thread-") as tmp:
        os.chmod(tmp, 0o700)
        try:
            issued = subprocess.run(
                ["t3", "auth", "session", "issue", "--ttl", "5m", "--label", LABEL, "--json"],
                capture_output=True, text=True, check=True, cwd=tmp).stdout
            info = json.loads(issued)
            session_id = info["sessionId"]
            yield info["token"]
        except subprocess.CalledProcessError as err:
            die(f"could not issue a token: {err.stderr.strip()[:300]}")
        finally:
            if session_id:
                subprocess.run(["t3", "auth", "session", "revoke", session_id],
                               capture_output=True, text=True, cwd=tmp)


def snapshot(token):
    status, raw = call("GET", f"{origin()}/api/orchestration/snapshot", token)
    if status != 200:
        die(f"snapshot failed ({status}): {raw[:300]}")
    return json.loads(raw)


def find_thread(snap, thread_id, live=True):
    thread = next((t for t in snap["threads"] if t["id"] == thread_id), None)
    if thread is None:
        die(f"thread {thread_id} not found")
    if live and (thread.get("deletedAt") or thread.get("archivedAt")):
        die(f"thread {thread_id} is deleted or archived")
    return thread


def dispatch(token, command, dry_run):
    """Print (dry run) or send a command; return the HTTP status."""
    if dry_run:
        print(json.dumps(command, indent=2))
        return None
    status, body = call("POST", f"{origin()}/api/orchestration/dispatch", token, command)
    if not 200 <= status < 300:
        die(f"dispatch failed ({status}): {body[:500]}")
    return status


def read_text(path):
    if path:
        with open(path) as f:
            text = f.read()
    else:
        text = sys.stdin.read()
    if not text.strip():
        die("refusing to send an empty message")
    return text


def user_message(text):
    return {"messageId": str(uuid.uuid4()), "role": "user", "text": text, "attachments": []}


def cmd_post(args):
    text = read_text(args.file)
    with session() as token:
        thread = find_thread(snapshot(token), args.thread_id)
        command = {
            "type": "thread.turn.start", "commandId": str(uuid.uuid4()), "threadId": args.thread_id,
            "message": user_message(text),
            "modelSelection": thread["modelSelection"], "runtimeMode": thread["runtimeMode"],
            "interactionMode": thread["interactionMode"], "createdAt": now_iso(),
        }
        status = dispatch(token, command, args.dry_run)
        if status:
            print(f"thread={args.thread_id} message={command['message']['messageId']} status={status}")


def cmd_settle(args):
    with session() as token:
        find_thread(snapshot(token), args.thread_id)
        command = {"type": "thread.settle", "commandId": str(uuid.uuid4()), "threadId": args.thread_id}
        status = dispatch(token, command, args.dry_run)
        if status:
            print(f"thread={args.thread_id} status={status}")


def git_toplevel(cwd):
    result = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, cwd=cwd)
    return result.stdout.strip() if result.returncode == 0 and result.stdout.strip() else cwd


def cmd_self(args):
    cwd = os.path.realpath(args.cwd)
    top = os.path.realpath(git_toplevel(cwd))
    try:
        db = sqlite3.connect(f"file:{STATE_DB}?mode=ro", uri=True)
        rows = db.execute(
            "SELECT thread_id, worktree_path, COALESCE(latest_user_message_at, updated_at, created_at), title"
            " FROM projection_threads WHERE deleted_at IS NULL AND archived_at IS NULL"
            " AND (settled_at IS NULL OR (unsettled_at IS NOT NULL AND unsettled_at > settled_at))"
            " AND worktree_path IS NOT NULL").fetchall()
    except sqlite3.Error as err:
        die(f"cannot read {STATE_DB}: {err}")
    matches = sorted((r for r in rows if os.path.realpath(r[1]) == top), key=lambda r: r[2] or "", reverse=True)
    if not matches:
        sys.exit(1)
    for other in matches[1:]:
        print(f"t3-thread: warning: other thread on {top}: {other[0]} ({other[3]})", file=sys.stderr)
    print(matches[0][0])


def default_base_branch(snap, project):
    for source in (project, snap):
        for key in ("defaultBranch", "baseBranch", "defaultBaseBranch"):
            if source.get(key):
                return source[key]
    return "develop"


def cmd_spawn(args):
    text = read_text(args.file)
    with session() as token:
        snap = snapshot(token)
        src = find_thread(snap, args.from_thread)
        project = next((p for p in snap["projects"] if p["id"] == src["projectId"]), None)
        if project is None:
            die(f"project {src['projectId']} not found")
        model = dict(src["modelSelection"])
        if args.model:
            model["model"] = args.model
        title = args.title or (text.strip().splitlines()[0][:60] or "New thread")
        if args.new_worktree:
            # The HTTP dispatch endpoint ignores turn-start bootstrap, so T3 cannot prepare a worktree here.
            die("--new-worktree is not supported over HTTP; create the worktree with `wt new` and spawn into it")
        new_id, created = str(uuid.uuid4()), now_iso()
        create = {
            "type": "thread.create", "commandId": str(uuid.uuid4()), "threadId": new_id,
            "projectId": src["projectId"], "title": title, "modelSelection": model,
            "runtimeMode": src["runtimeMode"], "interactionMode": src["interactionMode"],
            "branch": src.get("branch"), "worktreePath": src.get("worktreePath"), "createdAt": created}
        turn = {
            "type": "thread.turn.start", "commandId": str(uuid.uuid4()), "threadId": new_id,
            "message": user_message(text), "modelSelection": model,
            "runtimeMode": src["runtimeMode"], "interactionMode": src["interactionMode"],
            "createdAt": now_iso()}
        if not dispatch(token, create, args.dry_run):
            dispatch(token, turn, True)
            return
        deadline = time.time() + 20
        while not any(t["id"] == new_id for t in snapshot(token)["threads"]):
            if time.time() > deadline:
                die(f"thread {new_id} did not appear within 20s")
            time.sleep(1)
        status = dispatch(token, turn, False)
        print(f"thread={new_id} status={status} title={title}")


def main():
    ap = argparse.ArgumentParser(description="Manage T3 Code threads.")
    sub = ap.add_subparsers(dest="command", required=True)

    def add(name, fn, help_text, dry=True):
        p = sub.add_parser(name, help=help_text)
        if dry:
            p.add_argument("--dry-run", action="store_true", help="print the command instead of sending it")
        p.set_defaults(fn=fn)
        return p

    p = add("post", cmd_post, "post a user message into a thread")
    p.add_argument("thread_id")
    p.add_argument("--file", help="read the message from this file (default: stdin)")
    p = add("self", cmd_self, "print the calling agent's own thread id", dry=False)
    p.add_argument("--cwd", default=os.getcwd())
    p = add("spawn", cmd_spawn, "start a new thread in the same project")
    p.add_argument("--from", dest="from_thread", required=True, metavar="THREAD_ID")
    p.add_argument("--file", required=True, help="first user message")
    p.add_argument("--title")
    p.add_argument("--new-worktree", action="store_true", help="have T3 prepare a fresh worktree")
    p.add_argument("--base-branch", help="base for --new-worktree (default: project default or develop)")
    p.add_argument("--model", help="override the model id only")
    p = add("settle", cmd_settle, "mark a thread settled")
    p.add_argument("thread_id")
    args = ap.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
