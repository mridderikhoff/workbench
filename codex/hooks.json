{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 '/home/marica/.codex/hooks/block-inline-checkout-edits-codex.py'",
            "timeout": 20,
            "type": "command"
          }
        ]
      },
      {
        "matcher": "^Agent$",
        "hooks": [
          {
            "command": "python3 '/home/marica/.codex/hooks/enforce-subagent-policy.py'",
            "timeout": 20,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/home/marica/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
